 		: format(1000000000, 'b');
 }
 
+QString HashBuilds(const QString &source) {
+	auto result = source;
+	const auto spans = Parse(source, true).spans;
+	for (auto i = int(spans.size()); i != 0;) {
+		const auto &span = spans[--i];
+		if ((span.till - span.from < 2)
+			|| (span.from > 0 && source[span.from - 1] == '#')) {
+			continue;
+		}
+		const auto tokens = Parse(
+			source.mid(span.from, span.till - span.from),
+			true).tokens;
+		if (tokens.size() == 1
+			&& tokens.front().variable
+			&& !tokens.front().broken
+			&& !tokens.front().brief
+			&& tokens.front().name == u"build"_q) {
+			result.insert(span.from, QChar('#'));
+		}
+	}
+	return result;
+}
+
 } // namespace Tele::Titles
