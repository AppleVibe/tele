From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sat, 10 Oct 2026 14:42:02 +0300
Subject: [PATCH] fix: double-click selects words in service messages and
 transfer comments

---
 .../history/view/history_view_element.cpp     | 14 +++++++-----
 .../view/media/history_view_media_generic.cpp | 22 +++++++++++++++++++
 .../SourceFiles/wallet/wallet_content.cpp     |  3 +++
 3 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/Telegram/SourceFiles/history/view/history_view_element.cpp b/Telegram/SourceFiles/history/view/history_view_element.cpp
index c8f86c93ab4ac9ab41b74860aefb5a6338dd4697..dad67a0fa3e350678a5841a9fa2344af5b8c6461 100644
--- a/Telegram/SourceFiles/history/view/history_view_element.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_element.cpp
@@ -3272,11 +3272,15 @@ MessageSelection Element::selectionFromStates(
 		|| current.selectionCursor.isRichPage()) {
 		return {};
 	}
-	return adjustSelection(
-		MessageSelection::Flat(
-			FlatSelectionEndpointFromState(anchor),
-			FlatSelectionEndpointFromState(current)),
-		type);
+	const auto anchorEndpoint = FlatSelectionEndpointFromState(anchor);
+	const auto currentEndpoint = FlatSelectionEndpointFromState(current);
+	auto selection = TextSelection(
+		uint16(std::min(anchorEndpoint.offset(), currentEndpoint.offset())),
+		uint16(std::max(anchorEndpoint.offset(), currentEndpoint.offset())));
+	if (type != TextSelectType::Letters) {
+		selection = adjustSelection(selection, type);
+	}
+	return MessageSelection::Flat(selection, anchorEndpoint, currentEndpoint);
 }
 
 TextForMimeData Element::selectedText(
diff --git a/Telegram/SourceFiles/history/view/media/history_view_media_generic.cpp b/Telegram/SourceFiles/history/view/media/history_view_media_generic.cpp
index 3e2af3a74b28fa52ec8979d7cf3b9462860fd40d..4c8401abb466afadafb05bf5bde2bcf7fd5296fd 100644
--- a/Telegram/SourceFiles/history/view/media/history_view_media_generic.cpp
+++ b/Telegram/SourceFiles/history/view/media/history_view_media_generic.cpp
@@ -296,6 +296,28 @@ TextSelection MediaGeneric::adjustSelection(
 		TextSelectType type) const {
 	if (selection == FullSelection) {
 		return selection;
+	} else if (selection.empty() && type != TextSelectType::Letters) {
+		// A double click selects around one point, which can sit right at
+		// the start or the end of a part: find the part that holds it.
+		auto offset = uint16(0);
+		for (const auto &entry : _entries) {
+			const auto length = entry.object->fullSelectionLength();
+			const auto end = uint16(offset + length);
+			if (length > 0
+				&& selection.from >= offset
+				&& selection.from <= end) {
+				const auto local = uint16(selection.from - offset);
+				const auto result = entry.object->adjustSelection(
+					{ local, local },
+					type);
+				return {
+					uint16(offset + result.from),
+					uint16(offset + result.to),
+				};
+			}
+			offset = end;
+		}
+		return selection;
 	}
 	auto offset = uint16(0);
 	auto firstFrom = std::optional<uint16>();
diff --git a/Telegram/SourceFiles/wallet/wallet_content.cpp b/Telegram/SourceFiles/wallet/wallet_content.cpp
index 1d44a2278b920628354eb46cfb504222a5c05191..3368a542d3b5d4d1f8458c6c88e3cd6124c44b19 100644
--- a/Telegram/SourceFiles/wallet/wallet_content.cpp
+++ b/Telegram/SourceFiles/wallet/wallet_content.cpp
@@ -3787,6 +3787,9 @@ void AddDetailsComment(
 			item,
 			std::move(originCurrent)))
 		: object_ptr<Ui::FlatLabel>(layout, comment, st::walletCommentLabel);
+	if (!item.commentEncrypted) {
+		label->setSelectable(true);
+	}
 	// The bubble stands inside the gap between the amount and the table
 	// rather than under the amount: the header leaves half of that gap and
 	// the bubble takes the other half, so it reads as its own line.
