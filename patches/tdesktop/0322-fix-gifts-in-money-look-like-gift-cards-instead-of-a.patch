@@ -0,0 +1,220 @@
+#include "tele/tele_gift_tile.h"
+
+#include "data/data_document.h"
+#include "data/data_document_media.h"
+#include "data/data_session.h"
+#include "data/data_star_gift.h"
+#include "data/stickers/data_custom_emoji.h"
+#include "history/view/media/history_view_sticker_player_abstract.h"
+#include "main/main_session.h"
+#include "tele/tele_money_card.h"
+#include "ui/emoji_config.h"
+#include "ui/painter.h"
+#include "ui/power_saving.h"
+#include "ui/text/text_custom_emoji.h"
+#include "ui/top_background_gradient.h"
+
+#include <QtGui/QRadialGradient>
+
+namespace Tele {
+namespace {
+
+constexpr auto kModelSide = 0.62;
+constexpr auto kPatternSide = 0.14;
+constexpr auto kPatternSpread = 12;
+
+void PaintPattern(
+		QPainter &p,
+		not_null<Ui::Text::CustomEmoji*> emoji,
+		const QColor &color,
+		QSize size) {
+	const auto ratio = style::DevicePixelRatio();
+	const auto large = Ui::Emoji::GetSizeLarge() / ratio;
+	const auto side = std::min(size.width(), size.height());
+	const auto spread = side / float64(kPatternSpread);
+	const auto area = QRectF(QPointF(), QSizeF(size)).marginsAdded(
+		{ spread, spread, spread, spread });
+	for (const auto &point : Ui::PatternBgPoints()) {
+		const auto symbol = side * kPatternSide * point.scale;
+		p.save();
+		p.setOpacity(point.opacity);
+		p.translate(
+			area.x() + point.position.x() * area.width(),
+			area.y() + point.position.y() * area.height());
+		p.scale(symbol / large, symbol / large);
+		emoji->paint(p, {
+			.textColor = color,
+			.position = QPoint(-large / 2, -large / 2),
+			.paused = true,
+		});
+		p.restore();
+	}
+}
+
+} // namespace
+
+GiftTile::GiftTile(
+	not_null<Main::Session*> session,
+	bool animated,
+	Fn<void()> repaint)
+: _session(session)
+, _animated(animated)
+, _repaint(std::move(repaint)) {
+}
+
+GiftTile::~GiftTile() = default;
+
+void GiftTile::setGift(const std::shared_ptr<Data::UniqueGift> &gift) {
+	if (_gift == gift) {
+		return;
+	}
+	_gift = gift;
+	_background = QImage();
+	_backgroundRadius = -1;
+	_backgroundPatterned = false;
+	_modelLifetime.destroy();
+	_player = nullptr;
+	_playerSide = 0;
+	_media = nullptr;
+	_still = QImage();
+	_stillSide = 0;
+	_pattern = nullptr;
+	if (!_gift) {
+		return;
+	}
+	_pattern = _session->data().customEmojiManager().create(
+		_gift->pattern.document,
+		[=] {
+			if (!_backgroundPatterned) {
+				_repaint();
+			}
+		},
+		Data::CustomEmojiSizeTag::Large);
+	[[maybe_unused]] const auto preload = _pattern->ready();
+}
+
+bool GiftTile::paint(
+		QPainter &p,
+		const std::shared_ptr<Data::UniqueGift> &gift,
+		QRect rect,
+		int radius) {
+	setGift(gift);
+	if (!_gift || rect.isEmpty()) {
+		return false;
+	}
+	validateBackground(rect.size(), radius);
+	auto hq = PainterHighQualityEnabler(p);
+	p.drawImage(rect.topLeft(), _background);
+	paintModel(p, rect);
+	return true;
+}
+
+void GiftTile::validateBackground(QSize size, int radius) {
+	const auto ratio = style::DevicePixelRatio();
+	if (_background.size() != size * ratio
+		|| _backgroundRadius != radius) {
+		_background = QImage(
+			size * ratio,
+			QImage::Format_ARGB32_Premultiplied);
+		_background.setDevicePixelRatio(ratio);
+		_background.fill(Qt::transparent);
+		_backgroundRadius = radius;
+		_backgroundPatterned = false;
+
+		auto p = QPainter(&_background);
+		auto hq = PainterHighQualityEnabler(p);
+		const auto inner = QRectF(QPointF(), QSizeF(size));
+		auto gradient = QRadialGradient(inner.center(), inner.width() / 2.);
+		gradient.setStops({
+			{ 0., _gift->backdrop.centerColor },
+			{ 1., _gift->backdrop.edgeColor },
+		});
+		p.setPen(Qt::NoPen);
+		p.setBrush(gradient);
+		p.drawRoundedRect(inner, radius, radius);
+	}
+	if (_backgroundPatterned || !_pattern || !_pattern->ready()) {
+		return;
+	}
+	_backgroundPatterned = true;
+	auto p = QPainter(&_background);
+	auto hq = PainterHighQualityEnabler(p);
+	p.setCompositionMode(QPainter::CompositionMode_SourceAtop);
+	PaintPattern(p, _pattern.get(), _gift->backdrop.patternColor, size);
+}
+
+void GiftTile::validateModel(int side) {
+	if (side <= 0
+		|| _playerSide >= side
+		|| (!_animated && _stillSide >= side)) {
+		return;
+	}
+	_modelLifetime.destroy();
+	_player = nullptr;
+	_playerSide = side;
+	const auto document = _gift->model.document;
+	if (!_media) {
+		_media = document->createMediaView();
+		_media->checkStickerLarge();
+	}
+	const auto media = _media;
+	rpl::single(rpl::empty) | rpl::then(
+		_session->downloaderTaskFinished()
+	) | rpl::filter([=] {
+		return media->loaded();
+	}) | rpl::take(1) | rpl::on_next([=] {
+		auto player = MakeMoneyCardModelPlayer(
+			document,
+			media.get(),
+			QSize(side, side));
+		if (!player) {
+			return;
+		}
+		player->setRepaintCallback(_repaint);
+		_player = std::move(player);
+		_repaint();
+	}, _modelLifetime);
+}
+
+void GiftTile::paintModel(QPainter &p, QRect rect) {
+	const auto side = int(std::round(rect.width() * kModelSide));
+	const auto model = QRect(
+		rect.x() + (rect.width() - side) / 2,
+		rect.y() + (rect.height() - side) / 2,
+		side,
+		side);
+	validateModel(side);
+	if (!_player || !_player->ready()) {
+		if (!_still.isNull()) {
+			p.drawImage(model, _still);
+		}
+		return;
+	}
+	const auto paused = !_animated
+		|| PowerSaving::On(PowerSaving::kStickersChat);
+	const auto info = _player->frame(
+		QSize(_playerSide, _playerSide),
+		QColor(0, 0, 0, 0),
+		false,
+		crl::now(),
+		paused);
+	if (!paused) {
+		_player->markFrameShown();
+	}
+	if (info.image.isNull()) {
+		if (!_still.isNull()) {
+			p.drawImage(model, _still);
+		}
+		return;
+	}
+	p.drawImage(model, info.image);
+	if (!_animated) {
+		_still = info.image.copy();
+		_stillSide = _playerSide;
+		_modelLifetime.destroy();
+		_player = nullptr;
+		_playerSide = 0;
+	}
+}
+
+} // namespace Tele
