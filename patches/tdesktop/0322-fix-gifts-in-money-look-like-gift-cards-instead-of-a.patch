+class StickerPlayer;
+} // namespace HistoryView
+
+namespace Main {
+class Session;
+} // namespace Main
+
+namespace Ui::Text {
+class CustomEmoji;
+} // namespace Ui::Text
+
+namespace Tele {
+
+class GiftTile final {
+public:
+	GiftTile(
+		not_null<Main::Session*> session,
+		bool animated,
+		Fn<void()> repaint);
+	~GiftTile();
+
+	bool paint(
+		QPainter &p,
+		const std::shared_ptr<Data::UniqueGift> &gift,
+		QRect rect,
+		int radius);
+
+private:
+	void setGift(const std::shared_ptr<Data::UniqueGift> &gift);
+	void validateBackground(QSize size, int radius);
+	void validateModel(int side);
+	void paintModel(QPainter &p, QRect rect);
+
+	const not_null<Main::Session*> _session;
+	const bool _animated = false;
+	const Fn<void()> _repaint;
+	std::shared_ptr<Data::UniqueGift> _gift;
+	std::unique_ptr<Ui::Text::CustomEmoji> _pattern;
+	QImage _background;
+	int _backgroundRadius = -1;
+	bool _backgroundPatterned = false;
+	std::shared_ptr<Data::DocumentMedia> _media;
+	std::unique_ptr<HistoryView::StickerPlayer> _player;
+	int _playerSide = 0;
+	QImage _still;
+	int _stillSide = 0;
+	rpl::lifetime _modelLifetime;
+
+};
+
+} // namespace Tele
