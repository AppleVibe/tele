+struct ShortcutSender {
+	const QObject *autocomplete = nullptr;
+	Fn<void(QString)> process;
+};
+
+[[nodiscard]] base::flat_map<const QObject*, ShortcutSender> &Senders() {
+	static auto result = base::flat_map<const QObject*, ShortcutSender>();
+	return result;
+}
+
+[[nodiscard]] bool ShortcutsForPeer(not_null<PeerData*> peer) {
+	if (const auto user = peer->asUser()) {
+		return !user->isBot() && !user->starsPerMessageChecked();
+	}
+	return GroupShortcutsAllowed(peer->asChat(), peer->asChannel());
+}
+
+[[nodiscard]] QString ShortcutNameIn(
+		not_null<PeerData*> peer,
+		const QString &text) {
+	const auto trimmed = text.trimmed();
+	if (trimmed.size() < 2
+		|| trimmed[0] != '/'
+		|| ranges::any_of(trimmed, [](QChar ch) { return ch.isSpace(); })) {
+		return QString();
+	}
+	const auto name = trimmed.mid(1);
+	const auto &list = peer->owner().shortcutMessages().shortcuts().list;
+	for (const auto &[id, shortcut] : list) {
+		if (shortcut.count > 0
+			&& !shortcut.name.compare(name, Qt::CaseInsensitive)) {
+			return shortcut.name;
+		}
+	}
+	return QString();
+}
+
 } // namespace
 
-void MarkShortcutsActionable(not_null<QObject*> autocomplete) {
+void MarkShortcutsActionable(
+		not_null<QObject*> autocomplete,
+		not_null<Ui::InputField*> field,
+		Fn<void(QString)> process) {
 	autocomplete->setProperty(kActionableProperty, true);
+	const auto key = static_cast<const QObject*>(field.get());
+	const auto source = static_cast<const QObject*>(autocomplete.get());
+	Senders()[key] = { .autocomplete = source, .process = std::move(process) };
+	const auto forget = [=](bool always) {
+		const auto i = Senders().find(key);
+		if (i != end(Senders()) && (always || i->second.autocomplete == source)) {
+			Senders().erase(i);
+		}
+	};
+	QObject::connect(autocomplete, &QObject::destroyed, [=] {
+		forget(false);
+	});
+	QObject::connect(field, &QObject::destroyed, [=] {
+		forget(true);
+	});
 }
 
 bool ShortcutsInChat(
@@ -582,6 +639,34 @@ bool ShortcutsInChat(
 		&& GroupShortcutsAllowed(chat, channel);
 }
 
+bool SendShortcutByName(
+		Ui::InputField *field,
+		not_null<PeerData*> peer,
+		const Api::SendOptions &options) {
+	if (!field
+		|| !QuickRepliesByName()
+		|| options.scheduled
+		|| options.scheduleRepeatPeriod
+		|| options.shortcutId
+		|| options.ttlSeconds
+		|| options.welcomeTemplate
+		|| !ShortcutsForPeer(peer)) {
+		return false;
+	}
+	const auto i = Senders().find(field);
+	if (i == end(Senders()) || !i->second.process) {
+		return false;
+	}
+	const auto name = ShortcutNameIn(peer, field->getLastText());
+	if (name.isEmpty()) {
+		return false;
+	}
+	const auto process = i->second.process;
+	field->setCursorPosition(field->getLastText().size());
+	process(name);
+	return true;
+}
+
 bool SendShortcut(
 		std::shared_ptr<ChatHelpers::Show> show,
 		Api::SendAction action,
