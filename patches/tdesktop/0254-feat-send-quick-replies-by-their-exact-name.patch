+template <typename Rows>
+void PreferExactShortcut(Rows &rows, int from, const QString &filter) {
+	if (!QuickRepliesByName()
+		|| filter.isEmpty()
+		|| from < 0
+		|| from + 1 >= int(rows.size())) {
+		return;
+	}
+	const auto first = begin(rows) + from + 1;
+	const auto exact = std::find_if(first, end(rows), [&](const auto &row) {
+		return !row.command.compare(filter, Qt::CaseInsensitive);
+	});
+	if (exact == end(rows)) {
+		return;
+	}
+	std::rotate(first, exact, exact + 1);
+	std::rotate(begin(rows), begin(rows) + from, end(rows));
+}
 
 } // namespace Tele
