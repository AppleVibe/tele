From: nitreojs <hello@starkow.dev>
Date: Fri, 16 Oct 2026 04:37:42 +0300
Subject: [PATCH] fix: glides in boxes no longer blank the chats under them

---
 .../SourceFiles/tele/tele_smooth_scroll.cpp   | 25 +++++++++++++++++--
 .../SourceFiles/tele/tele_smooth_scroll.h     |  3 ++-
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/Telegram/SourceFiles/tele/tele_smooth_scroll.cpp b/Telegram/SourceFiles/tele/tele_smooth_scroll.cpp
index 8f05787b328676a63689f9c42398d920ab65c8d2..62a3e2b9f1dc09dd361afbdeafbdb0fddfeff194 100644
--- a/Telegram/SourceFiles/tele/tele_smooth_scroll.cpp
+++ b/Telegram/SourceFiles/tele/tele_smooth_scroll.cpp
@@ -34,6 +34,23 @@ constexpr auto kHeldRepaintTimeout = crl::time(32);
 	});
 }
 
+[[nodiscard]] bool OverlapsGlide(
+		not_null<QWidget*> widget,
+		not_null<QWidget*> scroll) {
+	auto branch = scroll.get();
+	while (const auto parent = branch->parentWidget()) {
+		if (parent->isAncestorOf(widget)) {
+			auto other = widget.get();
+			while (other->parentWidget() != parent) {
+				other = other->parentWidget();
+			}
+			return branch->geometry().intersects(other->geometry());
+		}
+		branch = parent;
+	}
+	return false;
+}
+
 void Resume(not_null<QWidget*> widget) {
 	auto &paused = Paused();
 	const auto i = ranges::find_if(paused, [&](const QPointer<QWidget> &e) {
@@ -47,7 +64,9 @@ void Resume(not_null<QWidget*> widget) {
 
 // While a glide runs, window repaints wait for its next step, so the
 // window paints once per step instead of whenever something changes.
-// Widgets outside the glide that asked for it stop repainting meanwhile.
+// Widgets that asked for it and don't overlap the glide stop repainting
+// meanwhile: a paused widget under a box or over the gliding area would
+// leave a hole whenever the glide repaints across it.
 class FrameBatcher final : public QObject {
 public:
 	FrameBatcher(not_null<QWidget*> scroll, not_null<QWidget*> window)
@@ -67,7 +86,9 @@ public:
 				continue;
 			} else if (scroll->isAncestorOf(widget)) {
 				Resume(widget);
-			} else if (widget->updatesEnabled() && !InsideGlide(widget)) {
+			} else if (widget->updatesEnabled()
+				&& !InsideGlide(widget)
+				&& !OverlapsGlide(widget, scroll)) {
 				widget->setUpdatesEnabled(false);
 				Paused().push_back(widget);
 				_paused.push_back(widget);
diff --git a/Telegram/SourceFiles/tele/tele_smooth_scroll.h b/Telegram/SourceFiles/tele/tele_smooth_scroll.h
index ecddf35fb70a857d2d0641c25dc7e121a01304f6..429ee4665129bf10e470e1838b4974a2be6ed2ef 100644
--- a/Telegram/SourceFiles/tele/tele_smooth_scroll.h
+++ b/Telegram/SourceFiles/tele/tele_smooth_scroll.h
@@ -9,7 +9,8 @@ namespace Tele {
 void StartSmoothScroll();
 [[nodiscard]] bool SmoothGlideActive();
 
-// The widget doesn't repaint while a glide outside it runs.
+// The widget doesn't repaint while a glide runs that neither contains nor
+// overlaps it.
 void PauseDuringOtherGlides(not_null<QWidget*> widget);
 
 void RepaintAfterDownloads(
