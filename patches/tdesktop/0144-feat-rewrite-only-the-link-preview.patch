 }
 
-void AddLinkPreview(
-		std::shared_ptr<ChatHelpers::Show> show,
-		not_null<HistoryView::Controls::WebpageProcessor*> processor,
-		const QString &link) {
-	const auto apply = [=](WebPageData *page) {
-		const auto now = base::unixtime::now();
-		if (!page
-			|| page->failed
-			|| (page->pendingTill > 0 && page->pendingTill < now)) {
-			show->showToast(tr::lng_preview_cant(tr::now));
-			return;
-		}
-		processor->apply({
-			.id = page->id,
-			.url = page->url,
-			.manual = true,
-		});
-	};
+[[nodiscard]] bool Previewable(WebPageData *page) {
+	const auto now = base::unixtime::now();
+	return page
+		&& !page->failed
+		&& !(page->pendingTill > 0 && page->pendingTill < now);
+}
+
+void ResolveLink(
+		not_null<Processor*> processor,
+		const QString &link,
+		Fn<void(WebPageData*)> done) {
 	const auto resolver = processor->resolver();
 	if (const auto value = resolver->lookup(link)) {
-		apply(*value);
+		done(*value);
 		return;
 	} else if (OfflineForLaunch()) {
-		apply(nullptr);
+		done(nullptr);
 		return;
 	}
 	resolver->resolved(
 	) | rpl::filter([=](const QString &resolved) {
 		return (resolved == link);
 	}) | rpl::take(1) | rpl::on_next([=] {
-		apply(resolver->lookup(link).value_or(nullptr));
+		done(resolver->lookup(link).value_or(nullptr));
 	}, processor->lifetime());
 	resolver->request(link);
 }
 
+void ApplyManualPreview(
+		not_null<Processor*> processor,
+		not_null<WebPageData*> page) {
+	processor->apply({
+		.id = page->id,
+		.url = page->url,
+		.manual = true,
+	});
+}
+
+[[nodiscard]] bool AutoPreview(not_null<Processor*> processor) {
+	const auto draft = processor->draft();
+	return !draft.manual && !draft.removed;
+}
+
+void AddLinkPreview(
+		std::shared_ptr<ChatHelpers::Show> show,
+		not_null<HistoryView::Controls::WebpageProcessor*> processor,
+		const QString &link) {
+	ResolveLink(processor, link, [=](WebPageData *page) {
+		if (!Previewable(page)) {
+			show->showToast(tr::lng_preview_cant(tr::now));
+			return;
+		}
+		ApplyManualPreview(processor, page);
+	});
+}
+
 } // namespace
 
 void NotifyFieldPaste(not_null<Ui::InputField*> field, QString text) {
@@ -239,7 +261,7 @@ void SetupLinkPreviews(
 		not_null<Ui::InputField*> field,
 		not_null<Processor*> processor) {
 	const auto state = processor->lifetime().make_state<ProcessorState>(
-		ProcessorState{ .field = field });
+		ProcessorState{ .field = field, .processor = processor });
 	const auto raw = processor.get();
 	States()[raw] = state;
 	processor->lifetime().add([=] {
@@ -337,6 +359,43 @@ bool SkipAutoLinkPreview(not_null<Processor*> processor) {
 	return true;
 }
 
+void PreviewRewrittenLinks(
+		not_null<Ui::InputField*> field,
+		const base::flat_map<QString, QString> &rewritten) {
+	const auto i = ranges::find_if(States(), [&](const auto &pair) {
+		return (pair.second->field == field);
+	});
+	if (i == end(States())) {
+		return;
+	}
+	const auto processor = i->second->processor;
+	const auto resolver = processor->resolver();
+	auto link = QString();
+	auto url = QString();
+	for (const auto &current : CurrentLinks(field, processor)) {
+		if (const auto j = rewritten.find(current); j != end(rewritten)) {
+			link = current;
+			url = j->second;
+			break;
+		} else if (const auto page = resolver->lookup(current)) {
+			if (!*page) {
+				continue;
+			}
+		}
+		return;
+	}
+	if (url.isEmpty() || !AutoPreview(processor)) {
+		return;
+	}
+	ResolveLink(processor, url, [=](WebPageData *page) {
+		if (Previewable(page)
+			&& AutoPreview(processor)
+			&& CurrentLinks(field, processor).contains(link)) {
+			ApplyManualPreview(processor, page);
+		}
+	});
+}
+
 void AddCustomLinkPreviewButtons(
 		not_null<Ui::VerticalLayout*> container,
 		CustomLinkPreviewArgs &&args) {
