+[[nodiscard]] base::flat_map<QString, QString> Rewritten(const Memo &memo) {
+	auto result = base::flat_map<QString, QString>();
+	for (const auto &[url, rewritten] : memo) {
+		if (rewritten) {
+			result.emplace(url, *rewritten);
+		}
+	}
+	return result;
+}
