+	}
+	auto translated = QString();
+	return Lower(Translate(text, &translated) ? translated : std::move(text));
+}
+
+QString Plural(
+		qint64 count,
+		QStringView englishOne,
+		QStringView englishOther,
+		QStringView russianOne,
+		QStringView russianFew,
+		QStringView russianMany) {
+	if (!Russian()) {
+		return Lower((count == 1 ? englishOne : englishOther).toString());
+	}
+	const auto last = count % 10;
+	const auto lastTwo = count % 100;
+	const auto one = (last == 1 || last == -1)
+		&& lastTwo != 11 && lastTwo != -11;
+	const auto few = ((last >= 2 && last <= 4) || (last <= -2 && last >= -4))
+		&& !(lastTwo >= 12 && lastTwo <= 14)
+		&& !(lastTwo <= -12 && lastTwo >= -14);
+	return Lower((one ? russianOne : few ? russianFew : russianMany).toString());
+}
+
