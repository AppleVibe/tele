+#include "tele/tele_i18n.h"
+
+#include "core/application.h"
+#include "lang/lang_keys.h"
+
+namespace Tele::I18n {
+
+bool Russian() {
+	if (!Core::IsAppLaunched()) {
+		return false;
+	}
+	const auto id = Lang::Id();
+	return id.compare(u"ru"_q, Qt::CaseInsensitive) == 0
+		|| id.startsWith(u"ru-"_q, Qt::CaseInsensitive)
+		|| id.startsWith(u"ru_"_q, Qt::CaseInsensitive);
+}
+
+}
diff --git a/Telegram/SourceFiles/tele/tele_i18n_tests.cpp b/Telegram/SourceFiles/tele/tele_i18n_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..269bb3f9d8daa6fccea2c3c3057fdca59c0bec17
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_i18n_tests.cpp
@@ -0,0 +1,74 @@
+#include "tele/tele_i18n.h"
+#include "tele/tele_lowercase.h"
+
+#include <cassert>
+#include <limits>
+
+namespace Tele {
+namespace {
+
+bool RussianLanguage = false;
+bool Lowercase = false;
+
+}
+
+bool LowercaseStrings() {
+	return Lowercase;
+}
+
+namespace I18n {
+
+bool Russian() {
+	return RussianLanguage;
+}
+
+}
+}
+
+int main() {
+	using namespace Tele;
+	const auto source = u"Delete"_q;
+	assert(I18n::Text(source) == source);
+	assert(Lower(source) == source);
+	RussianLanguage = true;
+	assert(I18n::Text(source) == u"Удалить"_q);
+	assert(Lower(source) == source);
+	assert(I18n::Text(u"unsupported ui string"_q) == u"unsupported ui string"_q);
+	assert(I18n::Text(u"In"_q, u"transactions") == u"Поступления"_q);
+	assert(I18n::Text(u"To"_q, u"gradient") == u"Конечный цвет"_q);
+	const auto name = u"Delete %2 https://Example.org/API"_q;
+	const auto text = I18n::Text(u"Script %1: %2"_q).arg(name, u"messages.sendMessage"_q);
+	assert(text.contains(name));
+	assert(text.contains(u"messages.sendMessage"_q));
+	assert(Lower(name) == name);
+	const auto files = [](qint64 count) {
+		return I18n::Plural(count, u"%1 file", u"%1 files",
+			u"%1 файл", u"%1 файла", u"%1 файлов").arg(count);
+	};
+	assert(files(0) == u"0 файлов"_q);
+	assert(files(1) == u"1 файл"_q);
+	assert(files(2) == u"2 файла"_q);
+	assert(files(4) == u"4 файла"_q);
+	assert(files(5) == u"5 файлов"_q);
+	assert(files(11) == u"11 файлов"_q);
+	assert(files(14) == u"14 файлов"_q);
+	assert(files(21) == u"21 файл"_q);
+	assert(files(22) == u"22 файла"_q);
+	assert(files(101) == u"101 файл"_q);
+	assert(files(-21) == u"-21 файл"_q);
+	assert(files(std::numeric_limits<qint64>::min())
+		== u"-9223372036854775808 файлов"_q);
+	RussianLanguage = false;
+	assert(I18n::Text(u"In"_q, u"transactions") == u"In"_q);
+	assert(files(1) == u"1 file"_q);
+	assert(files(2) == u"2 files"_q);
+	assert(files(5) == u"5 files"_q);
+	assert(files(11) == u"11 files"_q);
+	assert(files(21) == u"21 files"_q);
+	Lowercase = true;
+	assert(I18n::Text(source) == u"delete"_q);
+	assert(Lower(u"Delete https://Example.org/API"_q)
+		== u"delete https://Example.org/API"_q);
+	RussianLanguage = true;
+	assert(I18n::Text(u"In"_q, u"transactions") == u"поступления"_q);
+}
