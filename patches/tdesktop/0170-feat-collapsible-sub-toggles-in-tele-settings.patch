+[[nodiscard]] rpl::producer<bool> EnabledValue(const QString &id) {
+	auto list = std::vector<rpl::producer<bool>>();
+	for (auto current = id; SubRows().contains(current);) {
+		const auto i = Parents().find(current);
+		if (i == end(Parents()) || i->second.list.empty()) {
+			break;
+		}
+		const auto parent = i->second.list.front().id;
+		list.push_back(OptionOnValue(parent));
+		current = QString::fromLatin1(parent);
+	}
+	if (list.empty()) {
+		return rpl::single(true);
+	}
+	return rpl::combine(
+		std::move(list)
+	) | rpl::map([](const std::vector<bool> &values) {
+		return ranges::all_of(values, [](bool value) { return value; });
+	}) | rpl::distinct_until_changed();
+}
+
+void BlockClicksWhenDisabled(not_null<Ui::AbstractButton*> button) {
+	if (!CurrentSubRow) {
+		return;
+	}
+	base::install_event_filter(button, [=](not_null<QEvent*> e) {
+		if (!button->isDisabled()) {
+			return base::EventFilterResult::Continue;
+		}
+		switch (e->type()) {
+		case QEvent::MouseButtonPress:
+		case QEvent::MouseButtonRelease:
+		case QEvent::MouseButtonDblClick:
+			return (static_cast<QMouseEvent*>(e.get())->button()
+				== Qt::RightButton)
+				? base::EventFilterResult::Continue
+				: base::EventFilterResult::Cancel;
+		case QEvent::KeyPress:
+		case QEvent::KeyRelease:
+			switch (static_cast<QKeyEvent*>(e.get())->key()) {
+			case Qt::Key_Space:
+			case Qt::Key_Return:
+			case Qt::Key_Enter:
+				return base::EventFilterResult::Cancel;
+			}
+			break;
+		}
+		return base::EventFilterResult::Continue;
+	});
+}
+
+void ApplySubRow(
+		not_null<Ui::RpWidget*> owner,
