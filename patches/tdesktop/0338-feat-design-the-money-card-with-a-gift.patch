+QSize MoneyCardModelSize(int chipSide) {
+	const auto side = int(base::SafeRound(chipSide * kModelScale));
+	return QSize(side, side);
+}
+
+QRect MoneyCardModelRect(const QRect &box) {
+	const auto side = MoneyCardModelSize(box.width()).width();
+	return QRect(
+		box.x() + (box.width() - side) / 2,
+		box.y() + (box.height() - side) / 2,
+		side,
+		side);
+}
+
+void SetupMoneyCardPill(
+		not_null<Ui::RoundButton*> button,
+		rpl::producer<MoneyCardLook> look,
+		Fn<void()> restyle) {
+	std::move(look) | rpl::on_next([=](const MoneyCardLook &look) {
+		if (look) {
+			auto ripple = look.text;
+			ripple.setAlpha(kPillRippleAlpha);
+			button->setProperty(kPillBgProperty, QVariant::fromValue(look.edge));
+			button->setProperty(kPillFgProperty, QVariant::fromValue(look.text));
+			button->setBrushOverride(QBrush(look.edge));
+			button->setRippleOverride(ripple);
+		} else {
+			button->setProperty(kPillBgProperty, QVariant());
+			button->setProperty(kPillFgProperty, QVariant());
+			button->setBrushOverride(std::nullopt);
+			button->setRippleOverride(std::nullopt);
+		}
+		restyle();
+		button->update();
+	}, button->lifetime());
+}
+
+std::optional<QColor> MoneyCardPillText(
+		not_null<const Ui::RoundButton*> button) {
+	const auto fg = button->property(kPillFgProperty);
+	if (!fg.isValid()) {
+		return std::nullopt;
+	}
+	const auto text = fg.value<QColor>();
+	if (!button->isDisabled()) {
+		return text;
+	}
+	return anim::color(
+		button->property(kPillBgProperty).value<QColor>(),
+		text,
+		0.5);
+}
+
+MoneyCardArt::MoneyCardArt(
+	not_null<Main::Session*> session,
+	QSize modelSize,
+	Fn<void()> repaint,
+	Fn<void()> frame)
+: _session(session)
+, _modelSize(modelSize)
+, _repaint(std::move(repaint))
+, _frame(frame ? std::move(frame) : _repaint) {
+}
+
+MoneyCardArt::~MoneyCardArt() = default;
+
+void MoneyCardArt::setLook(const MoneyCardLook &look) {
+	if (_look == look) {
+		return;
+	}
+	const auto patternChanged = (_look.patternId != look.patternId);
+	const auto modelChanged = (_look.modelId != look.modelId);
+	_look = look;
+	_patternCache.clear();
+	if (patternChanged) {
+		_pattern = _look.patternId
+			? _session->data().customEmojiManager().create(
+				_look.patternId,
+				_repaint,
+				Data::CustomEmojiSizeTag::Large)
+			: nullptr;
+	}
+	if (modelChanged && !_modelSize.isEmpty()) {
+		resolveModel();
+	}
+}
+
+const MoneyCardLook &MoneyCardArt::look() const {
+	return _look;
+}
+
+bool MoneyCardArt::ready() const {
+	return _player && _player->ready();
+}
+
+void MoneyCardArt::resolveModel() {
+	_modelLifetime.destroy();
+	_player = nullptr;
+	_media = nullptr;
+	if (!_look.modelId) {
+		return;
+	}
+	_session->data().customEmojiManager().resolve(
+		_look.modelId
+	) | rpl::take(
+		1
+	) | rpl::on_next_error([=](not_null<DocumentData*> document) {
+		const auto media = document->createMediaView();
+		media->checkStickerLarge();
+		_media = media;
+		rpl::single(rpl::empty) | rpl::then(
+			_session->downloaderTaskFinished()
+		) | rpl::filter([=] {
+			return media->loaded();
+		}) | rpl::take(1) | rpl::on_next([=] {
+			auto result = std::unique_ptr<HistoryView::StickerPlayer>();
+			const auto sticker = document->sticker();
+			if (!sticker) {
+				return;
+			} else if (sticker->isLottie()) {
+				result = std::make_unique<HistoryView::LottiePlayer>(
+					ChatHelpers::LottiePlayerFromDocument(
+						media.get(),
+						ChatHelpers::StickerLottieSize::InlineResults,
+						_modelSize,
+						Lottie::Quality::High));
+			} else if (sticker->isWebm()) {
+				result = std::make_unique<HistoryView::WebmPlayer>(
+					media->owner()->location(),
+					media->bytes(),
+					_modelSize);
+			} else {
+				result = std::make_unique<HistoryView::StaticStickerPlayer>(
+					media->owner()->location(),
+					media->bytes(),
+					_modelSize);
+			}
+			result->setRepaintCallback(_frame);
+			_player = std::move(result);
+			_repaint();
+		}, _modelLifetime);
+	}, [] {}, _modelLifetime);
+}
+
+void MoneyCardArt::paintBackground(
+		QPainter &p,
+		const QRect &card,
+		QPointF light,
+		int radius) {
+	const auto reach = std::hypot(
+		std::max(light.x() - card.x(), card.x() + card.width() - light.x()),
+		std::max(
+			light.y() - card.y(),
+			card.y() + card.height() - light.y()));
+	auto gradient = QRadialGradient(light, std::max(reach, 1.));
+	gradient.setStops({
+		{ 0., _look.center },
+		{ 1., _look.edge },
+	});
+	auto hq = PainterHighQualityEnabler(p);
+	auto path = QPainterPath();
+	path.addRoundedRect(QRectF(card), radius, radius);
+	p.fillPath(path, gradient);
+	if (_pattern) {
+		p.save();
+		p.setClipPath(path, Qt::IntersectClip);
+		Ui::PaintBgPoints(
+			p,
+			PatternPoints(),
+			_patternCache,
+			_pattern.get(),
+			_look.pattern,
+			card);
+		p.restore();
+	}
+}
+
+bool MoneyCardArt::paintModel(
+		QPainter &p,
+		const QRect &rect,
+		bool paused) {
+	if (!_player || !_player->ready()) {
+		return false;
+	}
+	const auto info = _player->frame(
+		_modelSize,
+		QColor(0, 0, 0, 0),
+		false,
+		crl::now(),
+		paused);
+	if (!paused) {
+		_player->markFrameShown();
+	}
+	if (info.image.isNull()) {
+		return false;
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	p.drawImage(QRectF(rect), info.image);
+	return true;
+}
+
+} // namespace Tele
