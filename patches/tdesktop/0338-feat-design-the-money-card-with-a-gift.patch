+public:
+	using Ui::AbstractButton::AbstractButton;
+
+	void setSelected(bool selected);
+
+private:
+	void paintEvent(QPaintEvent *e) override;
+
+	Wallet::CardBackground _background;
+	bool _selected = false;
+
