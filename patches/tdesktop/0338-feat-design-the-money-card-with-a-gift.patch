+
+void MoneyCardDesignBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Main::Session*> session,
+		MoneyCardPreview preview) {
+	using namespace Info::PeerGifts;
+
+	struct State {
+		rpl::variable<MoneyCardChoice> choice;
+		rpl::variable<bool> loaded = false;
+		rpl::variable<Ui::VisibleRange> range;
+		std::optional<Delegate> delegate;
+		std::vector<Data::SavedStarGift> gifts;
+		std::vector<std::unique_ptr<GiftButton>> buttons;
+		DefaultTile *defaultTile = nullptr;
+	};
+	const auto state = box->lifetime().make_state<State>();
+	state->choice = MoneyCardChoiceFor(session);
+	state->delegate.emplace(session, GiftButtonMode::Minimal);
+	const auto initialId = state->choice.current().gift.giftId;
+
+	box->setTitle(rpl::single(Lower(u"Card design"_q)));
+	box->setWidth(st::boxWideWidth);
+
+	box->addRow(
+		preview(
+			box,
+			rpl::combine(
+				state->choice.value(),
+				MoneyCardStatusLookValue(session)
+			) | rpl::map([](
+					const MoneyCardChoice &choice,
+					const MoneyCardLook &status) {
+				return ResolveMoneyCardLook(choice, status);
+			})),
+		style::margins(0, 0, 0, st::boxRowPadding.left()),
+		style::al_top);
+
+	const auto sync = box->addRow(
+		object_ptr<Ui::SettingsButton>(
+			box,
+			rpl::single(Lower(u"Sync with gift status"_q)),
+			st::settingsButtonNoIcon),
+		style::margins());
+	sync->toggleOn(rpl::single(state->choice.current().sync));
+	sync->toggledValue(
+	) | rpl::on_next([=](bool on) {
+		auto choice = state->choice.current();
+		choice.sync = on;
+		state->choice = std::move(choice);
+	}, sync->lifetime());
+
+	const auto wrap = box->addRow(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			box,
+			object_ptr<Ui::VerticalLayout>(box)),
+		style::margins());
+	wrap->toggleOn(state->choice.value(
+	) | rpl::map([](const MoneyCardChoice &choice) {
+		return !choice.sync;
+	}));
+	wrap->finishAnimating();
+	const auto inner = wrap->entity();
+
+	const auto grid = inner->add(
+		object_ptr<Ui::VisibleRangeWidget>(inner),
+		style::margins());
+	const auto empty = inner->add(
+		object_ptr<Ui::SlideWrap<Ui::FlatLabel>>(
+			inner,
+			object_ptr<Ui::FlatLabel>(
+				inner,
+				Lower(u"Collectible gifts you own show up here."_q),
+				st::boxDividerLabel),
+			st::boxRowPadding));
+	empty->toggleOn(state->loaded.value() | rpl::map([=](bool loaded) {
+		return loaded && state->gifts.empty();
+	}));
+	empty->finishAnimating();
+
+	const auto single = state->delegate->buttonSize();
+	const auto extend = state->delegate->buttonExtend();
+	const auto &padding = st::giftBoxPadding;
+	const auto available = st::boxWideWidth
+		- padding.left()
+		- padding.right();
+	const auto perRow = std::max(available / single.width(), 1);
+	const auto skipX = (perRow > 1)
+		? ((available - perRow * single.width()) / (perRow - 1))
+		: 0;
+	const auto rowHeight = single.height() + st::giftBoxGiftSkip.y();
+	const auto tileRect = [=](int index) {
+		return QRect(
+			padding.left() + (index % perRow) * (single.width() + skipX),
+			padding.top() + (index / perRow) * rowHeight,
+			single.width(),
+			single.height());
+	};
+	const auto selectedId = [=] {
+		return state->choice.current().gift.giftId;
+	};
+	const auto choose = [=](MoneyCardLook look) {
+		auto choice = state->choice.current();
+		choice.gift = std::move(look);
+		state->choice = std::move(choice);
+	};
+
+	state->defaultTile = Ui::CreateChild<DefaultTile>(grid);
+	state->defaultTile->setGeometry(tileRect(0));
+	state->defaultTile->setClickedCallback([=] {
+		choose(MoneyCardLook());
+	});
+	state->defaultTile->show();
+
+	const auto resize = [=] {
+		const auto count = int(state->gifts.size()) + 1;
+		const auto rows = (count + perRow - 1) / perRow;
+		grid->resize(
+			st::boxWideWidth,
+			padding.top()
+				+ rows * single.height()
+				+ (rows - 1) * st::giftBoxGiftSkip.y()
+				+ padding.bottom());
+	};
+	const auto rebuild = [=] {
+		const auto range = state->range.current();
+		const auto count = int(state->gifts.size());
+		state->buttons.resize(count);
+		const auto from = std::max(range.top - padding.top(), 0) / rowHeight;
+		const auto till = (std::max(range.bottom - padding.top(), 0)
+			+ rowHeight
+			- 1) / rowHeight + 1;
+		const auto selected = selectedId();
+		for (auto i = 0; i != count; ++i) {
+			const auto index = i + 1;
+			const auto row = index / perRow;
+			auto &button = state->buttons[i];
+			if (row < from || row >= till) {
+				button = nullptr;
+				continue;
+			} else if (button) {
+				continue;
+			}
+			const auto &gift = state->gifts[i];
+			const auto unique = gift.info.unique;
+			button = std::make_unique<GiftButton>(grid, &*state->delegate);
+			button->setDescriptor(
+				GiftDescriptor{ GiftTypeStars{ .info = gift.info } },
+				GiftButtonMode::Minimal);
+			button->setClickedCallback([=] {
+				choose(MoneyCardLookFrom(*unique));
+			});
+			button->setGeometry(tileRect(index), extend);
+			button->toggleSelected(
+				(unique->id == selected),
+				GiftSelectionMode::Inset,
+				anim::type::instant);
+			button->show();
+		}
+	};
+
+	state->range = grid->visibleRange();
+	state->range.changes(
+	) | rpl::on_next(rebuild, grid->lifetime());
+
+	state->choice.value(
+	) | rpl::map([](const MoneyCardChoice &choice) {
+		return choice.gift.giftId;
+	}) | rpl::distinct_until_changed(
+	) | rpl::on_next([=](uint64 id) {
+		state->defaultTile->setSelected(!id);
+		const auto count = int(state->buttons.size());
+		for (auto i = 0; i != count; ++i) {
+			if (const auto button = state->buttons[i].get()) {
+				const auto unique = state->gifts[i].info.unique;
+				button->toggleSelected(
+					(unique->id == id),
+					GiftSelectionMode::Inset);
+			}
+		}
+	}, grid->lifetime());
+
+	resize();
+	MoneyCardOwnedGifts(
+		session
+	) | rpl::take(
+		1
+	) | rpl::on_next([=](std::vector<Data::SavedStarGift> gifts) {
+		state->buttons.clear();
+		state->gifts = std::move(gifts);
+		if (initialId
+			&& !MoneyCardChoiceFor(session).gift
+			&& selectedId() == initialId) {
+			choose(MoneyCardLook());
+		}
+		resize();
+		rebuild();
+		state->loaded = true;
+	}, grid->lifetime());
+
+	box->addButton(tr::lng_settings_save(), [=] {
+		SetMoneyCardChoice(session, state->choice.current());
+		box->closeBox();
+	});
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+} // namespace Tele
