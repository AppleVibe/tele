+struct SessionState {
+	rpl::variable<MoneyCardChoice> choice;
+	rpl::lifetime validation;
+	bool validated = false;
+};
+
+[[nodiscard]] QString ColorValue(const QColor &color) {
+	return QString::number(color.rgba());
+}
+
+[[nodiscard]] QColor ColorFrom(const QJsonValue &value) {
+	auto ok = false;
+	const auto rgba = value.toString().toUInt(&ok);
+	return ok ? QColor::fromRgba(rgba) : QColor();
+}
+
+[[nodiscard]] QString Serialize(const MoneyCardChoice &choice) {
+	auto object = QJsonObject();
+	if (choice.sync) {
+		object.insert(u"sync"_q, true);
+	}
+	if (const auto &gift = choice.gift) {
+		object.insert(u"id"_q, QString::number(gift.giftId));
+		object.insert(u"slug"_q, gift.slug);
+		object.insert(u"model"_q, QString::number(gift.modelId));
+		object.insert(u"pattern"_q, QString::number(gift.patternId));
+		object.insert(u"center"_q, ColorValue(gift.center));
+		object.insert(u"edge"_q, ColorValue(gift.edge));
+		object.insert(u"patternColor"_q, ColorValue(gift.pattern));
+		object.insert(u"text"_q, ColorValue(gift.text));
+	}
+	return object.isEmpty()
+		? QString()
+		: QString::fromUtf8(
+			QJsonDocument(object).toJson(QJsonDocument::Compact));
+}
+
+[[nodiscard]] MoneyCardChoice Deserialize(const QString &value) {
+	if (value.isEmpty()) {
+		return {};
+	}
+	const auto document = QJsonDocument::fromJson(value.toUtf8());
+	if (!document.isObject()) {
+		return {};
+	}
+	const auto object = document.object();
+	auto result = MoneyCardChoice{
+		.sync = object.value(u"sync"_q).toBool(),
+	};
+	const auto id = object.value(u"id"_q).toString().toULongLong();
+	if (id) {
+		result.gift = MoneyCardLook{
+			.giftId = id,
+			.slug = object.value(u"slug"_q).toString(),
+			.modelId = object.value(u"model"_q).toString().toULongLong(),
+			.patternId = object.value(u"pattern"_q).toString().toULongLong(),
+			.center = ColorFrom(object.value(u"center"_q)),
+			.edge = ColorFrom(object.value(u"edge"_q)),
+			.pattern = ColorFrom(object.value(u"patternColor"_q)),
+			.text = ColorFrom(object.value(u"text"_q)),
+		};
+		if (!result.gift.center.isValid()
+			|| !result.gift.edge.isValid()
+			|| !result.gift.pattern.isValid()
+			|| !result.gift.text.isValid()) {
+			result.gift = MoneyCardLook();
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] SessionState &StateFor(not_null<Main::Session*> session) {
+	static auto states = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<SessionState>>();
+	auto i = states.find(session);
+	if (i == end(states)) {
+		auto state = std::make_unique<SessionState>();
+		state->choice = Deserialize(
+			session->local().readPref<QString>(kChoicePref));
+		i = states.emplace(session, std::move(state)).first;
+		session->lifetime().add([=] {
+			states.remove(session);
+		});
+	}
+	return *i->second;
+}
+
+void CheckOwned(
+		not_null<Main::Session*> session,
+		const std::vector<Data::SavedStarGift> &owned) {
+	auto choice = StateFor(session).choice.current();
+	if (!choice.gift) {
+		return;
+	}
+	const auto id = choice.gift.giftId;
+	const auto has = ranges::any_of(owned, [&](
+			const Data::SavedStarGift &gift) {
+		return gift.info.unique && (gift.info.unique->id == id);
+	});
+	if (!has) {
+		choice.gift = MoneyCardLook();
+		SetMoneyCardChoice(session, choice);
+	}
+}
+
+[[nodiscard]] const std::vector<Ui::PatternPoint> &PatternPoints() {
+	static const auto result = [] {
+		auto list = Ui::PatternBgPoints();
+		list.push_back({ { 0.5, 0.5 }, 0.85, 0.3 });
+		return list;
+	}();
+	return result;
+}
