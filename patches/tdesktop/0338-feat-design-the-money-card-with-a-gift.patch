+constexpr auto kChoicePref = std::string_view("tele_money_card");
+constexpr auto kOwnedPerPage = 50;
+constexpr auto kOwnedMaxPages = 40;
+constexpr auto kModelScale = 0.8;
+constexpr auto kPillRippleAlpha = 40;
