+
+void DefaultTile::setSelected(bool selected) {
+	if (_selected != selected) {
+		_selected = selected;
+		update();
+	}
+}
+
+void DefaultTile::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	auto hq = PainterHighQualityEnabler(p);
+	const auto radius = st::giftBoxGiftRadius;
+	auto path = QPainterPath();
+	path.addRoundedRect(QRectF(rect()), radius, radius);
+	p.setClipPath(path);
+	const auto extra = st::walletCardRadius;
+	_background.paint(
+		p,
+		rect().marginsAdded({ extra, extra, extra, extra }),
+		0.);
+	p.setClipping(false);
+	p.setPen(st::activeButtonFg);
+	p.setFont(st::semiboldFont);
+	p.drawText(rect(), Lower(u"Default"_q), style::al_center);
+	if (_selected) {
+		const auto thickness = style::ConvertScaleExact(2.);
+		auto pen = st::boxBg->p;
+		pen.setWidthF(thickness);
+		p.setPen(pen);
+		p.setBrush(Qt::NoBrush);
+		const auto shift = thickness * 2;
+		p.drawRoundedRect(
+			QRectF(rect()).marginsRemoved({ shift, shift, shift, shift }),
+			radius - shift,
+			radius - shift);
+	}
+}
