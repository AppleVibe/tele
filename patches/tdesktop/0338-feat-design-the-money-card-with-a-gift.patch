+MoneyCardLook MoneyCardLookFrom(const Data::UniqueGift &gift) {
+	return {
+		.giftId = gift.id,
+		.slug = gift.slug,
+		.modelId = gift.model.document->id,
+		.patternId = gift.pattern.document->id,
+		.center = gift.backdrop.centerColor,
+		.edge = gift.backdrop.edgeColor,
+		.pattern = gift.backdrop.patternColor,
+		.text = gift.backdrop.textColor,
+	};
+}
+
+MoneyCardLook MoneyCardLookFrom(const Data::EmojiStatusCollectible &status) {
+	return {
+		.giftId = status.id,
+		.slug = status.slug,
+		.modelId = status.documentId,
+		.patternId = status.patternDocumentId,
+		.center = status.centerColor,
+		.edge = status.edgeColor,
+		.pattern = status.patternColor,
+		.text = status.textColor,
+	};
+}
+
+bool MoneyCardDesigns() {
+	return MoneyCardDesignsOn() && !NoMoney();
+}
+
+rpl::producer<bool> MoneyCardDesignsValue() {
+	return MoneyCardDesignsOnValue() | rpl::map([](bool on) {
+		return on && !NoMoney();
+	});
+}
+
+MoneyCardChoice MoneyCardChoiceFor(not_null<Main::Session*> session) {
+	return StateFor(session).choice.current();
+}
+
+void SetMoneyCardChoice(
+		not_null<Main::Session*> session,
+		MoneyCardChoice choice) {
+	auto &state = StateFor(session);
+	if (state.choice.current() == choice) {
+		return;
+	}
+	const auto value = Serialize(choice);
+	if (value.isEmpty()) {
+		session->local().clearPref(kChoicePref);
+	} else {
+		session->local().writePref<QString>(kChoicePref, value);
+	}
+	state.choice = std::move(choice);
+}
+
+MoneyCardLook MoneyCardStatusLook(not_null<Main::Session*> session) {
+	if (const auto collectible = session->user()->emojiStatusId().collectible) {
+		return MoneyCardLookFrom(*collectible);
+	}
+	return {};
+}
+
+rpl::producer<MoneyCardLook> MoneyCardStatusLookValue(
+		not_null<Main::Session*> session) {
+	return session->changes().peerFlagsValue(
+		session->user(),
+		Data::PeerUpdate::Flag::EmojiStatus
+	) | rpl::map([=](const Data::PeerUpdate &) {
+		return MoneyCardStatusLook(session);
+	}) | rpl::distinct_until_changed();
+}
+
+MoneyCardLook ResolveMoneyCardLook(
+		const MoneyCardChoice &choice,
+		const MoneyCardLook &status) {
+	return choice.sync ? status : choice.gift;
+}
+
+MoneyCardLook CurrentMoneyCard(not_null<Main::Session*> session) {
+	return MoneyCardDesigns()
+		? ResolveMoneyCardLook(
+			StateFor(session).choice.current(),
+			MoneyCardStatusLook(session))
+		: MoneyCardLook();
+}
+
+rpl::producer<MoneyCardLook> MoneyCardValue(
+		not_null<Main::Session*> session) {
+	return rpl::combine(
+		MoneyCardDesignsValue(),
+		StateFor(session).choice.value(),
+		MoneyCardStatusLookValue(session)
+	) | rpl::map([](
+			bool on,
+			const MoneyCardChoice &choice,
+			const MoneyCardLook &status) {
+		return on ? ResolveMoneyCardLook(choice, status) : MoneyCardLook();
+	}) | rpl::distinct_until_changed();
+}
+
+rpl::producer<std::vector<Data::SavedStarGift>> MoneyCardOwnedGifts(
+		not_null<Main::Session*> session) {
+	return [=](auto consumer) {
+		auto lifetime = rpl::lifetime();
+		struct Loader {
+			std::vector<Data::SavedStarGift> list;
+			mtpRequestId requestId = 0;
+			int pages = 0;
+			Fn<void(QString)> load;
+		};
+		const auto loader = lifetime.make_state<Loader>();
+		loader->load = [=](QString offset) {
+			using Flag = MTPpayments_GetSavedStarGifts::Flag;
+			const auto user = session->user();
+			loader->requestId = session->api().request(
+				MTPpayments_GetSavedStarGifts(
+					MTP_flags(Flag::f_exclude_upgradable
+						| Flag::f_exclude_unupgradable
+						| Flag::f_exclude_unlimited),
+					user->input(),
+					MTP_int(0),
+					MTP_string(offset),
+					MTP_int(kOwnedPerPage))
+			).done([=](const MTPpayments_SavedStarGifts &result) {
+				loader->requestId = 0;
+				const auto &data = result.data();
+				session->data().processUsers(data.vusers());
+				session->data().processChats(data.vchats());
+				for (const auto &gift : data.vgifts().v) {
+					if (auto parsed = Api::FromTL(user, gift)) {
+						if (parsed->info.unique) {
+							loader->list.push_back(std::move(*parsed));
+						}
+					}
+				}
+				const auto next = data.vnext_offset()
+					? qs(*data.vnext_offset())
+					: QString();
+				if (!next.isEmpty() && ++loader->pages < kOwnedMaxPages) {
+					loader->load(next);
+					return;
+				} else if (next.isEmpty()) {
+					CheckOwned(session, loader->list);
+				}
+				consumer.put_next_copy(loader->list);
+			}).fail([=] {
+				loader->requestId = 0;
+				consumer.put_next_copy(loader->list);
+			}).send();
+		};
+		loader->load(QString());
+		lifetime.add([=] {
+			session->api().request(base::take(loader->requestId)).cancel();
+		});
+		return lifetime;
+	};
+}
+
+void ValidateMoneyCardChoice(not_null<Main::Session*> session) {
+	auto &state = StateFor(session);
+	const auto &choice = state.choice.current();
+	if (state.validated
+		|| !MoneyCardDesigns()
+		|| choice.sync
+		|| !choice.gift) {
+		return;
+	}
+	state.validated = true;
+	state.validation = MoneyCardOwnedGifts(
+		session
+	) | rpl::on_next([](const std::vector<Data::SavedStarGift> &) {
+	});
+}
