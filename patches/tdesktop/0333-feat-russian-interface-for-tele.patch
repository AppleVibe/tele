+
+bool Russian() {
+	return Lang::Id().startsWith(u"ru"_q, Qt::CaseInsensitive);
+}
+
+bool Translate(const QString &text, QString *result) {
+	if (!Russian()) {
+		return false;
+	}
+	static const auto index = [] {
+		auto result = QHash<QString, QString>();
+		result.reserve(int(std::size(kEntries)));
+		for (const auto &entry : kEntries) {
+			result.insert(entry.english.toString(), entry.russian);
+		}
+		return result;
+	}();
+	const auto i = index.constFind(text);
+	if (i == index.cend()) {
+		return false;
+	}
+	*result = i.value();
+	return true;
+}
+
