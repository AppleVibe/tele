+private:
+	style::FlatLabel _st;
+	object_ptr<Ui::FlatLabel> _label = { nullptr };
+	object_ptr<Ui::LinkButton> _more = { nullptr };
+	bool _expanded = false;
+
+};
+
+Clamped::Clamped(
+	not_null<QWidget*> parent,
+	const TextWithEntities &text,
+	Ui::Text::MarkedContext context,
+	Fn<void()> toggled)
+: _st(st::defaultFlatLabel) {
+	_label.create(parent, _st, st::popupMenuWithIcons);
+	_label->setMarkedText(text, std::move(context));
+	_more.create(parent, Lower(u"Show more"_q), st::defaultLinkButton);
+	_more->hide();
+	_more->setClickedCallback([=] {
+		_expanded = !_expanded;
+		toggled();
+	});
+}
+
+not_null<Ui::FlatLabel*> Clamped::label() const {
+	return _label.data();
+}
+
+int Clamped::resizeGetHeight(int newWidth) {
+	const auto line = std::max(_st.style.lineHeight, _st.style.font->height);
+	const auto limit = kTextLines * line;
+	_st.maxHeight = 0;
+	_label->resizeToWidth(newWidth);
+	const auto overflow = (_label->height() > limit);
+	if (overflow && !_expanded) {
+		_st.maxHeight = limit;
+		_label->resizeToWidth(newWidth);
+	}
+	_label->update();
+	_more->setVisible(overflow);
+	if (!overflow) {
+		return _label->height();
+	}
+	_more->setText(Lower(_expanded ? u"Show less"_q : u"Show more"_q));
+	return _label->height() + _more->height();
+}
+
+void Clamped::moveToLeft(int left, int top, int outerWidth) {
+	_label->moveToLeft(left, top, outerWidth);
+	_more->moveToLeft(left, top + _label->height(), outerWidth);
+}
+
