+void FillNew(
+		SectionBuilder &builder,
+		const NewPages &pages,
+		int version,
+		const QString &query) {
+	const auto words = QueryWords(query);
+	const auto &fresh = ::Tele::NewSettings();
+	const auto freshIds = base::flat_set<QString>(begin(fresh), end(fresh));
+	auto covered = base::flat_set<QString>();
+	auto first = true;
+	builder.addSkip();
+	for (const auto &release : ::Tele::ChangelogHistory()) {
+		if (words.isEmpty() && release.version != version) {
+			continue;
+		}
+		AddNewRelease(
+			builder,
+			pages,
+			release,
+			words,
+			freshIds,
+			covered,
+			first);
+	}
+	if (words.isEmpty() && version == DefaultNewVersion()) {
+		auto rest = base::flat_set<QString>();
+		for (const auto &id : fresh) {
+			if (!covered.contains(id)) {
+				rest.emplace(id);
+			}
+		}
+		AddFreshSettings(builder, pages, rest, first);
+	}
+	if (first) {
+		builder.add([&](const WidgetContext &ctx) {
+			return SectionBuilder::WidgetToAdd{
+				.widget = object_ptr<Ui::FlatLabel>(
+					ctx.container,
+					(words.isEmpty()
+						? rpl::producer<QString>(rpl::single(::Tele::Lower(
+							u"No release notes yet."_q)))
+						: tr::lng_search_tab_no_results()),
+					st::settingsSearchNoResults),
+				.margin = st::settingsSearchNoResultsPadding,
+			};
+		}, nullptr);
+	}
 	builder.addSkip();
 }
 
