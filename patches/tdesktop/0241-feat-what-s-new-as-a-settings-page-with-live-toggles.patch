+[[nodiscard]] NewPages CollectNewPages(not_null<::Main::Session*> session) {
+	auto result = NewPages();
+	const auto add = [&](
+			const QString &title,
+			Type section,
+			const BuildHelper &helper,
+			void (*fill)(SectionBuilder&)) {
+		const auto index = int(result.list.size());
+		auto page = NewPage{
+			.title = title,
+			.section = section,
+			.fill = fill,
+		};
+		for (const auto &entry : helper.index(session)) {
+			if (!entry.id.isEmpty()) {
+				page.ids.push_back(entry.id);
+				result.where[entry.id].emplace(index);
+			}
+		}
+		result.list.push_back(std::move(page));
+	};
+	for (const auto &category : Categories()) {
+		add(category.title, category.id, *category.helper, category.fill);
+	}
+	add(u"tele"_q, TeleSection::Id(), kMeta, FillRoot);
+	return result;
+}
