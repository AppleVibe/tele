+
+void NewSection::sectionRestoreState(const std::any &state) {
+	const auto saved = std::any_cast<NewSectionState>(&state);
+	if (!saved) {
+		return;
+	}
+	if (saved->version && HasRelease(saved->version)) {
+		_version = saved->version;
+		_versionPicked = true;
+		if (_tabs) {
+			_tabs->setActiveTab(QString::number(_version));
+		}
+	}
+	_query = saved->query;
+	if (_searchField) {
+		_searchField->setText(_query);
+	}
+	if (_tabsWrap) {
+		_tabsWrap->toggle(_query.isEmpty(), anim::type::instant);
+	}
+	rebuild();
+}
