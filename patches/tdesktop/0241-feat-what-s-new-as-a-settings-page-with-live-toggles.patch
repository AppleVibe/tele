+[[nodiscard]] not_null<Ui::RpWidget*> CreateNewPill(
+		not_null<Ui::RpWidget*> parent) {
+	const auto &st = st::settingsPremiumNewBadge;
+	const auto &base = st::settingsPremiumNewBadgePadding;
+	const auto font = st.style.font;
+	const auto vertical = base.top() + base.bottom();
+	const auto shift = font->height
+		- 2 * font->ascent
+		+ LowercaseHeight(font);
+	const auto top = std::clamp((vertical + shift) / 2, 0, vertical);
+	const auto padding = style::margins(
+		base.left(),
+		top,
+		base.right(),
+		vertical - top);
+	const auto badge = Ui::CreateChild<Ui::PaddingWrap<Ui::FlatLabel>>(
+		parent.get(),
+		object_ptr<Ui::FlatLabel>(
+			parent,
+			::Tele::Lower(u"NEW"_q),
+			st),
+		padding);
+	badge->show();
+	badge->setAttribute(Qt::WA_TransparentForMouseEvents);
+	badge->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(badge);
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgActive);
+		const auto radius = base.left();
+		p.drawRoundedRect(badge->rect(), radius, radius);
+	}, badge->lifetime());
+	return badge;
+}
