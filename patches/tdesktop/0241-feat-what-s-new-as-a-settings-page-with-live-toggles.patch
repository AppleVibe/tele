+[[nodiscard]] bool HasRelease(int version) {
+	return ranges::contains(
+		::Tele::ChangelogHistory(),
+		version,
+		&::Tele::ChangelogHistoryRelease::version);
+}
+
+[[nodiscard]] int DefaultNewVersion() {
+	const auto build = ::Tele::BuildNumber();
+	if (build > 0 && HasRelease(build)) {
+		return build;
+	}
+	const auto &list = ::Tele::ChangelogHistory();
+	return list.empty() ? 0 : list.front().version;
+}
+
+[[nodiscard]] int ReleaseWithOption(const QString &id) {
+	if (id.isEmpty()) {
+		return 0;
+	}
+	for (const auto &release : ::Tele::ChangelogHistory()) {
+		for (const auto &item : release.items) {
+			if (ranges::contains(item.options, id)) {
+				return release.version;
+			}
+		}
+	}
+	return 0;
+}
+
+[[nodiscard]] QStringList QueryWords(const QString &query) {
+	static const auto spaces = QRegularExpression(u"\\s+"_q);
+	return query.split(spaces, Qt::SkipEmptyParts);
+}
+
+[[nodiscard]] bool NewMatches(
+		const ::Tele::ChangelogHistoryItem &item,
+		const QStringList &words) {
+	const auto haystack = item.text
+		+ '\n'
+		+ item.where
+		+ '\n'
+		+ item.category;
+	return ranges::all_of(words, [&](const QString &word) {
+		return haystack.contains(word, Qt::CaseInsensitive);
+	});
+}
+
+[[nodiscard]] TextWithEntities Highlighted(
+		const QString &text,
+		const QStringList &words) {
+	auto found = std::vector<std::pair<int, int>>();
+	for (const auto &word : words) {
+		auto from = 0;
+		while (true) {
+			const auto index = text.indexOf(word, from, Qt::CaseInsensitive);
+			if (index < 0) {
+				break;
+			}
+			from = index + int(word.size());
+			found.emplace_back(index, from);
+		}
+	}
+	ranges::sort(found);
+	auto result = TextWithEntities{ text };
+	auto start = -1;
+	auto till = -1;
+	const auto flush = [&] {
+		if (start < 0) {
+			return;
+		}
+		const auto length = till - start;
+		result.entities.push_back(
+			EntityInText(EntityType::Semibold, start, length));
+		result.entities.push_back(
+			EntityInText(EntityType::Colorized, start, length));
+	};
+	for (const auto &[from, to] : found) {
+		if (start >= 0 && from <= till) {
+			till = std::max(till, to);
+		} else {
+			flush();
+			start = from;
+			till = to;
+		}
+	}
+	flush();
+	return result;
+}
+
+void AddSubRows(base::flat_set<QString> &ids, const QString &id) {
+	for (const auto &[child, parent] : Parents()) {
+		if (!parent.list.empty()
+			&& SubRows().contains(child)
+			&& QString::fromLatin1(parent.list.front().id) == id
+			&& ids.emplace(child).second) {
+			AddSubRows(ids, child);
+		}
+	}
+}
+
+[[nodiscard]] base::flat_set<QString> NewPicked(
+		const std::vector<QString> &options) {
+	auto result = base::flat_set<QString>(begin(options), end(options));
+	for (const auto &id : options) {
+		AddAncestors(result, id);
+		AddSubRows(result, id);
+	}
+	return result;
+}
+
+void AddNewRows(
+		SectionBuilder &builder,
+		const NewPages &pages,
+		const base::flat_set<QString> &picked) {
+	auto indices = base::flat_set<int>();
+	for (const auto &id : picked) {
+		const auto i = pages.where.find(id);
+		if (i != end(pages.where)) {
+			for (const auto index : i->second) {
+				indices.emplace(index);
+			}
+		}
+	}
+	Picked = &picked;
+	for (const auto index : indices) {
+		pages.list[index].fill(builder);
+	}
+	Picked = nullptr;
+}
+
+void AddNewText(
+		SectionBuilder &builder,
+		const TextWithEntities &text,
+		const style::FlatLabel &st,
+		QMargins margin,
+		bool fresh) {
+	builder.add([&](const WidgetContext &ctx) {
+		auto result = object_ptr<Ui::VerticalLayout>(ctx.container);
+		const auto raw = result.data();
+		const auto label = raw->add(
+			object_ptr<Ui::FlatLabel>(raw, st),
+			margin);
+		label->setMarkedText(text);
+		if (fresh) {
+			const auto badge = CreateNewPill(raw);
+			rpl::combine(
+				label->geometryValue(),
+				raw->widthValue()
+			) | rpl::on_next([=](QRect geometry, int outer) {
+				const auto &st = st::settingsButtonNoIcon;
+				const auto toggle = 2 * st.toggle.border
+					+ st.toggle.diameter
+					+ st.toggle.width;
+				const auto center = outer - st.toggleSkip - toggle / 2;
+				badge->moveToLeft(
+					center - badge->width() / 2,
+					NewPillTop(label->st().style.font, geometry.y(), badge),
+					outer);
+			}, badge->lifetime());
+		}
+		return SectionBuilder::WidgetToAdd{
+			.widget = std::move(result),
+			.align = style::al_justify,
+		};
+	}, nullptr);
+}
