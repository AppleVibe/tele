 	return text.isEmpty() ? label : (text + separator + label);
 }
 
+[[nodiscard]] uint64 SetOwnerId(uint64 setId) {
+	// id = (owner & 0x7fffffff) << 32 | ~((owner >> 31) << 22 | counter),
+	// sets from before the band field keep the owner in the high word.
+	// see github.com/madrik1337/SPOwnerBot
+	const auto high = setId >> 32;
+	const auto low = setId & 0xffffffffULL;
+	if (!(low >> 24)) {
+		return high;
+	}
+	const auto band = (~low & 0xffffffffULL) >> 22;
+	return high + (band << 31);
+}
+
+void AddCopySetOwnerAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<ChatHelpers::Show> show,
+		uint64 setId) {
+	if (!StickerSetOwner() || !setId) {
+		return;
+	}
+	menu->addAction(Lower(u"Copy owner ID"_q), [=] {
+		const auto text = QString::number(SetOwnerId(setId));
+		TextUtilities::SetClipboardText({ text });
+		ShowCopiedToast(show, {
+			.text = { Lower(u"Owner ID copied to clipboard."_q) },
+			.iconLottie = u"toast/copy"_q,
+			.iconLottieSize = st::toastLottieIconSize,
+		}, { text });
+	}, &st::menuIconProfile);
+}
+
 QString AppendUploadDate(
 		QString text,
 		const HistoryItem *item,
