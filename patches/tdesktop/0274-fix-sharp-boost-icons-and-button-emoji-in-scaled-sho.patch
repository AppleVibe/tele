 			_options.hidden & uint16(ShotPart::Buttons));
+		const auto keyboards = KeyboardsScope(_items, _keyboards);
 		for (const auto &view : _views) {
 			if (view->data() == item) {
 				view->itemDataChanged();
@@ -769,6 +813,7 @@ void ShotRenderer::subscribe() {
 			not_null<const HistoryItem*>) {
 		clear();
 		_items.clear();
+		_keyboards.clear();
