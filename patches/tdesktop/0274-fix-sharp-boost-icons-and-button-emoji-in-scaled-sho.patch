 2 files changed, 51 insertions(+)

diff --git a/Telegram/SourceFiles/tele/tele_shot.cpp b/Telegram/SourceFiles/tele/tele_shot.cpp
index be06c58074f6693b63367eb8572ccba9d1f0abdc..de7f20d21013a8a6ff03ae4db2ccea93fcbc434e 100644
--- a/Telegram/SourceFiles/tele/tele_shot.cpp
+++ b/Telegram/SourceFiles/tele/tele_shot.cpp
@@ -179,6 +179,48 @@ private:
 
 };
 
+using Keyboards = base::flat_map<
+	not_null<HistoryItem*>,
+	std::unique_ptr<ReplyKeyboard>>;
+
+// keyboards belong to the item and are built once, outside the shot's
+// emoji scope, so a shot lays out and paints its own ones
+class KeyboardsScope final {
+public:
+	KeyboardsScope(
+		const std::vector<not_null<HistoryItem*>> &items,
+		Keyboards &keyboards)
+	: _items(items)
+	, _keyboards(keyboards) {
+		if (!Depth()++) {
+			swap();
+		}
+	}
+	~KeyboardsScope() {
+		if (!--Depth()) {
+			swap();
+		}
+	}
+
+private:
+	[[nodiscard]] static int &Depth() {
+		static auto result = 0;
+		return result;
+	}
+
+	void swap() {
+		for (const auto &item : _items) {
+			if (const auto markup = item->Get<HistoryMessageReplyMarkup>()) {
+				std::swap(markup->inlineKeyboard, _keyboards[item]);
+			}
+		}
+	}
+
+	const std::vector<not_null<HistoryItem*>> &_items;
+	Keyboards &_keyboards;
+
+};
+
 [[nodiscard]] auto Registered()
 -> base::flat_map<const HistoryView::ElementDelegate*, ShotFlags> & {
 	static auto result = base::flat_map<
@@ -477,6 +519,7 @@ private:
 
