 	loadPhotos();
 	for (const auto &item : _items) {
 		auto view = item->createView(_delegate.get());
@@ -861,6 +908,7 @@ void ShotRenderer::relayout() {
 	const auto scope = ShotEmojiScope();
 	const auto buttons = ButtonsScope(
 		_options.hidden & uint16(ShotPart::Buttons));
+	const auto keyboards = KeyboardsScope(_items, _keyboards);
 	_layingOut = true;
 	for (const auto &view : base::take(_dirty)) {
 		view->initDimensions();
@@ -1019,6 +1067,7 @@ void ShotRenderer::paintContent(Painter &p, QRect clip, int ratio) {
 	const auto scope = ShotEmojiScope();
 	const auto buttons = ButtonsScope(
 		_options.hidden & uint16(ShotPart::Buttons));
+	const auto keyboards = KeyboardsScope(_items, _keyboards);
 	validateCorners(ratio);
 	ValidateShotTextQuotes(style());
 	const auto st = style();
