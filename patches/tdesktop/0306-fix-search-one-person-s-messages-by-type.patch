diff --git a/Telegram/SourceFiles/api/api_messages_search.cpp b/Telegram/SourceFiles/api/api_messages_search.cpp
index 1e9b6247f468fcff878ea26013140deb68c54204..ad8194266df6a192d54982cce99f171259f9759a 100644
--- a/Telegram/SourceFiles/api/api_messages_search.cpp
+++ b/Telegram/SourceFiles/api/api_messages_search.cpp
@@ -92,19 +92,56 @@ MessagesSearch::~MessagesSearch() {
 void MessagesSearch::searchMessages(Request request) {
 	_request = std::move(request);
 	_offsetId = {};
+	_combo = nullptr;
+	_comboFound.clear();
+	_comboCount = 0;
+	const auto from = _history->peer->isUser() ? nullptr : _request.from;
+	if (Tele::SearchTypeCombines(from, _request.filter)) {
+		_combo = std::make_unique<Tele::SearchTypeCombo>(
+			not_null<PeerData*>(from),
+			_request.filter);
+	}
 	searchRequest();
+	if (_combo) {
+		const auto nextToken = RequestToToken(_request);
+		_combo->probe({
+			.peer = _history->peer,
+			.query = _request.query,
+			.tags = _request.tags,
+			.topMsgId = _request.topMsgId,
+		}, [=](const MTPmessages_Messages *result) {
+			if (result) {
+				searchReceived(*result, _requestId, nextToken);
+			} else {
+				_requestId = 0;
+				_messagesFounds.fire({ 0, MessageIdsList(), nextToken });
+			}
+		});
+	}
 }
 
 void MessagesSearch::searchMore() {
 	if (_searchInHistoryRequest || _requestId) {
 		return;
+	} else if (_combo && !_combo->pages().take()) {
+		return;
 	}
 	searchRequest();
 }
 
+void MessagesSearch::resume() {
+	if (_combo && _combo->pages().resume()) {
+		searchMore();
+	}
+}
+
+bool MessagesSearch::filtersLocally() const {
+	return (_combo != nullptr);
+}
+
 void MessagesSearch::searchRequest() {
 	const auto nextToken = RequestToToken(_request);
-	if (!_offsetId) {
+	if (!_offsetId && !_combo) {
 		const auto it = _cacheOfStartByToken.find(nextToken);
 		if (it != end(_cacheOfStartByToken)) {
 			_requestId = 0;
@@ -115,7 +152,10 @@ void MessagesSearch::searchRequest() {
 	auto callback = [=](Fn<void()> finish) {
 		using Flag = MTPmessages_Search::Flag;
 		const auto from = _request.from;
-		const auto fromPeer = _history->peer->isUser() ? nullptr : from;
+		const auto fromPeer = (_history->peer->isUser()
+			|| (_combo && !_combo->sendsFrom()))
+			? nullptr
+			: from;
 		const auto savedPeer = _history->peer->isSelf() ? from : nullptr;
 		_requestId = _history->session().api().request(MTPmessages_Search(
 			MTP_flags((fromPeer ? Flag::f_from_id : Flag())
@@ -130,12 +170,12 @@ void MessagesSearch::searchRequest() {
 				Data::ReactionToMTP
 			)),
 			MTP_int(_request.topMsgId), // top_msg_id
-			PrepareFilter(_request.filter),
+			(_combo ? _combo->filter() : PrepareFilter(_request.filter)),
 			MTP_int(0), // min_date
 			MTP_int(0), // max_date
 			MTP_int(_offsetId), // offset_id
 			MTP_int(0), // add_offset
-			MTP_int(kSearchPerPage),
+			MTP_int(_combo ? _combo->limit() : kSearchPerPage),
 			MTP_int(0), // max_id
 			MTP_int(0), // min_id
 			MTP_long(0) // hash
@@ -146,10 +186,26 @@ void MessagesSearch::searchRequest() {
 		}).fail([=](const MTP::Error &error, mtpRequestId id) {
 			_searchInHistoryRequest = 0;
 
-			if (_requestId == id) {
+			const auto current = (_requestId == id);
+			if (current && _combo && _combo->holdFailed()) {
+				finish();
+				return;
+			} else if (current) {
 				_requestId = 0;
 			}
-			if (error.type() == u"SEARCH_QUERY_EMPTY"_q) {
+			const auto terminal = (error.type() == u"SEARCH_QUERY_EMPTY"_q)
+				|| (error.type() == u"INPUT_FILTER_INVALID"_q);
+			if (current && _combo) {
+				if (terminal) {
+					(void)_combo->pages().received(0, true);
+				}
+				_messagesFounds.fire({
+					_comboCount + (terminal ? 0 : 1),
+					base::take(_comboFound),
+					nextToken,
+					!terminal,
+				});
+			} else if (terminal) {
 				_messagesFounds.fire({ 0, MessageIdsList(), nextToken });
 			}
 
@@ -169,9 +225,13 @@ void MessagesSearch::searchReceived(
 		const QString &nextToken) {
 	if (requestId != _requestId) {
 		return;
+	} else if (_combo && _combo->hold(result)) {
+		return;
 	}
 	auto &owner = _history->owner();
+	auto complete = false;
 	auto found = result.match([&](const MTPDmessages_messages &data) {
+		complete = true;
 		if (_requestId != 0) {
 			// Don't apply cached data!
 			owner.processUsers(data.vusers());
@@ -209,7 +269,8 @@ void MessagesSearch::searchReceived(
 		auto items = HistoryItemsFromTL(&owner, data.vmessages().v);
 		const auto total = int(data.vcount().v);
 		return FoundMessages{ total, std::move(items), nextToken };
-	}, [](const MTPDmessages_messagesNotModified &data) {
+	}, [&](const MTPDmessages_messagesNotModified &data) {
+		complete = true;
 		return FoundMessages{};
 	});
 	if (!_offsetId) {
@@ -219,6 +280,26 @@ void MessagesSearch::searchReceived(
 	_offsetId = found.messages.empty()
 		? MsgId()
 		: found.messages.back().msg;
+	if (_combo) {
+		const auto full = complete || found.messages.empty();
+		auto matches = 0;
+		for (const auto &id : found.messages) {
+			const auto item = owner.message(id);
+			if (item && _combo->matches(item)) {
+				_comboFound.push_back(id);
+				++matches;
+			}
+		}
+		_comboCount += matches;
+		if (_combo->pages().received(matches, full)
+			&& _combo->pages().take()) {
+			searchRequest();
+			return;
+		}
+		found.messages = base::take(_comboFound);
+		found.total = _comboCount + (full ? 0 : 1);
+		found.partial = !full;
+	}
 	_messagesFounds.fire(std::move(found));
 }
 
