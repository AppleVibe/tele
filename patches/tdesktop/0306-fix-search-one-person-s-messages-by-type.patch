+	}
+	_fromDone = true;
+	_byFrom = result;
+	resolve();
+	return true;
+}
+
+bool SearchTypeCombo::holdFailed() {
+	if (!_probing || _fromDone) {
+		return false;
+	}
+	_fromDone = true;
+	resolve();
+	return true;
+}
+
+void SearchTypeCombo::cancel() {
+	_api.request(base::take(_typeRequest)).cancel();
+	if (_probing) {
+		_probing = false;
+		_done = nullptr;
+		_byFrom = _byType = std::nullopt;
+		_typeOnServer = false;
