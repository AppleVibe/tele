+bool MatchesSearchType(
+		not_null<HistoryItem*> item,
+		Api::SearchFilter filter) {
+	using Type = Storage::SharedMediaType;
+	const auto type = [&]() -> std::optional<Type> {
+		switch (filter) {
+		case Filter::Photo: return Type::Photo;
+		case Filter::Video: return Type::Video;
+		case Filter::File: return Type::File;
+		case Filter::Music: return Type::MusicFile;
+		case Filter::Voice: return Type::VoiceFile;
+		case Filter::RoundVideo: return Type::RoundFile;
+		case Filter::Gif: return Type::GIF;
+		case Filter::Url: return Type::Link;
+		case Filter::Pinned: return Type::Pinned;
+		case Filter::NoFilter: break;
+		}
+		return std::nullopt;
+	}();
+	return !type || item->sharedMediaTypes().test(*type);
+}
