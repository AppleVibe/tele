 const char kOptionRevealSpoilers[] = "tele-reveal-spoilers";
 const char kOptionCodeLineNumbers[] = "tele-code-line-numbers";
 const char kOptionCopyProtected[] = "tele-copy-protected";
@@ -632,6 +633,11 @@ base::options::option<QString> DeletedReplyOption({
 		"quoted instead.",
 });
 
+base::options::option<QString> DeletedQuoteNameOption({
+	.id = kOptionDeletedQuoteName,
+	.name = "Name in quotes",
+});
+
 base::options::toggle RevealSpoilersOption({
 	.id = kOptionRevealSpoilers,
 	.name = "Reveal spoilers automatically",
@@ -1742,6 +1748,24 @@ rpl::producer<QString> DeletedReplyValue() {
 	});
 }
 
+QString DeletedQuoteName() {
+	return DeletedQuoteNameOption.value();
+}
+
+void SetDeletedQuoteName(const QString &value) {
+	DeletedQuoteNameOption.set(value);
+}
+
+rpl::producer<QString> DeletedQuoteNameValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		DeletedQuoteNameOption.changes()
+	) | rpl::map([] {
+		return DeletedQuoteNameOption.value();
+	});
+}
+
 bool RevealSpoilers() {
 	return RevealSpoilersOption.value();
 }
