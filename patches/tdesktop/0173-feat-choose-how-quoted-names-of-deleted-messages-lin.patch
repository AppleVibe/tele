--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -2652,6 +2652,19 @@ void FillMessages(SectionBuilder &builder) {
 				},
 				{ u"reply"_q, u"quote"_q, u"deleted"_q },
 				::Tele::kOptionKeepDeleted);
+			AddButtonChoice(
+				builder,
+				::Tele::kOptionDeletedQuoteName,
