+				},
+				{ u"username"_q, u"author"_q, u"deleted"_q },
+				{ ::Tele::kOptionKeepDeleted, ::Tele::kOptionDeletedReply });
 		});
 	AddOptionToggle(builder, ::Tele::kOptionCopyProtected);
 	AddGroupDivider(builder);
diff --git a/Telegram/SourceFiles/tele/tele_deleted_reply.cpp b/Telegram/SourceFiles/tele/tele_deleted_reply.cpp
index 8ca7ddbd4075dea631d0f0a6e22a103cb5c254b8..ed9aaae468f591a8c4aa51c0185b01eb485ccc36 100644
--- a/Telegram/SourceFiles/tele/tele_deleted_reply.cpp
+++ b/Telegram/SourceFiles/tele/tele_deleted_reply.cpp
@@ -5,6 +5,7 @@
 #include "data/data_peer.h"
 #include "data/data_premium_limits.h"
 #include "data/data_session.h"
+#include "data/data_user.h"
 #include "data/stickers/data_custom_emoji.h"
 #include "history/history.h"
 #include "history/history_item.h"
@@ -45,6 +46,37 @@ void MarkQuoted(QuotedKey key) {
 	return (DeletedReply() == u"quote"_q);
 }
 
+[[nodiscard]] std::optional<EntityInText> NameLink(
+		not_null<Main::Session*> session,
+		not_null<PeerData*> author,
+		int length) {
+	const auto mode = DeletedQuoteName();
+	if (!length || mode.isEmpty()) {
+		return std::nullopt;
+	}
+	const auto user = author->asUser();
+	if (user && mode == u"mention"_q) {
+		return EntityInText(
+			EntityType::MentionName,
+			0,
+			length,
+			TextUtilities::MentionNameDataFromFields({
+				.selfId = session->userId().bare,
+				.userId = peerToUser(user->id).bare,
+				.accessHash = user->accessHash(),
+			}));
+	}
+	const auto username = author->username();
+	if (username.isEmpty()) {
+		return std::nullopt;
+	}
+	return EntityInText(
+		EntityType::CustomUrl,
+		0,
+		length,
+		u"https://t.me/"_q + username);
+}
+
 [[nodiscard]] HistoryItem *DeletedTarget(
 		not_null<History*> history,
 		const FullReplyTo &replyTo) {
@@ -134,7 +166,8 @@ void Truncate(TextWithEntities &text, int limit) {
 		not_null<HistoryItem*> item,
 		const TextWithEntities &quote,
 		const TextWithTags &own,
-		Kind kind) {
+		Kind kind,
+		const std::optional<EntityInText> &link) {
 	const auto session = &history->session();
 	const auto limits = Data::PremiumLimits(session);
 	const auto limit = (kind == Kind::Message)
@@ -165,6 +198,9 @@ void Truncate(TextWithEntities &text, int limit) {
 		prefix.text = name;
 		prefix.entities.push_back(
 			EntityInText(EntityType::Bold, 0, int(name.size())));
+		if (link) {
+			prefix.entities.push_back(*link);
+		}
 	}
 	if (!quoted.empty()) {
 		if (!prefix.text.isEmpty()) {
@@ -204,25 +240,33 @@ void Truncate(TextWithEntities &text, int limit) {
 	return result;
 }
 
-void Apply(Api::SendAction &action, TextWithTags *text, Kind kind) {
+bool Apply(Api::SendAction &action, TextWithTags *text, Kind kind) {
 	const auto history = action.history;
 	const auto item = DeletedTarget(history, action.replyTo);
 	if (!item) {
-		return;
+		return false;
 	}
 	const auto quote = action.replyTo.quote;
 	Strip(history, action.replyTo, item);
 	if (!text || kind == Kind::None || !QuoteMode()) {
-		return;
+		return false;
 	}
 	const auto key = QuotedKey(item->fullId(), history->peer->id);
 	if (Quoted().contains(key)) {
-		return;
+		return false;
 	}
-	if (auto result = Compose(history, item, quote, *text, kind)) {
-		*text = std::move(*result);
-		MarkQuoted(key);
+	const auto author = item->author();
+	const auto link = NameLink(
+		&history->session(),
+		author,
+		int(author->name().size()));
+	auto result = Compose(history, item, quote, *text, kind, link);
+	if (!result) {
+		return false;
 	}
+	*text = std::move(*result);
+	MarkQuoted(key);
+	return link && (link->type() == EntityType::CustomUrl);
 }
 
 } // namespace
@@ -246,7 +290,13 @@ void StripDeletedReply(
 }
 
 void QuoteDeletedReply(Api::MessageToSend &message) {
-	Apply(message.action, &message.textWithTags, Kind::Message);
+	const auto linked = Apply(
+		message.action,
+		&message.textWithTags,
+		Kind::Message);
+	if (linked && message.webPage.url.isEmpty()) {
+		message.webPage.removed = true;
+	}
 }
 
 void QuoteDeletedCaption(Api::MessageToSend &message) {
