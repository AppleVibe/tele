+#include "tele/tele_search_types.h"
+
+#include "base/flat_map.h"
+#include "dialogs/dialogs_key.h"
+#include "dialogs/ui/chat_search_in.h"
+#include "tele/tele_lowercase.h"
+#include "tele/tele_options.h"
+#include "ui/effects/ripple_animation.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/popup_menu.h"
+#include "ui/painter.h"
+#include "styles/style_dialogs.h"
+#include "styles/style_info.h"
+#include "styles/style_media_player.h"
+#include "styles/style_menu_icons.h"
+#include "styles/style_widgets.h"
+
+namespace Tele {
+namespace {
+
+using Filter = Api::SearchFilter;
+
+struct Type {
+	Filter filter = Filter::NoFilter;
+	const char *name = nullptr;
+};
+
+constexpr auto kTypes = std::array{
+	Type{ Filter::NoFilter, "All messages" },
+	Type{ Filter::Photo, "Photos" },
+	Type{ Filter::Video, "Videos" },
+	Type{ Filter::File, "Files" },
+	Type{ Filter::Music, "Music" },
+	Type{ Filter::Voice, "Voice messages" },
+	Type{ Filter::RoundVideo, "Round videos" },
+	Type{ Filter::Gif, "GIFs" },
+	Type{ Filter::Url, "Links" },
+};
+
+[[nodiscard]] const style::icon &Icon(Filter filter) {
+	switch (filter) {
+	case Filter::Photo: return st::infoIconMediaPhoto;
+	case Filter::Video:
+	case Filter::RoundVideo: return st::infoIconMediaVideo;
+	case Filter::File: return st::infoIconMediaFile;
+	case Filter::Music: return st::infoIconMediaAudio;
+	case Filter::Voice: return st::infoIconMediaVoice;
+	case Filter::Gif: return st::infoIconMediaGif;
+	case Filter::Url: return st::infoIconMediaLink;
+	case Filter::NoFilter:
+	case Filter::Pinned: break;
+	}
+	return st::menuIconTagFilter;
+}
+
+void FillMenu(
+		not_null<Ui::PopupMenu*> menu,
+		Filter current,
+		Fn<void(Filter)> choose) {
+	for (const auto &type : kTypes) {
+		const auto filter = type.filter;
+		menu->addAction(
+			Lower(QString::fromLatin1(type.name)),
+			[=] { choose(filter); },
+			(current == filter) ? &st::mediaPlayerMenuCheck : nullptr);
+	}
+}
+
+class DialogsTypeButton final : public Ui::AbstractButton {
+public:
+	explicit DialogsTypeButton(QWidget *parent);
+
+	void setFilter(Filter filter);
+
+protected:
+	void paintEvent(QPaintEvent *e) override;
+	void onStateChanged(State was, StateChangeSource source) override;
+
+private:
+	Filter _filter = Filter::NoFilter;
+
+};
+
+DialogsTypeButton::DialogsTypeButton(QWidget *parent)
+: AbstractButton(parent) {
+	resize(st::dialogsCalendar.width, st::dialogsCalendar.height);
+	setCursor(style::cur_pointer);
+}
+
+void DialogsTypeButton::setFilter(Filter filter) {
+	if (_filter != filter) {
+		_filter = filter;
+		update();
+	}
+}
+
+void DialogsTypeButton::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto active = (_filter != Filter::NoFilter);
+	if (active) {
+		auto hq = PainterHighQualityEnabler(p);
+		const auto size = std::min(width(), height()) - 4 * st::lineWidth;
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::lightButtonBgOver);
+		p.drawEllipse(QRect(
+			(width() - size) / 2,
+			(height() - size) / 2,
+			size,
+			size));
+	}
+	Icon(_filter).paintInCenter(
+		p,
+		rect(),
+		(active
+			? st::lightButtonFg
+			: isOver()
+			? st::dialogsMenuIconFgOver
+			: st::dialogsMenuIconFg)->c);
+}
+
+void DialogsTypeButton::onStateChanged(
+		State was,
+		StateChangeSource source) {
+	update();
+}
+
+class DialogsSearchType final {
+public:
+	explicit DialogsSearchType(DialogsSearchTypeDescriptor &&descriptor);
+	~DialogsSearchType();
+
+	[[nodiscard]] Ui::RpWidget *button() const;
+	void setState(const Dialogs::SearchState &state);
+	void setBlocked(bool blocked);
+	void reset();
+	[[nodiscard]] bool chosen() const;
+	[[nodiscard]] bool dirty() const;
+	void invalidate();
+	[[nodiscard]] MTPMessagesFilter takeFilter();
+	[[nodiscard]] MTPMessagesFilter requestedFilter() const;
+
+private:
+	[[nodiscard]] bool shown() const;
+	bool clear();
+	void choose(Filter filter);
+	void showMenu();
+	void updateVisibility();
+
+	const not_null<QWidget*> _widget;
+	const Fn<void(bool)> _changed;
+	const base::unique_qptr<DialogsTypeButton> _button;
+	base::unique_qptr<Ui::PopupMenu> _menu;
+	Dialogs::Key _key;
+	Filter _filter = Filter::NoFilter;
+	std::optional<Filter> _requested;
+	bool _eligible = false;
+	bool _blocked = false;
+	rpl::lifetime _lifetime;
+
+};
+
+[[nodiscard]] auto Registry()
+-> base::flat_map<not_null<QWidget*>, DialogsSearchType*> & {
+	static auto result = base::flat_map<
+		not_null<QWidget*>,
+		DialogsSearchType*>();
+	return result;
+}
+
+[[nodiscard]] DialogsSearchType *Lookup(not_null<QWidget*> widget) {
+	const auto &registry = Registry();
+	const auto i = registry.find(widget);
+	return (i != end(registry)) ? i->second : nullptr;
+}
+
+DialogsSearchType::DialogsSearchType(DialogsSearchTypeDescriptor &&descriptor)
+: _widget(descriptor.widget)
+, _changed(std::move(descriptor.changed))
+, _button(base::make_unique_q<DialogsTypeButton>(descriptor.parent)) {
+	Registry().emplace(_widget, this);
+
+	_button->hide();
+	_button->setAccessibleName(Lower(u"Message type"_q));
+	_button->setClickedCallback([=] { showMenu(); });
+
+	SearchTypesValue(
+	) | rpl::skip(1) | rpl::on_next([=](bool enabled) {
+		if (!enabled && clear()) {
+			_changed(true);
+		}
+		updateVisibility();
+	}, _lifetime);
+}
+
+DialogsSearchType::~DialogsSearchType() {
+	Registry().remove(_widget);
+}
+
+Ui::RpWidget *DialogsSearchType::button() const {
+	return _button.get();
+}
+
+void DialogsSearchType::setState(const Dialogs::SearchState &state) {
+	using Tab = Dialogs::ChatSearchTab;
+	_eligible = state.inChat.owningHistory()
+		&& ((state.tab == Tab::ThisPeer) || (state.tab == Tab::ThisTopic));
+	if (_key != state.inChat || !_eligible) {
+		_key = state.inChat;
+		clear();
+	}
+	updateVisibility();
+}
+
+void DialogsSearchType::setBlocked(bool blocked) {
+	_blocked = blocked;
+	if (blocked && clear()) {
+		_changed(false);
+	}
+	updateVisibility();
+}
+
+void DialogsSearchType::reset() {
+	if (clear()) {
+		_changed(false);
+	}
+}
+
+bool DialogsSearchType::chosen() const {
+	return (_filter != Filter::NoFilter);
+}
+
+bool DialogsSearchType::dirty() const {
+	return shown() && (_requested != _filter);
+}
+
+void DialogsSearchType::invalidate() {
+	_requested = std::nullopt;
+}
+
+MTPMessagesFilter DialogsSearchType::takeFilter() {
+	_requested = _filter;
+	return SearchTypeFilter(_filter);
+}
+
+MTPMessagesFilter DialogsSearchType::requestedFilter() const {
+	return SearchTypeFilter(_requested.value_or(Filter::NoFilter));
+}
+
+bool DialogsSearchType::shown() const {
+	return SearchTypes() && _eligible && !_blocked;
+}
+
+bool DialogsSearchType::clear() {
+	_menu = nullptr;
+	if (_filter == Filter::NoFilter) {
+		return false;
+	}
+	_filter = Filter::NoFilter;
+	_button->setFilter(_filter);
+	return true;
+}
+
+void DialogsSearchType::choose(Filter filter) {
+	if (_filter == filter || !shown()) {
+		return;
+	}
+	_filter = filter;
+	_button->setFilter(filter);
+	_changed(true);
+}
+
+void DialogsSearchType::showMenu() {
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		_button.get(),
+		st::popupMenuWithIcons);
+	FillMenu(_menu.get(), _filter, [=](Filter filter) { choose(filter); });
+	_menu->popup(_button->mapToGlobal(QPoint(0, _button->height())));
+}
+
+void DialogsSearchType::updateVisibility() {
+	const auto visible = shown();
+	if (!visible) {
+		_menu = nullptr;
+	}
+	if (_button->isHidden() == visible) {
+		_button->setVisible(visible);
+	}
+}
+
+} // namespace
+
+class ComposeSearchType::Button final : public Ui::RippleButton {
+public:
+	explicit Button(QWidget *parent);
+
+	void setFilter(Filter filter);
+
+protected:
+	void paintEvent(QPaintEvent *e) override;
+
+	QImage prepareRippleMask() const override;
+	QPoint prepareRippleStartPosition() const override;
+
+private:
+	Filter _filter = Filter::NoFilter;
+
+};
+
+ComposeSearchType::Button::Button(QWidget *parent)
+: RippleButton(parent, st::dialogSearchFrom.ripple) {
+	resize(st::dialogSearchFrom.width, st::dialogSearchFrom.height);
+	setCursor(style::cur_pointer);
+}
+
+void ComposeSearchType::Button::setFilter(Filter filter) {
+	if (_filter != filter) {
+		_filter = filter;
+		update();
+	}
+}
+
+void ComposeSearchType::Button::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	const auto &st = st::dialogSearchFrom;
+	const auto active = (_filter != Filter::NoFilter);
+	if (active) {
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::lightButtonBgOver);
+		p.drawEllipse(QRect(
+			st.rippleAreaPosition,
+			QSize(st.rippleAreaSize, st.rippleAreaSize)));
+	}
+	paintRipple(p, st.rippleAreaPosition);
+	Icon(_filter).paintInCenter(
+		p,
+		rect(),
+		(isOver() ? st::lightButtonFgOver : st::lightButtonFg)->c);
+}
+
+QImage ComposeSearchType::Button::prepareRippleMask() const {
+	const auto size = st::dialogSearchFrom.rippleAreaSize;
+	return Ui::RippleAnimation::EllipseMask(QSize(size, size));
+}
+
+QPoint ComposeSearchType::Button::prepareRippleStartPosition() const {
+	return mapFromGlobal(QCursor::pos())
+		- st::dialogSearchFrom.rippleAreaPosition;
+}
+
+MTPMessagesFilter SearchTypeFilter(Api::SearchFilter filter) {
+	switch (filter) {
+	case Filter::Photo: return MTP_inputMessagesFilterPhotos();
+	case Filter::Video: return MTP_inputMessagesFilterVideo();
+	case Filter::File: return MTP_inputMessagesFilterDocument();
+	case Filter::Music: return MTP_inputMessagesFilterMusic();
+	case Filter::Voice: return MTP_inputMessagesFilterVoice();
+	case Filter::RoundVideo: return MTP_inputMessagesFilterRoundVideo();
+	case Filter::Gif: return MTP_inputMessagesFilterGif();
+	case Filter::Url: return MTP_inputMessagesFilterUrl();
+	case Filter::Pinned: return MTP_inputMessagesFilterPinned();
+	case Filter::NoFilter: break;
+	}
+	return MTP_inputMessagesFilterEmpty();
+}
+
+QString SearchTypeToken(Api::SearchFilter filter) {
+	return u"\ntype"_q + QString::number(int(filter));
+}
+
+ComposeSearchType::ComposeSearchType(not_null<Ui::RpWidget*> bar) {
+	if (SearchTypes()) {
+		_button = base::make_unique_q<Button>(bar.get());
+		_button->setClickedCallback([=] { showMenu(); });
+	}
+}
+
+ComposeSearchType::~ComposeSearchType() = default;
+
+Ui::RpWidget *ComposeSearchType::button() const {
+	return _button.get();
+}
+
+rpl::producer<bool> ComposeSearchType::shownValue() const {
+	if (_button) {
+		return _button->shownValue();
+	}
+	return rpl::single(false);
+}
+
+Api::SearchFilter ComposeSearchType::filter() const {
+	return _filter;
+}
+
+rpl::producer<> ComposeSearchType::changes() const {
+	return _changes.events();
+}
+
+void ComposeSearchType::setAvailable(bool available) {
+	if (!_button) {
+		return;
+	}
+	if (!available) {
+		_menu = nullptr;
+		if (_filter != Filter::NoFilter) {
+			_filter = Filter::NoFilter;
+			_button->setFilter(_filter);
+		}
+	}
+	_button->setVisible(available);
+}
+
+void ComposeSearchType::showMenu() {
+	_menu = base::make_unique_q<Ui::PopupMenu>(
+		_button.get(),
+		st::popupMenuWithIcons);
+	FillMenu(_menu.get(), _filter, [=](Filter filter) { choose(filter); });
+	_menu->setForcedOrigin(Ui::PanelAnimation::Origin::BottomLeft);
+	_menu->popup(_button->mapToGlobal(QPoint()));
+}
+
+void ComposeSearchType::choose(Api::SearchFilter filter) {
+	if (_filter == filter) {
+		return;
+	}
+	_filter = filter;
+	_button->setFilter(filter);
+	_changes.fire({});
+}
+
+Ui::RpWidget *SetupDialogsSearchType(
+		DialogsSearchTypeDescriptor &&descriptor) {
+	const auto widget = descriptor.widget;
+	return widget->lifetime().make_state<DialogsSearchType>(
+		std::move(descriptor))->button();
+}
+
+void DialogsSearchTypeState(
+		not_null<QWidget*> widget,
+		const Dialogs::SearchState &state) {
+	if (const auto type = Lookup(widget)) {
+		type->setState(state);
+	}
+}
+
+void DialogsSearchTypeBlock(not_null<QWidget*> widget, bool blocked) {
+	if (const auto type = Lookup(widget)) {
+		type->setBlocked(blocked);
+	}
+}
+
+void DialogsSearchTypeReset(not_null<QWidget*> widget) {
+	if (const auto type = Lookup(widget)) {
+		type->reset();
+	}
+}
+
+bool DialogsSearchTypeChosen(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return type && type->chosen();
+}
+
+bool DialogsSearchTypeChosenAbove(not_null<QWidget*> child) {
+	for (auto w = child->parentWidget(); w; w = w->parentWidget()) {
+		if (const auto type = Lookup(w)) {
+			return type->chosen();
+		}
+	}
+	return false;
+}
+
+bool DialogsSearchTypeDirty(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return type && type->dirty();
+}
+
+void DialogsSearchTypeInvalidate(not_null<QWidget*> widget) {
+	if (const auto type = Lookup(widget)) {
+		type->invalidate();
+	}
+}
+
+MTPMessagesFilter DialogsSearchTypeTake(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return type ? type->takeFilter() : MTP_inputMessagesFilterEmpty();
+}
+
+MTPMessagesFilter DialogsSearchTypeRequested(not_null<QWidget*> widget) {
+	const auto type = Lookup(widget);
+	return type ? type->requestedFilter() : MTP_inputMessagesFilterEmpty();
+}
+
+} // namespace Tele
