+bool HistoryInner::paintScrollLayer(Painter &p, QRect clip) {
+	if (!_teleScrollLayer->gliding()) {
+		return false;
+	}
+	const auto mtop = migratedTop();
+	const auto htop = historyTop();
+	const auto historyDisplayedEmpty = _history->isDisplayedEmpty()
+		&& (!_migrated || _migrated->isDisplayedEmpty());
+	const auto usable = !historyDisplayedEmpty
+		&& (mtop >= 0 || htop >= 0)
+		&& !_theme->bubblesBackgroundPattern()
+		&& !_gestureHorizontal
+		&& !_inSelectionModeAnimation.animating();
+	if (usable && !Tele::NoAi()) {
+		const auto band = st::msgDateImgDelta + st::historyFastShareSize;
+		enumerateItems<EnumItemsDirection::TopToBottom>([&](
+				not_null<Element*> view,
+				int itemtop,
+				int itembottom) {
+			if (itemtop >= _visibleAreaTop + st::msgDateImgDelta) {
+				return false;
+			} else if (view->data()->canBeSummarized()) {
+				const auto from = std::max(itemtop, _visibleAreaTop);
+				const auto till = std::min(
+					itembottom,
+					_visibleAreaTop + band);
+				_teleScrollLayer->stick(QRect(0, from, width(), till - from));
+			}
+			return true;
+		});
+	}
+	const auto key = Tele::ScrollLayerKey(
+		width(),
+		height(),
+		mtop,
+		htop,
+		_contentWidth,
+		_isChatWide,
+		_theme.get(),
+		_selected.size(),
+		_dragSelFrom,
+		_dragSelTo,
+		_dragSelecting,
+		_mouseAction,
+		_lastInSelectionMode,
+		collapseGaps().size(),
+		_aboutView ? _aboutView->top : -1);
+	if (!_teleScrollLayer->paint(p, clip, usable, key)) {
+		return false;
+	}
+	if (base::take(_readMetricsStale)) {
+		_readMetricsTracker->startBatch(_visibleAreaTop, _visibleAreaBottom);
+		enumerateItems<EnumItemsDirection::TopToBottom>([&](
+				not_null<Element*> view,
+				int itemtop,
+				int itembottom) {
+			if (itembottom > itemtop) {
+				_readMetricsTracker->push(
+					view->data(),
+					itemtop,
+					itembottom - itemtop);
+			}
+			return true;
+		});
+		_readMetricsTracker->endBatch();
+	}
+	paintChat(p, clip, ChatPaint::Overlay);
+	return true;
+}
 
