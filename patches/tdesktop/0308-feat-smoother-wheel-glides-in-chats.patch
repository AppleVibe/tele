+}
+
+bool SmoothGlideActive() {
+	ForgetGlide(nullptr);
+	return !Gliding().empty();
+}
+
+void PauseDuringOtherGlides(not_null<QWidget*> widget) {
+	auto &list = Pausable();
+	list.erase(ranges::remove_if(list, [](const QPointer<QWidget> &entry) {
+		return !entry;
+	}), end(list));
+	list.push_back(widget.get());
+}
+
+void RepaintAfterDownloads(
+		not_null<Ui::RpWidget*> widget,
+		rpl::producer<> downloads,
+		Fn<void()> repaint) {
+	struct State {
+		base::Timer timer;
+		crl::time last = 0;
+	};
+	const auto state = widget->lifetime().make_state<State>();
+	const auto run = [=] {
+		state->last = crl::now();
+		repaint();
+	};
+	state->timer.setCallback([=] {
+		if (SmoothGlideActive()) {
+			state->timer.callOnce(kDownloadsRepaintDelay);
+		} else {
+			run();
+		}
+	});
+	std::move(downloads) | rpl::on_next([=] {
+		if (state->timer.isActive()) {
+			return;
+		}
+		const auto wait = state->last + kDownloadsRepaintDelay - crl::now();
+		if (wait <= 0 && !SmoothGlideActive()) {
+			run();
+		} else {
+			state->timer.callOnce((wait > 0) ? wait : kDownloadsRepaintDelay);
+		}
+	}, widget->lifetime());
 }
 
