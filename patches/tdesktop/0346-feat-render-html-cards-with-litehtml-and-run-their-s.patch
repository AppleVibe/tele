+[[nodiscard]] Sheet MasterSheet(const Scheme &scheme) {
+	static auto cache = base::flat_map<uint64, Sheet>();
+	const auto key = scheme.key();
+	if (const auto i = cache.find(key); i != end(cache)) {
+		return i->second;
+	} else if (cache.size() >= kMaxMasterSheets) {
+		cache.clear();
+	}
+	const auto kit = PrepareStyles(KitStyle(scheme), scheme.dark);
+	auto result = ParseSheet(
+		std::string(litehtml::master_css) + kit.toStdString(),
+		scheme);
+	cache.emplace(key, result);
+	return result;
+}
+
+[[nodiscard]] Sheet AuthorSheet(const QString &styles, const Scheme &scheme) {
+	struct Entry {
+		QString styles;
+		bool dark = false;
+		Sheet sheet;
+	};
+	static auto cache = std::deque<Entry>();
+	const auto i = ranges::find_if(cache, [&](const Entry &entry) {
+		return (entry.dark == scheme.dark) && (entry.styles == styles);
+	});
+	if (i != end(cache)) {
+		return i->sheet;
+	} else if (cache.size() >= kMaxAuthorSheets) {
+		cache.pop_front();
+	}
+	auto result = ParseSheet(
+		PrepareStyles(styles, scheme.dark).toStdString(),
+		scheme);
+	cache.push_back({ styles, scheme.dark, result });
+	return result;
+}
+
+} // namespace
+
+Document::Document(
+	const QString &styles,
+	const QString &body,
+	const Scheme &scheme,
+	int width)
+: _container(std::make_unique<Container>(scheme)) {
+	if (!CheckMarkup(body).isEmpty()) {
+		return;
+	}
+	const auto master = MasterSheet(scheme);
+	const auto author = AuthorSheet(styles, scheme);
+	if (!master || !author) {
+		return;
+	}
+	const auto root = scheme.dark ? u"lc-dark"_q : u"lc-light"_q;
+	const auto html = u"<html class=\"%1\"><body>"_q.arg(root)
+		+ body
+		+ u"</body></html>"_q;
+	_width = std::max(width, 0);
+	_container->setWidth(_width);
+	try {
+		_document = litehtml::document::createFromStringParsed(
+			litehtml::estring(html.toStdString()),
+			_container.get(),
+			master,
+			author);
+	} catch (...) {
+		_document = nullptr;
+	}
+}
+
+Document::~Document() {
+	_document = nullptr;
+}
+
+bool Document::valid() const {
+	return _document != nullptr;
+}
+
+void Document::layout(int width) {
+	_width = std::max(width, 1);
+	if (!_document) {
+		return;
+	}
+	_container->setWidth(_width);
+	_document->media_changed();
+	_natural = int(std::ceil(F(_document->render(float(_width)))));
+}
+
+int Document::layoutWidth() const {
+	return _width;
+}
+
+int Document::contentWidth() const {
+	return std::clamp(_natural, 1, std::max(_width, 1));
+}
+
+int Document::height() const {
+	return _document
+		? std::max(int(std::ceil(F(_document->height()))), 1)
+		: 1;
+}
+
+void Document::paint(QPainter &p, QRect clip) const {
+	if (!_document) {
+		return;
+	}
+	_container->clearClips();
+	auto position = litehtml::position(
+		float(clip.x()),
+		float(clip.y()),
+		float(clip.width()),
+		float(clip.height()));
+	p.save();
+	p.setRenderHint(QPainter::TextAntialiasing);
+	_document->draw(
+		reinterpret_cast<litehtml::uint_ptr>(&p),
+		0.f,
+		0.f,
+		&position);
+	p.restore();
+}
+
+Hit Document::hitTest(QPoint point) const {
+	auto result = Hit();
+	if (!_document || !_document->root_render()) {
+		return result;
+	}
+	auto element = _document->root_render()->get_element_by_point(
+		float(point.x()),
+		float(point.y()),
+		float(point.x()),
+		float(point.y()),
+		nullptr);
+	for (; element; element = element->parent()) {
+		const auto tag = Utf8(element->get_tagName()).toLower();
+		if (const auto action = element->get_attr("data-action")) {
+			result.action = Utf8(action);
+			result.value = Utf8(element->get_attr("data-value", ""));
+			result.pointer = true;
+			return result;
+		} else if (tag == u"a"_q) {
+			const auto href = Utf8(element->get_attr("href", "")).trimmed();
+			if (!href.isEmpty() && !href.startsWith('#')) {
+				result.link = href;
+				result.pointer = true;
+				return result;
+			}
+		}
+	}
+	return result;
+}
+
+bool Document::hover(QPoint point) {
+	if (!_document) {
+		return false;
+	}
+	const auto changed = _document->on_mouse_over(
+		float(point.x()),
+		float(point.y()),
+		float(point.x()),
+		float(point.y()),
+		[](const litehtml::position &) {});
+	if (changed) {
+		_document->render(float(_width));
+	}
+	return changed;
+}
+
+bool Document::leave() {
+	if (!_document) {
+		return false;
+	}
+	const auto changed = _document->on_mouse_leave(
+		[](const litehtml::position &) {});
+	if (changed) {
+		_document->render(float(_width));
+	}
+	return changed;
+}
+
+QString Document::plainText() const {
+	if (!_document || !_document->root()) {
+		return QString();
+	}
+	auto text = std::string();
+	_document->root()->get_text(text);
+	return QString::fromStdString(text).simplified();
+}
+
+} // namespace Tele::Html
