+ParsedCard ParseCard(const QString &source) {
+	auto result = ParsedCard();
+	static const auto comments = QRegularExpression(
+		u"<!--[\\s\\S]*?-->"_q);
+	static const auto scripts = QRegularExpression(
+		u"<script\\b([^>]*)>([\\s\\S]*?)</script\\s*>"_q,
+		QRegularExpression::CaseInsensitiveOption);
+	static const auto styles = QRegularExpression(
+		u"<style\\b[^>]*>([\\s\\S]*?)</style\\s*>"_q,
+		QRegularExpression::CaseInsensitiveOption);
+	static const auto widget = QRegularExpression(
+		u"^<div\\b[^>]*\\bclass\\s*=\\s*[\"'][^\"']*\\bwidget\\b"_q,
+		QRegularExpression::CaseInsensitiveOption);
+	static const auto src = QRegularExpression(
+		u"\\bsrc\\s*="_q,
+		QRegularExpression::CaseInsensitiveOption);
+	auto text = source;
+	text.remove(comments);
+	auto iterator = scripts.globalMatch(text);
+	while (iterator.hasNext()) {
+		const auto match = iterator.next();
+		if (match.captured(1).contains(src)) {
+			result.external = true;
+		} else if (!match.captured(2).trimmed().isEmpty()) {
+			result.scripts.push_back(match.captured(2));
+		}
+	}
+	text.remove(scripts);
+	auto styleIterator = styles.globalMatch(text);
+	while (styleIterator.hasNext()) {
+		result.styles.append(styleIterator.next().captured(1));
+		result.styles.append('\n');
+	}
+	text.remove(styles);
+	result.body = text.trimmed();
+	result.bubble = widget.match(result.body).hasMatch();
+	return result;
+}
