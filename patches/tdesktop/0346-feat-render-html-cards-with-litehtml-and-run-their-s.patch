+
+private:
+	template <typename Callback>
+	void withClips(QPainter *p, Callback &&callback) {
+		p->save();
+		for (const auto &clip : _clips) {
+			p->setClipPath(clip, Qt::IntersectClip);
+		}
+		callback();
+		p->restore();
+	}
+
+	template <typename Callback>
+	void withLayer(
+			QPainter *p,
+			const litehtml::background_layer &layer,
+			Callback &&callback) {
+		withClips(p, [&] {
+			p->setRenderHint(QPainter::Antialiasing);
+			p->setRenderHint(QPainter::SmoothPixmapTransform);
+			p->setClipPath(
+				RoundedPath(ToRect(layer.border_box), layer.border_radius),
+				Qt::IntersectClip);
+			p->setClipRect(ToRect(layer.clip_box), Qt::IntersectClip);
+			callback();
+		});
+	}
+
+	void fillLayer(
+			QPainter *p,
+			const litehtml::background_layer &layer,
+			const QBrush &brush) {
+		withLayer(p, layer, [&] {
+			p->fillRect(ToRect(layer.clip_box), brush);
+		});
+	}
+
+	void drawImage(QPainter *p, const Image &image, const QRectF &rect) {
+		if (image.svg) {
+			image.svg->render(p, rect);
+		} else if (!image.raster.isNull()) {
+			p->drawImage(rect, image.raster);
+		}
+	}
+
+	void drawImageAt(QPainter *p, const QString &url, const QRectF &rect) {
+		if (const auto found = image(url)) {
+			drawImage(p, *found, rect);
+		}
+	}
+
+	const Image *image(const QString &url) {
+		const auto i = _images.find(url);
+		if (i != end(_images)) {
+			return (i->second.svg || !i->second.raster.isNull())
+				? &i->second
+				: nullptr;
+		}
+		if (_images.size() >= kMaxImages) {
+			return nullptr;
+		}
+		auto loaded = LoadImage(url);
+		const auto pixels = int64(loaded.raster.width())
+			* loaded.raster.height();
+		if (_pixels + pixels > kMaxDocumentPixels) {
+			loaded = Image();
+		} else {
+			_pixels += pixels;
+		}
+		const auto j = _images.emplace(url, std::move(loaded)).first;
+		return (j->second.svg || !j->second.raster.isNull())
+			? &j->second
+			: nullptr;
+	}
+
+	Scheme _scheme;
+	int _width = 0;
+	QPainter *_painter = nullptr;
+	base::flat_set<FontHandle*> _fonts;
+	std::map<QString, Image> _images;
+	int64 _pixels = 0;
+	std::vector<QPainterPath> _clips;
+	QString _cursor;
+
+};
