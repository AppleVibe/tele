+#pragma once
+
+#include "base/timer.h"
+#include "base/weak_ptr.h"
+
+#include <quickjs.h>
+
+namespace Tele::Html {
+
+class Script final : public base::has_weak_ptr {
+public:
+	[[nodiscard]] static std::unique_ptr<Script> Create(
+		QString source,
+		Fn<void()> changed);
+
+	Script(QString source, Fn<void()> changed);
+	~Script();
+
+	[[nodiscard]] QString render();
+	void action(QString name, QString value);
+	[[nodiscard]] bool animating() const;
+	void tick(crl::time now);
+	[[nodiscard]] QString takeTransition();
+	[[nodiscard]] const std::vector<QString> &log() const;
+	[[nodiscard]] rpl::producer<> logUpdates() const;
+	[[nodiscard]] bool failed() const;
+	void setPaused(bool paused);
+	void warn(const QString &text);
+
+	JSValue native(int magic, int argc, JSValueConst *argv);
+	[[nodiscard]] bool interrupt();
+
+private:
+	enum class Level {
+		Log,
+		Warn,
+		Error,
+	};
+
+	void start(const QString &source);
+	[[nodiscard]] JSValue hook(const char *name);
+	void addLog(Level level, QString text);
+	[[nodiscard]] bool enter(crl::time budget);
+	void leave();
+	void runJobs();
+	bool check(JSValue value, const QString &where);
+	[[nodiscard]] QString describe(JSValue exception);
+	[[nodiscard]] QString string(JSValueConst value);
+	void stop(const QString &reason);
+	void notify();
+	void fire(int id);
+	void schedule(int id, crl::time delay, bool repeat);
+	void cancel(int id);
+	void account(crl::time spent);
+	void resumeDeferred();
+	[[nodiscard]] bool overloaded() const;
+
+	const Fn<void()> _changed;
+	base::Timer _resume;
+	std::vector<int> _deferred;
+	crl::time _entered = 0;
+	crl::time _windowStart = 0;
+	crl::time _spent = 0;
+	int _overruns = 0;
+	bool _overloaded = false;
+	bool _paused = false;
+	JSRuntime *_rt = nullptr;
+	JSContext *_ctx = nullptr;
+	JSValue _hooks = JS_UNDEFINED;
+	std::map<int, std::unique_ptr<base::Timer>> _timers;
+	std::vector<QString> _log;
+	rpl::event_stream<> _logUpdates;
+	QString _transition;
+	crl::time _deadline = 0;
+	bool _interrupted = false;
+	bool _failed = false;
+	bool _frames = false;
+	bool _inAction = false;
+	bool _notifyScheduled = false;
+	int _depth = 0;
+
+};
+
+} // namespace Tele::Html
