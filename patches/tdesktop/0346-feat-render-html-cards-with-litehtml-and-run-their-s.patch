+constexpr auto kDefaultFontSize = 14;
+constexpr auto kMaxImages = 64;
+constexpr auto kMaxImageBytes = 4 * 1024 * 1024;
+constexpr auto kMaxImageSide = 4096;
+constexpr auto kMaxImagePixels = int64(4096) * 4096;
+constexpr auto kMaxDocumentPixels = int64(48) * 1024 * 1024;
+constexpr auto kMaxDepth = 256;
+constexpr auto kMaxElements = 5000;
+
+using litehtml::pixel_t;
+
+[[nodiscard]] float F(pixel_t value) {
+	return value.value();
+}
+
+[[nodiscard]] QColor ToColor(const litehtml::web_color &color) {
+	return QColor(color.red, color.green, color.blue, color.alpha);
+}
+
+[[nodiscard]] QRectF ToRect(const litehtml::position &position) {
+	return QRectF(
+		F(position.x),
+		F(position.y),
+		F(position.width),
+		F(position.height));
+}
+
+[[nodiscard]] QString Utf8(const char *text) {
+	return text ? QString::fromUtf8(text) : QString();
+}
+
+[[nodiscard]] QString CssColor(const QColor &color) {
+	return u"rgba(%1,%2,%3,%4)"_q
+		.arg(color.red())
+		.arg(color.green())
+		.arg(color.blue())
+		.arg(QString::number(color.alphaF(), 'f', 3));
+}
+
+[[nodiscard]] QColor WithAlpha(QColor color, float64 alpha) {
+	color.setAlphaF(alpha);
+	return color;
+}
+
+[[nodiscard]] QPainterPath RoundedPath(
+		const QRectF &rect,
+		const litehtml::border_radiuses &radius) {
+	auto path = QPainterPath();
+	const auto tlx = std::min(double(F(radius.top_left_x)), rect.width() / 2);
+	const auto tly = std::min(double(F(radius.top_left_y)), rect.height() / 2);
+	const auto trx = std::min(double(F(radius.top_right_x)), rect.width() / 2);
+	const auto try_ = std::min(double(F(radius.top_right_y)), rect.height() / 2);
+	const auto brx = std::min(double(F(radius.bottom_right_x)), rect.width() / 2);
+	const auto bry = std::min(double(F(radius.bottom_right_y)), rect.height() / 2);
+	const auto blx = std::min(double(F(radius.bottom_left_x)), rect.width() / 2);
+	const auto bly = std::min(double(F(radius.bottom_left_y)), rect.height() / 2);
+	if (tlx <= 0 && tly <= 0 && trx <= 0 && try_ <= 0
+		&& brx <= 0 && bry <= 0 && blx <= 0 && bly <= 0) {
+		path.addRect(rect);
+		return path;
+	}
+	const auto l = rect.left();
+	const auto t = rect.top();
+	const auto r = rect.right();
+	const auto b = rect.bottom();
+	path.moveTo(l + tlx, t);
+	path.lineTo(r - trx, t);
+	if (trx > 0 && try_ > 0) {
+		path.arcTo(QRectF(r - 2 * trx, t, 2 * trx, 2 * try_), 90, -90);
+	}
+	path.lineTo(r, b - bry);
+	if (brx > 0 && bry > 0) {
+		path.arcTo(QRectF(r - 2 * brx, b - 2 * bry, 2 * brx, 2 * bry), 0, -90);
+	}
+	path.lineTo(l + blx, b);
+	if (blx > 0 && bly > 0) {
+		path.arcTo(QRectF(l, b - 2 * bly, 2 * blx, 2 * bly), 270, -90);
+	}
+	path.lineTo(l, t + tly);
+	if (tlx > 0 && tly > 0) {
+		path.arcTo(QRectF(l, t, 2 * tlx, 2 * tly), 180, -90);
+	}
+	path.closeSubpath();
+	return path;
+}
+
+[[nodiscard]] bool Square(const litehtml::border_radiuses &radius) {
+	return (F(radius.top_left_x) <= 0.f || F(radius.top_left_y) <= 0.f)
+		&& (F(radius.top_right_x) <= 0.f || F(radius.top_right_y) <= 0.f)
+		&& (F(radius.bottom_right_x) <= 0.f
+			|| F(radius.bottom_right_y) <= 0.f)
+		&& (F(radius.bottom_left_x) <= 0.f
+			|| F(radius.bottom_left_y) <= 0.f);
+}
+
+[[nodiscard]] litehtml::border_radiuses Shrink(
+		litehtml::border_radiuses radius,
+		const litehtml::borders &borders) {
+	const auto sub = [](pixel_t &value, pixel_t by) {
+		value = std::max(0.f, F(value) - F(by));
+	};
+	sub(radius.top_left_x, borders.left.width);
+	sub(radius.top_left_y, borders.top.width);
+	sub(radius.top_right_x, borders.right.width);
+	sub(radius.top_right_y, borders.top.width);
+	sub(radius.bottom_right_x, borders.right.width);
+	sub(radius.bottom_right_y, borders.bottom.width);
+	sub(radius.bottom_left_x, borders.left.width);
+	sub(radius.bottom_left_y, borders.bottom.width);
+	return radius;
+}
+
+[[nodiscard]] QString ReplaceLightDark(const QString &css, bool dark) {
+	static const auto open = u"light-dark("_q;
+	auto result = QString();
+	result.reserve(css.size());
+	auto from = 0;
+	while (true) {
+		const auto index = css.indexOf(open, from, Qt::CaseInsensitive);
+		if (index < 0) {
+			result.append(QStringView(css).mid(from));
+			break;
+		}
+		result.append(QStringView(css).mid(from, index - from));
+		auto depth = 1;
+		auto comma = -1;
+		auto i = index + open.size();
+		for (; i < css.size() && depth > 0; ++i) {
+			const auto ch = css[i];
+			if (ch == '(') {
+				++depth;
+			} else if (ch == ')') {
+				--depth;
+			} else if (ch == ',' && depth == 1 && comma < 0) {
+				comma = i;
+			}
+		}
+		const auto end = i - 1;
+		const auto start = index + open.size();
+		if (depth != 0 || comma < 0) {
+			result.append(QStringView(css).mid(index));
+			break;
+		}
+		const auto value = dark
+			? css.mid(comma + 1, end - comma - 1)
+			: css.mid(start, comma - start);
+		result.append(ReplaceLightDark(value.trimmed(), dark));
+		from = i;
+	}
+	return result;
+}
+
+struct FontBase {
+	QFont font;
+	QFontMetricsF metrics;
+};
+
+struct FontHandle {
+	not_null<const FontBase*> base;
+	int decoration = 0;
+	QColor decorationColor;
+	bool currentDecorationColor = true;
+};
+
+struct Image {
+	QImage raster;
+	std::unique_ptr<QSvgRenderer> svg;
+	QSize size;
+};
+
+[[nodiscard]] std::optional<QByteArray> DecodeData(const QString &url) {
+	if (!url.startsWith(u"data:"_q, Qt::CaseInsensitive)) {
+		return std::nullopt;
+	}
+	const auto comma = url.indexOf(',');
+	if (comma < 0) {
+		return std::nullopt;
+	}
+	const auto header = url.mid(5, comma - 5);
+	const auto payload = url.mid(comma + 1).toUtf8();
+	if (payload.size() > kMaxImageBytes * 2) {
+		return std::nullopt;
+	}
+	if (header.endsWith(u";base64"_q, Qt::CaseInsensitive)) {
+		return QByteArray::fromBase64(QByteArray::fromPercentEncoding(payload));
+	}
+	return QByteArray::fromPercentEncoding(payload);
+}
+
+[[nodiscard]] QString AppAsset(const QString &name) {
+	if (name == u"logo"_q) {
+		return u":/gui/art/logo_256_no_margin.png"_q;
+	} else if (name == u"tele"_q) {
+		return u":/gui/art/tele_userpic.jpg"_q;
+	}
+	return QString();
+}
+
+[[nodiscard]] Image LoadImage(const QString &url) {
+	auto result = Image();
+	auto bytes = QByteArray();
+	if (url.startsWith(u"app:"_q, Qt::CaseInsensitive)) {
+		const auto path = AppAsset(url.mid(4).trimmed().toLower());
+		if (!path.isEmpty()) {
+			result.raster = QImage(path);
+		}
+	} else if (const auto data = DecodeData(url)) {
+		bytes = *data;
+		const auto svg = url.mid(5, 16).startsWith(
+			u"image/svg"_q,
+			Qt::CaseInsensitive)
+			|| bytes.trimmed().startsWith("<svg")
+			|| bytes.trimmed().startsWith("<?xml");
+		static const auto external = QRegularExpression(
+			u"<image\\b[^>]*\\bhref\\s*=\\s*[\"'](?!data:)"_q,
+			QRegularExpression::CaseInsensitiveOption);
+		if (svg && QString::fromUtf8(bytes).contains(external)) {
+			return result;
+		} else if (svg) {
+			auto renderer = std::make_unique<QSvgRenderer>(bytes);
+			if (renderer->isValid()) {
+				result.size = renderer->defaultSize();
+				result.svg = std::move(renderer);
+			}
+		} else if (bytes.size() <= kMaxImageBytes) {
+			auto buffer = QBuffer(&bytes);
+			buffer.open(QIODevice::ReadOnly);
+			auto reader = QImageReader(&buffer);
+			const auto size = reader.size();
+			if (size.isValid()
+				&& (int64(size.width()) * size.height() <= kMaxImagePixels)) {
+				if (size.width() > kMaxImageSide
+					|| size.height() > kMaxImageSide) {
+					reader.setScaledSize(size.scaled(
+						kMaxImageSide,
+						kMaxImageSide,
+						Qt::KeepAspectRatio));
+				}
+				result.raster = reader.read();
+			}
+		}
+	}
+	if (!result.raster.isNull()) {
+		if (result.raster.width() > kMaxImageSide
+			|| result.raster.height() > kMaxImageSide) {
+			result.raster = result.raster.scaled(
+				kMaxImageSide,
+				kMaxImageSide,
+				Qt::KeepAspectRatio,
+				Qt::SmoothTransformation);
+		}
+		result.raster = result.raster.convertToFormat(
+			QImage::Format_ARGB32_Premultiplied);
+		result.size = result.raster.size();
+	}
+	return result;
+}
+
+} // namespace
