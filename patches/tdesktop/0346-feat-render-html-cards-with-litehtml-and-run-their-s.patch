+		return !action.isEmpty() || !link.isEmpty();
+	}
+};
+
+class Container;
+
+class Document final {
+public:
+	Document(
+		const QString &styles,
+		const QString &body,
+		const Scheme &scheme,
+		int width = 0);
+	~Document();
+
+	[[nodiscard]] bool valid() const;
+	void layout(int width);
+	[[nodiscard]] int layoutWidth() const;
+	[[nodiscard]] int contentWidth() const;
+	[[nodiscard]] int height() const;
+
+	void paint(QPainter &p, QRect clip) const;
