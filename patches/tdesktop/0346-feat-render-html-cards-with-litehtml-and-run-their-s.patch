+class Container final : public litehtml::document_container {
+public:
+	explicit Container(const Scheme &scheme) : _scheme(scheme) {
+	}
+
+	void setWidth(int width) {
+		_width = width;
+	}
+	void setPainter(QPainter *p) {
+		_painter = p;
+	}
+
+	litehtml::uint_ptr create_font(
+			const litehtml::font_description &descr,
+			const litehtml::document *doc,
+			litehtml::font_metrics *fm) override {
+		const auto family = Utf8(descr.family.c_str()).toLower();
+		const auto mono = family.contains(u"mono"_q)
+			|| family.contains(u"courier"_q)
+			|| family.contains(u"consol"_q)
+			|| family.contains(u"menlo"_q);
+		const auto bold = (descr.weight >= 600);
+		const auto italic = (descr.style == litehtml::font_style_italic);
+		auto flags = style::FontFlags();
+		if (mono) {
+			flags = style::FontFlag::Monospace;
+		} else {
+			if (bold) {
+				flags |= style::FontFlag::Bold;
+			}
+			if (italic) {
+				flags |= style::FontFlag::Italic;
+			}
+		}
+		const auto size = std::clamp(
+			int(std::round(F(descr.size))),
+			1,
+			512);
+		static auto bases = std::map<uint32, std::unique_ptr<FontBase>>();
+		const auto key = (uint32(size) << 8)
+			| (uint32(flags.value()) << 2)
+			| (bold ? 2U : 0U)
+			| (italic ? 1U : 0U);
+		auto &base = bases[key];
+		if (!base) {
+			auto font = style::font(size, flags, 0)->f;
+			if (mono) {
+				font.setBold(bold);
+				font.setItalic(italic);
+			}
+			font.setHintingPreference(QFont::PreferNoHinting);
+			base = std::make_unique<FontBase>(FontBase{
+				.font = font,
+				.metrics = QFontMetricsF(font),
+			});
+		}
+		auto handle = new FontHandle{
+			.base = base.get(),
+			.decoration = descr.decoration_line,
+			.decorationColor = ToColor(descr.decoration_color),
+			.currentDecorationColor = descr.decoration_color.is_current_color,
+		};
+		if (fm) {
+			const auto &m = handle->base->metrics;
+			fm->font_size = float(size);
+			fm->ascent = float(m.ascent());
+			fm->descent = float(m.descent());
+			fm->height = float(m.height());
+			fm->x_height = float(m.xHeight());
+			fm->ch_width = float(m.horizontalAdvance(QChar('0')));
+			fm->draw_spaces = (handle->decoration != 0);
+			fm->sub_shift = float(size / 5.);
+			fm->super_shift = float(size / 3.);
+		}
+		_fonts.emplace(handle);
+		return reinterpret_cast<litehtml::uint_ptr>(handle);
+	}
+
+	void delete_font(litehtml::uint_ptr hFont) override {
+		const auto handle = reinterpret_cast<FontHandle*>(hFont);
+		if (_fonts.remove(handle)) {
+			delete handle;
+		}
+	}
+
+	~Container() {
+		for (const auto handle : base::take(_fonts)) {
+			delete handle;
+		}
+	}
+
+	pixel_t text_width(const char *text, litehtml::uint_ptr hFont) override {
+		const auto handle = reinterpret_cast<FontHandle*>(hFont);
+		return float(handle->base->metrics.horizontalAdvance(Utf8(text)));
+	}
+
+	void draw_text(
+			litehtml::uint_ptr hdc,
+			const char *text,
+			litehtml::uint_ptr hFont,
+			litehtml::web_color color,
+			const litehtml::position &pos) override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		const auto handle = reinterpret_cast<FontHandle*>(hFont);
+		const auto string = Utf8(text);
+		withClips(p, [&] {
+			const auto fg = ToColor(color);
+			p->setFont(handle->base->font);
+			p->setPen(fg);
+			const auto baseline = F(pos.y) + handle->base->metrics.ascent();
+			p->drawText(QPointF(F(pos.x), baseline), string);
+			if (handle->decoration) {
+				const auto line = handle->currentDecorationColor
+					? fg
+					: handle->decorationColor;
+				const auto width = handle->base->metrics.horizontalAdvance(string);
+				const auto thickness = std::max(
+					1.,
+					handle->base->metrics.lineWidth());
+				const auto draw = [&](qreal y) {
+					p->fillRect(
+						QRectF(F(pos.x), y, width, thickness),
+						line);
+				};
+				using namespace litehtml;
+				if (handle->decoration & text_decoration_line_underline) {
+					draw(baseline + handle->base->metrics.underlinePos());
+				}
+				if (handle->decoration & text_decoration_line_line_through) {
+					draw(baseline - handle->base->metrics.strikeOutPos());
+				}
+				if (handle->decoration & text_decoration_line_overline) {
+					draw(baseline - handle->base->metrics.overlinePos());
+				}
+			}
+		});
+	}
+
+	pixel_t pt_to_px(float pt) const override {
+		return pt * 96.f / 72.f;
+	}
+	pixel_t get_default_font_size() const override {
+		return float(kDefaultFontSize);
+	}
+	const char *get_default_font_name() const override {
+		return "sans-serif";
+	}
+
+	void draw_list_marker(
+			litehtml::uint_ptr hdc,
+			const litehtml::list_marker &marker) override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		const auto rect = ToRect(marker.pos);
+		const auto color = ToColor(marker.color);
+		withClips(p, [&] {
+			using namespace litehtml;
+			if (!marker.image.empty()) {
+				drawImageAt(p, Utf8(marker.image.c_str()), rect);
+				return;
+			}
+			p->setRenderHint(QPainter::Antialiasing);
+			switch (marker.marker_type) {
+			case list_style_type_circle:
+				p->setPen(QPen(color, 1.));
+				p->setBrush(Qt::NoBrush);
+				p->drawEllipse(rect.adjusted(0.5, 0.5, -0.5, -0.5));
+				break;
+			case list_style_type_disc:
+				p->setPen(Qt::NoPen);
+				p->setBrush(color);
+				p->drawEllipse(rect);
+				break;
+			case list_style_type_square:
+				p->fillRect(rect, color);
+				break;
+			default:
+				if (marker.font) {
+					const auto handle = reinterpret_cast<FontHandle*>(
+						marker.font);
+					const auto text = QString::number(marker.index) + '.';
+					const auto width = handle->base->metrics.horizontalAdvance(
+						text);
+					p->setFont(handle->base->font);
+					p->setPen(color);
+					p->drawText(
+						QPointF(
+							rect.x() + rect.width() - width,
+							rect.y() + handle->base->metrics.ascent()),
+						text);
+				}
+				break;
+			}
+		});
+	}
+
+	void load_image(
+			const char *src,
+			const char *baseurl,
+			bool redraw_on_ready) override {
+		image(Utf8(src));
+	}
+
+	void get_image_size(
+			const char *src,
+			const char *baseurl,
+			litehtml::size &sz) override {
+		const auto found = image(Utf8(src));
+		sz.width = found ? found->size.width() : 0;
+		sz.height = found ? found->size.height() : 0;
+	}
+
+	void draw_image(
+			litehtml::uint_ptr hdc,
+			const litehtml::background_layer &layer,
+			const std::string &url,
+			const std::string &base_url) override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		const auto found = image(Utf8(url.c_str()));
+		if (!found) {
+			return;
+		}
+		withLayer(p, layer, [&] {
+			const auto origin = ToRect(layer.origin_box);
+			if (origin.width() <= 0 || origin.height() <= 0) {
+				return;
+			}
+			using namespace litehtml;
+			if (layer.repeat == background_repeat_no_repeat) {
+				drawImage(p, *found, origin);
+				return;
+			}
+			const auto clip = ToRect(layer.clip_box);
+			const auto repeatX = (layer.repeat != background_repeat_repeat_y);
+			const auto repeatY = (layer.repeat != background_repeat_repeat_x);
+			if (origin.width() < 1. || origin.height() < 1.) {
+				return;
+			}
+			const auto back = [](qreal from, qreal edge, qreal step) {
+				return (from > edge)
+					? (from - std::ceil((from - edge) / step) * step)
+					: from;
+			};
+			const auto startX = repeatX
+				? back(origin.x(), clip.x(), origin.width())
+				: origin.x();
+			const auto startY = repeatY
+				? back(origin.y(), clip.y(), origin.height())
+				: origin.y();
+			auto count = 0;
+			for (auto y = startY
+				; (repeatY ? (y < clip.bottom()) : (y == startY))
+				; y += origin.height()) {
+				for (auto x = startX
+					; (repeatX ? (x < clip.right()) : (x == startX))
+					; x += origin.width()) {
+					drawImage(
+						p,
+						*found,
+						QRectF(x, y, origin.width(), origin.height()));
+					if (++count > 4096) {
+						return;
+					}
+				}
+			}
+		});
+	}
+
+	void draw_solid_fill(
+			litehtml::uint_ptr hdc,
+			const litehtml::background_layer &layer,
+			const litehtml::web_color &color) override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		if (!color.alpha) {
+			return;
+		}
+		withClips(p, [&] {
+			const auto box = ToRect(layer.border_box);
+			const auto clip = ToRect(layer.clip_box);
+			if (Square(layer.border_radius)) {
+				p->fillRect(box.intersected(clip), ToColor(color));
+				return;
+			}
+			p->setRenderHint(QPainter::Antialiasing);
+			p->setClipRect(clip, Qt::IntersectClip);
+			p->fillPath(RoundedPath(box, layer.border_radius), ToColor(color));
+		});
+	}
+
+	void draw_linear_gradient(
+			litehtml::uint_ptr hdc,
+			const litehtml::background_layer &layer,
+			const litehtml::background_layer::linear_gradient &gradient)
+			override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		auto brush = QLinearGradient(
+			QPointF(gradient.start.x, gradient.start.y),
+			QPointF(gradient.end.x, gradient.end.y));
+		for (const auto &point : gradient.color_points) {
+			brush.setColorAt(
+				std::clamp(double(point.offset), 0., 1.),
+				ToColor(point.color));
+		}
+		fillLayer(p, layer, QBrush(brush));
+	}
+
+	void draw_radial_gradient(
+			litehtml::uint_ptr hdc,
+			const litehtml::background_layer &layer,
+			const litehtml::background_layer::radial_gradient &gradient)
+			override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		const auto rx = std::max(0.01f, gradient.radius.x);
+		const auto ry = std::max(0.01f, gradient.radius.y);
+		auto brush = QRadialGradient(QPointF(0, 0), rx);
+		for (const auto &point : gradient.color_points) {
+			brush.setColorAt(
+				std::clamp(double(point.offset), 0., 1.),
+				ToColor(point.color));
+		}
+		auto result = QBrush(brush);
+		auto transform = QTransform();
+		transform.translate(gradient.position.x, gradient.position.y);
+		transform.scale(1., ry / rx);
+		result.setTransform(transform);
+		fillLayer(p, layer, result);
+	}
+
+	void draw_conic_gradient(
+			litehtml::uint_ptr hdc,
+			const litehtml::background_layer &layer,
+			const litehtml::background_layer::conic_gradient &gradient)
+			override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		auto brush = QConicalGradient(
+			QPointF(gradient.position.x, gradient.position.y),
+			90. - gradient.angle);
+		for (const auto &point : gradient.color_points) {
+			brush.setColorAt(
+				std::clamp(1. - double(point.offset), 0., 1.),
+				ToColor(point.color));
+		}
+		fillLayer(p, layer, QBrush(brush));
+	}
+
+	void draw_borders(
+			litehtml::uint_ptr hdc,
+			const litehtml::borders &borders,
+			const litehtml::position &draw_pos,
+			bool root) override {
+		const auto p = reinterpret_cast<QPainter*>(hdc);
+		const auto rect = ToRect(draw_pos);
+		const auto visible = [](const litehtml::border &border) {
+			return (F(border.width) > 0.f)
+				&& (border.style != litehtml::border_style_none)
+				&& (border.style != litehtml::border_style_hidden)
+				&& border.color.alpha;
+		};
+		const auto l = visible(borders.left);
+		const auto t = visible(borders.top);
+		const auto r = visible(borders.right);
+		const auto b = visible(borders.bottom);
+		if (!l && !t && !r && !b) {
+			return;
+		}
+		withClips(p, [&] {
+			p->setRenderHint(QPainter::Antialiasing);
+			const auto same = l && t && r && b
+				&& borders.left.color == borders.top.color
+				&& borders.left.color == borders.right.color
+				&& borders.left.color == borders.bottom.color;
+			const auto inner = rect.adjusted(
+				F(borders.left.width),
+				F(borders.top.width),
+				-F(borders.right.width),
+				-F(borders.bottom.width));
+			auto ring = RoundedPath(rect, borders.radius);
+			if (inner.width() > 0 && inner.height() > 0) {
+				ring.addPath(RoundedPath(inner, Shrink(borders.radius, borders)));
+			}
+			ring.setFillRule(Qt::OddEvenFill);
+			if (same) {
+				p->fillPath(ring, ToColor(borders.top.color));
+				return;
+			}
+			const auto side = [&](
+					bool shown,
+					const litehtml::border &border,
+					QPolygonF polygon) {
+				if (!shown) {
+					return;
+				}
+				auto path = QPainterPath();
+				path.addPolygon(polygon);
+				path.closeSubpath();
+				p->save();
+				p->setClipPath(path, Qt::IntersectClip);
+				p->fillPath(ring, ToColor(border.color));
+				p->restore();
+			};
+			side(t, borders.top, QPolygonF({
+				rect.topLeft(),
+				rect.topRight(),
+				inner.topRight(),
+				inner.topLeft(),
+			}));
+			side(b, borders.bottom, QPolygonF({
+				rect.bottomLeft(),
+				rect.bottomRight(),
+				inner.bottomRight(),
+				inner.bottomLeft(),
+			}));
+			side(l, borders.left, QPolygonF({
+				rect.topLeft(),
+				inner.topLeft(),
+				inner.bottomLeft(),
+				rect.bottomLeft(),
+			}));
+			side(r, borders.right, QPolygonF({
+				rect.topRight(),
+				inner.topRight(),
+				inner.bottomRight(),
+				rect.bottomRight(),
+			}));
+		});
+	}
