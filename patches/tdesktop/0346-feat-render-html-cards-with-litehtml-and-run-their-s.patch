+QString CheckMarkup(const QString &html) {
+	static const auto voids = base::flat_set<QString>{
+		u"area"_q, u"base"_q, u"br"_q, u"col"_q, u"embed"_q, u"hr"_q,
+		u"img"_q, u"input"_q, u"link"_q, u"meta"_q, u"param"_q,
+		u"source"_q, u"track"_q, u"wbr"_q,
+	};
+	auto depth = 0;
+	auto count = 0;
+	const auto size = int(html.size());
+	for (auto i = 0; i < size; ++i) {
+		if (html[i] != '<' || i + 1 >= size) {
+			continue;
+		} else if (html[i + 1] == '/') {
+			depth = std::max(depth - 1, 0);
+			continue;
+		} else if (!html[i + 1].isLetter()) {
+			continue;
+		}
+		auto j = i + 1;
+		while (j < size && (html[j].isLetterOrNumber() || html[j] == '-')) {
+			++j;
+		}
+		const auto name = html.mid(i + 1, j - i - 1).toLower();
+		const auto end = html.indexOf('>', j);
+		if (end < 0) {
+			break;
+		} else if (++count > kMaxElements) {
+			return u"more than %1 elements"_q.arg(kMaxElements);
+		} else if (html[end - 1] != '/' && !voids.contains(name)) {
+			if (++depth > kMaxDepth) {
+				return u"elements nested deeper than %1"_q.arg(kMaxDepth);
+			}
+		}
+		i = end;
+	}
+	return QString();
+}
+
+QString PrepareStyles(QString css, bool dark) {
+	static const auto media = QRegularExpression(
+		u"@media\\s*\\(\\s*prefers-color-scheme\\s*:\\s*(dark|light)\\s*\\)"_q,
+		QRegularExpression::CaseInsensitiveOption);
+	css = ReplaceLightDark(css, dark);
+	auto result = QString();
+	auto from = 0;
+	auto iterator = media.globalMatch(css);
+	while (iterator.hasNext()) {
+		const auto match = iterator.next();
+		result.append(QStringView(css).mid(
+			from,
+			match.capturedStart() - from));
+		const auto wantsDark = (match.captured(1).toLower() == u"dark"_q);
+		result.append((wantsDark == dark)
+			? u"@media screen"_q
+			: u"@media print"_q);
+		from = match.capturedEnd();
+	}
+	result.append(QStringView(css).mid(from));
+	return result;
+}
