+
+void PlaygroundWidget::updateControlsGeometry() {
+	const auto contentWidth = width();
+
+	const auto newScrollTop = _scroll->isHidden()
+		? std::nullopt
+		: base::make_optional(_scroll->scrollTop() + takeTopDelta());
+	_topBar->resizeToWidth(contentWidth);
+	_topBarShadow->resize(contentWidth, st::lineWidth);
+
+	const auto top = _topBar->height();
+	const auto compose = composeHeight();
+	const auto fieldLeft = st::historySendPadding;
+	const auto fieldWidth = std::max(
+		contentWidth - fieldLeft - _send->width() - st::historySendRight,
+		1);
+	_compose->setGeometry(0, height() - compose, contentWidth, compose);
+	_field->resizeToWidth(fieldWidth);
+	_field->moveToLeft(
+		fieldLeft,
+		compose - _field->height() - st::historySendPadding);
+	_send->moveToRight(
+		st::historySendRight,
+		compose - _send->height());
+	_composeShadow->setGeometry(
+		0,
+		height() - compose - st::lineWidth,
+		contentWidth,
+		st::lineWidth);
+	const auto scrollSize = QSize(contentWidth, height() - top - compose);
+	if (_scroll->size() != scrollSize) {
+		_skipScrollEvent = true;
+		_scroll->resize(scrollSize);
+		_inner->resizeToWidth(scrollSize.width(), _scroll->height());
+		_skipScrollEvent = false;
+	}
+	_scroll->move(0, top);
+	if (!_scroll->isHidden()) {
+		if (newScrollTop) {
+			_scroll->scrollToY(*newScrollTop);
+		}
+		updateInnerVisibleArea();
+	}
+}
+
+void PlaygroundWidget::paintEvent(QPaintEvent *e) {
+	if (animatingShow()) {
+		SectionWidget::paintEvent(e);
+		return;
+	} else if (controller()->contentOverlapped(this, e)) {
+		return;
+	}
+
+	const auto aboveHeight = _topBar->height();
+	const auto bg = e->rect().intersected(QRect(
+		0,
+		aboveHeight,
+		width(),
+		height() - aboveHeight - composeHeight()));
+	SectionWidget::PaintBackground(controller(), _theme.get(), this, bg);
+}
