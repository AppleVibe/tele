+
+constexpr auto kMaxTgwSize = int64(256 * 1024);
+constexpr auto kTransitionDuration = crl::time(240);
+constexpr auto kBareWidthFactor = 1.5;
+constexpr auto kFrameInterval = crl::time(15);
+constexpr auto kMaxLiveScripts = 16;
+constexpr auto kMaxCssHeight = 4096;
+constexpr auto kTempLifetime = crl::time(10 * 60 * 1000);
+
+std::vector<base::weak_ptr<Card>> StartQueue;
+std::vector<base::weak_ptr<Card>> Live;
+bool StartScheduled = false;
+
+void ProcessStartQueue() {
+	StartScheduled = false;
+	while (!StartQueue.empty()) {
+		const auto card = StartQueue.front().get();
+		StartQueue.erase(begin(StartQueue));
+		if (card && card->visible() && !card->script()) {
+			card->start();
+			break;
+		}
+	}
+	if (!StartQueue.empty() && !StartScheduled) {
+		StartScheduled = true;
+		crl::on_main([] { ProcessStartQueue(); });
+	}
+}
+
+void ScheduleStart(not_null<Card*> card) {
+	StartQueue.push_back(base::make_weak(card.get()));
+	if (!StartScheduled) {
+		StartScheduled = true;
+		crl::on_main([] { ProcessStartQueue(); });
+	}
+}
+
+void TouchLive(not_null<Card*> card) {
+	Live.erase(ranges::remove_if(Live, [&](const base::weak_ptr<Card> &weak) {
+		const auto strong = weak.get();
+		return !strong || (strong == card.get()) || !strong->script();
+	}), end(Live));
+	Live.push_back(base::make_weak(card.get()));
+	for (auto i = begin(Live); int(Live.size()) > kMaxLiveScripts;) {
+		if (i == end(Live)) {
+			break;
+		}
+		const auto strong = i->get();
+		if (strong && strong != card.get() && !strong->visible()) {
+			strong->stopScript();
+			i = Live.erase(i);
+		} else {
+			++i;
+		}
+	}
+}
+
+using CardKey = std::pair<Main::Session*, FullMsgId>;
+
+struct CardEntry {
+	std::shared_ptr<Card> card;
+};
+
+std::map<CardKey, CardEntry> Cards;
+base::flat_set<Main::Session*> Watched;
+std::map<Main::Session*, base::flat_set<FullMsgId>> Tracked;
+
+void Watch(not_null<Main::Session*> session) {
+	if (!Watched.emplace(session).second) {
+		return;
+	}
+	session->data().itemRemoved(
+	) | rpl::on_next([=](not_null<const HistoryItem*> item) {
+		Cards.erase(CardKey{ session.get(), item->fullId() });
+		const auto i = Tracked.find(session);
+		if (i != end(Tracked)) {
+			i->second.remove(item->fullId());
+		}
+	}, session->lifetime());
+	session->lifetime().add([=] {
+		Watched.remove(session);
+		Tracked.erase(session);
+		for (auto i = begin(Cards); i != end(Cards);) {
+			if (i->first.first == session) {
+				i = Cards.erase(i);
+			} else {
+				++i;
+			}
+		}
+	});
+}
+
+void Track(not_null<HistoryItem*> item) {
+	const auto session = &item->history()->session();
+	Watch(session);
+	Tracked[session].emplace(item->fullId());
+}
+
+[[nodiscard]] bool LinkAllowed(const QString &url) {
+	const auto lower = url.trimmed().toLower();
+	return lower.startsWith(u"https://"_q)
+		|| lower.startsWith(u"http://"_q)
+		|| lower.startsWith(u"tg://"_q)
+		|| lower.startsWith(u"ton://"_q)
+		|| lower.startsWith(u"mailto:"_q);
+}
+
+[[nodiscard]] QString CardFileName(const QString &source) {
+	const auto hash = QCryptographicHash::hash(
+		source.toUtf8(),
+		QCryptographicHash::Sha256).toHex().left(12);
+	return u"card-"_q + QString::fromLatin1(hash) + u".tgw"_q;
+}
+
+void SendAsTgw(
+		not_null<Window::SessionController*> controller,
+		QString source) {
+	const auto chosen = std::make_shared<Data::Thread*>(nullptr);
+	const auto weak = base::make_weak(controller);
+	Window::ShowChooseRecipientBox(
+		controller,
+		[=](not_null<Data::Thread*> thread) {
+			*chosen = thread;
+			return true;
+		},
+		rpl::single(Lower(u"Send as .tgw to"_q)),
+		[=] {
+			const auto strong = weak.get();
+			const auto thread = *chosen;
+			if (!strong || !thread) {
+				return;
+			}
+			const auto folder = cWorkingDir() + u"tdata/tele_html_send"_q;
+			QDir().mkpath(folder);
+			const auto path = folder + '/' + CardFileName(source);
+			auto file = QFile(path);
+			base::call_delayed(kTempLifetime, [=] {
+				QFile::remove(path);
+			});
+			if (!file.open(QIODevice::WriteOnly)) {
+				strong->showToast(Lower(u"Couldn't write the .tgw file."_q));
+				return;
+			}
+			file.write(source.toUtf8());
+			file.close();
+			auto list = Storage::PrepareMediaList(
+				QStringList{ path },
+				st::sendMediaPreviewSize,
+				strong->session().premium());
+			if (list.error != Ui::PreparedList::Error::None
+				|| list.files.empty()) {
+				strong->showToast(Lower(u"Couldn't send the .tgw file."_q));
+				return;
+			}
+			for (auto &prepared : list.files) {
+				prepared.type = Ui::PreparedFile::Type::File;
+			}
+			thread->session().api().sendFiles(
+				std::move(list),
+				SendMediaType::File,
+				nullptr,
+				Api::SendAction(thread));
+			strong->showToast(Lower(u"Sent as a .tgw file."_q));
+		});
+}
+
+void ScriptLogBox(
+		not_null<Ui::GenericBox*> box,
+		std::weak_ptr<Card> weak) {
+	box->setTitle(rpl::single(Lower(u"Script log"_q)));
+	box->setWidth(st::boxWideWidth);
+	const auto text = [=] {
+		const auto card = weak.lock();
+		const auto script = card ? card->script() : nullptr;
+		if (!script) {
+			return Lower(u"The card is gone."_q);
+		}
+		const auto &lines = script->log();
+		if (lines.empty()) {
+			return Lower(u"Nothing logged yet."_q);
+		}
+		auto result = QStringList();
+		for (const auto &line : lines) {
+			result.push_back(line);
+		}
+		return result.join('\n');
+	};
+	const auto label = box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		text(),
+		st::boxLabel));
+	label->setSelectable(true);
+	if (const auto card = weak.lock()) {
+		if (const auto script = card->script()) {
+			script->logUpdates(
+			) | rpl::on_next([=] {
+				label->setText(text());
+			}, label->lifetime());
+		}
+	}
+	box->addButton(rpl::single(Lower(u"Copy"_q)), [=] {
+		QGuiApplication::clipboard()->setText(text());
+		box->showToast(Lower(u"Copied."_q));
+	});
+	box->addButton(rpl::single(Lower(u"Close"_q)), [=] {
+		box->closeBox();
+	});
+}
+
+[[nodiscard]] Window::SessionController *ControllerFor(
+		not_null<Main::Session*> session) {
+	const auto check = [&](Window::Controller *window) {
+		const auto controller = window ? window->sessionController() : nullptr;
+		return (controller && &controller->session() == session)
+			? controller
+			: nullptr;
+	};
+	if (const auto result = check(Core::App().activeWindow())) {
+		return result;
+	}
+	return check(Core::App().activePrimaryWindow());
+}
