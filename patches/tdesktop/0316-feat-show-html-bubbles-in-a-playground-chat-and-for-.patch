+	object_ptr<Ui::PlainShadow> _composeShadow;
+
+	rpl::event_stream<> _refreshes;
+	QString _query;
+	bool _refreshScheduled = false;
+	bool _scrollToBottom = false;
+
+};
+
+PlaygroundWidget::PlaygroundWidget(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller,
+	not_null<History*> history)
+: Window::SectionWidget(parent, controller, history->peer)
+, HistoryView::WindowListDelegate(controller)
+, _history(history)
+, _topBar(this, controller)
+, _topBarShadow(this)
+, _scroll(std::make_unique<Ui::ElasticScroll>(
+	this,
+	controller->chatStyle()->value(lifetime(), st::historyScroll)))
+, _compose(this)
+, _field(
+	_compose.data(),
+	st::historyComposeField,
+	Ui::InputField::Mode::MultiLine,
+	rpl::single(Lower(u"HTML, with <style> and <script>"_q)))
+, _send(_compose.data(), st::historySend)
+, _composeShadow(this) {
+	controller->chatStyle()->paletteChanged(
+	) | rpl::on_next([=] {
+		_scroll->updateBars();
+	}, _scroll->lifetime());
+
+	Window::ChatThemeValueFromPeer(
+		controller,
+		history->peer
+	) | rpl::on_next([=](std::shared_ptr<Ui::ChatTheme> &&theme) {
+		_theme = std::move(theme);
+		controller->setChatStyleTheme(_theme);
+	}, lifetime());
+
+	_topBar->setActiveChat(
+		TopBarWidget::ActiveChat{
+			.key = _history,
+			.section = Dialogs::EntryState::Section::History,
+		},
+		nullptr);
+
+	_topBar->move(0, 0);
+	_topBar->resizeToWidth(width());
+	_topBar->show();
+
+	_topBar->deleteSelectionRequest(
+	) | rpl::on_next([=] {
+		confirmDeleteSelected();
+	}, _topBar->lifetime());
+	_topBar->clearSelectionRequest(
+	) | rpl::on_next([=] {
+		clearSelected();
+	}, _topBar->lifetime());
+	setupSearch();
+
+	_topBarShadow->raise();
+	controller->adaptive().value(
+	) | rpl::on_next([=] {
+		updateAdaptiveLayout();
+	}, lifetime());
+
+	_scroll->setHandleTouch(false);
+	_inner = _scroll->setOwnedWidget(object_ptr<ListWidget>(
+		this,
+		&controller->session(),
+		static_cast<ListDelegate*>(this)));
+	_inner->lower();
+	_scroll->move(0, _topBar->height());
+	_scroll->show();
+	_scroll->setOverscrollBg(QColor(0, 0, 0, 0));
+	_scroll->setOverscrollEdges([=] {
+		return _inner->loadedAtTopKnown() && _inner->loadedAtTop();
+	}, [=] {
+		return _inner->loadedAtBottomKnown() && _inner->loadedAtBottom();
+	});
+	_scroll->scrolls(
+	) | rpl::on_next([=] {
+		onScroll();
+	}, lifetime());
+
+	_inner->scrollKeyEvents(
+	) | rpl::on_next([=](not_null<QKeyEvent*> e) {
+		_scroll->keyPressEvent(e);
+	}, lifetime());
+
+	const auto owner = &_history->owner();
+	owner->newItemAdded(
+	) | rpl::filter([=](not_null<HistoryItem*> item) {
+		return (item->history() == _history);
+	}) | rpl::on_next([=] {
+		scheduleRefresh();
+		markRead();
+	}, lifetime());
+	owner->itemRemoved(
+	) | rpl::filter([=](not_null<const HistoryItem*> item) {
+		return (item->history() == _history);
+	}) | rpl::on_next([=] {
+		scheduleRefresh();
+	}, lifetime());
+	owner->historyCleared(
+	) | rpl::filter([=](not_null<const History*> history) {
+		return (history == _history);
+	}) | rpl::on_next([=] {
+		scheduleRefresh();
+	}, lifetime());
+
+	Window::SetupSwipeBackSection(this, _scroll.get(), _inner);
+	setupCompose();
+
+	crl::on_main(this, [=] {
+		markRead();
+	});
+}
+
+void PlaygroundWidget::setupCompose() {
+	_compose->paintRequest(
+	) | rpl::on_next([=](QRect clip) {
+		QPainter(_compose.data()).fillRect(clip, st::historyComposeAreaBg);
+	}, _compose->lifetime());
+	_field->setMinHeight(
+		st::historySendSize.height() - 2 * st::historySendPadding);
+	_field->setMaxHeight(st::historyComposeFieldMaxHeight);
+	_field->setDocumentMargin(4.);
+	_field->setAdditionalMargin(style::ConvertScale(4) - 4);
+	_field->setSubmitSettings(Ui::InputField::SubmitSettings::CtrlEnter);
+	_field->submits(
+	) | rpl::on_next([=] {
+		send();
+	}, _field->lifetime());
+	_field->heightValue(
+	) | rpl::on_next([=] {
+		updateControlsGeometry();
+	}, _field->lifetime());
+	_send->setClickedCallback([=] {
+		send();
+	});
+	_compose->show();
+	_field->show();
+	_send->show();
+	_composeShadow->show();
+}
