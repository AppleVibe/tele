+const progress = { value: 0 };
+
+function finished() {
+  return items.filter(item => item.done).length;
+}
+
+function onAction(name, value) {
+  if (name === 'toggle') {
+    const item = items[Number(value)];
+    item.done = !item.done;
+    tween(progress, { value: finished() / items.length }, 360, ease.outCubic);
+    if (finished() === items.length) {
+      transition('pop');
+      console.log('all done');
