+  } else if (name === 'clear') {
+    items.forEach(item => item.done = false);
+    tween(progress, { value: 0 }, 300);
+    transition('slide-down');
+  }
+}
+
+function render() {
+  const all = finished() === items.length;
+  const list = items.map((item, i) => `<div class="item ${item.done ? 'done' : ''}" data-action="toggle" data-value="${i}">
+      <div class="box">${item.done ? '✓' : ''}</div><div class="label">${esc(item.text)}</div></div>`).join('');
+  const color = mix('#3a8ee6', '#2fa84f', progress.value);
