+#include "tele/tele_html_samples.h"
+
+namespace Tele::Html {
+namespace {
+
+const char kIntro[] = R"html(<div class="widget">
+<p><b>HTML playground</b></p>
+<p>Every message here is its own small HTML page. Send HTML with <code>&lt;style&gt;</code> and <code>&lt;script&gt;</code>: it shows full width, or inside a bubble when wrapped in <code>&lt;div class="widget"&gt;</code>.</p>
+<p class="small muted" style="margin: 0">Right-click a card to send it to a chat as a .tgw file. tele with HTML bubbles on shows it as a card, other apps as a file.</p>
+</div>)html";
+
+const char kCounter[] = R"html(<div class="widget">
+<style>
+.counter { width: 250px; }
+.counter .value { height: 60px; line-height: 60px; text-align: center; font-weight: 700; }
+.counter .buttons { text-align: center; }
+.counter button { width: 60px; margin: 0 3px; }
+</style>
+<div class="counter">
+  <div class="caps">Counter</div>
+  <div class="value" style="font-size: 40px">0</div>
+  <p class="small muted center">The buttons need the script.</p>
+</div>
+<script>
+let count = 0;
+const shown = { value: 0, size: 1 };
+
+function onAction(name) {
+  if (name === 'reset') {
+    if (count === 0) return;
+    count = 0;
+    transition('pop');
+  } else {
+    count += (name === 'up') ? 1 : -1;
+  }
+  console.log('count is', count);
+  shown.size = 1.3;
+  tween(shown, { value: count }, 280, ease.outCubic);
+  tween(shown, { size: 1 }, 420, ease.outBack);
+}
+
+function render() {
+  const tone = count > 0 ? 't-green' : count < 0 ? 't-red' : '';
+  return `<div class="counter">
+    <div class="caps">Counter</div>
+    <div class="value ${tone}" style="font-size: ${Math.round(40 * shown.size)}px">${Math.round(shown.value)}</div>
+    <div class="buttons">
+      <button data-action="down">−</button>
+      <button data-action="reset">↺</button>
+      <button class="primary" data-action="up">+</button>
