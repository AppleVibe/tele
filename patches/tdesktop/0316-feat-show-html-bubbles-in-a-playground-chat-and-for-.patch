+bool IsTgwDocument(not_null<DocumentData*> document) {
+	return document->filename().endsWith(u".tgw"_q, Qt::CaseInsensitive)
+		&& (document->size > 0)
+		&& (document->size <= kMaxTgwSize);
+}
+
+std::unique_ptr<HistoryView::Media> CreateMedia(
+		not_null<HistoryView::Element*> view) {
+	const auto item = view->data();
+	if (item->isService()) {
+		return nullptr;
+	} else if (const auto media = item->media()) {
+		const auto document = media->document();
+		if (!document
+			|| media->webpage()
+			|| item->groupId()
+			|| !IsTgwDocument(document)) {
+			return nullptr;
+		}
+		Track(item);
+		return HtmlBubbles()
+			? std::make_unique<CardMedia>(view, document)
+			: nullptr;
+	} else if (!HtmlBubbles() || !IsPlaygroundPeer(item->history()->peer)) {
+		return nullptr;
+	}
+	const auto text = item->originalText().text;
+	if (text.trimmed().isEmpty()) {
+		return nullptr;
+	}
+	return std::make_unique<CardMedia>(view, ResolveCard(item, text));
+}
+
+std::shared_ptr<Card> ResolveCard(
+		not_null<HistoryItem*> item,
+		const QString &source) {
+	const auto session = &item->history()->session();
+	Watch(session);
+	const auto key = CardKey{ session, item->fullId() };
+	auto &entry = Cards[key];
+	if (!entry.card || entry.card->source() != source) {
+		entry.card = std::make_shared<Card>(source);
+	}
+	return entry.card;
+}
+
+std::shared_ptr<Card> FindCard(not_null<HistoryItem*> item) {
+	const auto session = &item->history()->session();
+	const auto i = Cards.find(CardKey{ session, item->fullId() });
+	return (i != end(Cards)) ? i->second.card : nullptr;
+}
+
+void ClearCards() {
+	Cards.clear();
+}
+
+void RefreshViews() {
+	for (const auto &[session, ids] : Tracked) {
+		for (const auto &id : ids) {
+			if (const auto item = session->data().message(id)) {
+				session->data().requestItemViewRefresh(item);
+			}
+		}
+	}
+}
+
+void AppendMenuActions(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<HistoryItem*> item) {
+	if (!HtmlBubbles()) {
+		return;
+	}
+	const auto session = &item->history()->session();
+	if (IsPlaygroundPeer(item->history()->peer)
+		&& !item->isService()
+		&& !item->originalText().text.trimmed().isEmpty()) {
+		const auto source = item->originalText().text;
+		menu->addAction(Lower(u"Send as .tgw to…"_q), [=] {
+			if (const auto controller = ControllerFor(session)) {
+				SendAsTgw(controller, source);
+			}
+		}, &st::menuIconForward);
+	}
+	const auto card = FindCard(item);
+	if (card && !card->parsed().scripts.empty()) {
+		const auto weak = std::weak_ptr<Card>(card);
+		menu->addAction(Lower(u"Script log"_q), [=] {
+			show->showBox(Box(ScriptLogBox, weak));
+		}, &st::menuIconInfo);
+	}
+}
