+  <div class="option">Pizza by the river</div>
+  <div class="option">Cook at home</div>
+</div>
+<script>
+const OPTIONS = ['Ramen place', 'Pizza by the river', 'Cook at home'];
+const votes = [4, 6, 2];
+let mine = -1;
+const shares = { 0: 0, 1: 0, 2: 0 };
+
+function onAction(name, value) {
+  if (name === 'vote') {
+    mine = Number(value);
+    votes[mine] += 1;
+    transition('slide-left');
+    const total = votes.reduce((a, b) => a + b, 0);
+    setTimeout(() => tween(shares, Object.fromEntries(votes.map((v, i) => [i, v / total])), 600, ease.outCubic), 120);
+  } else if (name === 'back') {
+    votes[mine] -= 1;
+    mine = -1;
+    Object.keys(shares).forEach(k => shares[k] = 0);
+    transition('slide-right');
+  }
+}
+
+function render() {
+  const head = `<div class="caps">Quick vote</div><p style="margin: 6px 0 0 0"><b>Where do we eat on Friday?</b></p>`;
