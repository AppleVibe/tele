+    <div class="bar" style="height: 64px"></div>
+    <div class="bar" style="height: 30px"></div>
+    <div class="bar" style="height: 48px"></div>
+  </div>
+  <div class="days small muted"><div class="day">Mo</div><div class="day">Tu</div><div class="day">We</div><div class="day">Th</div><div class="day">Fr</div><div class="day">Sa</div><div class="day">Su</div></div>
+</div>
+<script>
+const DAYS = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
+const DATA = {
+  'this week': [36, 64, 49, 98, 57, 27, 43],
+  'last week': [52, 41, 70, 45, 88, 61, 22],
+};
+let range = 'this week';
+let picked = -1;
+const heights = {};
+DAYS.forEach((_, i) => heights[i] = 0);
+
+function grow() {
+  const max = Math.max(...DATA[range]);
+  const target = {};
+  DATA[range].forEach((v, i) => target[i] = Math.round(v / max * 110));
+  tween(heights, target, 520, ease.outCubic);
+}
+
+function onAction(name, value) {
+  if (name === 'range' && value !== range) {
+    range = value;
+    picked = -1;
+    grow();
+  } else if (name === 'pick') {
+    picked = (picked === Number(value)) ? -1 : Number(value);
+  }
+}
+
+function render() {
+  const values = DATA[range];
+  const best = values.indexOf(Math.max(...values));
+  const seg = Object.keys(DATA).map(k => `<span class="seg ${k === range ? 'on' : ''}" data-action="range" data-value="${k}">${k}</span>`).join('');
+  const bars = DAYS.map((d, i) => {
+    const kind = i === picked ? 'picked' : i === best ? 'best' : '';
+    return `<div class="bar ${kind}" data-action="pick" data-value="${i}" style="height: ${Math.max(2, heights[i]).toFixed(1)}px"></div>`;
+  }).join('');
+  const note = picked >= 0
+    ? `${DAYS[picked]}: <b>${values[picked]}</b> messages`
+    : `Busiest day: <b>${DAYS[best]}</b>`;
+  return `<div class="chart">
+    <div class="row between"><b>Messages a day</b><span>${seg}</span></div>
+    <div class="bars">${bars}</div>
+    <div class="days small muted">${DAYS.map(d => `<div class="day">${d}</div>`).join('')}</div>
+    <div class="note small">${note}</div>
+  </div>`;
+}
+
+grow();
+</script>
