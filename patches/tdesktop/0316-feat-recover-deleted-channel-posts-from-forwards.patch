+[[nodiscard]] std::optional<RecoveredSource> ReadRecovered(
+		QDataStream &stream) {
+	if (stream.atEnd()) {
+		return std::nullopt;
+	}
+	auto tag = quint32();
+	stream >> tag;
+	if (stream.status() != QDataStream::Ok || tag != kRecoveredTag) {
+		return std::nullopt;
+	}
+	auto peer = quint64();
+	auto msg = qint64();
+	auto name = QString();
+	stream >> peer >> msg >> name;
+	if (stream.status() != QDataStream::Ok) {
+		return std::nullopt;
+	}
+	return RecoveredSource{
+		.peer = DeserializePeerId(peer),
+		.msgId = MsgId(msg),
+		.name = name,
+	};
+}
