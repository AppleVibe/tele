+constexpr auto kPendingTimeout = crl::time(120000);
+
+struct Pending {
+	uint64 session = 0;
+	FullMsgId forward;
+	PeerId channel = 0;
+	MsgId post = 0;
+	crl::time when = 0;
+};
+
+struct Recovered {
+	not_null<Main::Session*> session;
+	RecoveredSource source;
+};
+
+struct State {
+	Pending pending;
+	base::flat_map<not_null<const HistoryItem*>, Recovered> items;
+	base::flat_set<not_null<Main::Session*>> sessions;
+};
+
+[[nodiscard]] State &Get() {
+	static State state;
+	return state;
+}
+
+void Track(not_null<Main::Session*> session) {
+	if (!Get().sessions.emplace(session).second) {
+		return;
+	}
+	session->data().itemRemoved(
+	) | rpl::on_next([](not_null<const HistoryItem*> item) {
+		Get().items.remove(item);
+	}, session->lifetime());
+	session->lifetime().add([=] {
+		auto &state = Get();
+		state.sessions.remove(session);
+		for (auto i = begin(state.items); i != end(state.items);) {
+			if (i->second.session == session) {
+				i = state.items.erase(i);
+			} else {
+				++i;
+			}
+		}
+	});
+}
+
+[[nodiscard]] const HistoryMessageForwarded *PostForward(
+		not_null<const HistoryItem*> item,
+		not_null<PeerData*> channel) {
+	const auto forwarded = item->Get<HistoryMessageForwarded>();
+	return (forwarded
+		&& forwarded->originalSender == channel.get()
+		&& !forwarded->story
+		&& IsServerMsgId(forwarded->originalId))
+		? forwarded
+		: nullptr;
+}
+
+[[nodiscard]] QString ChatName(not_null<PeerData*> peer) {
+	return peer->isSelf() ? tr::lng_saved_messages(tr::now) : peer->name();
+}
+
+[[nodiscard]] not_null<HistoryItem*> MakePost(
+		not_null<History*> history,
+		not_null<HistoryItem*> forward,
+		not_null<const HistoryMessageForwarded*> forwarded,
+		uint64 groupedId) {
+	const auto media = forward->media();
+	auto text = forward->originalText();
+	if (text.text.isEmpty() && media) {
+		text = media->consumedMessageText();
+	}
+	auto flags = MessageFlags(MessageFlag::Post);
+	if (forward->invertMedia()) {
+		flags |= MessageFlag::InvertMedia;
+	}
+	if (!forwarded->originalPostAuthor.isEmpty()) {
+		flags |= MessageFlag::HasPostAuthor;
+	}
+	const auto via = forward->viaBot();
+	const auto result = history->makeMessage({
+		.id = forwarded->originalId,
+		.flags = flags,
+		.from = history->peer->id,
+		.date = (forwarded->originalDate
+			? forwarded->originalDate
+			: forward->date()),
+		.viaBotId = via ? peerToUser(via->id) : UserId(),
+		.postAuthor = forwarded->originalPostAuthor,
+		.groupedId = groupedId,
+	}, TextWithEntities(), MTP_messageMediaEmpty());
+	if (media) {
+		result->overrideMedia(media->clone(result));
+		if (groupedId) {
+			history->owner().groups().refreshMessage(result);
+		}
+	}
+	if (const auto page = forward->richPage()) {
+		result->applyLocalRichPage(page);
+	} else {
+		result->setText(std::move(text));
+	}
+	return result;
+}
+
+[[nodiscard]] std::vector<not_null<HistoryItem*>> Recover(
+		not_null<History*> history,
+		not_null<HistoryItem*> forward) {
+	const auto channel = history->peer;
+	auto &owner = history->owner();
+	auto members = std::vector<not_null<HistoryItem*>>();
+	if (const auto group = owner.groups().find(forward)) {
+		members = group->items;
+	}
+	if (!ranges::contains(members, forward)) {
+		members = { forward };
+	}
+	auto missing = std::vector<not_null<HistoryItem*>>();
+	for (const auto &member : members) {
+		const auto forwarded = PostForward(member, channel);
+		if (forwarded && !owner.message(channel, forwarded->originalId)) {
+			missing.push_back(member);
+		}
+	}
+	const auto groupedId = (members.size() > 1
+		&& missing.size() == members.size())
+		? forward->groupId().raw()
+		: uint64();
+	const auto source = RecoveredSource{
+		.peer = forward->history()->peer->id,
+		.msgId = forward->id,
+		.name = ChatName(forward->history()->peer),
+	};
+	Track(&history->session());
+	auto result = std::vector<not_null<HistoryItem*>>();
+	for (const auto &member : missing) {
+		const auto forwarded = PostForward(member, channel);
+		const auto item = MakePost(history, member, forwarded, groupedId);
+		SetRecoveredFrom(item, source);
+		result.push_back(item);
+	}
+	auto rejected = result;
+	KeepRecovered(rejected);
+	for (const auto &item : rejected) {
+		result.erase(ranges::remove(result, item), end(result));
+		item->destroy();
+	}
+	return result;
+}
+
+void ShowRecovered(
+		not_null<Window::SessionController*> controller,
+		std::vector<FullMsgId> ids,
+		FullMsgId target) {
+	const auto sessionId = controller->session().uniqueId();
+	crl::on_main(controller, [=] {
+		auto &session = controller->session();
+		if (session.uniqueId() != sessionId) {
+			return;
+		}
+		auto &owner = session.data();
+		for (const auto &id : ids) {
+			if (const auto item = owner.message(id)) {
+				ReinsertDeleted(item);
+			}
+		}
+		owner.sendHistoryChangeNotifications();
+		if (const auto item = owner.message(target)) {
+			auto params = Window::SectionShow(
+				Window::SectionShow::Way::Forward);
+			params.allowDuplicateInStack = true;
+			controller->showMessage(item, params);
+		}
+	});
+}
+
+} // namespace
+
+ClickHandlerPtr ForwardOriginalLink(
+		not_null<const HistoryItem*> item,
+		ClickHandlerPtr jump) {
+	const auto weak = base::make_weak(&item->history()->session());
+	const auto id = item->fullId();
+	return std::make_shared<LambdaClickHandler>([=](ClickContext context) {
+		if (const auto session = weak.get()) {
+			if (const auto forward = session->data().message(id)) {
+				const auto forwarded = forward->Get<HistoryMessageForwarded>();
+				if (forwarded && forwarded->originalSender) {
+					NoteForwardJump(
+						forward,
+						forwarded->originalSender,
+						forwarded->originalId);
+				}
+			}
+		}
+		jump->onClick(context);
+	});
+}
+
+void NoteForwardJump(
+		not_null<const HistoryItem*> forward,
+		not_null<PeerData*> peer,
+		MsgId msgId) {
+	auto &pending = Get().pending;
+	const auto forwarded = PostForward(forward, peer);
+	if (!RecoverForwarded()
+		|| !peer->isBroadcast()
+		|| !forwarded
+		|| forwarded->originalId != msgId) {
+		pending = Pending();
+		return;
+	}
+	pending = Pending{
+		.session = forward->history()->session().uniqueId(),
+		.forward = forward->fullId(),
+		.channel = peer->id,
+		.post = msgId,
+		.when = crl::now(),
+	};
+}
+
+bool RecoverForwardedPost(
+		not_null<Window::SessionController*> controller,
+		not_null<History*> history,
+		MsgId msgId) {
+	auto &pending = Get().pending;
+	if (!pending.post
+		|| pending.post != msgId
+		|| pending.channel != history->peer->id
+		|| pending.session != history->session().uniqueId()) {
+		return false;
+	}
+	const auto data = base::take(pending);
+	const auto channel = history->peer->asBroadcast();
+	if (!RecoverForwarded()
+		|| (crl::now() - data.when > kPendingTimeout)
+		|| !channel
+		|| channel->isForbidden()
+		|| (&controller->session() != &history->session())) {
+		return false;
+	}
+	auto &owner = history->owner();
+	const auto forward = owner.message(data.forward);
+	if (!forward || !PostForward(forward, channel)) {
+		return false;
+	}
+	const auto target = FullMsgId(channel->id, msgId);
+	auto ids = std::vector<FullMsgId>();
+	if (const auto existing = owner.message(target)) {
+		if (!IsKeptDeleted(existing)) {
+			return false;
+		}
+		ids.push_back(target);
+	} else {
+		for (const auto &item : Recover(history, forward)) {
+			ids.push_back(item->fullId());
+		}
+		if (!ranges::contains(ids, target)) {
+			return false;
+		}
+		ranges::sort(ids);
+	}
+	ShowRecovered(controller, std::move(ids), target);
+	return true;
+}
+
+void DropRecovered(
+		not_null<History*> history,
+		MsgId msgId,
+		const MTPMessage &message) {
+	if (Get().items.empty() || message.type() != mtpc_message) {
+		return;
+	}
+	const auto item = history->owner().message(history->peer, msgId);
+	if (item && Get().items.contains(not_null<const HistoryItem*>(item))) {
+		item->destroy();
+	}
+}
+
+const RecoveredSource *RecoveredFrom(not_null<const HistoryItem*> item) {
+	const auto &items = Get().items;
+	if (items.empty()) {
+		return nullptr;
+	}
+	const auto i = items.find(item);
+	return (i != end(items)) ? &i->second.source : nullptr;
+}
+
+void SetRecoveredFrom(not_null<HistoryItem*> item, RecoveredSource source) {
+	const auto session = &item->history()->session();
+	Track(session);
+	Get().items.emplace_or_assign(item, Recovered{
+		.session = session,
+		.source = std::move(source),
+	});
+}
+
+QString RecoveredFromText(not_null<const HistoryItem*> item) {
+	const auto source = RecoveredFrom(item);
+	if (!source || !IsKeptDeleted(item)) {
+		return QString();
+	}
+	const auto peer = item->history()->owner().peerLoaded(source->peer);
+	const auto name = peer ? ChatName(peer) : source->name;
+	return name.isEmpty()
+		? Lower(u"Recovered from a forward"_q)
+		: Lower(u"Recovered from a forward in %1"_q).arg(name);
+}
+
+} // namespace Tele
