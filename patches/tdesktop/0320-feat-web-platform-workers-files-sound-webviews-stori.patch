+		}
+	}
+	const auto region = (parts.size() > 1 && parts[1].size() == 2)
+		? parts[1].toUpper()
+		: QString();
+	const auto system = QLocale::system();
+	if (LanguageCode(system) == language
+		&& (region.isEmpty() || RegionCode(system) == region)) {
+		return TagOf(system);
+	}
+	const auto locale = QLocale(region.isEmpty()
+		? language
+		: (language + '_' + region));
+	return (locale.language() == QLocale::C
+		|| LanguageCode(locale) != language)
+		? QString()
+		: TagOf(locale);
+}
+
+[[nodiscard]] QString ComputeDefaultLocale() {
+	const auto &instance = Lang::GetInstance();
+	const auto ids = {
+		Lang::LanguageIdOrDefault(Lang::Id()),
+		instance.baseId(),
+	};
+	for (const auto &id : ids) {
+		if (!id.isEmpty()) {
+			if (const auto result = LocaleFromLanguageId(id)
+				; !result.isEmpty()) {
+				return result;
+			}
+		}
+	}
+	return SystemLocale();
+}
+
+[[nodiscard]] QString DefaultLocale() {
+	static auto mutex = std::mutex();
+	static auto cached = QString();
+	const auto app = QCoreApplication::instance();
+	if (app && QThread::currentThread() == app->thread()) {
+		const auto result = ComputeDefaultLocale();
+		const auto lock = std::lock_guard<std::mutex>(mutex);
+		cached = result;
+		return result;
+	}
+	const auto lock = std::lock_guard<std::mutex>(mutex);
+	return cached.isEmpty() ? SystemLocale() : cached;
+}
+
+void SetString(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name,
+		const QString &value) {
+	JS_SetPropertyStr(ctx, object, name, NewString(ctx, value));
+}
+
+[[nodiscard]] JSValue Strings(JSContext *ctx, const QStringList &list) {
+	auto result = JS_NewArray(ctx);
+	for (auto i = 0; i != int(list.size()); ++i) {
+		JS_SetPropertyUint32(ctx, result, uint32_t(i), NewString(ctx, list[i]));
+	}
+	return result;
+}
+
+[[nodiscard]] JSValue Affixes(
+		JSContext *ctx,
+		const QString &pattern,
+		const QString &number) {
+	const auto index = pattern.indexOf(number);
+	auto result = JS_NewArray(ctx);
+	JS_SetPropertyUint32(
+		ctx,
+		result,
+		0,
+		NewString(ctx, (index < 0) ? QString() : pattern.left(index)));
+	JS_SetPropertyUint32(
+		ctx,
+		result,
+		1,
+		NewString(
+			ctx,
+			(index < 0) ? QString() : pattern.mid(index + number.size())));
+	return result;
+}
+
+[[nodiscard]] JSValue Names(
+		JSContext *ctx,
+		const QLocale &locale,
+		bool months,
+		bool standalone) {
+	auto result = JS_NewObject(ctx);
+	const auto fill = [&](const char *key, QLocale::FormatType type) {
+		auto list = QStringList();
+		if (months) {
+			for (auto month = 1; month <= 12; ++month) {
+				list.push_back(standalone
+					? locale.standaloneMonthName(month, type)
+					: locale.monthName(month, type));
+			}
+		} else {
+			for (auto index = 0; index != 7; ++index) {
+				const auto day = index ? index : 7;
+				list.push_back(standalone
+					? locale.standaloneDayName(day, type)
+					: locale.dayName(day, type));
+			}
+		}
+		JS_SetPropertyStr(ctx, result, key, Strings(ctx, list));
+	};
+	fill("long", QLocale::LongFormat);
+	fill("short", QLocale::ShortFormat);
+	fill("narrow", QLocale::NarrowFormat);
+	return result;
+}
+
+[[nodiscard]] JSValue LocaleData(JSContext *ctx, const QLocale &locale) {
+	auto result = JS_NewObject(ctx);
+	SetString(ctx, result, "tag", TagOf(locale));
+	SetString(ctx, result, "language", LanguageCode(locale));
+	SetString(ctx, result, "region", RegionCode(locale));
+	SetString(ctx, result, "decimal", Text(locale.decimalPoint()));
+	SetString(ctx, result, "group", Text(locale.groupSeparator()));
+	SetString(ctx, result, "percent", Text(locale.percent()));
+	SetString(ctx, result, "minus", Text(locale.negativeSign()));
+	SetString(ctx, result, "plus", Text(locale.positiveSign()));
+	SetString(ctx, result, "zero", Text(locale.zeroDigit()));
+
+	const auto group = Text(locale.groupSeparator());
+	const auto sample = locale.toString(qlonglong(1234567890));
+	const auto groups = group.isEmpty()
+		? QStringList(sample)
+		: sample.split(group);
+	const auto primary = (groups.size() > 1)
+		? int(groups.back().size())
+		: 3;
+	const auto secondary = (groups.size() > 2)
+		? int(groups[groups.size() - 2].size())
+		: primary;
+	JS_SetPropertyStr(ctx, result, "primaryGroup", JS_NewInt32(ctx, primary));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"secondaryGroup",
+		JS_NewInt32(ctx, secondary));
+
+	const auto seven = locale.toString(7);
+	const auto marker = QString(QChar(0x00A4));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"currencyPattern",
+		Affixes(ctx, locale.toCurrencyString(7., marker, 0), seven));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"accountingPattern",
+		Affixes(ctx, locale.toCurrencyString(-7., marker, 0), seven));
+	SetString(
+		ctx,
+		result,
+		"currency",
+		locale.currencySymbol(QLocale::CurrencyIsoCode));
+
+	JS_SetPropertyStr(ctx, result, "months", Names(ctx, locale, true, false));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"standaloneMonths",
+		Names(ctx, locale, true, true));
+	JS_SetPropertyStr(ctx, result, "days", Names(ctx, locale, false, false));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"standaloneDays",
+		Names(ctx, locale, false, true));
+	SetString(ctx, result, "am", locale.amText());
+	SetString(ctx, result, "pm", locale.pmText());
+	SetString(ctx, result, "dateLong", locale.dateFormat(QLocale::LongFormat));
+	SetString(
+		ctx,
+		result,
+		"dateShort",
+		locale.dateFormat(QLocale::ShortFormat));
+	SetString(ctx, result, "timeLong", locale.timeFormat(QLocale::LongFormat));
+	SetString(
+		ctx,
+		result,
+		"timeShort",
+		locale.timeFormat(QLocale::ShortFormat));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"rtl",
+		JS_NewBool(ctx, locale.textDirection() == Qt::RightToLeft));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"firstDay",
+		JS_NewInt32(ctx, int(locale.firstDayOfWeek()) % 7));
+	return result;
+}
+
+[[nodiscard]] std::optional<CurrencyNames> FindCurrency(
+		const QList<QLocale> &list,
+		const QString &code) {
+	for (const auto &locale : list) {
+		if (locale.currencySymbol(QLocale::CurrencyIsoCode) == code) {
+			return CurrencyNames{
+				locale.currencySymbol(QLocale::CurrencySymbol),
+				locale.currencySymbol(QLocale::CurrencyDisplayName),
+			};
+		}
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] QString AnyCurrencySymbol(const QString &code) {
+	thread_local auto cache = std::map<QString, QString>();
+	if (const auto i = cache.find(code); i != end(cache)) {
+		return i->second;
+	}
+	auto result = QString();
+	const auto home = code.left(2);
+	const auto all = QLocale::matchingLocales(
+		QLocale::AnyLanguage,
+		QLocale::AnyScript,
+		kAnyTerritory);
+	for (const auto &locale : all) {
+		if (locale.currencySymbol(QLocale::CurrencyIsoCode) != code) {
+			continue;
+		} else if (result.isEmpty()) {
+			result = locale.currencySymbol(QLocale::CurrencySymbol);
+		}
+		if (RegionCode(locale) == home) {
+			result = locale.currencySymbol(QLocale::CurrencySymbol);
+			break;
+		}
+	}
+	cache.emplace(code, result);
+	return result;
+}
+
+[[nodiscard]] JSValue CurrencyData(
+		JSContext *ctx,
+		const QString &tag,
+		const QString &code) {
+	auto result = JS_NewObject(ctx);
+	const auto locale = LocaleFromTag(tag);
+	const auto own = locale
+		&& (locale->currencySymbol(QLocale::CurrencyIsoCode) == code);
+	const auto names = !locale
+		? std::optional<CurrencyNames>()
+		: own
+		? FindCurrency({ *locale }, code)
+		: FindCurrency(
+			QLocale::matchingLocales(
+				locale->language(),
+				QLocale::AnyScript,
+				kAnyTerritory),
+			code);
+	JS_SetPropertyStr(ctx, result, "own", JS_NewBool(ctx, own));
+	SetString(ctx, result, "symbol", names ? names->symbol : QString());
+	SetString(ctx, result, "name", names ? names->name : QString());
+	SetString(ctx, result, "any", AnyCurrencySymbol(code));
+	return result;
+}
+
+[[nodiscard]] int Compare(
+		const QString &tag,
+		const QString &a,
+		const QString &b,
+		int flags) {
+	thread_local auto collators = std::map<QString, QCollator>();
+	const auto key = tag + '/' + QString::number(flags);
+	auto i = collators.find(key);
+	if (i == end(collators)) {
+		if (int(collators.size()) >= kCachedCollators) {
+			collators.clear();
+		}
+		auto collator = QCollator(LocaleFromTag(tag).value_or(QLocale()));
+		collator.setCaseSensitivity((flags & kCaseInsensitive)
+			? Qt::CaseInsensitive
+			: Qt::CaseSensitive);
+		collator.setIgnorePunctuation((flags & kIgnorePunctuation) != 0);
+		collator.setNumericMode((flags & kNumeric) != 0);
+		i = collators.emplace(key, std::move(collator)).first;
+	}
+	return i->second.compare(a, b);
+}
+
+[[nodiscard]] QString ZoneName(
+		qint64 ms,
+		const QString &tag,
+		bool utc,
+		bool full) {
+	const auto zone = utc ? QTimeZone::utc() : QTimeZone::systemTimeZone();
+	const auto when = QDateTime::fromMSecsSinceEpoch(ms, zone);
+	return full
+		? zone.displayName(
+			when,
+			QTimeZone::LongName,
+			LocaleFromTag(tag).value_or(QLocale()))
+		: zone.abbreviation(when);
+}
+
+JSValue NativeIntl(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto argument = [&](int index) {
+		return (index < argc) ? argv[index] : JS_UNDEFINED;
+	};
+	const auto text = [&](int index) {
+		return FromStd(ToStd(ctx, argument(index)));
+	};
+	switch (IntlCall(magic)) {
+	case IntlCall::Defaults: {
+		auto result = JS_NewObject(ctx);
+		SetString(ctx, result, "locale", DefaultLocale());
+		const auto zone = QString::fromUtf8(QTimeZone::systemTimeZoneId());
+		SetString(ctx, result, "timeZone", zone.isEmpty() ? u"UTC"_q : zone);
+		return result;
+	}
+	case IntlCall::Locale: {
+		const auto locale = LocaleFromTag(text(0));
+		return locale ? LocaleData(ctx, *locale) : JS_NULL;
+	}
+	case IntlCall::Currency:
+		return CurrencyData(ctx, text(0), text(1).toUpper());
+	case IntlCall::Compare: {
+		auto flags = int32_t();
+		if (JS_ToInt32(ctx, &flags, argument(3))) {
+			return JS_EXCEPTION;
+		}
+		return JS_NewInt32(ctx, Compare(text(0), text(1), text(2), flags));
+	}
+	case IntlCall::ZoneName: {
+		auto ms = 0.;
+		if (JS_ToFloat64(ctx, &ms, argument(0))) {
+			return JS_EXCEPTION;
+		}
+		return NewString(
+			ctx,
+			ZoneName(
+				qint64(ms),
+				text(1),
+				JS_ToBool(ctx, argument(2)) > 0,
+				JS_ToBool(ctx, argument(3)) > 0));
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+} // namespace
+
+void AddIntlNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "intlDefaults", NativeIntl, 0, int(IntlCall::Defaults) },
+		{ "intlLocale", NativeIntl, 1, int(IntlCall::Locale) },
+		{ "intlCurrency", NativeIntl, 2, int(IntlCall::Currency) },
+		{ "intlCompare", NativeIntl, 4, int(IntlCall::Compare) },
+		{ "intlZoneName", NativeIntl, 4, int(IntlCall::ZoneName) },
+	});
+}
+
+std::string_view IntlTypings() {
+	return std::string_view();
+}
