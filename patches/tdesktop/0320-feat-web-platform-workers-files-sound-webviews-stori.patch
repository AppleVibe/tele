+void SetupDialogs(DialogsDescriptor &&descriptor) {
+	const auto widget = descriptor.widget;
+	widget->lifetime().make_state<Host>(std::move(descriptor));
+}
+
+void DialogsSearchChanged(
+		not_null<QWidget*> widget,
+		const QString &query,
+		PeerData *inChat) {
+	if (const auto host = LookupHost(widget)) {
+		host->searchChanged(query, inChat);
+	}
+}
+
+void InterceptDialogsSearch(
+		not_null<Main::Session*> session,
+		const QString &query,
+		PeerData *inChat,
+		std::vector<not_null<HistoryItem*>> items,
+		HistoryItem *inject,
+		Fn<void(std::vector<not_null<HistoryItem*>>, HistoryItem*)> done) {
+	auto interceptors = std::vector<int>();
+	for (const auto &[id, entry] : State().entries) {
+		if (entry.kind == Kind::Interceptor && entry.session == session) {
+			interceptors.push_back(id);
+		}
+	}
+	if (interceptors.empty() || items.empty()) {
+		done(std::move(items), inject);
+		return;
+	}
+	auto ids = std::vector<FullMsgId>();
+	ids.reserve(items.size());
+	for (const auto &item : items) {
+		ids.push_back(item->fullId());
+	}
+	auto chain = std::make_shared<Chain>(Chain{
+		.session = base::make_weak(session),
+		.query = query,
+		.chatId = inChat
+			? std::make_optional(MarkedId(inChat->id))
+			: std::nullopt,
+		.ids = std::move(ids),
+		.inject = inject ? inject->fullId() : FullMsgId(),
+		.interceptors = std::move(interceptors),
+		.done = std::move(done),
+	});
+	crl::on_main([=] { Step(chain); });
+}
