+bool ChatBanners::refresh() {
+	auto ids = std::vector<int>();
+	for (const auto &banner : Banners()) {
+		if (banner.session == _session && banner.peer == _peer) {
+			ids.push_back(banner.id);
+		}
+	}
+	if (ids == _ids) {
+		return false;
+	}
+	_ids = std::move(ids);
+	_bars.clear();
+	for (const auto &banner : Banners()) {
+		if (banner.session == _session && banner.peer == _peer) {
+			_bars.push_back(base::make_unique_q<BannerBar>(this, banner));
+			_bars.back()->show();
+		}
+	}
+	return true;
+}
