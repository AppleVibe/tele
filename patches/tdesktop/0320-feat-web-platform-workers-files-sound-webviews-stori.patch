+	} else if (!JS_IsString(value)) {
+		return std::nullopt;
+	}
+	const auto name = ToStd(ctx, value);
+	if (name == "default") {
+		return DecorationButtonStyle::Default;
+	} else if (name == "primary") {
+		return DecorationButtonStyle::Primary;
+	} else if (name == "danger") {
+		return DecorationButtonStyle::Danger;
