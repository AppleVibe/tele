+namespace {
+
+constexpr auto kMaxArea = qint64(100'000'000);
+constexpr auto kMaxOutput = qint64(256 * 1024 * 1024);
+constexpr auto kChunk = 256 * 1024;
+
+constexpr auto kGzip = 0;
+constexpr auto kRaw = 2;
+
+constexpr auto kPackNames = std::array{
+	"compression.gzip",
+	"compression.deflate",
+	"compression.deflateRaw",
+};
+constexpr auto kUnpackNames = std::array{
+	"compression.gunzip",
+	"compression.inflate",
+	"compression.inflateRaw",
+};
+constexpr auto kFormatNames = std::array{ "gzip", "zlib", "raw deflate" };
+constexpr auto kOpNames = std::array{
+	"tg.image.resize",
+	"tg.image.crop",
+	"tg.image.rotate",
+	"tg.image.convert",
+};
+
+enum Magic {
+	kCompress,
+	kDecompress,
+	kInfo,
+	kTransform,
+	kToPixels,
+	kFromPixels,
+};
+
+enum class Op {
+	Resize,
+	Crop,
+	Rotate,
+	Convert,
+};
+
+enum class Fit {
+	Contain,
+	Cover,
+	Fill,
+	Inside,
+	Outside,
+};
+
+struct Transform {
+	Op op = Op::Convert;
+	int width = 0;
+	int height = 0;
+	Fit fit = Fit::Cover;
+	QRect area;
+	int degrees = 0;
+	QByteArray format;
+	int quality = -1;
+	std::optional<QColor> background;
+};
+
+struct Outcome {
+	QByteArray bytes;
+	QByteArray format;
+	int width = 0;
+	int height = 0;
+	int frames = 0;
+	bool animated = false;
+	const char *code = nullptr;
+	QString error;
+	bool typeError = false;
+};
+
+struct ImageRead {
+	QImage image;
+	QByteArray format;
+	const char *code = nullptr;
+	QString error;
+};
+
+struct Sizes {
+	QSize scaled;
+	QSize box;
+};
+
+using Maker = JSValue (*)(JSContext*, const Outcome&);
+
+[[nodiscard]] Outcome Failure(const char *code, const QString &error) {
+	auto result = Outcome();
+	result.code = code;
+	result.error = error;
+	return result;
+}
+
+[[nodiscard]] Outcome TypeFailure(const QString &error) {
+	auto result = Outcome();
+	result.error = error;
+	result.typeError = true;
+	return result;
+}
+
+[[nodiscard]] int WindowBits(int kind) {
+	return (kind == kGzip)
+		? (MAX_WBITS + 16)
+		: (kind == kRaw)
+		? -MAX_WBITS
+		: MAX_WBITS;
+}
+
+[[nodiscard]] Outcome Compress(
+		int kind,
+		const QByteArray &bytes,
+		int level,
+		const char *name) {
+	const auto what = QString::fromLatin1(name);
+	auto stream = z_stream();
+	if (deflateInit2(
+			&stream,
+			level,
+			Z_DEFLATED,
+			WindowBits(kind),
+			8,
+			Z_DEFAULT_STRATEGY) != Z_OK) {
+		return Failure("internal", what + u": zlib couldn't start"_q);
+	}
+	auto result = QByteArray(
+		int(deflateBound(&stream, uLong(bytes.size()))),
+		Qt::Uninitialized);
+	stream.next_in = reinterpret_cast<Bytef*>(
+		const_cast<char*>(bytes.constData()));
+	stream.avail_in = uInt(bytes.size());
+	stream.next_out = reinterpret_cast<Bytef*>(result.data());
+	stream.avail_out = uInt(result.size());
+	const auto status = deflate(&stream, Z_FINISH);
+	const auto total = stream.total_out;
+	deflateEnd(&stream);
+	if (status != Z_STREAM_END) {
+		return Failure("internal", what + u": zlib couldn't compress"_q);
+	}
+	result.resize(int(total));
+	auto outcome = Outcome();
+	outcome.bytes = std::move(result);
+	return outcome;
+}
+
+[[nodiscard]] Outcome Decompress(
+		int kind,
+		const QByteArray &bytes,
+		qint64 maxSize,
+		const char *name) {
+	const auto what = QString::fromLatin1(name);
+	const auto invalid = what
+		+ u": the data isn't valid %1"_q.arg(
+			QString::fromLatin1(kFormatNames[kind]));
+	auto stream = z_stream();
+	if (inflateInit2(&stream, WindowBits(kind)) != Z_OK) {
+		return Failure("internal", what + u": zlib couldn't start"_q);
+	}
+	stream.next_in = reinterpret_cast<Bytef*>(
+		const_cast<char*>(bytes.constData()));
+	stream.avail_in = uInt(bytes.size());
+	auto result = QByteArray();
+	auto chunk = QByteArray(kChunk, Qt::Uninitialized);
+	auto failure = std::optional<Outcome>();
+	while (!failure) {
+		stream.next_out = reinterpret_cast<Bytef*>(chunk.data());
+		stream.avail_out = uInt(kChunk);
+		const auto status = inflate(&stream, Z_NO_FLUSH);
+		const auto produced = kChunk - int(stream.avail_out);
+		if (qint64(result.size()) + produced > maxSize) {
+			failure = Failure(
+				"quota-exceeded",
+				what + u": the output is over maxSize (%1 bytes)"_q.arg(
+					maxSize));
+			break;
+		}
+		result.append(chunk.constData(), produced);
+		if (status == Z_STREAM_END) {
+			if (!stream.avail_in) {
+				break;
+			}
+			const auto next = stream.next_in;
+			const auto member = (kind == kGzip)
+				&& (stream.avail_in >= 2)
+				&& (next[0] == 0x1F)
+				&& (next[1] == 0x8B);
+			if (!member) {
+				failure = Failure(
+					"unsupported",
+					what + u": unexpected bytes after the end of the data"_q);
+			} else if (inflateReset(&stream) != Z_OK) {
+				failure = Failure("internal", what + u": zlib failed"_q);
+			}
+		} else if (status == Z_BUF_ERROR) {
+			if (!stream.avail_in || !produced) {
+				failure = Failure(
+					"unsupported",
+					what + u": the data is truncated"_q);
+			}
+		} else if (status == Z_MEM_ERROR) {
+			failure = Failure("internal", what + u": out of memory"_q);
+		} else if (status != Z_OK) {
+			failure = Failure("unsupported", stream.msg
+				? (invalid + u" (%1)"_q.arg(QString::fromLatin1(stream.msg)))
+				: invalid);
+		}
+	}
+	inflateEnd(&stream);
+	if (failure) {
+		return *failure;
+	}
+	auto outcome = Outcome();
+	outcome.bytes = std::move(result);
+	return outcome;
+}
+
+[[nodiscard]] QByteArray Normalized(QByteArray format) {
+	format = format.toLower();
+	return (format == "jpg") ? QByteArray("jpeg") : format;
+}
+
+[[nodiscard]] bool Writable(const QByteArray &format) {
+	return QImageWriter::supportedImageFormats().contains(format);
+}
+
+[[nodiscard]] Outcome CantWrite(const QString &what, const QByteArray &format) {
+	return Failure(
+		"unsupported",
+		what + u": tele can't write %1 images here, pass another format"_q.arg(
+			QString::fromLatin1(format)));
+}
+
+[[nodiscard]] QString TooBig(const QString &what, QSize size) {
+	return what + u": %1x%2 is over 100 megapixels"_q.arg(
+		size.width()).arg(size.height());
+}
+
+[[nodiscard]] ImageRead Decode(const QByteArray &bytes, const QString &what) {
+	auto buffer = QBuffer();
+	buffer.setData(bytes);
+	buffer.open(QIODevice::ReadOnly);
+	auto reader = QImageReader(&buffer);
+	reader.setAutoTransform(true);
+	auto result = ImageRead();
+	if (!reader.canRead()) {
+		result.code = "unsupported";
+		result.error = what + u": these bytes aren't an image tele can read"_q;
+		return result;
+	}
+	const auto size = reader.size();
+	if (size.isValid() && qint64(size.width()) * size.height() > kMaxArea) {
+		result.code = "quota-exceeded";
+		result.error = TooBig(what, size);
+		return result;
+	}
+	result.format = Normalized(reader.format());
+	if (!reader.read(&result.image) || result.image.isNull()) {
+		result.image = QImage();
+		result.code = "unsupported";
+		result.error = what + u": can't decode the image (%1)"_q.arg(
+			reader.errorString());
+		return result;
+	}
+	const auto decoded = result.image.size();
+	if (qint64(decoded.width()) * decoded.height() > kMaxArea) {
+		result.image = QImage();
+		result.code = "quota-exceeded";
+		result.error = TooBig(what, decoded);
+	}
+	return result;
+}
+
+[[nodiscard]] QImage Flatten(
+		const QImage &image,
+		const std::optional<QColor> &background) {
+	auto result = QImage(image.size(), QImage::Format_RGB32);
+	result.fill(Qt::white);
+	auto p = QPainter(&result);
+	if (background) {
+		p.fillRect(result.rect(), *background);
+	}
+	p.drawImage(0, 0, image);
+	p.end();
+	return result;
+}
+
+[[nodiscard]] Outcome Encode(
+		QImage image,
+		const QByteArray &format,
+		int quality,
+		const std::optional<QColor> &background,
+		const QString &what) {
+	if (!Writable(format)) {
+		return CantWrite(what, format);
+	}
+	if ((format == "jpeg" || format == "bmp") && image.hasAlphaChannel()) {
+		image = Flatten(image, background);
+	}
+	auto result = QByteArray();
+	auto buffer = QBuffer(&result);
+	buffer.open(QIODevice::WriteOnly);
+	auto writer = QImageWriter(&buffer, format);
+	if (quality >= 0) {
+		writer.setQuality(quality);
+	}
+	if (!writer.write(image)) {
+		return Failure(
+			"internal",
+			what + u": can't write the image (%1)"_q.arg(
+				writer.errorString()));
+	}
+	buffer.close();
+	auto outcome = Outcome();
+	outcome.bytes = result;
+	outcome.format = format;
+	outcome.width = image.width();
+	outcome.height = image.height();
+	return outcome;
+}
+
+[[nodiscard]] qint64 Dimension(double value) {
+	return (value >= double(kMaxArea))
+		? kMaxArea
+		: std::max(qint64(1), qRound64(value));
+}
+
+[[nodiscard]] std::optional<QSize> Checked(qint64 width, qint64 height) {
+	if (width < 1
+		|| height < 1
+		|| width > kMaxArea
+		|| height > kMaxArea
+		|| width * height > kMaxArea) {
+		return std::nullopt;
+	}
+	return QSize(int(width), int(height));
+}
+
+[[nodiscard]] std::optional<Sizes> ResizeSizes(
+		QSize source,
+		const Transform &transform) {
+	const auto sw = double(source.width());
+	const auto sh = double(source.height());
+	const auto w = qint64(transform.width);
+	const auto h = qint64(transform.height);
+	auto scaled = std::optional<QSize>();
+	auto box = std::optional<QSize>();
+	if (!w) {
+		scaled = box = Checked(Dimension(sw * h / sh), h);
+	} else if (!h) {
+		scaled = box = Checked(w, Dimension(sh * w / sw));
+	} else if (transform.fit == Fit::Fill) {
+		scaled = box = Checked(w, h);
+	} else {
+		const auto within = (transform.fit == Fit::Contain)
+			|| (transform.fit == Fit::Inside);
+		const auto ratio = within
+			? std::min(w / sw, h / sh)
+			: std::max(w / sw, h / sh);
+		scaled = Checked(Dimension(sw * ratio), Dimension(sh * ratio));
+		box = (transform.fit == Fit::Contain || transform.fit == Fit::Cover)
+			? Checked(w, h)
+			: scaled;
+	}
+	if (!scaled || !box) {
+		return std::nullopt;
+	}
+	return Sizes{ *scaled, *box };
+}
+
+[[nodiscard]] Outcome Apply(const QByteArray &bytes, const Transform &transform) {
+	const auto what = QString::fromLatin1(kOpNames[int(transform.op)]);
+	if (!transform.format.isEmpty() && !Writable(transform.format)) {
+		return CantWrite(what, transform.format);
+	}
+	auto decoded = Decode(bytes, what);
+	if (decoded.code) {
+		return Failure(decoded.code, decoded.error);
+	}
+	auto image = std::move(decoded.image);
+	auto background = transform.background;
+	switch (transform.op) {
+	case Op::Resize: {
+		const auto sizes = ResizeSizes(image.size(), transform);
+		if (!sizes) {
+			return Failure(
+				"quota-exceeded",
+				what + u": the result would be over 100 megapixels"_q);
+		}
+		auto scaled = image.scaled(
+			sizes->scaled,
+			Qt::IgnoreAspectRatio,
+			Qt::SmoothTransformation);
+		const auto offset = QPoint(
+			(sizes->box.width() - sizes->scaled.width()) / 2,
+			(sizes->box.height() - sizes->scaled.height()) / 2);
+		if (sizes->box == sizes->scaled) {
+			image = std::move(scaled);
+		} else if (transform.fit == Fit::Cover) {
+			image = scaled.copy(QRect(-offset, sizes->box));
+		} else {
+			auto canvas = QImage(
+				sizes->box,
+				QImage::Format_ARGB32_Premultiplied);
+			canvas.fill(background.value_or(QColor(0, 0, 0, 0)));
+			auto p = QPainter(&canvas);
+			p.drawImage(offset, scaled);
+			p.end();
+			image = std::move(canvas);
+			background = std::nullopt;
+		}
+	} break;
+	case Op::Crop:
+		if (!image.rect().contains(transform.area)) {
+			return TypeFailure(
+				what + u": the area %1,%2 %3x%4 is outside the %5x%6 image"_q
+					.arg(transform.area.x())
+					.arg(transform.area.y())
+					.arg(transform.area.width())
+					.arg(transform.area.height())
+					.arg(image.width())
+					.arg(image.height()));
+		}
+		image = image.copy(transform.area);
+		break;
+	case Op::Rotate:
+		image = image.transformed(QTransform().rotate(transform.degrees));
+		break;
+	case Op::Convert:
+		break;
+	}
+	return Encode(
+		std::move(image),
+		transform.format.isEmpty() ? decoded.format : transform.format,
+		transform.quality,
+		background,
+		what);
+}
+
+[[nodiscard]] Outcome Info(const QByteArray &bytes) {
+	const auto what = u"tg.image.info"_q;
+	auto buffer = QBuffer();
+	buffer.setData(bytes);
+	buffer.open(QIODevice::ReadOnly);
+	auto reader = QImageReader(&buffer);
+	reader.setAutoTransform(true);
+	if (!reader.canRead()) {
+		return Failure(
+			"unsupported",
+			what + u": these bytes aren't an image tele can read"_q);
+	}
+	auto result = Outcome();
+	result.format = Normalized(reader.format());
+	auto size = reader.size();
+	if (size.isValid()) {
+		if (reader.transformation().testFlag(
+				QImageIOHandler::TransformationRotate90)) {
+			size.transpose();
+		}
+	} else {
+		auto image = QImage();
+		if (!reader.read(&image) || image.isNull()) {
+			return Failure(
+				"unsupported",
+				what + u": can't decode the image (%1)"_q.arg(
+					reader.errorString()));
+		}
+		size = image.size();
+	}
+	result.width = size.width();
+	result.height = size.height();
+	result.frames = std::max(reader.imageCount(), 1);
+	result.animated = reader.supportsAnimation() && (result.frames > 1);
+	return result;
+}
+
+[[nodiscard]] Outcome ToPixels(const QByteArray &bytes) {
+	auto decoded = Decode(bytes, u"tg.image.toPixels"_q);
+	if (decoded.code) {
+		return Failure(decoded.code, decoded.error);
+	}
+	const auto image = decoded.image.convertToFormat(
+		QImage::Format_RGBA8888);
+	const auto line = image.width() * 4;
+	auto result = Outcome();
+	result.bytes = QByteArray(line * image.height(), Qt::Uninitialized);
+	for (auto y = 0; y != image.height(); ++y) {
+		std::memcpy(
+			result.bytes.data() + y * line,
+			image.constScanLine(y),
+			line);
+	}
+	result.width = image.width();
+	result.height = image.height();
+	return result;
+}
+
+[[nodiscard]] Outcome FromPixels(
+		int width,
+		int height,
+		const QByteArray &data,
+		const QByteArray &format,
+		int quality) {
+	const auto what = u"tg.image.fromPixels"_q;
+	auto image = QImage(width, height, QImage::Format_RGBA8888);
+	if (image.isNull()) {
+		return Failure("internal", what + u": out of memory"_q);
+	}
+	const auto line = width * 4;
+	for (auto y = 0; y != height; ++y) {
+		std::memcpy(image.scanLine(y), data.constData() + y * line, line);
+	}
+	return Encode(std::move(image), format, quality, std::nullopt, what);
+}
+
+JSValue MakeBytes(JSContext *ctx, const Outcome &outcome) {
+	return NewBytes(ctx, outcome.bytes);
+}
+
+JSValue MakeInfo(JSContext *ctx, const Outcome &outcome) {
+	auto result = JS_NewObject(ctx);
+	if (JS_IsException(result)) {
+		return result;
+	}
+	JS_SetPropertyStr(ctx, result, "width", JS_NewInt32(ctx, outcome.width));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"height",
+		JS_NewInt32(ctx, outcome.height));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"format",
+		NewString(ctx, QString::fromLatin1(outcome.format)));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"animated",
+		JS_NewBool(ctx, outcome.animated));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"frames",
+		JS_NewInt32(ctx, outcome.frames));
+	return result;
+}
+
+JSValue MakePixels(JSContext *ctx, const Outcome &outcome) {
+	auto data = NewBytes(ctx, outcome.bytes);
+	if (JS_IsException(data)) {
+		return data;
+	}
+	auto result = JS_NewObject(ctx);
+	if (JS_IsException(result)) {
+		JS_FreeValue(ctx, data);
+		return result;
+	}
+	JS_SetPropertyStr(ctx, result, "width", JS_NewInt32(ctx, outcome.width));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"height",
+		JS_NewInt32(ctx, outcome.height));
+	JS_SetPropertyStr(ctx, result, "data", data);
+	return result;
+}
+
+void Settle(const Pending &pending, const Outcome &outcome, Maker make) {
+	if (outcome.typeError) {
+		const auto text = outcome.error.toUtf8();
+		RejectWith(pending, [=](JSContext *ctx) {
+			JS_ThrowTypeError(ctx, "%s", text.constData());
+			return JS_GetException(ctx);
+		});
+		return;
+	} else if (outcome.code) {
+		Reject(pending, outcome.code, outcome.error);
+		return;
+	}
+	const auto strong = pending.instance.get();
+	const auto ctx = strong ? strong->context() : nullptr;
+	if (!ctx) {
+		return;
+	}
+	const auto value = make(ctx, outcome);
+	if (JS_IsException(value)) {
+		RejectWith(pending, [](JSContext *context) {
+			return JS_GetException(context);
+		});
+	} else {
+		Resolve(pending, [=](JSContext*) {
+			return value;
+		});
+	}
+}
+
+template <typename Work>
+JSValue Run(JSContext *ctx, Work work, Maker make) {
+	auto created = NewPending(ctx);
+	if (JS_IsException(created.second)) {
+		return created.second;
+	}
+	crl::async([
+			pending = created.first,
+			work = std::move(work),
+			make]() mutable {
+		auto outcome = work();
+		crl::on_main([
+				pending = std::move(pending),
+				outcome = std::move(outcome),
+				make] {
+			Settle(pending, outcome, make);
+		});
+	});
+	return created.second;
+}
+
+[[nodiscard]] int IntArg(JSContext *ctx, JSValueConst value, int fallback) {
+	auto result = 0.;
+	if (!JS_IsNumber(value) || JS_ToFloat64(ctx, &result, value)) {
+		return fallback;
+	}
+	return int(std::clamp(result, -2147483647., 2147483647.));
+}
+
+JSValue ZlibNative(JSContext *ctx, JSValueConst *argv, bool unpack) {
+	const auto kind = std::clamp(IntArg(ctx, argv[0], kGzip), kGzip, kRaw);
+	const auto name = unpack ? kUnpackNames[kind] : kPackNames[kind];
+	auto input = BytesFrom(ctx, argv[1]);
+	if (!input) {
+		return JS_ThrowTypeError(
+			ctx,
+			"%s needs a Uint8Array, an ArrayBuffer or a string",
+			name);
+	}
+	auto number = 0.;
+	if (JS_IsNumber(argv[2])) {
+		JS_ToFloat64(ctx, &number, argv[2]);
+	}
+	if (unpack) {
+		const auto limit = qint64(std::clamp(number, 1., double(kMaxOutput)));
+		return Run(ctx, [=, bytes = std::move(*input)] {
+			return Decompress(kind, bytes, limit, name);
+		}, MakeBytes);
+	}
+	const auto level = std::clamp(int(number), -1, 9);
+	return Run(ctx, [=, bytes = std::move(*input)] {
+		return Compress(kind, bytes, level, name);
+	}, MakeBytes);
+}
+
+JSValue ImageNative(JSContext *ctx, JSValueConst *argv, int magic) {
+	if (magic == kFromPixels) {
+		const auto width = IntArg(ctx, argv[0], 0);
+		const auto height = IntArg(ctx, argv[1], 0);
+		auto data = BytesFrom(ctx, argv[2]);
+		if (width < 1 || height < 1) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.image.fromPixels: width and height are positive integers");
+		} else if (qint64(width) * height > kMaxArea) {
+			return ThrowTeleError(
+				ctx,
+				"quota-exceeded",
+				TooBig(u"tg.image.fromPixels"_q, QSize(width, height)));
+		} else if (!data || qint64(data->size()) != qint64(width) * height * 4) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.image.fromPixels: data is width * height * 4 RGBA bytes");
+		}
+		const auto format = JS_IsString(argv[3])
+			? Normalized(FromStd(ToStd(ctx, argv[3])).toLatin1())
+			: QByteArray();
+		const auto quality = IntArg(ctx, argv[4], -1);
+		return Run(ctx, [=, bytes = std::move(*data)] {
+			return FromPixels(
+				width,
+				height,
+				bytes,
+				format.isEmpty() ? QByteArray("png") : format,
+				quality);
+		}, MakeBytes);
+	}
+	static constexpr auto names = std::array{
+		"tg.image.info",
+		"tg.image",
+		"tg.image.toPixels",
+	};
+	const auto name = names[magic - kInfo];
+	auto input = BytesFrom(ctx, argv[0]);
+	if (!input) {
+		return JS_ThrowTypeError(
+			ctx,
+			"%s needs the image as a Uint8Array or an ArrayBuffer",
+			name);
+	}
+	if (magic == kInfo) {
+		return Run(ctx, [bytes = std::move(*input)] {
+			return Info(bytes);
+		}, MakeInfo);
+	} else if (magic == kToPixels) {
+		return Run(ctx, [bytes = std::move(*input)] {
+			return ToPixels(bytes);
+		}, MakePixels);
+	}
+	const auto request = argv[1];
+	if (!JS_IsObject(request)) {
+		return JS_ThrowTypeError(ctx, "tg.image: options is an object");
+	}
+	const auto number = [&](const char *field, int fallback) {
+		const auto value = NumberProperty(ctx, request, field);
+		return value
+			? int(std::clamp(*value, -2147483647., 2147483647.))
+			: fallback;
+	};
+	auto transform = Transform();
+	transform.op = Op(std::clamp(number("op", 3), 0, 3));
+	transform.width = std::max(number("width", 0), 0);
+	transform.height = std::max(number("height", 0), 0);
+	transform.fit = Fit(std::clamp(number("fit", 1), 0, 4));
+	transform.area = QRect(
+		number("x", 0),
+		number("y", 0),
+		transform.width,
+		transform.height);
+	transform.degrees = number("degrees", 0);
+	transform.format = Normalized(
+		StringProperty(ctx, request, "format").toLatin1());
+	transform.quality = std::clamp(number("quality", -1), -1, 100);
+	if (const auto color = NumberProperty(ctx, request, "background")) {
+		const auto value = quint32(std::clamp(*color, 0., 4294967295.));
+		transform.background = QColor(
+			int((value >> 24) & 0xFF),
+			int((value >> 16) & 0xFF),
+			int((value >> 8) & 0xFF),
+			int(value & 0xFF));
+	}
+	if (transform.op == Op::Resize
+		&& !transform.width
+		&& !transform.height) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.image.resize needs a width, a height or both");
+	} else if (transform.op == Op::Crop && transform.area.isEmpty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.image.crop needs a positive width and height");
+	} else if (transform.op == Op::Rotate
+		&& transform.degrees != 90
+		&& transform.degrees != 180
+		&& transform.degrees != 270) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.image.rotate: degrees is 90, 180 or 270");
+	}
+	return Run(ctx, [transform, bytes = std::move(*input)] {
+		return Apply(bytes, transform);
+	}, MakeBytes);
+}
+
+JSValue NativeData(
+		JSContext *ctx,
+		JSValueConst thisVal,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	switch (magic) {
+	case kCompress: return ZlibNative(ctx, argv, false);
+	case kDecompress: return ZlibNative(ctx, argv, true);
+	case kInfo:
+	case kTransform:
+	case kToPixels:
+	case kFromPixels: return ImageNative(ctx, argv, magic);
+	}
+	return JS_UNDEFINED;
+}
+
+constexpr auto kTypings = R"ts(
+type CompressionInput = Uint8Array | ArrayBuffer | string
+
+interface CompressionOptions {
+  level?: number
+}
+
+interface DecompressionOptions {
+  maxSize?: number
+}
+
+declare var compression: {
+  gzip(input: CompressionInput, options?: CompressionOptions): Promise<Uint8Array>
+  gunzip(input: CompressionInput, options?: DecompressionOptions): Promise<Uint8Array>
+  deflate(input: CompressionInput, options?: CompressionOptions): Promise<Uint8Array>
+  inflate(input: CompressionInput, options?: DecompressionOptions): Promise<Uint8Array>
+  deflateRaw(input: CompressionInput, options?: CompressionOptions): Promise<Uint8Array>
+  inflateRaw(input: CompressionInput, options?: DecompressionOptions): Promise<Uint8Array>
+}
+
+declare module 'tele' {
+  export type ImageInput = Uint8Array | ArrayBuffer
+  export type ImageFormat = 'jpeg' | 'png' | 'webp' | 'bmp'
+  export type ImageFit = 'contain' | 'cover' | 'fill' | 'inside' | 'outside'
+
+  export interface ImageInfo {
+    width: number
+    height: number
+    format: string
+    animated: boolean
+    frames: number
+  }
+
+  export interface ImageEncodeOptions {
+    format?: ImageFormat
+    quality?: number
+  }
+
+  export interface ImageResizeOptions extends ImageEncodeOptions {
+    width?: number
+    height?: number
+    fit?: ImageFit
+    background?: string
+  }
+
+  export interface ImageCropOptions extends ImageEncodeOptions {
+    x: number
+    y: number
+    width: number
+    height: number
+  }
+
+  export interface ImagePixels {
+    width: number
+    height: number
+    data: Uint8Array
+  }
+
+  export interface Images {
+    info(bytes: ImageInput): Promise<ImageInfo>
+    resize(bytes: ImageInput, options: ImageResizeOptions): Promise<Uint8Array>
+    crop(bytes: ImageInput, options: ImageCropOptions): Promise<Uint8Array>
+    rotate(bytes: ImageInput, degrees: 90 | 180 | 270, options?: ImageEncodeOptions): Promise<Uint8Array>
+    convert(bytes: ImageInput, options: ImageEncodeOptions & { format: ImageFormat }): Promise<Uint8Array>
+    toPixels(bytes: ImageInput): Promise<ImagePixels>
+    fromPixels(
+      pixels: { width: number, height: number, data: Uint8Array | Uint8ClampedArray },
+      options?: ImageEncodeOptions,
+    ): Promise<Uint8Array>
+  }
+
+  export interface Tg {
+    readonly image: Images
+  }
+}
+)ts";
+
+} // namespace
+
+void AddDataNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "dataCompress", NativeData, 3, kCompress },
+		{ "dataDecompress", NativeData, 3, kDecompress },
+		{ "dataImageInfo", NativeData, 1, kInfo },
+		{ "dataImageTransform", NativeData, 2, kTransform },
+		{ "dataImageToPixels", NativeData, 1, kToPixels },
+		{ "dataImageFromPixels", NativeData, 5, kFromPixels },
+	});
+}
+
+std::string_view DataTypings() {
+	return kTypings;
+}
+
+} // namespace Tele::Scripting
