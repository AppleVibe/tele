+		if (value === undefined) {
+			if (fallback === undefined) {
+				throw new TypeError(`${what} needs ${field}`);
+			}
+			return fallback;
+		} else if (!Number.isInteger(value) || value < min || value > max) {
+			throw new TypeError(`${what}: ${field} is an integer from ${min} to ${max}`);
+		}
+		return value;
+	};
