+++ b/Telegram/SourceFiles/tele/scripting/tele_script_miniapps.cpp
@@ -0,0 +1,519 @@
+#include "tele/scripting/tele_script_miniapps.h"
+
+#include "api/api_common.h"
+#include "base/timer.h"
+#include "base/weak_ptr.h"
+#include "data/data_changes.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "inline_bots/bot_attach_web_view.h"
+#include "main/main_session.h"
+#include "tele/scripting/tele_script_instance.h"
+#include "tele/scripting/tele_script_native.h"
+#include "ui/chat/attach/attach_bot_webview.h"
+#include "window/window_session_controller.h"
+
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QJsonValue>
+#include <QtCore/QUrl>
+
+namespace Tele::Scripting {
+namespace {
+
+constexpr auto kFullInfoTimeout = crl::time(10000);
+
+enum class Op {
+	Open,
+	List,
+	Listen,
+	Unlisten,
+};
+
+struct OpenApp {
+	base::weak_ptr<Ui::BotWebView::Panel> panel;
+	const Main::Session *session = nullptr;
+	UserId bot = 0;
+	QString url;
+	bool fullsize = false;
+};
+
+struct Listener {
+	base::weak_ptr<Instance> instance;
+	const Instance *owner = nullptr;
+	const Main::Session *session = nullptr;
+	int kept = 0;
+};
+
+struct Registry {
+	base::flat_map<const void*, OpenApp> apps;
+	std::vector<Listener> listeners;
+};
+
+struct OpenRequest {
+	QString url;
+	QString startParam;
+	QString mode;
+};
+
+struct FullInfoWait {
+	base::Timer timer;
+	rpl::lifetime lifetime;
+	bool finished = false;
+};
+
+[[nodiscard]] Registry &Apps() {
+	static auto result = Registry();
+	return result;
+}
+
+[[nodiscard]] QString PublicUrl(const QString &url) {
+	auto parsed = QUrl(url);
+	if (!parsed.hasFragment()) {
+		return url;
+	}
+	auto kept = QStringList();
+	const auto parts = parsed.fragment(QUrl::FullyEncoded).split('&');
+	for (const auto &part : parts) {
+		if (!part.startsWith(u"tgWebApp"_q)) {
+			kept.push_back(part);
+		}
+	}
+	if (kept.isEmpty()) {
+		parsed.setFragment(QString());
+	} else {
+		parsed.setFragment(kept.join('&'));
+	}
+	return parsed.toString(QUrl::FullyEncoded);
+}
+
+[[nodiscard]] QString ModeOf(const OpenApp &app) {
+	const auto panel = app.panel.get();
+	return (panel && panel->fullscreen())
+		? u"fullscreen"_q
+		: app.fullsize
+		? u"fullsize"_q
+		: u"compact"_q;
+}
+
+[[nodiscard]] Window::SessionController *WindowOf(
+		not_null<Main::Session*> session) {
+	auto result = (Window::SessionController*)nullptr;
+	for (const auto &window : session->windows()) {
+		if (window->isPrimary()) {
+			return window;
+		} else if (!result) {
+			result = window;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<UserId> UserIdFrom(
+		JSContext *ctx,
+		JSValueConst input) {
+	if (!JS_IsObject(input)) {
+		return std::nullopt;
+	}
+	auto value = JS_GetPropertyStr(ctx, input, "userId");
+	auto result = std::optional<UserId>();
+	if (JS_IsBigInt(value)) {
+		auto id = std::int64_t();
+		if (!JS_ToBigInt64(ctx, &id, value) && id > 0) {
+			result = UserId(std::uint64_t(id));
+		}
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+[[nodiscard]] QString OpenWebApp(
+		not_null<Window::SessionController*> window,
+		not_null<UserData*> bot,
+		const OpenRequest &request) {
+	const auto info = bot->botInfo.get();
+	if (!info) {
+		return u"tg.ui.openWebApp: this peer isn't a bot"_q;
+	}
+	const auto context = InlineBots::WebViewContext{
+		.controller = window.get(),
+		.action = Api::SendAction(bot->owner().history(bot)),
+		.fullscreen = (request.mode == u"fullscreen"_q),
+		.maySkipConfirmation = true,
+	};
+	auto &attach = bot->session().attachWebView();
+	if (!request.url.isEmpty()) {
+		attach.open({
+			.bot = bot,
+			.context = context,
+			.button = {
+				.startCommand = request.startParam,
+				.url = request.url.toUtf8(),
+			},
+			.source = InlineBots::WebViewSourceButton{ .simple = false },
+		});
+	} else if (info->hasMainApp) {
+		attach.open({
+			.bot = bot,
+			.context = context,
+			.button = { .startCommand = request.startParam },
+			.source = InlineBots::WebViewSourceLinkBotProfile{
+				.token = request.startParam,
+				.compact = (request.mode == u"compact"_q),
+			},
+		});
+	} else if (!info->botMenuButtonUrl.isEmpty()) {
+		attach.open({
+			.bot = bot,
+			.context = context,
+			.button = {
+				.text = info->botMenuButtonText,
+				.startCommand = request.startParam,
+				.url = info->botMenuButtonUrl.toUtf8(),
+			},
+			.source = InlineBots::WebViewSourceBotMenu(),
+		});
+	} else {
+		return u"tg.ui.openWebApp: this bot has no mini app, pass "
+			"options.url"_q;
+	}
+	return QString();
+}
+
+void WhenFullLoaded(
+		not_null<Instance*> instance,
+		not_null<UserData*> bot,
+		Fn<void()> done) {
+	const auto state = ScriptLifetime(instance).make_state<FullInfoWait>();
+	const auto finish = [=] {
+		if (!state->finished) {
+			state->finished = true;
+			state->timer.cancel();
+			done();
+		}
+	};
+	state->timer.setCallback([=] {
+		state->lifetime.destroy();
+		finish();
+	});
+	state->timer.callOnce(kFullInfoTimeout);
+	bot->session().changes().peerUpdates(
+		bot,
+		Data::PeerUpdate::Flag::FullInfo
+	) | rpl::take(1) | rpl::on_next(finish, state->lifetime);
+	bot->updateFull();
+}
+
+JSValue Open(JSContext *ctx, int argc, JSValueConst *argv) {
+	if (argc < 2 || !JS_IsObject(argv[1])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.ui.openWebApp(bot, { url?, startParam?, mode? })");
+	}
+	const auto request = OpenRequest{
+		.url = StringProperty(ctx, argv[1], "url"),
+		.startParam = StringProperty(ctx, argv[1], "startParam"),
+		.mode = StringProperty(ctx, argv[1], "mode"),
+	};
+	if (!request.url.isEmpty()) {
+		const auto parsed = QUrl(request.url, QUrl::StrictMode);
+		const auto scheme = parsed.scheme().toLower();
+		if (!parsed.isValid()
+			|| parsed.host().isEmpty()
+			|| (scheme != u"https"_q && scheme != u"http"_q)) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.openWebApp: url must be an http(s) address");
+		}
+	}
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto session = ScriptSession(instance);
+	const auto userId = UserIdFrom(ctx, argv[0]);
+	if (!userId) {
+		return ThrowTeleError(
+			ctx,
+			"not-found",
+			u"tg.ui.openWebApp: this peer isn't a bot"_q);
+	}
+	const auto bot = session->data().userLoaded(*userId);
+	if (!bot) {
+		return JS_ThrowTypeError(ctx, "this peer isn't in tele's cache");
+	} else if (!bot->isBot()) {
+		return ThrowTeleError(
+			ctx,
+			"not-found",
+			u"tg.ui.openWebApp: %1 isn't a bot"_q.arg(bot->name()));
+	}
+	const auto window = WindowOf(session);
+	if (!window) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"this account has no window"_q);
+	}
+	auto created = NewPending(ctx);
+	const auto pending = created.first;
+	if (!pending.key) {
+		return created.second;
+	}
+	const auto weak = base::make_weak(window);
+	const auto open = [=] {
+		const auto strong = weak.get();
+		if (!strong) {
+			Reject(pending, "unsupported", u"this account has no window"_q);
+			return;
+		}
+		const auto error = OpenWebApp(strong, bot, request);
+		if (!error.isEmpty()) {
+			Reject(pending, "unsupported", error);
+		} else {
+			Resolve(pending, [](JSContext*) { return JS_UNDEFINED; });
+		}
+	};
+	if (request.url.isEmpty()
+		&& !bot->botInfo->hasMainApp
+		&& !bot->isFullLoaded()) {
+		WhenFullLoaded(instance, bot, open);
+	} else {
+		crl::on_main(open);
+	}
+	return created.second;
+}
+
+JSValue List(JSContext *ctx) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::UiRead,
+		"",
+		"tg.ui.webApps");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = ScriptSession(instance).get();
+	auto result = JS_NewArray(ctx);
+	auto index = uint32_t();
+	for (const auto &[key, app] : Apps().apps) {
+		if (app.session != session) {
+			continue;
+		}
+		auto entry = JS_NewObject(ctx);
+		JS_SetPropertyStr(
+			ctx,
+			entry,
+			"bot",
+			JS_NewBigInt64(ctx, std::int64_t(app.bot.bare)));
+		JS_SetPropertyStr(ctx, entry, "url", NewString(ctx, app.url));
+		JS_SetPropertyStr(ctx, entry, "mode", NewString(ctx, ModeOf(app)));
+		JS_SetPropertyUint32(ctx, result, index++, entry);
+	}
+	return result;
+}
+
+void RemoveListeners(const Instance *owner) {
+	auto &listeners = Apps().listeners;
+	listeners.erase(ranges::remove(
+		listeners,
+		owner,
+		&Listener::owner), end(listeners));
+}
+
+JSValue Listen(JSContext *ctx, int argc, JSValueConst *argv) {
+	if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+		return JS_ThrowTypeError(ctx, "tg.ui.onWebAppEvent(function)");
+	}
+	const auto instance = Permitted(
+		ctx,
+		Capability::UiRead,
+		"",
+		"tg.ui.onWebAppEvent");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto kept = KeepFunction(instance, argv[0]);
+	Apps().listeners.push_back({
+		.instance = base::make_weak(instance),
+		.owner = instance,
+		.session = ScriptSession(instance).get(),
+		.kept = kept,
+	});
+	ScriptLifetime(instance).add([owner = instance] {
+		RemoveListeners(owner);
+	});
+	return JS_NewInt32(ctx, kept);
+}
+
+JSValue Unlisten(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	auto kept = int32_t();
+	if (!instance
+		|| argc < 1
+		|| JS_ToInt32(ctx, &kept, argv[0])) {
+		return JS_UNDEFINED;
+	}
+	auto &listeners = Apps().listeners;
+	const auto i = ranges::find_if(listeners, [&](const Listener &entry) {
+		return (entry.owner == instance) && (entry.kept == kept);
+	});
+	if (i != end(listeners)) {
+		listeners.erase(i);
+		ForgetKept(base::make_weak(instance), kept);
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue EventPayload(
+		JSContext *ctx,
+		UserId bot,
+		const QString &name,
+		const QByteArray &json) {
+	auto data = JS_ParseJSON(
+		ctx,
+		json.constData(),
+		size_t(json.size()),
+		"<web app event>");
+	if (JS_IsException(data)) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		data = JS_NewObject(ctx);
+	}
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"bot",
+		JS_NewBigInt64(ctx, std::int64_t(bot.bare)));
+	JS_SetPropertyStr(ctx, result, "name", NewString(ctx, name));
+	JS_SetPropertyStr(ctx, result, "data", data);
+	return result;
+}
+
+JSValue NativeMiniApps(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	switch (Op(magic)) {
+	case Op::Open: return Open(ctx, argc, argv);
+	case Op::List: return List(ctx);
+	case Op::Listen: return Listen(ctx, argc, argv);
+	case Op::Unlisten: return Unlisten(ctx, argc, argv);
+	}
+	return JS_UNDEFINED;
+}
+
+constexpr auto kTypings = std::string_view(R"TS(
+declare module 'tele' {
+  export type WebAppMode = 'compact' | 'fullsize' | 'fullscreen'
+
+  export interface WebAppOptions {
+    url?: string
+    startParam?: string
+    mode?: WebAppMode
+  }
+
+  export interface WebAppInfo {
+    bot: bigint
+    url: string
+    mode: WebAppMode
+  }
+
+  export interface WebAppEvent {
+    bot: bigint
+    name: string
+    data: Record<string, unknown>
+  }
+
+  export interface Ui {
+    openWebApp(bot: InputPeerLike, options?: WebAppOptions): Promise<void>
+    webApps(): WebAppInfo[]
+    onWebAppEvent(callback: (event: WebAppEvent) => unknown): Disposer
+  }
+}
+)TS");
+
+} // namespace
+
+void AddMiniAppsNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "miniAppsOpen", NativeMiniApps, 2, int(Op::Open) },
+		{ "miniAppsList", NativeMiniApps, 0, int(Op::List) },
+		{ "miniAppsListen", NativeMiniApps, 1, int(Op::Listen) },
+		{ "miniAppsUnlisten", NativeMiniApps, 1, int(Op::Unlisten) },
+	});
+}
+
+std::string_view MiniAppsTypings() {
+	return kTypings;
+}
+
+void WebAppShown(
+		not_null<InlineBots::WebViewInstance*> instance,
+		not_null<Ui::BotWebView::Panel*> panel,
+		const InlineBots::WebViewResultData &result) {
+	Apps().apps[instance.get()] = OpenApp{
+		.panel = base::make_weak(panel.get()),
+		.session = &instance->session(),
+		.bot = peerToUser(instance->bot()->id),
+		.url = PublicUrl(result.url),
+		.fullsize = result.fullsize,
+	};
+}
+
+void WebAppEvent(
+		not_null<InlineBots::WebViewInstance*> instance,
+		const QString &name,
+		const QJsonObject &data) {
+	const auto &registry = Apps();
+	const auto i = registry.apps.find(instance.get());
+	if (i == end(registry.apps)) {
+		return;
+	}
+	const auto session = i->second.session;
+	const auto bot = i->second.bot;
+	const auto listening = ranges::any_of(
+		registry.listeners,
+		[&](const Listener &entry) { return entry.session == session; });
+	if (!listening) {
+		return;
+	}
+	auto copy = data;
+	if (name.endsWith(u"_storage_save_key"_q)
+		&& copy.contains(u"value"_q)) {
+		copy.insert(u"value"_q, QJsonValue(QJsonValue::Null));
+	}
+	const auto json = QJsonDocument(copy).toJson(QJsonDocument::Compact);
+	crl::on_main([=] {
+		const auto listeners = Apps().listeners;
+		for (const auto &entry : listeners) {
+			if (entry.session != session) {
+				continue;
+			}
+			const auto still = ranges::any_of(
+				Apps().listeners,
+				[&](const Listener &current) {
+					return (current.owner == entry.owner)
+						&& (current.kept == entry.kept);
+				});
+			if (!still) {
+				continue;
+			}
+			CallKept(entry.instance, entry.kept, [=](JSContext *ctx) {
+				return EventPayload(ctx, bot, name, json);
+			}, u"onWebAppEvent"_q);
+		}
+	});
+}
+
+void WebAppClosed(not_null<InlineBots::WebViewInstance*> instance) {
+	auto &apps = Apps().apps;
+	const auto i = apps.find(instance.get());
+	if (i != end(apps)) {
+		apps.erase(i);
+	}
+}
+
+} // namespace Tele::Scripting
