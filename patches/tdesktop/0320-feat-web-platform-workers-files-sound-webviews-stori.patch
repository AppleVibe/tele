diff --git a/Telegram/Resources/tele/scripting/teledata.js b/Telegram/Resources/tele/scripting/teledata.js
new file mode 100644
index 0000000000000000000000000000000000000000..9da17448666add6d0513f5a6131da1c89a59903e
--- /dev/null
+++ b/Telegram/Resources/tele/scripting/teledata.js
@@ -0,0 +1,172 @@
+(() => {
+	const CHANNEL_SHIFT = 1000000000000n;
+	const VERDICTS = ['keep', 'discard'];
+
+	const markedOf = (input, selfId) => {
+		switch (input?._) {
+		case 'inputPeerSelf':
+			return selfId;
+		case 'inputPeerUser':
+		case 'inputPeerUserFromMessage':
+			return BigInt(input.userId);
+		case 'inputPeerChat':
+			return -BigInt(input.chatId);
+		case 'inputPeerChannel':
+		case 'inputPeerChannelFromMessage':
+			return -CHANNEL_SHIFT - BigInt(input.channelId);
+		}
+		throw new TypeError('expected a user, a chat or a channel');
+	};
+
+	globalThis.__teleExtensions.push({
+		name: 'teledata',
+		tg(tg, natives, { resolvePeer }) {
+			const Message = globalThis.__teleMessage;
+			const chatOf = async (peer) => markedOf(await resolvePeer(peer), tg.selfId);
+			const optionalChat = async (peer) => ((peer === undefined || peer === null) ? null : chatOf(peer));
+			const chatsOf = async (list, what) => {
+				if (list === undefined) {
+					return undefined;
+				} else if (!Array.isArray(list)) {
+					throw new TypeError(`${what} is an array of chats`);
+				}
+				return Promise.all(list.map(chatOf));
+			};
+			const target = (what, args) => {
+				const [first, second] = args;
+				if (typeof second === 'number') {
+					return { peer: first, id: second, rest: args.slice(2) };
+				} else if (first instanceof Message) {
+					return { peer: first, id: first.id, rest: args.slice(1) };
+				}
+				throw new TypeError(`${what}(message) or ${what}(chat, messageId)`);
+			};
+			const listen = (register, callback, what) => {
+				if (typeof callback !== 'function') {
+					throw new TypeError(`${what}(callback)`);
+				}
+				const id = register(callback);
+				return __teleDisposer(() => natives.teledataOff(id));
+			};
+			const keptOf = (payload) => (payload.raw
+				? Object.freeze({ chatId: payload.chatId, own: payload.own, message: new Message(payload.raw, tg) })
+				: null);
+			const folderOf = async (folder, what) => {
+				if (folder === null || typeof folder !== 'object') {
+					throw new TypeError(`${what}: the folder is an object`);
+				}
+				return {
+					title: folder.title,
+					emoji: folder.emoji,
+					color: folder.color,
+					flags: folder.flags,
+					include: await chatsOf(folder.include, `${what}: include`),
+					exclude: await chatsOf(folder.exclude, `${what}: exclude`),
+					pinned: await chatsOf(folder.pinned, `${what}: pinned`),
+				};
+			};
+			const folderId = (id, what) => {
+				if (!Number.isInteger(id) || id <= 0) {
+					throw new TypeError(`${what}: id is a folder id from tg.tele.folders.list()`);
+				}
+				return id;
+			};
+
+			const members = {
+				bookmarks: Object.freeze({
+					list: () => natives.teledataBookmarks(),
+					async add(...args) {
+						const { peer, id, rest } = target('tg.tele.bookmarks.add', args);
+						const name = rest[0];
+						if (name !== undefined && name !== null && typeof name !== 'string') {
+							throw new TypeError('tg.tele.bookmarks.add: name is a string');
+						}
+						return natives.teledataBookmarkAdd(await chatOf(peer), id, name ?? '');
+					},
+					async remove(...args) {
+						const { peer, id } = target('tg.tele.bookmarks.remove', args);
+						return natives.teledataBookmarkRemove(await chatOf(peer), id);
+					},
+					onChange(callback) {
+						return listen((fn) => natives.teledataBookmarksOnChange(() => fn()), callback, 'tg.tele.bookmarks.onChange');
+					},
+				}),
+				pins: Object.freeze({
+					list: (folder) => natives.teledataPins(folder ?? 0),
+					async pin(chat, folder) {
+						natives.teledataPinSet(await chatOf(chat), folder ?? 0, true);
+					},
+					async unpin(chat, folder) {
+						natives.teledataPinSet(await chatOf(chat), folder ?? 0, false);
+					},
+				}),
+				folders: Object.freeze({
+					list: () => natives.teledataFolders(),
+					async create(folder) {
+						return natives.teledataFolderSave(0, await folderOf(folder, 'tg.tele.folders.create'));
+					},
+					async edit(id, changes) {
+						const checked = folderId(id, 'tg.tele.folders.edit');
+						await natives.teledataFolderSave(checked, await folderOf(changes, 'tg.tele.folders.edit'));
+					},
+					async delete(id) {
+						await natives.teledataFolderDelete(folderId(id, 'tg.tele.folders.delete'));
+					},
+					async reorder(ids) {
+						natives.teledataFoldersReorder(ids);
+					},
+				}),
+				hiddenWords: Object.freeze({
+					async list(chat) {
+						return natives.teledataHiddenWords(await optionalChat(chat));
+					},
+					async add(rule, chat) {
+						return natives.teledataHiddenWordChange(await optionalChat(chat), rule, true);
+					},
+					async remove(rule, chat) {
+						return natives.teledataHiddenWordChange(await optionalChat(chat), rule, false);
+					},
+				}),
+				async editHistory(...args) {
+					const { peer, id } = target('tg.tele.editHistory', args);
+					return natives.teledataEditHistory(await chatOf(peer), id).map((version) => Object.freeze({
+						date: version.date,
+						original: version.original,
+						current: version.current,
+						message: new Message(version.raw, tg),
+					}));
+				},
+				deleted: Object.freeze({
+					async list(chat) {
+						return natives.teledataDeleted(await chatOf(chat)).map((raw) => new Message(raw, tg));
+					},
+					onKept(callback) {
+						return listen((fn) => natives.teledataDeletedOnKept((payload) => {
+							const kept = keptOf(payload);
+							if (kept) {
+								return fn(kept);
+							}
+						}), callback, 'tg.tele.deleted.onKept');
+					},
+					interceptKeep(interceptor) {
+						return listen((fn) => natives.teledataDeletedIntercept(async (payload) => {
+							let verdict;
+							try {
+								const kept = keptOf(payload);
+								verdict = kept ? await fn(kept) : undefined;
+								if (verdict !== undefined && verdict !== null && !VERDICTS.includes(verdict)) {
+									console.error(`tg.tele.deleted.interceptKeep: the verdict is 'keep' or 'discard', got ${String(verdict)}`);
+								}
+							} finally {
+								natives.teledataDeletedAnswer(payload.callId, (verdict === 'discard') ? 'discard' : 'keep');
+							}
+						}), interceptor, 'tg.tele.deleted.interceptKeep');
+					},
+				}),
+			};
+			for (const [name, value] of Object.entries(members)) {
+				Object.defineProperty(tg.tele, name, { value, enumerable: true });
+			}
+		},
+	});
+})();
