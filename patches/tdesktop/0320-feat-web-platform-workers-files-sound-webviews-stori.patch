+  export type GiftLike = SavedGift | Gift | string | tl.TypeInputSavedStarGift
+
+  export interface GiftListOptions {
+    limit?: number
+    offset?: string
+  }
+
+  export interface SavedGiftsPage {
+    gifts: SavedGift[]
