+	};
+
+	const starsOf = (amount) => ({ stars: amount?.amount ?? 0n, nanos: amount?.nanos ?? 0 });
+
+	globalThis.__teleExtensions.push({
+		name: 'gifts',
+		tg(tg, natives, { resolvePeer }) {
+			const read = (what) => natives.giftsRead(what);
+			const write = (what) => natives.giftsWrite(what);
+
+			const pay = async (invoice, free, what) => {
+				let form = null;
+				try {
+					form = await tg.call({ _: 'payments.getPaymentForm', invoice });
+				} catch (error) {
+					if (error instanceof RpcError && error.type === 'NO_PAYMENT_NEEDED') {
