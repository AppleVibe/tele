+		if (typeof value === 'string') {
+			encoder ??= new TextEncoder();
+			return encoder.encode(value);
+		} else if (value instanceof Uint8Array || value instanceof ArrayBuffer) {
+			return value;
+		}
+		throw new TypeError(`${what} needs a Uint8Array, an ArrayBuffer or a string`);
+	};
+	const imageInput = (what, value) => {
+		if (value instanceof Uint8Array || value instanceof ArrayBuffer) {
+			return value;
+		}
+		throw new TypeError(`${what} needs the image as a Uint8Array or an ArrayBuffer`);
+	};
+	const format = (what, value) => {
+		if (value === undefined) {
+			return '';
