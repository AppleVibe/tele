+				},
+				convert(bytes, settings) {
+					const what = 'tg.image.convert';
+					const input = imageInput(what, bytes);
+					const given = options(what, settings);
+					if (given.format === undefined) {
+						throw new TypeError(`${what} needs { format }`);
+					}
