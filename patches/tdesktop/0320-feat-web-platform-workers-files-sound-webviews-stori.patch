+	Derive,
+};
+
+enum class KeyKind : uchar {
+	Secret,
+	Rsa,
+	Ec,
+	X25519,
+	Ed25519,
+};
+
+struct OpenSslFree {
+	void operator()(EVP_PKEY *value) const {
+		EVP_PKEY_free(value);
+	}
+	void operator()(EVP_PKEY_CTX *value) const {
+		EVP_PKEY_CTX_free(value);
+	}
+	void operator()(EVP_MD_CTX *value) const {
+		EVP_MD_CTX_free(value);
+	}
+	void operator()(EVP_CIPHER_CTX *value) const {
+		EVP_CIPHER_CTX_free(value);
+	}
+	void operator()(EVP_KDF *value) const {
+		EVP_KDF_free(value);
+	}
+	void operator()(EVP_KDF_CTX *value) const {
+		EVP_KDF_CTX_free(value);
+	}
+	void operator()(BIGNUM *value) const {
+		BN_clear_free(value);
+	}
+	void operator()(OSSL_PARAM_BLD *value) const {
+		OSSL_PARAM_BLD_free(value);
+	}
+	void operator()(OSSL_PARAM *value) const {
+		OSSL_PARAM_free(value);
+	}
+	void operator()(ECDSA_SIG *value) const {
+		ECDSA_SIG_free(value);
+	}
+	void operator()(PKCS8_PRIV_KEY_INFO *value) const {
+		PKCS8_PRIV_KEY_INFO_free(value);
+	}
+};
+
+template <typename Type>
+using Owned = std::unique_ptr<Type, OpenSslFree>;
+
+struct KeyData {
+	~KeyData() {
+		if (!secret.isEmpty()) {
+			OPENSSL_cleanse(secret.data(), size_t(secret.size()));
+		}
+	}
+
+	KeyKind kind = KeyKind::Secret;
+	bool isPrivate = false;
+	QByteArray secret;
+	Owned<EVP_PKEY> pkey;
+};
+
+using KeyPointer = std::shared_ptr<KeyData>;
+using Parts = std::vector<std::optional<QByteArray>>;
+
+struct Outcome {
+	enum class Type : uchar {
+		Buffer,
+		Boolean,
+		Key,
+		Pair,
+		List,
+	};
+
+	Type type = Type::Buffer;
+	QByteArray bytes;
+	bool flag = false;
+	KeyPointer key;
+	KeyPointer second;
+	std::vector<QByteArray> parts;
+	const char *error = nullptr;
+	QString message;
+};
+
+struct CipherParams {
+	QByteArray iv;
+	QByteArray extra;
+	int number = 0;
+	const EVP_MD *md = nullptr;
+};
+
+struct DeriveParams {
+	const EVP_MD *md = nullptr;
+	QByteArray salt;
+	QByteArray info;
+	uint64_t iterations = 0;
+	KeyPointer peer;
+};
+
+[[nodiscard]] const unsigned char *Raw(const QByteArray &bytes) {
+	return reinterpret_cast<const unsigned char*>(bytes.constData());
+}
+
+[[nodiscard]] unsigned char *Writable(QByteArray &bytes) {
+	return reinterpret_cast<unsigned char*>(bytes.data());
+}
+
+[[nodiscard]] Outcome Failed(const char *name, const char *message) {
+	auto result = Outcome();
+	result.error = name;
+	result.message = QString::fromLatin1(message);
+	return result;
+}
+
+[[nodiscard]] Outcome BufferOutcome(QByteArray bytes) {
+	auto result = Outcome();
+	result.bytes = std::move(bytes);
+	return result;
+}
+
+[[nodiscard]] Outcome BooleanOutcome(bool value) {
+	auto result = Outcome();
+	result.type = Outcome::Type::Boolean;
+	result.flag = value;
+	return result;
+}
+
+[[nodiscard]] Outcome KeyOutcome(KeyPointer key) {
+	auto result = Outcome();
+	result.type = Outcome::Type::Key;
+	result.key = std::move(key);
+	return result;
+}
+
+[[nodiscard]] Outcome PairOutcome(KeyPointer publicKey, KeyPointer privateKey) {
+	auto result = Outcome();
+	result.type = Outcome::Type::Pair;
+	result.key = std::move(publicKey);
+	result.second = std::move(privateKey);
+	return result;
+}
+
+[[nodiscard]] Outcome PartsOutcome(std::vector<QByteArray> parts) {
+	auto result = Outcome();
+	result.type = Outcome::Type::List;
+	result.parts = std::move(parts);
+	return result;
+}
+
+[[nodiscard]] const EVP_MD *MdOf(const std::string &name) {
+	return (name == "SHA-1")
+		? EVP_sha1()
+		: (name == "SHA-256")
+		? EVP_sha256()
+		: (name == "SHA-384")
+		? EVP_sha384()
+		: (name == "SHA-512")
+		? EVP_sha512()
+		: nullptr;
+}
+
+[[nodiscard]] const char *GroupOf(const std::string &curve) {
+	return (curve == "P-256")
+		? "prime256v1"
+		: (curve == "P-384")
+		? "secp384r1"
+		: (curve == "P-521")
+		? "secp521r1"
+		: nullptr;
+}
+
+[[nodiscard]] int FieldSize(const std::string &curve) {
+	return (curve == "P-256")
+		? 32
+		: (curve == "P-384")
+		? 48
+		: (curve == "P-521")
+		? 66
+		: 0;
+}
+
+[[nodiscard]] std::string CurveOf(EVP_PKEY *key) {
+	char name[64] = { 0 };
+	auto size = size_t();
+	if (EVP_PKEY_get_utf8_string_param(
+			key,
+			OSSL_PKEY_PARAM_GROUP_NAME,
+			name,
+			sizeof(name),
+			&size) != 1) {
+		return std::string();
+	}
+	const auto group = std::string_view(name, size);
+	return (group == "prime256v1" || group == "P-256")
+		? "P-256"
+		: (group == "secp384r1" || group == "P-384")
+		? "P-384"
+		: (group == "secp521r1" || group == "P-521")
+		? "P-521"
+		: std::string();
+}
+
+[[nodiscard]] std::optional<KeyKind> KindFrom(const std::string &name) {
+	return (name == "secret")
+		? std::make_optional(KeyKind::Secret)
+		: (name == "RSA")
+		? std::make_optional(KeyKind::Rsa)
+		: (name == "EC")
+		? std::make_optional(KeyKind::Ec)
+		: (name == "X25519")
+		? std::make_optional(KeyKind::X25519)
+		: (name == "Ed25519")
+		? std::make_optional(KeyKind::Ed25519)
+		: std::nullopt;
+}
+
+[[nodiscard]] const char *KindName(KeyKind kind) {
+	switch (kind) {
+	case KeyKind::Secret: return "secret";
+	case KeyKind::Rsa: return "RSA";
+	case KeyKind::Ec: return "EC";
+	case KeyKind::X25519: return "X25519";
+	case KeyKind::Ed25519: return "Ed25519";
+	}
+	return "secret";
+}
+
+[[nodiscard]] const char *TypeOf(KeyKind kind) {
+	switch (kind) {
+	case KeyKind::Secret: return nullptr;
+	case KeyKind::Rsa: return "RSA";
+	case KeyKind::Ec: return "EC";
+	case KeyKind::X25519: return "X25519";
+	case KeyKind::Ed25519: return "ED25519";
+	}
+	return nullptr;
+}
+
+[[nodiscard]] KeyPointer MakeKey(
+		KeyKind kind,
+		bool isPrivate,
+		Owned<EVP_PKEY> pkey) {
+	auto result = std::make_shared<KeyData>();
+	result->kind = kind;
+	result->isPrivate = isPrivate;
+	result->pkey = std::move(pkey);
+	return result;
+}
+
+[[nodiscard]] KeyPointer MakeSecret(const QByteArray &secret) {
+	auto result = std::make_shared<KeyData>();
+	result->secret = QByteArray(secret.constData(), secret.size());
+	return result;
+}
+
+[[nodiscard]] int FieldBytes(EVP_PKEY *key) {
+	return (EVP_PKEY_get_bits(key) + 7) / 8;
+}
+
+[[nodiscard]] Owned<EVP_PKEY> FromData(
+		const char *type,
+		int selection,
+		OSSL_PARAM *params) {
+	auto context = Owned<EVP_PKEY_CTX>(
+		EVP_PKEY_CTX_new_from_name(nullptr, type, nullptr));
+	EVP_PKEY *key = nullptr;
+	if (!params
+		|| !context
+		|| EVP_PKEY_fromdata_init(context.get()) <= 0
+		|| EVP_PKEY_fromdata(context.get(), &key, selection, params) <= 0) {
+		return nullptr;
+	}
+	return Owned<EVP_PKEY>(key);
+}
+
+[[nodiscard]] bool Checked(EVP_PKEY *key, bool isPrivate) {
+	auto context = Owned<EVP_PKEY_CTX>(
+		EVP_PKEY_CTX_new_from_pkey(nullptr, key, nullptr));
+	if (!context) {
+		return false;
+	}
+	return (isPrivate
+		? EVP_PKEY_pairwise_check(context.get())
+		: EVP_PKEY_public_check(context.get())) == 1;
+}
+
+[[nodiscard]] std::optional<QByteArray> PublicDer(EVP_PKEY *key) {
+	const auto size = i2d_PUBKEY(key, nullptr);
+	if (size <= 0) {
+		return std::nullopt;
+	}
+	auto result = QByteArray(size, Qt::Uninitialized);
+	auto out = Writable(result);
+	if (i2d_PUBKEY(key, &out) != size) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<QByteArray> PrivateDer(EVP_PKEY *key) {
+	auto info = Owned<PKCS8_PRIV_KEY_INFO>(EVP_PKEY2PKCS8(key));
+	const auto size = info
+		? i2d_PKCS8_PRIV_KEY_INFO(info.get(), nullptr)
+		: 0;
+	if (size <= 0) {
+		return std::nullopt;
+	}
+	auto result = QByteArray(size, Qt::Uninitialized);
+	auto out = Writable(result);
+	if (i2d_PKCS8_PRIV_KEY_INFO(info.get(), &out) != size) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] Owned<EVP_PKEY> PublicOnly(EVP_PKEY *key) {
+	const auto der = PublicDer(key);
+	if (!der) {
+		return nullptr;
+	}
+	auto in = Raw(*der);
+	return Owned<EVP_PKEY>(d2i_PUBKEY(nullptr, &in, long(der->size())));
+}
+
+[[nodiscard]] std::optional<QByteArray> RawPublic(EVP_PKEY *key) {
+	auto size = size_t();
+	if (EVP_PKEY_get_raw_public_key(key, nullptr, &size) != 1) {
+		return std::nullopt;
+	}
+	auto result = QByteArray(int(size), Qt::Uninitialized);
+	if (EVP_PKEY_get_raw_public_key(key, Writable(result), &size) != 1) {
+		return std::nullopt;
+	}
+	result.resize(int(size));
+	return result;
+}
+
+[[nodiscard]] std::optional<QByteArray> RawPrivate(EVP_PKEY *key) {
+	auto size = size_t();
+	if (EVP_PKEY_get_raw_private_key(key, nullptr, &size) != 1) {
+		return std::nullopt;
+	}
+	auto result = QByteArray(int(size), Qt::Uninitialized);
+	if (EVP_PKEY_get_raw_private_key(key, Writable(result), &size) != 1) {
+		return std::nullopt;
+	}
+	result.resize(int(size));
+	return result;
+}
+
+[[nodiscard]] std::optional<QByteArray> EncodedPoint(EVP_PKEY *key) {
+	auto size = size_t();
+	if (EVP_PKEY_get_octet_string_param(
+			key,
+			OSSL_PKEY_PARAM_ENCODED_PUBLIC_KEY,
+			nullptr,
+			0,
+			&size) != 1) {
+		return std::nullopt;
+	}
+	auto result = QByteArray(int(size), Qt::Uninitialized);
+	if (EVP_PKEY_get_octet_string_param(
+			key,
+			OSSL_PKEY_PARAM_ENCODED_PUBLIC_KEY,
+			Writable(result),
+			size_t(result.size()),
+			&size) != 1) {
+		return std::nullopt;
+	}
+	result.resize(int(size));
+	return result;
+}
+
+[[nodiscard]] std::optional<QByteArray> Number(
+		EVP_PKEY *key,
+		const char *name,
+		int pad) {
+	BIGNUM *value = nullptr;
+	if (EVP_PKEY_get_bn_param(key, name, &value) != 1 || !value) {
+		return std::nullopt;
+	}
+	const auto owned = Owned<BIGNUM>(value);
+	const auto size = pad ? pad : BN_num_bytes(value);
+	auto result = QByteArray(size, Qt::Uninitialized);
+	if (BN_bn2binpad(value, Writable(result), size) != size) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] Owned<EVP_PKEY> GenerateKey(
+		const char *type,
+		const char *group,
+		int bits,
+		const QByteArray &exponent) {
+	auto context = Owned<EVP_PKEY_CTX>(
+		EVP_PKEY_CTX_new_from_name(nullptr, type, nullptr));
+	if (!context || EVP_PKEY_keygen_init(context.get()) <= 0) {
+		return nullptr;
+	} else if (group
+		&& EVP_PKEY_CTX_set_group_name(context.get(), group) <= 0) {
+		return nullptr;
+	} else if (bits > 0) {
+		auto e = Owned<BIGNUM>(
+			BN_bin2bn(Raw(exponent), exponent.size(), nullptr));
+		if (!e
+			|| EVP_PKEY_CTX_set_rsa_keygen_bits(context.get(), bits) <= 0
+			|| EVP_PKEY_CTX_set1_rsa_keygen_pubexp(
+				context.get(),
+				e.get()) <= 0) {
+			return nullptr;
+		}
+	}
+	EVP_PKEY *key = nullptr;
+	if (EVP_PKEY_generate(context.get(), &key) <= 0) {
+		return nullptr;
+	}
+	return Owned<EVP_PKEY>(key);
+}
+
+[[nodiscard]] Outcome Generate(
+		KeyKind kind,
+		const std::string &curve,
+		int number,
+		const QByteArray &exponent) {
+	if (kind == KeyKind::Secret) {
+		if (number <= 0 || number > kMaxSecret) {
+			return Failed(kOperationError, "the key length is wrong");
+		}
+		auto secret = QByteArray(number, Qt::Uninitialized);
+		if (RAND_bytes(Writable(secret), number) != 1) {
+			return Failed(kOperationError, "the random generator failed");
+		}
+		auto result = KeyOutcome(MakeSecret(secret));
+		OPENSSL_cleanse(secret.data(), size_t(secret.size()));
+		return result;
+	}
+	const auto group = (kind == KeyKind::Ec) ? GroupOf(curve) : nullptr;
+	if (kind == KeyKind::Ec && !group) {
+		return Failed(
+			kNotSupportedError,
+			"the curve is P-256, P-384 or P-521");
+	}
+	auto key = GenerateKey(
+		TypeOf(kind),
+		group,
+		(kind == KeyKind::Rsa) ? number : 0,
+		exponent);
+	if (!key) {
+		return Failed(kOperationError, "the key generation failed");
+	}
+	auto open = PublicOnly(key.get());
+	if (!open) {
+		return Failed(kOperationError, "the key generation failed");
+	}
+	return PairOutcome(
+		MakeKey(kind, false, std::move(open)),
+		MakeKey(kind, true, std::move(key)));
+}
+
+[[nodiscard]] Outcome Adopt(
+		Owned<EVP_PKEY> key,
+		KeyKind kind,
+		bool isPrivate,
+		const std::string &curve) {
+	const auto type = TypeOf(kind);
+	if (!key
+		|| !type
+		|| EVP_PKEY_is_a(key.get(), type) != 1
+		|| (kind == KeyKind::Ec && CurveOf(key.get()) != curve)) {
+		return Failed(
+			kDataError,
+			"the key data doesn't match the algorithm");
+	}
+	return KeyOutcome(MakeKey(kind, isPrivate, std::move(key)));
+}
+
+[[nodiscard]] Owned<EVP_PKEY> EcFromParts(
+		const std::string &curve,
+		const QByteArray &point,
+		const QByteArray *secret) {
+	const auto group = GroupOf(curve);
+	auto build = Owned<OSSL_PARAM_BLD>(OSSL_PARAM_BLD_new());
+	auto number = Owned<BIGNUM>(secret
+		? BN_bin2bn(Raw(*secret), secret->size(), nullptr)
+		: nullptr);
+	if (!group
+		|| !build
+		|| (secret && !number)
+		|| OSSL_PARAM_BLD_push_utf8_string(
+			build.get(),
+			OSSL_PKEY_PARAM_GROUP_NAME,
+			group,
+			0) != 1
+		|| OSSL_PARAM_BLD_push_octet_string(
+			build.get(),
+			OSSL_PKEY_PARAM_PUB_KEY,
+			point.constData(),
+			size_t(point.size())) != 1
+		|| (number
+			&& OSSL_PARAM_BLD_push_BN(
+				build.get(),
+				OSSL_PKEY_PARAM_PRIV_KEY,
+				number.get()) != 1)) {
+		return nullptr;
+	}
+	auto params = Owned<OSSL_PARAM>(OSSL_PARAM_BLD_to_param(build.get()));
+	auto key = FromData(
+		"EC",
+		secret ? EVP_PKEY_KEYPAIR : EVP_PKEY_PUBLIC_KEY,
+		params.get());
+	if (key && !Checked(key.get(), secret != nullptr)) {
+		return nullptr;
+	}
+	return key;
+}
+
+[[nodiscard]] Owned<EVP_PKEY> RsaFromParts(const Parts &parts) {
+	static constexpr const char *kNames[] = {
+		OSSL_PKEY_PARAM_RSA_N,
+		OSSL_PKEY_PARAM_RSA_E,
+		OSSL_PKEY_PARAM_RSA_D,
+		OSSL_PKEY_PARAM_RSA_FACTOR1,
+		OSSL_PKEY_PARAM_RSA_FACTOR2,
+		OSSL_PKEY_PARAM_RSA_EXPONENT1,
+		OSSL_PKEY_PARAM_RSA_EXPONENT2,
+		OSSL_PKEY_PARAM_RSA_COEFFICIENT1,
+	};
+	const auto isPrivate = (parts.size() > 2) && parts[2].has_value();
+	const auto count = isPrivate ? 8 : 2;
+	auto build = Owned<OSSL_PARAM_BLD>(OSSL_PARAM_BLD_new());
+	if (!build || int(parts.size()) < count) {
+		return nullptr;
+	}
+	auto numbers = std::vector<Owned<BIGNUM>>();
+	numbers.reserve(count);
+	for (auto i = 0; i != count; ++i) {
+		const auto &part = parts[i];
+		if (!part || part->isEmpty()) {
+			return nullptr;
+		}
+		numbers.emplace_back(BN_bin2bn(Raw(*part), part->size(), nullptr));
+		if (!numbers.back()
+			|| OSSL_PARAM_BLD_push_BN(
+				build.get(),
+				kNames[i],
+				numbers.back().get()) != 1) {
+			return nullptr;
+		}
+	}
+	auto params = Owned<OSSL_PARAM>(OSSL_PARAM_BLD_to_param(build.get()));
+	return FromData(
+		"RSA",
+		isPrivate ? EVP_PKEY_KEYPAIR : EVP_PKEY_PUBLIC_KEY,
+		params.get());
+}
+
+[[nodiscard]] Outcome ImportRaw(
+		KeyKind kind,
+		const std::string &curve,
+		const QByteArray &data) {
+	switch (kind) {
+	case KeyKind::Secret:
+		if (data.size() > kMaxSecret) {
+			return Failed(kDataError, "the key is too long");
+		}
+		return KeyOutcome(MakeSecret(data));
+	case KeyKind::Ec:
+		return Adopt(EcFromParts(curve, data, nullptr), kind, false, curve);
+	case KeyKind::X25519:
+	case KeyKind::Ed25519:
+		if (data.size() != kOkpSize) {
+			return Failed(kDataError, "the public key has 32 bytes");
+		}
+		return Adopt(
+			Owned<EVP_PKEY>(EVP_PKEY_new_raw_public_key_ex(
+				nullptr,
+				TypeOf(kind),
+				nullptr,
+				Raw(data),
+				size_t(data.size()))),
+			kind,
+			false,
+			curve);
+	case KeyKind::Rsa:
+		break;
+	}
+	return Failed(kNotSupportedError, "rsa keys have no raw format");
+}
+
+[[nodiscard]] Outcome ImportDer(
+		bool isPrivate,
+		KeyKind kind,
+		const std::string &curve,
+		const QByteArray &der) {
+	if (kind == KeyKind::Secret) {
+		return Failed(kNotSupportedError, "secret keys have no der format");
+	}
+	auto in = Raw(der);
+	const auto end = in + der.size();
+	auto key = Owned<EVP_PKEY>();
+	if (isPrivate) {
+		auto info = Owned<PKCS8_PRIV_KEY_INFO>(
+			d2i_PKCS8_PRIV_KEY_INFO(nullptr, &in, long(der.size())));
+		if (info && in == end) {
+			key.reset(EVP_PKCS82PKEY(info.get()));
+		}
+	} else {
+		key.reset(d2i_PUBKEY(nullptr, &in, long(der.size())));
+		if (in != end) {
+			key = nullptr;
+		}
+	}
+	return Adopt(std::move(key), kind, isPrivate, curve);
+}
+
+[[nodiscard]] Outcome ImportJwk(
+		KeyKind kind,
+		const std::string &curve,
+		const Parts &parts) {
+	const auto part = [&](size_t index) {
+		return (index < parts.size()) ? parts[index] : std::nullopt;
+	};
+	switch (kind) {
+	case KeyKind::Secret: {
+		const auto secret = part(0);
+		if (!secret) {
+			return Failed(kDataError, "the jwk has no k");
+		}
+		return ImportRaw(kind, curve, *secret);
+	}
+	case KeyKind::Rsa: {
+		const auto isPrivate = part(2).has_value();
+		return Adopt(RsaFromParts(parts), kind, isPrivate, curve);
+	}
+	case KeyKind::Ec: {
+		const auto size = FieldSize(curve);
+		const auto x = part(0);
+		const auto y = part(1);
+		const auto d = part(2);
+		if (!size
+			|| !x
+			|| !y
+			|| x->size() != size
+			|| y->size() != size
+			|| (d && d->size() != size)) {
+			return Failed(kDataError, "the jwk coordinates have a wrong size");
+		}
+		auto point = QByteArray(1, char(0x04));
+		point.append(*x);
+		point.append(*y);
+		return Adopt(
+			EcFromParts(curve, point, d ? &*d : nullptr),
+			kind,
+			d.has_value(),
+			curve);
+	}
+	case KeyKind::X25519:
+	case KeyKind::Ed25519: {
+		const auto x = part(0);
+		const auto d = part(1);
+		if (!x || x->size() != kOkpSize || (d && d->size() != kOkpSize)) {
+			return Failed(kDataError, "the jwk x and d have 32 bytes");
+		}
+		auto key = Owned<EVP_PKEY>(d
+			? EVP_PKEY_new_raw_private_key_ex(
+				nullptr,
+				TypeOf(kind),
+				nullptr,
+				Raw(*d),
+				size_t(d->size()))
+			: EVP_PKEY_new_raw_public_key_ex(
+				nullptr,
+				TypeOf(kind),
+				nullptr,
+				Raw(*x),
+				size_t(x->size())));
+		if (key && d) {
+			const auto mine = RawPublic(key.get());
+			if (!mine || *mine != *x) {
+				return Failed(
+					kDataError,
+					"the jwk x doesn't match its d");
+			}
+		}
+		return Adopt(std::move(key), kind, d.has_value(), curve);
+	}
+	}
+	return Failed(kNotSupportedError, "the key kind is unknown");
+}
+
+[[nodiscard]] Outcome Export(const std::string &format, KeyPointer key) {
+	if (format == "raw") {
+		if (key->kind == KeyKind::Secret) {
+			return BufferOutcome(key->secret);
+		} else if (key->kind == KeyKind::Rsa) {
+			return Failed(kNotSupportedError, "rsa keys have no raw format");
+		} else if (key->isPrivate) {
+			return Failed(
+				kInvalidAccessError,
+				"only public keys export as raw");
+		}
+		const auto result = (key->kind == KeyKind::Ec)
+			? EncodedPoint(key->pkey.get())
+			: RawPublic(key->pkey.get());
+		return result
+			? BufferOutcome(*result)
+			: Failed(kOperationError, "the key can't be exported");
+	} else if (key->kind == KeyKind::Secret) {
+		return Failed(
+			kNotSupportedError,
+			"secret keys export as raw or jwk");
+	} else if (format != "spki" && format != "pkcs8") {
+		return Failed(kNotSupportedError, "the format is unknown");
+	} else if ((format == "pkcs8") != key->isPrivate) {
+		return Failed(
+			kInvalidAccessError,
+			"spki is for public keys and pkcs8 for private keys");
+	}
+	const auto result = key->isPrivate
+		? PrivateDer(key->pkey.get())
+		: PublicDer(key->pkey.get());
+	return result
+		? BufferOutcome(*result)
+		: Failed(kOperationError, "the key can't be exported");
+}
+
+[[nodiscard]] Outcome ExportJwk(KeyPointer key) {
+	auto parts = std::vector<QByteArray>();
+	const auto add = [&](std::optional<QByteArray> part) {
+		if (!part) {
+			return false;
+		}
+		parts.push_back(std::move(*part));
+		return true;
+	};
+	const auto pkey = key->pkey.get();
+	auto ok = true;
+	switch (key->kind) {
+	case KeyKind::Secret:
+		parts.push_back(key->secret);
+		break;
+	case KeyKind::Rsa: {
+		static constexpr const char *kNames[] = {
+			OSSL_PKEY_PARAM_RSA_N,
+			OSSL_PKEY_PARAM_RSA_E,
+			OSSL_PKEY_PARAM_RSA_D,
+			OSSL_PKEY_PARAM_RSA_FACTOR1,
+			OSSL_PKEY_PARAM_RSA_FACTOR2,
+			OSSL_PKEY_PARAM_RSA_EXPONENT1,
+			OSSL_PKEY_PARAM_RSA_EXPONENT2,
+			OSSL_PKEY_PARAM_RSA_COEFFICIENT1,
+		};
+		const auto count = key->isPrivate ? 8 : 2;
+		for (auto i = 0; ok && i != count; ++i) {
+			ok = add(Number(pkey, kNames[i], 0));
+		}
+	} break;
+	case KeyKind::Ec: {
+		const auto size = FieldBytes(pkey);
+		ok = add(Number(pkey, OSSL_PKEY_PARAM_EC_PUB_X, size))
+			&& add(Number(pkey, OSSL_PKEY_PARAM_EC_PUB_Y, size))
+			&& (!key->isPrivate
+				|| add(Number(pkey, OSSL_PKEY_PARAM_PRIV_KEY, size)));
+	} break;
+	case KeyKind::X25519:
+	case KeyKind::Ed25519:
+		ok = add(RawPublic(pkey))
+			&& (!key->isPrivate || add(RawPrivate(pkey)));
+		break;
+	}
+	if (!ok) {
+		return Failed(kOperationError, "the key can't be exported");
+	}
+	return PartsOutcome(std::move(parts));
+}
+
+[[nodiscard]] std::optional<QByteArray> Hmac(
+		const EVP_MD *md,
+		const QByteArray &key,
+		const QByteArray &data) {
+	auto result = QByteArray(EVP_MAX_MD_SIZE, Qt::Uninitialized);
+	auto size = 0u;
+	if (!HMAC(
+			md,
+			key.constData(),
+			key.size(),
+			Raw(data),
+			size_t(data.size()),
+			Writable(result),
+			&size)) {
+		return std::nullopt;
+	}
+	result.resize(int(size));
+	return result;
+}
+
+[[nodiscard]] bool Pad(
+		EVP_PKEY_CTX *context,
+		const EVP_MD *md,
+		int padding,
+		int saltLength) {
+	if (!padding) {
+		return true;
+	} else if (EVP_PKEY_CTX_set_rsa_padding(context, padding) <= 0) {
+		return false;
+	}
+	return (padding != RSA_PKCS1_PSS_PADDING)
+		|| (EVP_PKEY_CTX_set_rsa_pss_saltlen(context, saltLength) > 0
+			&& EVP_PKEY_CTX_set_rsa_mgf1_md(context, md) > 0);
+}
+
+[[nodiscard]] std::optional<QByteArray> DigestSign(
+		EVP_PKEY *key,
+		const EVP_MD *md,
+		const QByteArray &data,
+		int padding,
+		int saltLength) {
+	auto context = Owned<EVP_MD_CTX>(EVP_MD_CTX_new());
+	EVP_PKEY_CTX *keyContext = nullptr;
+	if (!context
+		|| EVP_DigestSignInit(
+			context.get(),
+			&keyContext,
+			md,
+			nullptr,
+			key) != 1
+		|| !Pad(keyContext, md, padding, saltLength)) {
+		return std::nullopt;
+	}
+	auto size = size_t();
+	if (EVP_DigestSign(
+			context.get(),
+			nullptr,
+			&size,
+			Raw(data),
+			size_t(data.size())) != 1) {
+		return std::nullopt;
+	}
+	auto result = QByteArray(int(size), Qt::Uninitialized);
+	if (EVP_DigestSign(
+			context.get(),
+			Writable(result),
+			&size,
+			Raw(data),
+			size_t(data.size())) != 1) {
+		return std::nullopt;
+	}
+	result.resize(int(size));
+	return result;
+}
+
+[[nodiscard]] int DigestVerify(
+		EVP_PKEY *key,
+		const EVP_MD *md,
+		const QByteArray &data,
+		const QByteArray &signature,
+		int padding,
+		int saltLength) {
+	auto context = Owned<EVP_MD_CTX>(EVP_MD_CTX_new());
+	EVP_PKEY_CTX *keyContext = nullptr;
+	if (!context
+		|| EVP_DigestVerifyInit(
+			context.get(),
+			&keyContext,
+			md,
+			nullptr,
+			key) != 1
+		|| !Pad(keyContext, md, padding, saltLength)) {
+		return -1;
+	}
+	return (EVP_DigestVerify(
+		context.get(),
+		Raw(signature),
+		size_t(signature.size()),
+		Raw(data),
+		size_t(data.size())) == 1) ? 1 : 0;
+}
+
+[[nodiscard]] std::optional<QByteArray> DerToP1363(
+		const QByteArray &der,
+		int size) {
+	auto in = Raw(der);
+	auto signature = Owned<ECDSA_SIG>(
+		d2i_ECDSA_SIG(nullptr, &in, long(der.size())));
+	if (!signature) {
+		return std::nullopt;
+	}
+	const BIGNUM *r = nullptr;
+	const BIGNUM *s = nullptr;
+	ECDSA_SIG_get0(signature.get(), &r, &s);
+	auto result = QByteArray(size * 2, Qt::Uninitialized);
+	const auto out = Writable(result);
+	if (BN_bn2binpad(r, out, size) != size
+		|| BN_bn2binpad(s, out + size, size) != size) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<QByteArray> P1363ToDer(
+		const QByteArray &signature,
+		int size) {
+	if (size <= 0 || signature.size() != size * 2) {
+		return std::nullopt;
+	}
+	const auto r = BN_bin2bn(Raw(signature), size, nullptr);
+	const auto s = BN_bin2bn(Raw(signature) + size, size, nullptr);
+	auto result = Owned<ECDSA_SIG>(ECDSA_SIG_new());
+	if (!r || !s || !result || ECDSA_SIG_set0(result.get(), r, s) != 1) {
+		BN_free(r);
+		BN_free(s);
+		return std::nullopt;
+	}
+	const auto length = i2d_ECDSA_SIG(result.get(), nullptr);
+	if (length <= 0) {
+		return std::nullopt;
+	}
+	auto der = QByteArray(length, Qt::Uninitialized);
+	auto out = Writable(der);
+	if (i2d_ECDSA_SIG(result.get(), &out) != length) {
+		return std::nullopt;
+	}
+	return der;
+}
+
+[[nodiscard]] std::optional<KeyKind> SignKind(const std::string &algorithm) {
+	return (algorithm == "ECDSA")
+		? std::make_optional(KeyKind::Ec)
+		: (algorithm == "Ed25519")
+		? std::make_optional(KeyKind::Ed25519)
+		: (algorithm == "RSASSA-PKCS1-v1_5" || algorithm == "RSA-PSS")
+		? std::make_optional(KeyKind::Rsa)
+		: std::nullopt;
+}
+
+[[nodiscard]] int PaddingOf(const std::string &algorithm) {
+	return (algorithm == "RSASSA-PKCS1-v1_5")
+		? RSA_PKCS1_PADDING
+		: (algorithm == "RSA-PSS")
+		? RSA_PKCS1_PSS_PADDING
+		: 0;
+}
+
+[[nodiscard]] Outcome Sign(
+		const std::string &algorithm,
+		KeyPointer key,
+		const QByteArray &data,
+		const EVP_MD *md,
+		int saltLength) {
+	if (algorithm == "HMAC") {
+		if (key->kind != KeyKind::Secret) {
+			return Failed(kInvalidAccessError, "HMAC needs a secret key");
+		} else if (!md) {
+			return Failed(kNotSupportedError, "the hash is unknown");
+		}
+		const auto result = Hmac(md, key->secret, data);
+		return result
+			? BufferOutcome(*result)
+			: Failed(kOperationError, "the signing failed");
+	}
+	const auto kind = SignKind(algorithm);
+	if (!kind) {
+		return Failed(kNotSupportedError, "the algorithm can't sign");
+	} else if (key->kind != *kind || !key->isPrivate) {
+		return Failed(
+			kInvalidAccessError,
+			"the key can't sign with this algorithm");
+	} else if (*kind != KeyKind::Ed25519 && !md) {
+		return Failed(kNotSupportedError, "the hash is unknown");
+	}
+	const auto pkey = key->pkey.get();
+	auto result = DigestSign(
+		pkey,
+		(*kind == KeyKind::Ed25519) ? nullptr : md,
+		data,
+		PaddingOf(algorithm),
+		saltLength);
+	if (result && *kind == KeyKind::Ec) {
+		result = DerToP1363(*result, FieldBytes(pkey));
+	}
+	return result
+		? BufferOutcome(*result)
+		: Failed(kOperationError, "the signing failed");
+}
+
+[[nodiscard]] Outcome Verify(
+		const std::string &algorithm,
+		KeyPointer key,
+		const QByteArray &signature,
+		const QByteArray &data,
+		const EVP_MD *md,
+		int saltLength) {
+	if (algorithm == "HMAC") {
+		if (key->kind != KeyKind::Secret) {
+			return Failed(kInvalidAccessError, "HMAC needs a secret key");
+		} else if (!md) {
+			return Failed(kNotSupportedError, "the hash is unknown");
+		}
+		const auto expected = Hmac(md, key->secret, data);
+		if (!expected) {
+			return Failed(kOperationError, "the verification failed");
+		}
+		return BooleanOutcome(expected->size() == signature.size()
+			&& !CRYPTO_memcmp(
+				expected->constData(),
+				signature.constData(),
+				size_t(signature.size())));
+	}
+	const auto kind = SignKind(algorithm);
+	if (!kind) {
+		return Failed(kNotSupportedError, "the algorithm can't verify");
+	} else if (key->kind != *kind || key->isPrivate) {
+		return Failed(
+			kInvalidAccessError,
+			"the key can't verify with this algorithm");
+	} else if (*kind != KeyKind::Ed25519 && !md) {
+		return Failed(kNotSupportedError, "the hash is unknown");
+	}
+	const auto pkey = key->pkey.get();
+	auto der = std::make_optional(signature);
+	if (*kind == KeyKind::Ec) {
+		der = P1363ToDer(signature, FieldBytes(pkey));
+		if (!der) {
+			return BooleanOutcome(false);
+		}
+	}
+	const auto result = DigestVerify(
+		pkey,
+		(*kind == KeyKind::Ed25519) ? nullptr : md,
+		data,
+		*der,
+		PaddingOf(algorithm),
+		saltLength);
+	if (result < 0) {
+		return Failed(kOperationError, "the verification failed");
+	}
+	return BooleanOutcome(result == 1);
+}
+
+[[nodiscard]] const EVP_CIPHER *AesCipher(
+		const std::string &algorithm,
+		int size) {
+	const auto index = (size == 16) ? 0 : (size == 24) ? 1 : (size == 32) ? 2 : -1;
+	if (index < 0) {
+		return nullptr;
+	} else if (algorithm == "AES-GCM") {
+		const EVP_CIPHER *list[] = {
+			EVP_aes_128_gcm(),
+			EVP_aes_192_gcm(),
+			EVP_aes_256_gcm(),
+		};
+		return list[index];
+	} else if (algorithm == "AES-CBC") {
+		const EVP_CIPHER *list[] = {
+			EVP_aes_128_cbc(),
+			EVP_aes_192_cbc(),
+			EVP_aes_256_cbc(),
+		};
+		return list[index];
+	} else if (algorithm == "AES-CTR") {
+		const EVP_CIPHER *list[] = {
+			EVP_aes_128_ecb(),
+			EVP_aes_192_ecb(),
+			EVP_aes_256_ecb(),
+		};
+		return list[index];
+	} else if (algorithm == "AES-KW") {
+		const EVP_CIPHER *list[] = {
+			EVP_aes_128_wrap(),
+			EVP_aes_192_wrap(),
+			EVP_aes_256_wrap(),
+		};
+		return list[index];
+	}
+	return nullptr;
+}
+
+[[nodiscard]] Outcome Gcm(
+		bool encrypt,
+		const EVP_CIPHER *cipher,
+		const QByteArray &key,
+		const CipherParams &params,
+		const QByteArray &data) {
+	const auto tag = params.number / 8;
+	if (params.iv.isEmpty()) {
+		return Failed(kOperationError, "the iv is empty");
+	} else if (params.number % 8 || tag < 4 || tag > 16) {
+		return Failed(kOperationError, "the tag length is wrong");
+	} else if (!encrypt && data.size() < tag) {
+		return Failed(kOperationError, "the data is shorter than the tag");
+	}
+	const auto body = encrypt ? data.size() : (data.size() - tag);
+	auto result = QByteArray(body + tag + kAesBlock, Qt::Uninitialized);
+	auto context = Owned<EVP_CIPHER_CTX>(EVP_CIPHER_CTX_new());
+	const auto out = Writable(result);
+	auto length = 0;
+	auto tail = 0;
+	auto extra = 0;
+	const auto ok = context
+		&& EVP_CipherInit_ex(
+			context.get(),
+			cipher,
+			nullptr,
+			nullptr,
+			nullptr,
+			encrypt ? 1 : 0) == 1
+		&& EVP_CIPHER_CTX_ctrl(
+			context.get(),
+			EVP_CTRL_GCM_SET_IVLEN,
+			int(params.iv.size()),
+			nullptr) == 1
+		&& EVP_CipherInit_ex(
+			context.get(),
+			nullptr,
+			nullptr,
+			Raw(key),
+			Raw(params.iv),
+			-1) == 1
+		&& (params.extra.isEmpty()
+			|| EVP_CipherUpdate(
+				context.get(),
+				nullptr,
+				&extra,
+				Raw(params.extra),
+				int(params.extra.size())) == 1)
+		&& EVP_CipherUpdate(
+			context.get(),
+			out,
+			&length,
+			Raw(data),
+			int(body)) == 1
+		&& (encrypt
+			|| EVP_CIPHER_CTX_ctrl(
+				context.get(),
+				EVP_CTRL_GCM_SET_TAG,
+				tag,
+				const_cast<char*>(data.constData() + body)) == 1)
+		&& EVP_CipherFinal_ex(context.get(), out + length, &tail) == 1
+		&& (!encrypt
+			|| EVP_CIPHER_CTX_ctrl(
+				context.get(),
+				EVP_CTRL_GCM_GET_TAG,
+				tag,
+				out + length + tail) == 1);
+	if (!ok) {
+		return Failed(
+			kOperationError,
+			encrypt ? "the encryption failed" : "the data or the tag is wrong");
+	}
+	result.resize(length + tail + (encrypt ? tag : 0));
+	return BufferOutcome(std::move(result));
+}
+
+[[nodiscard]] Outcome Block(
+		bool encrypt,
+		const EVP_CIPHER *cipher,
+		const QByteArray &key,
+		const QByteArray &iv,
+		const QByteArray &data,
+		bool wrap) {
+	auto context = Owned<EVP_CIPHER_CTX>(EVP_CIPHER_CTX_new());
+	auto result = QByteArray(data.size() + 2 * kAesBlock, Qt::Uninitialized);
+	const auto out = Writable(result);
+	auto length = 0;
+	auto tail = 0;
+	if (context && wrap) {
+		EVP_CIPHER_CTX_set_flags(
+			context.get(),
+			EVP_CIPHER_CTX_FLAG_WRAP_ALLOW);
+	}
+	const auto ok = context
+		&& EVP_CipherInit_ex(
+			context.get(),
+			cipher,
+			nullptr,
+			Raw(key),
+			iv.isEmpty() ? nullptr : Raw(iv),
+			encrypt ? 1 : 0) == 1
+		&& EVP_CipherUpdate(
+			context.get(),
+			out,
+			&length,
+			Raw(data),
+			int(data.size())) > 0
+		&& EVP_CipherFinal_ex(context.get(), out + length, &tail) == 1;
+	if (!ok) {
+		return Failed(
+			kOperationError,
+			encrypt ? "the encryption failed" : "the data is wrong");
+	}
+	result.resize(length + tail);
+	return BufferOutcome(std::move(result));
+}
+
+[[nodiscard]] Outcome Ctr(
+		const EVP_CIPHER *cipher,
+		const QByteArray &key,
+		const CipherParams &params,
+		const QByteArray &data) {
+	const auto bits = params.number;
+	if (params.iv.size() != kAesBlock || bits < 1 || bits > 128) {
+		return Failed(
+			kOperationError,
+			"the counter has 16 bytes and a length from 1 to 128");
+	}
+	const auto blocks = (uint64_t(data.size()) + kAesBlock - 1) / kAesBlock;
+	if (bits < 64 && blocks > (uint64_t(1) << bits)) {
+		return Failed(kOperationError, "the counter would repeat");
+	}
+	auto high = uint64_t();
+	auto low = uint64_t();
+	for (auto i = 0; i != 8; ++i) {
+		high = (high << 8) | uchar(params.iv[i]);
+		low = (low << 8) | uchar(params.iv[i + 8]);
+	}
+	const auto lowMask = (bits >= 64)
+		? ~uint64_t()
+		: ((uint64_t(1) << bits) - 1);
+	const auto highMask = (bits <= 64)
+		? uint64_t()
+		: (bits == 128)
+		? ~uint64_t()
+		: ((uint64_t(1) << (bits - 64)) - 1);
+	auto context = Owned<EVP_CIPHER_CTX>(EVP_CIPHER_CTX_new());
+	if (!context
+		|| EVP_EncryptInit_ex(
+			context.get(),
+			cipher,
+			nullptr,
+			Raw(key),
+			nullptr) != 1
+		|| EVP_CIPHER_CTX_set_padding(context.get(), 0) != 1) {
+		return Failed(kOperationError, "the encryption failed");
+	}
+	auto result = QByteArray(data.size(), Qt::Uninitialized);
+	auto counters = QByteArray(kCtrChunk * kAesBlock, Qt::Uninitialized);
+	auto stream = QByteArray(kCtrChunk * kAesBlock + kAesBlock, Qt::Uninitialized);
+	const auto input = Raw(data);
+	const auto output = Writable(result);
+	const auto counter = Writable(counters);
+	const auto keystream = Writable(stream);
+	const auto total = int(data.size());
+	for (auto offset = 0; offset < total;) {
+		const auto left = total - offset;
+		const auto count = std::min(
+			kCtrChunk,
+			(left + kAesBlock - 1) / kAesBlock);
+		for (auto block = 0; block != count; ++block) {
+			const auto at = counter + block * kAesBlock;
+			for (auto i = 0; i != 8; ++i) {
+				at[i] = uchar(high >> (56 - 8 * i));
+				at[i + 8] = uchar(low >> (56 - 8 * i));
+			}
+			const auto next = low + 1;
+			if (bits > 64 && next == 0) {
+				high = (high & ~highMask) | ((high + 1) & highMask);
+			}
+			low = (low & ~lowMask) | (next & lowMask);
+		}
+		auto produced = 0;
+		if (EVP_EncryptUpdate(
+				context.get(),
+				keystream,
+				&produced,
+				counter,
+				count * kAesBlock) != 1
+			|| produced != count * kAesBlock) {
+			return Failed(kOperationError, "the encryption failed");
+		}
+		const auto size = std::min(left, count * kAesBlock);
+		for (auto i = 0; i != size; ++i) {
+			output[offset + i] = uchar(input[offset + i] ^ keystream[i]);
+		}
+		offset += size;
+	}
+	return BufferOutcome(std::move(result));
+}
+
+[[nodiscard]] Outcome Oaep(
+		bool encrypt,
+		EVP_PKEY *key,
+		const CipherParams &params,
+		const QByteArray &data) {
+	if (!params.md) {
+		return Failed(kNotSupportedError, "the hash is unknown");
+	}
+	auto context = Owned<EVP_PKEY_CTX>(
+		EVP_PKEY_CTX_new_from_pkey(nullptr, key, nullptr));
+	auto ok = context
+		&& (encrypt
+			? EVP_PKEY_encrypt_init(context.get())
+			: EVP_PKEY_decrypt_init(context.get())) > 0
+		&& EVP_PKEY_CTX_set_rsa_padding(
+			context.get(),
+			RSA_PKCS1_OAEP_PADDING) > 0
+		&& EVP_PKEY_CTX_set_rsa_oaep_md(context.get(), params.md) > 0
+		&& EVP_PKEY_CTX_set_rsa_mgf1_md(context.get(), params.md) > 0;
+	if (ok && !params.extra.isEmpty()) {
+		const auto label = OPENSSL_memdup(
+			params.extra.constData(),
+			size_t(params.extra.size()));
+		ok = label
+			&& EVP_PKEY_CTX_set0_rsa_oaep_label(
+				context.get(),
+				label,
+				int(params.extra.size())) > 0;
+		if (!ok) {
+			OPENSSL_free(label);
+		}
+	}
+	const auto run = encrypt ? EVP_PKEY_encrypt : EVP_PKEY_decrypt;
+	auto size = size_t();
+	if (!ok
+		|| run(
+			context.get(),
+			nullptr,
+			&size,
+			Raw(data),
+			size_t(data.size())) <= 0) {
+		return Failed(
+			kOperationError,
+			encrypt ? "the encryption failed" : "the decryption failed");
+	}
+	auto result = QByteArray(int(size), Qt::Uninitialized);
+	if (run(
+			context.get(),
+			Writable(result),
+			&size,
+			Raw(data),
+			size_t(data.size())) <= 0) {
+		return Failed(
+			kOperationError,
+			encrypt ? "the encryption failed" : "the decryption failed");
+	}
+	result.resize(int(size));
+	return BufferOutcome(std::move(result));
+}
+
+[[nodiscard]] Outcome Cipher(
+		bool encrypt,
+		const std::string &algorithm,
+		KeyPointer key,
+		const QByteArray &data,
+		const CipherParams &params) {
+	if (algorithm == "RSA-OAEP") {
+		if (key->kind != KeyKind::Rsa || key->isPrivate == encrypt) {
+			return Failed(
+				kInvalidAccessError,
+				"RSA-OAEP encrypts with public keys and decrypts with private keys");
+		}
+		return Oaep(encrypt, key->pkey.get(), params, data);
+	} else if (key->kind != KeyKind::Secret) {
+		return Failed(kInvalidAccessError, "AES needs a secret key");
+	}
+	const auto cipher = AesCipher(algorithm, key->secret.size());
+	if (!cipher) {
+		return Failed(kNotSupportedError, "the algorithm can't encrypt");
+	} else if (algorithm == "AES-GCM") {
+		return Gcm(encrypt, cipher, key->secret, params, data);
+	} else if (algorithm == "AES-CTR") {
+		return Ctr(cipher, key->secret, params, data);
+	} else if (algorithm == "AES-CBC") {
+		if (params.iv.size() != kAesBlock) {
+			return Failed(kOperationError, "the AES-CBC iv has 16 bytes");
+		}
+		return Block(encrypt, cipher, key->secret, params.iv, data, false);
+	} else if (data.size() % 8 || data.size() < (encrypt ? 16 : 24)) {
+		return Failed(
+			kOperationError,
+			"AES-KW data is a multiple of 8 bytes, at least 16");
+	}
+	return Block(encrypt, cipher, key->secret, QByteArray(), data, true);
+}
+
+[[nodiscard]] OSSL_PARAM Octets(const char *name, const QByteArray &bytes) {
+	return OSSL_PARAM_construct_octet_string(
+		name,
+		const_cast<char*>(bytes.constData()),
+		size_t(bytes.size()));
+}
+
+[[nodiscard]] std::optional<QByteArray> Kdf(
+		bool pbkdf2,
+		const QByteArray &secret,
+		const DeriveParams &params,
+		int size) {
+	auto kdf = Owned<EVP_KDF>(
+		EVP_KDF_fetch(nullptr, pbkdf2 ? "PBKDF2" : "HKDF", nullptr));
+	auto context = Owned<EVP_KDF_CTX>(
+		kdf ? EVP_KDF_CTX_new(kdf.get()) : nullptr);
+	if (!context) {
+		return std::nullopt;
+	}
+	auto iterations = params.iterations;
+	auto relaxed = 1;
+	auto list = std::vector<OSSL_PARAM>();
+	list.push_back(OSSL_PARAM_construct_utf8_string(
+		OSSL_KDF_PARAM_DIGEST,
+		const_cast<char*>(EVP_MD_get0_name(params.md)),
+		0));
+	if (pbkdf2) {
+		list.push_back(OSSL_PARAM_construct_int(
+			OSSL_KDF_PARAM_PKCS5,
+			&relaxed));
+		list.push_back(Octets(OSSL_KDF_PARAM_PASSWORD, secret));
+		list.push_back(Octets(OSSL_KDF_PARAM_SALT, params.salt));
+		list.push_back(OSSL_PARAM_construct_uint64(
+			OSSL_KDF_PARAM_ITER,
+			&iterations));
+	} else {
+		list.push_back(Octets(OSSL_KDF_PARAM_KEY, secret));
+		if (!params.salt.isEmpty()) {
+			list.push_back(Octets(OSSL_KDF_PARAM_SALT, params.salt));
+		}
+		if (!params.info.isEmpty()) {
+			list.push_back(Octets(OSSL_KDF_PARAM_INFO, params.info));
+		}
+	}
+	list.push_back(OSSL_PARAM_construct_end());
+	auto result = QByteArray(size, Qt::Uninitialized);
+	if (EVP_KDF_derive(
+			context.get(),
+			Writable(result),
+			size_t(size),
+			list.data()) != 1) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<QByteArray> Agree(
+		EVP_PKEY *mine,
+		EVP_PKEY *theirs) {
+	auto context = Owned<EVP_PKEY_CTX>(
+		EVP_PKEY_CTX_new_from_pkey(nullptr, mine, nullptr));
+	auto size = size_t();
+	if (!context
+		|| EVP_PKEY_derive_init(context.get()) <= 0
+		|| EVP_PKEY_derive_set_peer(context.get(), theirs) <= 0
+		|| EVP_PKEY_derive(context.get(), nullptr, &size) <= 0) {
+		return std::nullopt;
+	}
+	auto result = QByteArray(int(size), Qt::Uninitialized);
+	if (EVP_PKEY_derive(context.get(), Writable(result), &size) <= 0) {
+		return std::nullopt;
+	}
+	result.resize(int(size));
+	return result;
+}
+
+[[nodiscard]] Outcome Truncated(QByteArray bytes, int bits) {
+	if (bits < 0) {
+		return BufferOutcome(std::move(bytes));
+	} else if (bits > bytes.size() * 8) {
+		return Failed(
+			kOperationError,
+			"the length is longer than the shared secret");
+	}
+	bytes.resize((bits + 7) / 8);
+	if (const auto rest = bits % 8) {
+		const auto last = bytes.size() - 1;
+		bytes[last] = char(uchar(bytes[last]) & uchar(0xFF << (8 - rest)));
+	}
+	return BufferOutcome(std::move(bytes));
+}
+
+[[nodiscard]] Outcome Derive(
+		const std::string &algorithm,
+		KeyPointer key,
+		int bits,
+		const DeriveParams &params) {
+	if (algorithm == "PBKDF2" || algorithm == "HKDF") {
+		const auto pbkdf2 = (algorithm == "PBKDF2");
+		if (key->kind != KeyKind::Secret) {
+			return Failed(kInvalidAccessError, "the key is not a secret");
+		} else if (!params.md) {
+			return Failed(kNotSupportedError, "the hash is unknown");
+		} else if (bits <= 0 || bits % 8) {
+			return Failed(
+				kOperationError,
+				"the length is a positive multiple of 8");
+		} else if (pbkdf2 && !params.iterations) {
+			return Failed(kOperationError, "iterations is at least 1");
+		}
+		const auto result = Kdf(pbkdf2, key->secret, params, bits / 8);
+		return result
+			? BufferOutcome(*result)
+			: Failed(kOperationError, "the derivation failed");
+	}
+	const auto kind = (algorithm == "ECDH")
+		? std::make_optional(KeyKind::Ec)
+		: (algorithm == "X25519")
+		? std::make_optional(KeyKind::X25519)
+		: std::nullopt;
+	if (!kind) {
+		return Failed(kNotSupportedError, "the algorithm can't derive");
+	} else if (key->kind != *kind
+		|| !key->isPrivate
+		|| !params.peer
+		|| params.peer->kind != *kind
+		|| params.peer->isPrivate
+		|| (*kind == KeyKind::Ec
+			&& CurveOf(key->pkey.get())
+				!= CurveOf(params.peer->pkey.get()))) {
+		return Failed(
+			kInvalidAccessError,
+			"the keys don't make a pair for this algorithm");
+	}
+	auto result = Agree(key->pkey.get(), params.peer->pkey.get());
+	if (!result) {
+		return Failed(kOperationError, "the key agreement failed");
+	}
+	auto outcome = Truncated(*result, bits);
+	OPENSSL_cleanse(result->data(), size_t(result->size()));
+	return outcome;
+}
+
+[[nodiscard]] Outcome Digest(const EVP_MD *md, const QByteArray &data) {
+	auto result = QByteArray(EVP_MD_get_size(md), Qt::Uninitialized);
+	auto size = 0u;
+	if (EVP_Digest(
+			data.constData(),
+			size_t(data.size()),
+			Writable(result),
+			&size,
+			md,
+			nullptr) != 1) {
+		return Failed(kOperationError, "the digest failed");
+	}
+	result.resize(int(size));
+	return BufferOutcome(std::move(result));
+}
+
+[[nodiscard]] std::map<JSRuntime*, JSClassID> &HandleClasses() {
+	static auto result = std::map<JSRuntime*, JSClassID>();
+	return result;
+}
+
+void FinalizeHandle(JSRuntime *runtime, JSValueConst value) {
+	auto id = JSClassID();
+	delete static_cast<KeyPointer*>(JS_GetAnyOpaque(value, &id));
+}
+
+[[nodiscard]] bool IsHandleClass(JSContext *ctx, JSClassID id) {
+	const auto runtime = JS_GetRuntime(ctx);
+	if (!id || !JS_IsRegisteredClass(runtime, id)) {
+		return false;
+	}
+	const auto atom = JS_GetClassName(runtime, id);
+	if (atom == JS_ATOM_NULL) {
+		return false;
+	}
+	const auto name = JS_AtomToCString(ctx, atom);
+	const auto result = name && (std::string_view(name) == kHandleClass);
+	if (name) {
+		JS_FreeCString(ctx, name);
+	}
+	JS_FreeAtom(ctx, atom);
+	return result;
+}
+
+void RegisterHandleClass(JSContext *ctx) {
+	const auto runtime = JS_GetRuntime(ctx);
+	auto &classes = HandleClasses();
+	const auto i = classes.find(runtime);
+	if (i != end(classes) && IsHandleClass(ctx, i->second)) {
+		return;
+	}
+	auto id = JSClassID();
+	JS_NewClassID(runtime, &id);
+	auto definition = JSClassDef();
+	definition.class_name = kHandleClass;
+	definition.finalizer = FinalizeHandle;
+	if (JS_NewClass(runtime, id, &definition) == 0) {
+		classes[runtime] = id;
+	}
+}
+
+[[nodiscard]] JSClassID HandleClass(JSContext *ctx) {
+	const auto &classes = HandleClasses();
+	const auto i = classes.find(JS_GetRuntime(ctx));
+	return (i != end(classes)) ? i->second : JSClassID();
+}
+
+[[nodiscard]] JSValue NewHandle(JSContext *ctx, KeyPointer key) {
+	const auto id = HandleClass(ctx);
+	if (!id || !key) {
+		return JS_ThrowInternalError(ctx, "the crypto key class is missing");
+	}
+	auto result = JS_NewObjectClass(ctx, id);
+	if (!JS_IsException(result)) {
+		JS_SetOpaque(result, new KeyPointer(std::move(key)));
+	}
+	return result;
+}
+
+[[nodiscard]] KeyPointer KeyOf(JSContext *ctx, JSValueConst value) {
+	const auto id = HandleClass(ctx);
+	const auto found = id
+		? static_cast<KeyPointer*>(JS_GetOpaque(value, id))
+		: nullptr;
+	return found ? *found : nullptr;
+}
+
+[[nodiscard]] JSValue MakeDomError(
+		JSContext *ctx,
+		const char *name,
+		const QString &message) {
+	auto global = JS_GetGlobalObject(ctx);
+	auto constructor = JS_GetPropertyStr(ctx, global, "DOMException");
+	JS_FreeValue(ctx, global);
+	if (!JS_IsConstructor(ctx, constructor)) {
+		JS_FreeValue(ctx, constructor);
+		JS_ThrowDOMException(ctx, name, "%s", message.toUtf8().constData());
+		return JS_GetException(ctx);
+	}
+	JSValue args[] = { NewString(ctx, message), JS_NewString(ctx, name) };
+	auto result = JS_CallConstructor(ctx, constructor, 2, args);
+	for (const auto &arg : args) {
+		JS_FreeValue(ctx, arg);
+	}
+	JS_FreeValue(ctx, constructor);
+	return JS_IsException(result) ? JS_GetException(ctx) : result;
+}
+
+[[nodiscard]] JSValue ToJs(JSContext *ctx, const Outcome &outcome) {
+	switch (outcome.type) {
+	case Outcome::Type::Buffer:
+		return JS_NewArrayBufferCopy(
+			ctx,
+			Raw(outcome.bytes),
+			size_t(outcome.bytes.size()));
+	case Outcome::Type::Boolean:
+		return JS_NewBool(ctx, outcome.flag);
+	case Outcome::Type::Key:
+		return NewHandle(ctx, outcome.key);
+	case Outcome::Type::Pair: {
+		auto result = JS_NewArray(ctx);
+		JS_SetPropertyUint32(ctx, result, 0, NewHandle(ctx, outcome.key));
+		JS_SetPropertyUint32(ctx, result, 1, NewHandle(ctx, outcome.second));
+		return result;
+	}
+	case Outcome::Type::List: {
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto &part : outcome.parts) {
+			JS_SetPropertyUint32(ctx, result, index++, NewBytes(ctx, part));
+		}
+		return result;
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] JSValue Launch(JSContext *ctx, Fn<Outcome()> job) {
+	auto made = NewPending(ctx);
+	if (JS_IsException(made.second)) {
+		return made.second;
+	}
+	const auto pending = made.first;
+	crl::async([=] {
+		const auto outcome = std::make_shared<Outcome>(job());
+		crl::on_main([=] {
+			if (outcome->error) {
+				RejectWith(pending, [=](JSContext *context) {
+					return MakeDomError(
+						context,
+						outcome->error,
+						outcome->message);
+				});
+			} else {
+				Resolve(pending, [=](JSContext *context) {
+					return ToJs(context, *outcome);
+				});
+			}
+		});
+	});
+	return made.second;
+}
+
+[[nodiscard]] JSValue Info(JSContext *ctx, const KeyPointer &key) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"kind",
+		JS_NewString(ctx, KindName(key->kind)));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"private",
+		JS_NewBool(ctx, key->isPrivate));
+	if (key->kind == KeyKind::Secret) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"bits",
+			JS_NewInt32(ctx, key->secret.size() * 8));
+		return result;
+	}
+	const auto pkey = key->pkey.get();
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"bits",
+		JS_NewInt32(ctx, EVP_PKEY_get_bits(pkey)));
+	if (key->kind == KeyKind::Ec) {
+		const auto curve = CurveOf(pkey);
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"curve",
+			JS_NewStringLen(ctx, curve.data(), curve.size()));
+	} else if (key->kind == KeyKind::Rsa) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"exponent",
+			NewBytes(
+				ctx,
+				Number(pkey, OSSL_PKEY_PARAM_RSA_E, 0).value_or(QByteArray())));
+	}
+	return result;
+}
+
+[[nodiscard]] int IntegerOf(
+		JSContext *ctx,
+		JSValueConst value,
+		int fallback) {
+	auto result = 0.;
+	if (!JS_IsNumber(value)
+		|| JS_ToFloat64(ctx, &result, value)
+		|| !std::isfinite(result)) {
+		return fallback;
+	}
+	return int(std::clamp(result, -1e9, 1e9));
+}
+
+[[nodiscard]] uint64_t CountOf(JSContext *ctx, JSValueConst value) {
+	auto result = 0.;
+	if (!JS_IsNumber(value)
+		|| JS_ToFloat64(ctx, &result, value)
+		|| !std::isfinite(result)) {
+		return 0;
+	}
+	return uint64_t(std::clamp(result, 0., 4294967295.));
+}
+
+[[nodiscard]] QByteArray BytesOf(JSContext *ctx, JSValueConst value) {
+	return BytesFrom(ctx, value).value_or(QByteArray());
+}
+
+[[nodiscard]] std::string TextOf(JSContext *ctx, JSValueConst value) {
+	return JS_IsString(value) ? ToStd(ctx, value) : std::string();
+}
+
+[[nodiscard]] Parts PartsOf(JSContext *ctx, JSValueConst value) {
+	auto result = Parts();
+	auto length = JS_GetPropertyStr(ctx, value, "length");
+	const auto count = std::clamp(IntegerOf(ctx, length, 0), 0, 16);
+	JS_FreeValue(ctx, length);
+	for (auto i = 0; i != count; ++i) {
+		auto item = JS_GetPropertyUint32(ctx, value, uint32_t(i));
+		result.push_back(JS_IsUndefined(item)
+			? std::nullopt
+			: BytesFrom(ctx, item));
+		JS_FreeValue(ctx, item);
+	}
+	return result;
+}
+
+JSValue NativeCrypto(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto arg = [&](int index) {
+		return (index < argc) ? argv[index] : JS_UNDEFINED;
+	};
+	const auto text = [&](int index) {
+		return TextOf(ctx, arg(index));
+	};
+	switch (Op(magic)) {
+	case Op::Digest: {
+		const auto md = MdOf(text(0));
+		if (!md) {
+			return JS_ThrowTypeError(
+				ctx,
+				"the hash is SHA-1, SHA-256, SHA-384 or SHA-512");
+		}
+		const auto data = BytesOf(ctx, arg(1));
+		return Launch(ctx, [=] {
+			return Digest(md, data);
+		});
+	}
+	case Op::Generate: {
+		const auto kind = KindFrom(text(0));
+		if (!kind) {
+			return JS_ThrowTypeError(ctx, "the key kind is unknown");
+		}
+		const auto curve = text(1);
+		const auto number = IntegerOf(ctx, arg(1), 0);
+		const auto exponent = BytesOf(ctx, arg(2));
+		return Launch(ctx, [=] {
+			return Generate(*kind, curve, number, exponent);
+		});
+	}
+	case Op::Import: {
+		const auto format = text(0);
+		const auto kind = KindFrom(text(1));
+		if (!kind) {
+			return JS_ThrowTypeError(ctx, "the key kind is unknown");
+		}
+		const auto data = BytesOf(ctx, arg(2));
+		const auto curve = text(3);
+		return Launch(ctx, [=] {
+			return (format == "raw")
+				? ImportRaw(*kind, curve, data)
+				: (format == "spki" || format == "pkcs8")
+				? ImportDer(format == "pkcs8", *kind, curve, data)
+				: Failed(kNotSupportedError, "the format is unknown");
+		});
+	}
+	case Op::ImportJwk: {
+		const auto kind = KindFrom(text(0));
+		if (!kind) {
+			return JS_ThrowTypeError(ctx, "the key kind is unknown");
+		}
+		const auto curve = text(1);
+		const auto parts = PartsOf(ctx, arg(2));
+		return Launch(ctx, [=] {
+			return ImportJwk(*kind, curve, parts);
+		});
+	}
+	case Op::Export:
+	case Op::ExportJwk:
+	case Op::Info: {
+		const auto key = KeyOf(ctx, arg((Op(magic) == Op::Export) ? 1 : 0));
+		if (!key) {
+			return JS_ThrowTypeError(ctx, "the key handle is unknown");
+		} else if (Op(magic) == Op::Info) {
+			return Info(ctx, key);
+		} else if (Op(magic) == Op::ExportJwk) {
+			return Launch(ctx, [=] {
+				return ExportJwk(key);
+			});
+		}
+		const auto format = text(0);
+		return Launch(ctx, [=] {
+			return Export(format, key);
+		});
+	}
+	case Op::Sign:
+	case Op::Verify: {
+		const auto verify = (Op(magic) == Op::Verify);
+		const auto algorithm = text(0);
+		const auto key = KeyOf(ctx, arg(1));
+		if (!key) {
+			return JS_ThrowTypeError(ctx, "the key handle is unknown");
+		}
+		const auto signature = verify ? BytesOf(ctx, arg(2)) : QByteArray();
+		const auto data = BytesOf(ctx, arg(verify ? 3 : 2));
+		const auto md = MdOf(text(verify ? 4 : 3));
+		const auto salt = IntegerOf(ctx, arg(verify ? 5 : 4), 0);
+		return Launch(ctx, [=] {
+			return verify
+				? Verify(algorithm, key, signature, data, md, salt)
+				: Sign(algorithm, key, data, md, salt);
+		});
+	}
+	case Op::Encrypt:
+	case Op::Decrypt: {
+		const auto encrypt = (Op(magic) == Op::Encrypt);
+		const auto algorithm = text(0);
+		const auto key = KeyOf(ctx, arg(1));
+		if (!key) {
+			return JS_ThrowTypeError(ctx, "the key handle is unknown");
+		}
+		const auto data = BytesOf(ctx, arg(2));
+		auto params = CipherParams();
+		if (algorithm == "RSA-OAEP") {
+			params.md = MdOf(text(3));
+		} else {
+			params.iv = BytesOf(ctx, arg(3));
+		}
+		if (algorithm == "AES-CTR") {
+			params.number = IntegerOf(ctx, arg(4), 0);
+		} else {
+			params.extra = BytesOf(ctx, arg(4));
+			params.number = IntegerOf(ctx, arg(5), 128);
+		}
+		return Launch(ctx, [=] {
+			return Cipher(encrypt, algorithm, key, data, params);
+		});
+	}
+	case Op::Derive: {
+		const auto algorithm = text(0);
+		const auto key = KeyOf(ctx, arg(1));
+		if (!key) {
+			return JS_ThrowTypeError(ctx, "the key handle is unknown");
+		}
+		const auto bits = IntegerOf(ctx, arg(2), -1);
+		auto params = DeriveParams();
+		if (algorithm == "PBKDF2" || algorithm == "HKDF") {
+			params.md = MdOf(text(3));
+			params.salt = BytesOf(ctx, arg(4));
+			if (algorithm == "PBKDF2") {
+				params.iterations = CountOf(ctx, arg(5));
+			} else {
+				params.info = BytesOf(ctx, arg(5));
+			}
+		} else {
+			params.peer = KeyOf(ctx, arg(3));
+		}
+		return Launch(ctx, [=] {
+			return Derive(algorithm, key, bits, params);
+		});
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+constexpr auto kTypings = std::string_view(R"ts(
+type KeyUsage = 'encrypt' | 'decrypt' | 'sign' | 'verify' | 'deriveKey' | 'deriveBits' | 'wrapKey' | 'unwrapKey'
+type KeyFormat = 'raw' | 'spki' | 'pkcs8' | 'jwk'
+type KeyType = 'public' | 'private' | 'secret'
+type NamedCurve = 'P-256' | 'P-384' | 'P-521'
+type AesName = 'AES-GCM' | 'AES-CBC' | 'AES-CTR' | 'AES-KW'
+type RsaName = 'RSA-OAEP' | 'RSASSA-PKCS1-v1_5' | 'RSA-PSS'
+
+interface JsonWebKey {
+  kty?: string
+  alg?: string
+  use?: string
+  key_ops?: string[]
+  ext?: boolean
+  crv?: string
+  x?: string
+  y?: string
+  d?: string
+  n?: string
+  e?: string
+  p?: string
+  q?: string
+  dp?: string
+  dq?: string
+  qi?: string
+  k?: string
+}
+
+interface KeyAlgorithm {
+  readonly name: string
+  readonly length?: number
+  readonly hash?: { readonly name: HashName }
+  readonly namedCurve?: NamedCurve
+  readonly modulusLength?: number
+  readonly publicExponent?: Uint8Array
+}
+
+declare class CryptoKey {
+  private constructor()
+  readonly type: KeyType
+  readonly extractable: boolean
+  readonly algorithm: KeyAlgorithm
+  readonly usages: readonly KeyUsage[]
+}
+
+interface CryptoKeyPair {
+  publicKey: CryptoKey
+  privateKey: CryptoKey
+}
+
+interface AesGcmParams {
+  name: 'AES-GCM'
+  iv: BufferSource
+  additionalData?: BufferSource
+  tagLength?: 32 | 64 | 96 | 104 | 112 | 120 | 128
+}
+
+interface AesCbcParams {
+  name: 'AES-CBC'
+  iv: BufferSource
+}
+
+interface AesCtrParams {
+  name: 'AES-CTR'
+  counter: BufferSource
+  length: number
+}
+
+interface RsaOaepParams {
+  name: 'RSA-OAEP'
+  label?: BufferSource
+}
+
+interface EcdsaParams {
+  name: 'ECDSA'
+  hash: HashAlgorithm
+}
+
+interface RsaPssParams {
+  name: 'RSA-PSS'
+  saltLength: number
+}
+
+interface Pbkdf2Params {
+  name: 'PBKDF2'
+  salt: BufferSource
+  iterations: number
+  hash: HashAlgorithm
+}
+
+interface HkdfParams {
+  name: 'HKDF'
+  salt: BufferSource
+  info: BufferSource
+  hash: HashAlgorithm
+}
+
+interface EcdhKeyDeriveParams {
+  name: 'ECDH' | 'X25519'
+  public: CryptoKey
+}
+
+interface AesKeyGenParams {
+  name: AesName
+  length: 128 | 192 | 256
+}
+
+interface HmacKeyGenParams {
+  name: 'HMAC'
+  hash: HashAlgorithm
+  length?: number
+}
+
+interface EcKeyGenParams {
+  name: 'ECDSA' | 'ECDH'
+  namedCurve: NamedCurve
+}
+
+interface RsaHashedKeyGenParams {
+  name: RsaName
+  modulusLength: number
+  publicExponent: Uint8Array
+  hash: HashAlgorithm
+}
+
+interface RsaHashedImportParams {
+  name: RsaName
+  hash: HashAlgorithm
+}
+
+type CipherAlgorithm = AesGcmParams | AesCbcParams | AesCtrParams | RsaOaepParams | 'RSA-OAEP'
+type WrapAlgorithm = CipherAlgorithm | 'AES-KW' | { name: 'AES-KW' }
+type SignAlgorithm =
+  | 'HMAC' | 'Ed25519' | 'RSASSA-PKCS1-v1_5'
+  | { name: 'HMAC' | 'Ed25519' | 'RSASSA-PKCS1-v1_5' }
+  | EcdsaParams
+  | RsaPssParams
+type DeriveAlgorithm = Pbkdf2Params | HkdfParams | EcdhKeyDeriveParams
+type PairAlgorithm = EcKeyGenParams | RsaHashedKeyGenParams | 'Ed25519' | 'X25519' | { name: 'Ed25519' | 'X25519' }
+type SecretAlgorithm = AesKeyGenParams | HmacKeyGenParams
+type ImportAlgorithm =
+  | AesName | 'PBKDF2' | 'HKDF' | 'Ed25519' | 'X25519'
+  | { name: AesName | 'PBKDF2' | 'HKDF' | 'Ed25519' | 'X25519' }
+  | HmacKeyGenParams
+  | EcKeyGenParams
+  | RsaHashedImportParams
+type DerivedKeyAlgorithm = AesKeyGenParams | HmacKeyGenParams | 'HKDF' | 'PBKDF2' | { name: 'HKDF' | 'PBKDF2' }
+
+declare class SubtleCrypto {
+  private constructor()
+  digest(algorithm: HashAlgorithm, data: BufferSource): Promise<ArrayBuffer>
+  encrypt(algorithm: CipherAlgorithm, key: CryptoKey, data: BufferSource): Promise<ArrayBuffer>
+  decrypt(algorithm: CipherAlgorithm, key: CryptoKey, data: BufferSource): Promise<ArrayBuffer>
+  sign(algorithm: SignAlgorithm, key: CryptoKey, data: BufferSource): Promise<ArrayBuffer>
+  verify(algorithm: SignAlgorithm, key: CryptoKey, signature: BufferSource, data: BufferSource): Promise<boolean>
+  generateKey(algorithm: PairAlgorithm, extractable: boolean, usages: readonly KeyUsage[]): Promise<CryptoKeyPair>
+  generateKey(algorithm: SecretAlgorithm, extractable: boolean, usages: readonly KeyUsage[]): Promise<CryptoKey>
+  deriveBits(algorithm: DeriveAlgorithm, baseKey: CryptoKey, length?: number | null): Promise<ArrayBuffer>
+  deriveKey(
+    algorithm: DeriveAlgorithm,
