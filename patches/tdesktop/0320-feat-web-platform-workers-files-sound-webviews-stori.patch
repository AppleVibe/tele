--- /dev/null
+++ b/Telegram/Resources/tele/scripting/stories.js
@@ -0,0 +1,402 @@
+(() => {
+	const CHANNEL_SHIFT = 1000000000000n;
+	const PRIVACY = ['everyone', 'contacts', 'close', 'selected'];
+
+	const markedOf = (peer, selfId) => {
+		switch (peer?._) {
+		case 'peerUser':
+		case 'inputPeerUser':
+		case 'inputPeerUserFromMessage':
+			return peer.userId;
+		case 'peerChat':
+		case 'inputPeerChat':
+			return -peer.chatId;
+		case 'peerChannel':
+		case 'inputPeerChannel':
+		case 'inputPeerChannelFromMessage':
+			return -CHANNEL_SHIFT - peer.channelId;
+		case 'inputPeerSelf':
+			return selfId;
+		}
+		return null;
+	};
+
+	const reactionOf = (reaction) => {
+		switch (reaction?._) {
+		case 'reactionEmoji':
+			return reaction.emoticon;
+		case 'reactionCustomEmoji':
+			return { customEmojiId: reaction.documentId };
+		}
+		return null;
+	};
+
+	const inputReactionOf = (reaction) => {
+		if (reaction === null || reaction === undefined) {
+			return { _: 'reactionEmpty' };
+		} else if (typeof reaction === 'string') {
+			return { _: 'reactionEmoji', emoticon: reaction };
+		} else if (typeof reaction === 'object' && reaction.customEmojiId !== undefined) {
+			return { _: 'reactionCustomEmoji', documentId: BigInt(reaction.customEmojiId) };
+		}
+		throw new TypeError('tg.stories.react: a reaction is an emoji string, { customEmojiId } or null');
+	};
+
+	const mediaOf = (media) => {
+		switch (media?._) {
+		case 'messageMediaPhoto':
+			return { type: 'photo', photo: media.photo ?? null, raw: media };
+		case 'messageMediaDocument': {
+			const video = (media.document?._ === 'document')
