+[[nodiscard]] bool SilentOf(not_null<PeerData*> peer) {
+	const auto &settings = peer->owner().notifySettings();
+	return peer->isBroadcast()
+		&& !settings.silentPostsUnknown(peer)
+		&& settings.silentPosts(peer);
