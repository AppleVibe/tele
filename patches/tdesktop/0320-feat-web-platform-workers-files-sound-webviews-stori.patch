+QString ResolveScopeFolder(std::string_view scope) {
+	auto text = QString::fromUtf8(scope.data(), int(scope.size())).trimmed();
+	text.replace('\\', '/');
+	if (text.isEmpty()) {
+		return QString();
+	}
+	const auto slash = text.indexOf('/');
+	const auto head = (slash < 0) ? text : text.left(slash);
+	const auto tail = (slash < 0) ? QString() : text.mid(slash);
+	const auto location = [&]() -> std::optional<QStandardPaths::StandardLocation> {
+		if (head == u"~"_q || head == u"home"_q) {
+			return QStandardPaths::HomeLocation;
+		} else if (head == u"documents"_q) {
+			return QStandardPaths::DocumentsLocation;
+		} else if (head == u"downloads"_q) {
+			return QStandardPaths::DownloadLocation;
+		} else if (head == u"desktop"_q) {
+			return QStandardPaths::DesktopLocation;
+		} else if (head == u"pictures"_q) {
+			return QStandardPaths::PicturesLocation;
+		} else if (head == u"music"_q) {
+			return QStandardPaths::MusicLocation;
+		} else if (head == u"videos"_q) {
+			return QStandardPaths::MoviesLocation;
+		} else if (head == u"temp"_q) {
+			return QStandardPaths::TempLocation;
+		}
+		return std::nullopt;
+	}();
+	auto absolute = QString();
+	if (location) {
+		const auto root = QStandardPaths::writableLocation(*location);
+		if (root.isEmpty()) {
+			return QString();
+		}
+		absolute = root + tail;
+	} else if (QDir::isAbsolutePath(text)) {
+		absolute = text;
+	} else {
+		return QString();
+	}
+	auto clean = QDir::cleanPath(absolute);
+	while (clean.size() > 1 && clean.endsWith('/') && !clean.endsWith(u":/"_q)) {
+		clean.chop(1);
+	}
+	return clean;
+}
+
+bool PathInside(const QString &path, const QString &folder) {
+	if (path.isEmpty() || folder.isEmpty()) {
+		return false;
+	}
+	const auto clean = QDir::cleanPath(QString(path).replace('\\', '/'));
+#ifdef Q_OS_WIN
+	constexpr auto sensitivity = Qt::CaseInsensitive;
+#else
+	constexpr auto sensitivity = Qt::CaseSensitive;
+#endif
+	if (clean.compare(folder, sensitivity) == 0) {
+		return true;
+	}
+	const auto prefix = folder.endsWith('/') ? folder : (folder + '/');
+	return clean.startsWith(prefix, sensitivity);
+}
