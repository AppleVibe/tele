+JSValue NativeGifts(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto what = (argc > 0 && JS_IsString(argv[0]))
+		? ToStd(ctx, argv[0])
+		: std::string("tg.gifts");
+	const auto capability = (Op(magic) == Op::Write)
+		? Capability::AccountWrite
+		: Capability::AccountRead;
+	return Permitted(ctx, capability, "gifts", what.c_str())
+		? JS_UNDEFINED
+		: JS_EXCEPTION;
+}
+
+constexpr auto kTypings = std::string_view(R"TS(
+declare module 'tele' {
+  export interface Tg {
+    readonly gifts: Gifts
+    readonly stars: Stars
+  }
+
+  export type GiftRarity = number | 'uncommon' | 'rare' | 'epic' | 'legendary'
