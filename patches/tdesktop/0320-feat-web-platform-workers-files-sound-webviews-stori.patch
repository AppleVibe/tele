+}
+
+void Panel::createPanel(not_null<QWidget*> parent, const Options &options) {
+	const auto panel = _panel.get();
+	panel->setObjectName(QString::fromLatin1(kPanelName));
+	panel->setWindowFlag(Qt::WindowStaysOnTopHint, false);
+	panel->setWindowTitle(_title.current());
+	panel->setTitle(_title.value());
+	Shortcuts::Listen(panel);
+	base::install_event_filter(panel, [](not_null<QEvent*> e) {
+		return (e->type() == QEvent::KeyPress
+			&& static_cast<QKeyEvent*>(e.get())->key() == Qt::Key_Escape)
+			? base::EventFilterResult::Cancel
+			: base::EventFilterResult::Continue;
+	});
+	panel->closeRequests(
+	) | rpl::on_next([=] {
+		closed();
+	}, panel->lifetime());
+
+	panel->setInnerSize(options.size, options.resizable);
+	if (options.resizable) {
+		const auto frame = panel->size() - panel->innerGeometry().size();
+		panel->setMinimumSize(QSize(
+			style::ConvertScale(kMinSize),
+			style::ConvertScale(kMinSize)) + frame);
+	}
+	PlaceOver(panel, parent);
+
+	auto container = base::make_unique_q<Ui::RpWidget>(panel);
+	_container = container.get();
+	panel->showInner(std::move(container));
+}
+
+bool Panel::createWebview(not_null<Instance*> instance, Options options) {
+	const auto remote = !options.url.isEmpty();
+	const auto permissions = instance->permissions();
+	_webview = std::make_unique<Webview::Window>(
+		_container,
+		Webview::WindowConfig{
+			.opaqueBg = st::windowBg->c,
+			.storageId = StorageFor(instance),
+			.safe = true,
+		});
+	const auto raw = _webview.get();
+	const auto widget = raw->widget();
+	if (!widget) {
+		_webview = nullptr;
+		return false;
+	}
+	widget->show();
+	_container->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		if (const auto widget = raw->widget()) {
+			widget->setGeometry(QRect(QPoint(), size));
+		}
+	}, _container->lifetime());
+	base::qt_signal_producer(
+		qApp,
+		&QGuiApplication::focusWindowChanged
+	) | rpl::filter([=](QWindow *focused) {
+		const auto handle = _panel->windowHandle();
+		const auto widget = raw->widget();
+		return widget
+			&& !widget->isHidden()
+			&& handle
+			&& (focused == handle);
+	}) | rpl::on_next([=] {
+		raw->focus();
+	}, raw->lifetime());
+	QObject::connect(widget, &QObject::destroyed, [=] {
+		if (_webview) {
+			closed();
+		}
+	});
+
+	raw->setNavigationPolicyHandler([=](const QString &uri, bool newWindow) {
+		if (newWindow) {
+			return false;
+		}
+		const auto url = QUrl(uri);
+		const auto scheme = url.scheme().toLower();
+		const auto host = url.host().toLower();
+		if (remote) {
+			return (scheme == u"https"_q)
+				&& !host.isEmpty()
+				&& permissions.allows(Capability::Fetch, host.toStdString());
+		}
+		return (scheme == u"http"_q && host == u"desktop-app-resource"_q)
+			|| (scheme == u"http"_q && host == u"127.0.0.1"_q)
+			|| (scheme == u"desktopappresource"_q)
+			|| (scheme == u"about"_q)
+			|| (scheme == u"data"_q)
+			|| (scheme == u"blob"_q);
+	});
+	raw->setNavigationDoneHandler([=](bool) {
+		crl::on_main(this, [=] {
+			loaded();
+		});
+	});
+	raw->setMessageHandler([=](std::string text) {
+		crl::on_main(this, [=, text = std::move(text)] {
+			CallKept(_instance, _handler, [=](JSContext *ctx) {
+				auto result = JS_NewObject(ctx);
+				JS_SetPropertyStr(
+					ctx,
+					result,
+					"type",
+					JS_NewString(ctx, "message"));
+				JS_SetPropertyStr(
+					ctx,
+					result,
+					"text",
+					JS_NewStringLen(ctx, text.data(), text.size()));
+				return result;
+			}, QString::fromLatin1(kWhere));
+		});
+	});
+	if (!remote) {
+		const auto page = WithPolicy(
+			std::move(options.html),
+			PolicyFor(permissions));
+		raw->setDataRequestHandler([=](Webview::DataRequest request) {
+			auto id = std::string_view(request.id);
+			if (const auto cut = id.find_first_of("?#"); cut != id.npos) {
+				id = id.substr(0, cut);
+			}
+			if (!id.starts_with(kPrefix)
+				|| id.substr(kPrefix.size()) != kPage) {
+				return Webview::DataResult::Failed;
+			}
+			request.done({
+				.stream = std::make_unique<Webview::DataStreamFromMemory>(
+					page,
+					"text/html; charset=utf-8"),
+			});
+			return Webview::DataResult::Done;
+		});
+	}
+	style::PaletteChanged(
+	) | rpl::on_next([=] {
+		updateTheme();
+	}, raw->lifetime());
+
+	raw->init(BridgeScript(!remote));
+	if (remote) {
+		raw->navigate(options.url);
+	} else {
+		raw->navigateToData(QString::fromLatin1(
+			kPrefix.data(),
+			kPrefix.size()) + QString::fromLatin1(kPage.data(), kPage.size()));
+	}
+	return true;
+}
+
+void Panel::activate() {
+	const auto state = _panel->windowState();
+	if (state & Qt::WindowMinimized) {
+		_panel->setWindowState(state & ~Qt::WindowMinimized);
+	}
+	_panel->showAndActivate();
+	if (const auto widget = _webview ? _webview->widget() : nullptr) {
+		InvokeQueued(widget, [=] {
+			if (_webview && widget->isVisible()) {
+				_webview->focus();
+			}
+		});
+	}
+}
+
+void Panel::loaded() {
+	if (!_webview) {
+		return;
+	}
+	updateTheme();
+	if (_loaded) {
+		return;
+	}
+	_loaded = true;
+	for (const auto &json : base::take(_queue)) {
+		deliver(json);
+	}
+}
+
+void Panel::post(QByteArray json) {
+	if (!_webview) {
+		return;
+	} else if (!_loaded) {
+		_queue.push_back(std::move(json));
+		return;
+	}
+	deliver(json);
+}
+
+void Panel::deliver(const QByteArray &json) {
+	_webview->eval("if (window.__teleDeliver) window.__teleDeliver('"
+		+ Ui::EscapeForScriptString(json)
+		+ "');");
+}
+
+void Panel::setTitle(const QString &title) {
+	_title = title;
+	if (_panel) {
+		_panel->setWindowTitle(title);
+	}
+}
+
+void Panel::updateTheme() {
+	if (!_webview) {
+		return;
+	}
+	_webview->eval("if (window.__teleTheme) window.__teleTheme("
+		+ ThemeJson()
+		+ ");");
+}
+
+void Panel::closed() {
+	if (_closing) {
+		return;
+	}
+	_closing = true;
+	crl::on_main(this, [=] {
+		ClosedByUser(_instance, _id);
+	});
+}
+
+[[nodiscard]] std::optional<int> SizeProperty(
+		JSContext *ctx,
+		JSValueConst options,
+		const char *name,
+		int fallback) {
+	auto value = JS_GetPropertyStr(ctx, options, name);
+	const auto missing = JS_IsUndefined(value);
+	JS_FreeValue(ctx, value);
+	if (missing) {
+		return fallback;
+	}
+	const auto number = NumberProperty(ctx, options, name);
+	if (!number
+		|| !std::isfinite(*number)
+		|| *number < kMinSize
+		|| *number > kMaxSize) {
+		return std::nullopt;
+	}
+	return int(std::round(*number));
+}
+
+JSValue Open(JSContext *ctx, int argc, JSValueConst *argv) {
+	if (argc < 2 || !JS_IsObject(argv[0]) || !JS_IsFunction(ctx, argv[1])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.ui.webview needs { title, html | url }");
+	}
+	const auto options = argv[0];
+	auto parsed = Options{
+		.title = StringProperty(ctx, options, "title"),
+		.html = StringProperty(ctx, options, "html").toUtf8(),
+		.url = StringProperty(ctx, options, "url"),
+	};
+	const auto width = SizeProperty(ctx, options, "width", kDefaultWidth);
+	const auto height = SizeProperty(ctx, options, "height", kDefaultHeight);
+	if (parsed.title.isEmpty()) {
+		return JS_ThrowTypeError(ctx, "tg.ui.webview needs a title");
+	} else if (!width || !height) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.ui.webview: width and height are numbers from %d to %d",
+			kMinSize,
+			kMaxSize);
+	}
+	parsed.size = QSize(
+		style::ConvertScale(*width),
+		style::ConvertScale(*height));
+	auto resizable = JS_GetPropertyStr(ctx, options, "resizable");
+	parsed.resizable = JS_IsUndefined(resizable)
+		|| (JS_ToBool(ctx, resizable) > 0);
+	JS_FreeValue(ctx, resizable);
+
+	auto instance = (Instance*)nullptr;
+	if (!parsed.url.isEmpty()) {
+		const auto url = QUrl(parsed.url, QUrl::StrictMode);
+		const auto host = url.host().toLower();
+		if (!url.isValid()
+			|| url.scheme().toLower() != u"https"_q
+			|| host.isEmpty()) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.ui.webview only takes https urls");
+		}
+		instance = Permitted(
+			ctx,
+			Capability::Fetch,
+			host.toStdString(),
+			kWhere);
+		if (!instance) {
+			return JS_EXCEPTION;
+		}
+	} else {
+		instance = Instance::From(ctx);
+		if (!instance) {
+			return JS_ThrowInternalError(ctx, "the script was stopped");
+		}
+	}
+	const auto available = Webview::Availability();
+	if (available.error != Webview::Available::Error::None) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"tg.ui.webview: "_q
+				+ Ui::BotWebView::ErrorText(available).text);
+	}
+	const auto window = WindowOf(ScriptSession(instance));
+	if (!window) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"tg.ui.webview: this account has no window"_q);
+	}
+	const auto panels = PanelsFor(instance);
+	const auto id = ++panels->next;
+	const auto handler = KeepFunction(instance, argv[1]);
+	auto panel = std::make_unique<Panel>(
+		instance,
+		window,
+		id,
+		handler,
+		std::move(parsed));
+	if (!panel->valid()) {
+		panel = nullptr;
+		ForgetKept(base::make_weak(instance), handler);
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"tg.ui.webview: could not start the webview"_q);
+	}
+	panels->list.emplace(id, std::move(panel));
+	return JS_NewInt32(ctx, id);
+}
+
+JSValue NativeWebview(
+		JSContext *ctx,
+		JSValueConst thisValue,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	if (magic == 0) {
+		return Open(ctx, argc, argv);
+	}
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	auto id = 0;
+	if (argc < 1 || JS_ToInt32(ctx, &id, argv[0]) < 0) {
+		return JS_EXCEPTION;
+	}
+	switch (magic) {
+	case 1: {
+		if (argc < 2 || !JS_IsString(argv[1])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"WebviewPanel.postMessage needs JSON-serializable data");
+		}
+		if (const auto panel = FindPanel(instance, id)) {
+			panel->post(QByteArray::fromStdString(ToStd(ctx, argv[1])));
+		}
+		return JS_UNDEFINED;
+	}
+	case 2: {
+		if (argc < 2 || !JS_IsString(argv[1])) {
+			return JS_ThrowTypeError(
+				ctx,
+				"WebviewPanel.setTitle needs a string");
+		}
+		if (const auto panel = FindPanel(instance, id)) {
+			panel->setTitle(FromStd(ToStd(ctx, argv[1])));
+		}
+		return JS_UNDEFINED;
+	}
+	case 3: {
+		if (auto panel = TakePanel(instance, id)) {
+			const auto handler = panel->handler();
+			panel = nullptr;
+			ForgetKept(base::make_weak(instance), handler);
+		}
+		return JS_UNDEFINED;
+	}
+	}
+	return JS_UNDEFINED;
+}
+
+} // namespace
+
+void AddWebviewNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "webviewOpen", NativeWebview, 2, 0 },
+		{ "webviewPost", NativeWebview, 2, 1 },
+		{ "webviewTitle", NativeWebview, 2, 2 },
+		{ "webviewClose", NativeWebview, 1, 3 },
+	});
+}
+
+std::string_view WebviewTypings() {
+	return R"ts(
+declare module 'tele' {
+  export interface WebviewCommonOptions {
+    title: string
+    width?: number
