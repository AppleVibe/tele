+[[nodiscard]] QString Guarded(
+		const Areas &areas,
+		const QString &path,
+		bool destructive) {
+	if (PathInside(path, areas.root)) {
+		return QString();
+	}
+	for (const auto &folder : areas.tele) {
+		if (Within(path, folder)) {
+			return path + u" is tele's own data"_q;
+		} else if (destructive && Within(folder, path)) {
+			return path + u" contains tele's own data"_q;
+		}
+	}
+	if (path.compare(areas.data, Qt::CaseInsensitive) == 0) {
+		return path + u" holds the file areas of all scripts"_q;
+	} else if (Within(path, areas.data)) {
+		return path + u" is another script's file area"_q;
+	} else if (destructive && Within(areas.data, path)) {
+		return path + u" contains the file areas of all scripts"_q;
+	}
+	return QString();
+}
