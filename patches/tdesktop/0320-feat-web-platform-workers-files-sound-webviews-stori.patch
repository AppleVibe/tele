+ChatBanners::ChatBanners(
+	QWidget *parent,
+	not_null<PeerData*> peer,
+	Fn<void()> relayout)
+: RpWidget(parent)
+, _session(&peer->session())
+, _peer(peer->id)
+, _relayout(std::move(relayout)) {
+	refresh();
+	resizeToWidth(parent->width());
+	BannerChanges().events() | rpl::on_next([=] {
+		if (_scheduled) {
+			return;
