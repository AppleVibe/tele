+[[nodiscard]] bool Within(const QString &path, const QString &folder) {
+	if (path.isEmpty() || folder.isEmpty()) {
+		return false;
+	} else if (path.compare(folder, Qt::CaseInsensitive) == 0) {
+		return true;
+	}
+	const auto prefix = folder.endsWith('/') ? folder : (folder + '/');
+	return path.startsWith(prefix, Qt::CaseInsensitive);
+}
+
+[[nodiscard]] QString Canonical(const QString &path) {
+	auto head = path;
+	auto tail = QString();
+	while (true) {
+		const auto real = QFileInfo(head).canonicalFilePath();
+		if (!real.isEmpty()) {
+			return QDir::cleanPath(real + tail);
+		}
+		const auto slash = head.lastIndexOf('/');
+		if (slash < 0) {
+			return path;
+		}
+		const auto keep = (slash == 0 || head[slash - 1] == ':')
+			? (slash + 1)
+			: slash;
+		if (keep >= head.size()) {
+			return path;
+		}
+		tail = head.mid(slash) + tail;
+		head = head.left(keep);
+	}
+}
