+				raw,
+			};
+		}
+		return {
+			unique: false,
+			id: raw.id,
+			giftId: raw.id,
+			slug: null,
+			link: null,
+			title: raw.title ?? null,
+			number: null,
+			owner: null,
+			ownerName: null,
+			model: null,
+			pattern: null,
+			backdrop: null,
+			originalDetails: null,
+			attributes: [],
+			sticker: raw.sticker ?? null,
+			stars: raw.stars,
+			convertStars: raw.convertStars,
