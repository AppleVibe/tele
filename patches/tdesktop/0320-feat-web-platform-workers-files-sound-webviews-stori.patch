+
+void AppendDecorationButtons(
+		not_null<const HistoryItem*> item,
+		not_null<ReplyKeyboard*> keyboard) {
+	const auto decoration = Find(item);
+	if (!decoration || !decoration->buttons) {
+		return;
+	}
+	const auto owner = &item->history()->owner();
+	const auto id = item->fullId();
+	auto rows = std::vector<std::vector<ReplyKeyboard::ExtraButton>>();
+	rows.reserve(decoration->buttons->size());
+	for (const auto &row : *decoration->buttons) {
+		auto &buttons = rows.emplace_back();
+		buttons.reserve(row.size());
+		for (const auto &button : row) {
+			buttons.push_back({
+				.text = button.text,
+				.color = ColorOf(button.style),
+				.link = std::make_shared<ButtonClickHandler>(
+					owner,
+					id,
+					button.callback),
+			});
+		}
+	}
+	keyboard->appendRows(std::move(rows));
+}
