+	const auto real = Canonical(path);
+	if (own) {
+		return PathInside(real, canonical.root)
+			? QString()
+			: (path + u" leads out of the script's file area"_q);
+	}
+	const auto reason = Guarded(areas, path, destructive);
+	return reason.isEmpty()
+		? Guarded(canonical, real, destructive)
+		: reason;
+}
+
+[[nodiscard]] std::optional<Outcome> Refuse(
+		const Areas &areas,
+		const Target &target,
+		bool destructive,
+		bool tree,
+		const QString &method) {
+	if (target.own && !QDir().mkpath(areas.root)) {
+		return Fail(
+			"internal",
+			method + u": can't create the file area "_q + areas.root);
+	}
+	const auto canonical = CanonicalAreas(areas);
+	auto reason = Refusal(
+		areas,
+		canonical,
+		target.path,
+		target.own,
+		destructive);
+	if (reason.isEmpty() && tree && QFileInfo(target.path).isDir()) {
+		auto i = QDirIterator(
+			target.path,
+			Everything(),
+			QDirIterator::Subdirectories);
+		while (reason.isEmpty() && i.hasNext()) {
+			reason = Refusal(
+				areas,
+				canonical,
+				QDir::cleanPath(i.next()),
+				target.own,
+				destructive);
+		}
+	}
+	if (reason.isEmpty()) {
+		return std::nullopt;
+	}
+	return Fail("forbidden", method + u": "_q + reason);
+}
+
+[[nodiscard]] qint64 SizeOf(const QString &path) {
+	const auto info = QFileInfo(path);
+	if (!info.exists()) {
+		return 0;
+	} else if (!info.isDir()) {
+		return info.size();
+	}
+	auto result = qint64();
+	auto i = QDirIterator(
+		path,
+		QDir::Files | QDir::Hidden | QDir::System,
+		QDirIterator::Subdirectories);
+	while (i.hasNext()) {
+		i.next();
+		result += i.fileInfo().size();
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<Outcome> OverQuota(
+		const Areas &areas,
+		qint64 added,
+		qint64 freed,
+		const QString &method) {
+	if (added <= freed
+		|| SizeOf(areas.root) - freed + added <= kAreaQuota) {
+		return std::nullopt;
+	}
+	return Fail("quota-exceeded", QuotaMessage(method));
+}
+
+[[nodiscard]] Outcome Missing(const QString &method, const QString &path) {
+	return Fail(
+		"not-found",
+		method + u": there's nothing at "_q + path);
+}
+
+[[nodiscard]] Info InfoOf(const QFileInfo &info) {
+	const auto modified = info.lastModified();
+	const auto born = info.birthTime();
+	const auto folder = info.isDir();
+	return Info{
+		.name = info.fileName(),
+		.folder = folder,
+		.size = folder ? qint64() : info.size(),
+		.modified = modified.toMSecsSinceEpoch(),
+		.created = (born.isValid() ? born : modified).toMSecsSinceEpoch(),
+	};
+}
+
+[[nodiscard]] JSValue InfoObject(
+		JSContext *ctx,
+		const Info &info,
+		bool detailed) {
+	auto result = JS_NewObject(ctx);
+	if (!detailed) {
+		JS_SetPropertyStr(ctx, result, "name", NewString(ctx, info.name));
+	}
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"kind",
+		JS_NewString(ctx, info.folder ? "folder" : "file"));
+	JS_SetPropertyStr(ctx, result, "size", JS_NewInt64(ctx, info.size));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"modified",
+		JS_NewInt64(ctx, info.modified));
+	if (detailed) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"created",
+			JS_NewInt64(ctx, info.created));
+	}
+	return result;
+}
+
+[[nodiscard]] bool CopyTree(const QString &from, const QString &to) {
+	if (!QDir().mkpath(to)) {
+		return false;
+	}
+	const auto source = QDir(from);
+	auto i = QDirIterator(from, Everything(), QDirIterator::Subdirectories);
+	while (i.hasNext()) {
+		const auto path = i.next();
+		const auto info = i.fileInfo();
+		const auto destination = to + '/' + source.relativeFilePath(path);
+		if (info.isDir() && !info.isSymLink()) {
+			if (!QDir().mkpath(destination)) {
+				return false;
+			}
+		} else if (!QDir().mkpath(QFileInfo(destination).absolutePath())
+			|| !QFile::copy(path, destination)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] Outcome DoRead(
+		const Areas &areas,
+		const Target &target,
+		bool text,
+		const QString &method) {
+	if (auto refusal = Refuse(areas, target, false, false, method)) {
+		return *refusal;
+	}
+	const auto info = QFileInfo(target.path);
+	if (!info.exists()) {
+		return Missing(method, target.path);
+	} else if (info.isDir()) {
+		return Fail(
+			"unsupported",
+			method + u": "_q + target.path + u" is a folder"_q);
+	} else if (info.size() > kReadLimit) {
+		return Fail(
+			"quota-exceeded",
+			method + u": "_q + target.path + u" is over 256 MB"_q);
+	}
+	auto file = QFile(target.path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return Fail(
+			"internal",
+			method
+				+ u": can't read "_q
+				+ target.path
+				+ u": "_q
+				+ file.errorString());
+	}
+	auto bytes = file.readAll();
+	if (!text) {
+		return Done([=](JSContext *ctx) { return NewBytes(ctx, bytes); });
+	} else if (bytes.startsWith("\xEF\xBB\xBF")) {
+		bytes.remove(0, 3);
+	}
+	return Done([=](JSContext *ctx) {
+		return JS_NewStringLen(ctx, bytes.constData(), bytes.size());
+	});
+}
+
+[[nodiscard]] Outcome DoWrite(
+		const Areas &areas,
+		const Target &target,
+		const QByteArray &bytes,
+		bool append,
+		const QString &method) {
+	const auto lock = std::lock_guard(ChangeMutex());
+	if (auto refusal = Refuse(areas, target, false, false, method)) {
+		return *refusal;
+	}
+	const auto info = QFileInfo(target.path);
+	if (info.isDir()) {
+		return Fail(
+			"unsupported",
+			method + u": "_q + target.path + u" is a folder"_q);
+	} else if (target.own) {
+		const auto freed = (info.exists() && !append)
+			? info.size()
+			: qint64();
+		if (auto over = OverQuota(areas, bytes.size(), freed, method)) {
+			return *over;
+		}
+	}
+	const auto failed = [&](const QString &reason) {
+		return Fail(
+			"internal",
+			method + u": can't write "_q + target.path + u": "_q + reason);
+	};
+	if (!QDir().mkpath(info.absolutePath())) {
+		return failed(u"can't create its folder"_q);
+	} else if (append) {
+		auto file = QFile(target.path);
+		if (!file.open(QIODevice::WriteOnly | QIODevice::Append)
+			|| file.write(bytes) != bytes.size()) {
+			return failed(file.errorString());
+		}
+		return Done();
+	}
+	auto file = QSaveFile(target.path);
+	file.setDirectWriteFallback(true);
+	if (!file.open(QIODevice::WriteOnly)
+		|| file.write(bytes) != bytes.size()
+		|| !file.commit()) {
+		return failed(file.errorString());
+	}
+	return Done();
+}
+
+[[nodiscard]] Outcome DoList(
+		const Areas &areas,
+		const Target &target,
+		const QString &method) {
+	if (auto refusal = Refuse(areas, target, false, false, method)) {
+		return *refusal;
+	}
+	const auto info = QFileInfo(target.path);
+	if (!info.exists()) {
+		return Missing(method, target.path);
+	} else if (!info.isDir()) {
+		return Fail(
+			"unsupported",
+			method + u": "_q + target.path + u" is a file"_q);
+	}
+	auto entries = std::vector<Info>();
+	const auto list = QDir(target.path).entryInfoList(
+		Everything(),
+		QDir::Name);
+	entries.reserve(list.size());
+	for (const auto &entry : list) {
+		entries.push_back(InfoOf(entry));
+	}
+	return Done([=](JSContext *ctx) {
+		auto result = JS_NewArray(ctx);
+		auto index = uint32_t();
+		for (const auto &entry : entries) {
+			JS_SetPropertyUint32(
+				ctx,
+				result,
+				index++,
+				InfoObject(ctx, entry, false));
+		}
+		return result;
+	});
+}
+
+[[nodiscard]] Outcome DoStat(
+		const Areas &areas,
+		const Target &target,
+		const QString &method) {
+	if (auto refusal = Refuse(areas, target, false, false, method)) {
+		return *refusal;
+	}
+	const auto info = QFileInfo(target.path);
+	if (!info.exists()) {
+		return Done([](JSContext*) { return JS_NULL; });
+	}
+	const auto result = InfoOf(info);
+	return Done([=](JSContext *ctx) {
+		return InfoObject(ctx, result, true);
+	});
+}
+
+[[nodiscard]] Outcome DoExists(
+		const Areas &areas,
+		const Target &target,
+		const QString &method) {
+	if (auto refusal = Refuse(areas, target, false, false, method)) {
+		return *refusal;
+	}
+	const auto exists = QFileInfo(target.path).exists();
+	return Done([=](JSContext *ctx) { return JS_NewBool(ctx, exists); });
+}
+
+[[nodiscard]] Outcome DoMkdir(
+		const Areas &areas,
+		const Target &target,
+		bool recursive,
+		const QString &method) {
+	const auto lock = std::lock_guard(ChangeMutex());
+	if (auto refusal = Refuse(areas, target, false, false, method)) {
+		return *refusal;
+	}
+	const auto info = QFileInfo(target.path);
+	if (info.exists()) {
+		return info.isDir()
+			? Done()
+			: Fail(
+				"unsupported",
+				method + u": "_q + target.path + u" is a file"_q);
+	}
+	const auto parent = info.absolutePath();
+	if (!recursive && !QFileInfo(parent).isDir()) {
+		return Fail(
+			"not-found",
+			method + u": there's no folder "_q + parent);
+	}
+	const auto made = recursive
+		? QDir().mkpath(target.path)
+		: QDir().mkdir(target.path);
+	return made
+		? Done()
+		: Fail("internal", method + u": can't create "_q + target.path);
+}
+
+[[nodiscard]] Outcome DoRemove(
+		const Areas &areas,
+		const Target &target,
+		bool recursive,
+		const QString &method) {
+	const auto lock = std::lock_guard(ChangeMutex());
+	if (auto refusal = Refuse(areas, target, true, recursive, method)) {
+		return *refusal;
+	}
+	const auto info = QFileInfo(target.path);
+	if (!info.exists() && !info.isSymLink()) {
+		return Missing(method, target.path);
+	}
+	const auto failed = Fail(
+		"internal",
+		method + u": can't remove "_q + target.path);
+	if (info.isSymLink()) {
+		return (QFile::remove(target.path) || QDir().rmdir(target.path))
+			? Done()
+			: failed;
+	} else if (!info.isDir()) {
+		return QFile::remove(target.path) ? Done() : failed;
+	} else if (recursive) {
+		return QDir(target.path).removeRecursively() ? Done() : failed;
+	} else if (!QDir(target.path).isEmpty(Everything())) {
+		return Fail(
+			"unsupported",
+			method
+				+ u": "_q
+				+ target.path
+				+ u" isn't empty, pass { recursive: true }"_q);
+	}
+	return QDir().rmdir(target.path) ? Done() : failed;
+}
+
+[[nodiscard]] Outcome DoRename(
+		const Areas &areas,
+		const Target &from,
+		const Target &to,
+		const QString &method) {
+	const auto lock = std::lock_guard(ChangeMutex());
+	if (auto refusal = Refuse(areas, from, true, true, method)) {
+		return *refusal;
+	} else if (auto blocked = Refuse(areas, to, true, false, method)) {
+		return *blocked;
+	}
+	const auto source = QFileInfo(from.path);
+	if (!source.exists() && !source.isSymLink()) {
+		return Missing(method, from.path);
+	} else if (from.path == to.path) {
+		return Done();
+	} else if (PathInside(to.path, from.path)) {
+		return Fail(
+			"unsupported",
+			method + u": can't move "_q + from.path + u" into itself"_q);
+	}
+	const auto target = QFileInfo(to.path);
+	const auto same = target.exists() && (target == source);
+	const auto replace = target.exists() && !same;
+	if (replace && (target.isDir() || source.isDir())) {
+		return Fail(
+			"unsupported",
+			method + u": "_q + to.path + u" already exists"_q);
+	} else if (to.own && !from.own) {
+		const auto freed = replace ? target.size() : qint64();
+		if (auto over = OverQuota(areas, SizeOf(from.path), freed, method)) {
+			return *over;
+		}
+	}
+	const auto failed = Fail(
+		"internal",
+		method + u": can't move "_q + from.path + u" to "_q + to.path);
+	if (!QDir().mkpath(target.absolutePath())
+		|| (replace && !QFile::remove(to.path))) {
+		return failed;
+	}
+	const auto moved = (source.isDir() && !source.isSymLink())
+		? QDir().rename(from.path, to.path)
+		: QFile::rename(from.path, to.path);
+	return moved ? Done() : failed;
+}
+
+[[nodiscard]] Outcome DoCopy(
+		const Areas &areas,
+		const Target &from,
+		const Target &to,
+		const QString &method) {
+	const auto lock = std::lock_guard(ChangeMutex());
+	if (auto refusal = Refuse(areas, from, false, true, method)) {
+		return *refusal;
+	} else if (auto blocked = Refuse(areas, to, true, false, method)) {
+		return *blocked;
+	}
+	const auto source = QFileInfo(from.path);
+	if (!source.exists()) {
+		return Missing(method, from.path);
+	}
+	const auto target = QFileInfo(to.path);
+	const auto failed = Fail(
+		"internal",
+		method + u": can't copy "_q + from.path + u" to "_q + to.path);
+	if (source.isDir()) {
+		if (target.exists()) {
+			return Fail(
+				"unsupported",
+				method + u": "_q + to.path + u" already exists"_q);
+		} else if (PathInside(to.path, from.path)) {
+			return Fail(
+				"unsupported",
+				method
+					+ u": can't copy "_q
+					+ from.path
+					+ u" into itself"_q);
+		} else if (to.own) {
+			const auto added = SizeOf(from.path);
+			if (auto over = OverQuota(areas, added, qint64(), method)) {
+				return *over;
+			}
+		}
+		return CopyTree(from.path, to.path) ? Done() : failed;
+	} else if (target.isDir()) {
+		return Fail(
+			"unsupported",
+			method + u": "_q + to.path + u" is a folder"_q);
+	} else if (target.exists() && target == source) {
+		return Fail(
+			"unsupported",
+			method + u": "_q + to.path + u" is the same file"_q);
+	} else if (to.own) {
+		const auto freed = target.exists() ? target.size() : qint64();
+		if (auto over = OverQuota(areas, source.size(), freed, method)) {
+			return *over;
+		}
+	}
+	if (!QDir().mkpath(target.absolutePath())
+		|| (target.exists() && !QFile::remove(to.path))
+		|| !QFile::copy(from.path, to.path)) {
+		return failed;
+	}
+	return Done();
+}
+
+void Settle(const Pending &pending, const Outcome &outcome) {
+	if (outcome.code) {
+		Reject(pending, outcome.code, outcome.message);
+	} else if (outcome.value) {
+		Resolve(pending, outcome.value);
+	} else {
+		Resolve(pending, [](JSContext*) { return JS_UNDEFINED; });
+	}
+}
+
+JSValue Run(JSContext *ctx, Fn<Outcome()> work) {
+	const auto made = NewPending(ctx);
+	if (JS_IsException(made.second)) {
+		return made.second;
+	}
+	const auto pending = made.first;
+	crl::async([=] {
+		auto outcome = work();
+		crl::on_main([=, outcome = std::move(outcome)] {
+			Settle(pending, outcome);
+		});
+	});
+	return made.second;
+}
+
+[[nodiscard]] QString MethodName(Op op) {
+	switch (op) {
+	case Op::ReadText: return u"tg.fs.readText"_q;
+	case Op::ReadBytes: return u"tg.fs.readBytes"_q;
+	case Op::WriteText: return u"tg.fs.writeText"_q;
+	case Op::WriteBytes: return u"tg.fs.writeBytes"_q;
+	case Op::List: return u"tg.fs.list"_q;
+	case Op::Stat: return u"tg.fs.stat"_q;
+	case Op::Exists: return u"tg.fs.exists"_q;
+	case Op::Mkdir: return u"tg.fs.mkdir"_q;
+	case Op::Remove: return u"tg.fs.remove"_q;
+	case Op::Rename: return u"tg.fs.rename"_q;
+	case Op::Copy: return u"tg.fs.copy"_q;
+	case Op::Root: break;
+	}
+	return u"tg.fs.root"_q;
+}
+
+[[nodiscard]] Access FirstAccess(Op op) {
+	switch (op) {
+	case Op::WriteText:
+	case Op::WriteBytes:
+	case Op::Mkdir: return Access::Write;
+	case Op::Remove:
+	case Op::Rename: return Access::Destroy;
+	default: return Access::Read;
+	}
+}
+
+[[nodiscard]] bool NamedFolder(const QString &head) {
+	static const auto names = QStringList{
+		u"~"_q,
+		u"home"_q,
+		u"documents"_q,
+		u"downloads"_q,
+		u"desktop"_q,
+		u"pictures"_q,
+		u"music"_q,
+		u"videos"_q,
+		u"temp"_q,
+	};
+	return names.contains(head);
+}
+
+[[nodiscard]] bool ValidPath(const QString &path) {
+	if (path.isEmpty() || path.contains(QChar(0))) {
+		return false;
+	}
+#ifdef Q_OS_WIN
+	if (path.startsWith(u"//./"_q) || path.startsWith(u"//?/"_q)) {
+		return false;
+	}
+	const auto parts = path.split('/', Qt::SkipEmptyParts);
+	for (auto i = 0; i != int(parts.size()); ++i) {
+		const auto &part = parts[i];
+		if (part == u"."_q || part == u".."_q) {
+			continue;
+		} else if (part.endsWith('.') || part.endsWith(' ')) {
+			return false;
+		}
+		for (const auto ch : part) {
+			if (ch.unicode() < 32 || u"<>\"|?*"_q.contains(ch)) {
+				return false;
+			}
+		}
+		const auto colon = part.indexOf(':');
+		if (colon >= 0
+			&& !(i == 0 && colon == 1 && part.size() == 2)) {
+			return false;
+		}
+	}
+#endif
+	return true;
+}
+
+[[nodiscard]] std::optional<Target> ResolveTarget(
+		JSContext *ctx,
+		const Areas &areas,
+		JSValueConst value,
+		Access access,
+		const QString &method) {
+	if (!JS_IsString(value)) {
+		const auto text = (method + u": a path is a string"_q).toUtf8();
+		JS_ThrowTypeError(ctx, "%s", text.constData());
+		return std::nullopt;
+	}
+	auto raw = FromStd(ToStd(ctx, value));
+	raw.replace('\\', '/');
+	if (!ValidPath(raw)) {
+		const auto text = (method
+			+ u": '"_q
+			+ QString(raw).replace(QChar(0), u"\\0"_q)
+			+ u"' isn't a valid path"_q).toUtf8();
+		JS_ThrowTypeError(ctx, "%s", text.constData());
+		return std::nullopt;
+	}
+	const auto slash = raw.indexOf('/');
+	const auto head = (slash < 0) ? raw : raw.left(slash);
+	auto path = QString();
+	if (NamedFolder(head)) {
+		path = ResolveScopeFolder(raw.toStdString());
+		if (path.isEmpty()) {
+			ThrowTeleError(
+				ctx,
+				"not-found",
+				method + u": this system has no '"_q + head + u"' folder"_q);
+			return std::nullopt;
+		}
+	} else if (QDir::isAbsolutePath(raw)) {
+		path = QDir::cleanPath(QFileInfo(raw).absoluteFilePath());
+	} else {
+		path = QDir::cleanPath(areas.root + '/' + raw);
+		if (!PathInside(path, areas.root)) {
+			ThrowTeleError(
+				ctx,
+				"forbidden",
+				method
+					+ u": '"_q
+					+ raw
+					+ u"' leads out of the script's file area"_q);
+			return std::nullopt;
+		}
+		return Target{ .path = path, .own = true };
+	}
+	if (PathInside(path, areas.root)) {
+		return Target{ .path = path, .own = true };
+	}
+	const auto reason = Guarded(areas, path, access == Access::Destroy);
+	if (!reason.isEmpty()) {
+		ThrowTeleError(ctx, "forbidden", method + u": "_q + reason);
+		return std::nullopt;
+	}
+	const auto read = (access == Access::Read);
+	const auto scope = path.toStdString();
+	if (!Permitted(
+			ctx,
+			read ? Capability::FsRead : Capability::FsWrite,
+			scope,
+			read ? "tg.fs.read" : "tg.fs.write")) {
+		return std::nullopt;
+	}
+	return Target{ .path = path };
+}
+
+[[nodiscard]] std::optional<QByteArray> WriteData(
+		JSContext *ctx,
+		Op op,
+		JSValueConst value,
+		const Target &target,
+		const QString &method) {
+	if (op == Op::WriteText) {
+		if (!JS_IsString(value)) {
+			const auto text = (method + u": text is a string"_q).toUtf8();
+			JS_ThrowTypeError(ctx, "%s", text.constData());
+			return std::nullopt;
+		}
+		auto length = int64_t();
+		if (JS_GetLength(ctx, value, &length) < 0) {
+			return std::nullopt;
+		} else if (target.own && length > kAreaQuota) {
+			ThrowTeleError(ctx, "quota-exceeded", QuotaMessage(method));
+			return std::nullopt;
+		}
+		auto size = size_t();
+		const auto data = JS_ToCStringLen(ctx, &size, value);
+		if (!data) {
+			return std::nullopt;
+		}
+		auto result = QByteArray(data, int(size));
+		JS_FreeCString(ctx, data);
+		return result;
+	}
+	auto result = BytesFrom(ctx, value);
+	if (!result) {
+		const auto text = (method
+			+ u": bytes are a Uint8Array or an ArrayBuffer"_q).toUtf8();
+		JS_ThrowTypeError(ctx, "%s", text.constData());
+	}
+	return result;
+}
+
+JSValue NativeFs(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto areas = AreasOf(instance);
+	const auto op = Op(magic);
+	if (op == Op::Root) {
+		return NewString(ctx, areas.root);
+	}
+	const auto method = MethodName(op);
+	const auto arg = [&](int index) -> JSValueConst {
+		return (index < argc) ? argv[index] : JS_UNDEFINED;
+	};
+	const auto flag = [&](int index) {
+		return (index < argc) && (JS_ToBool(ctx, argv[index]) > 0);
+	};
+	const auto first = ResolveTarget(
+		ctx,
+		areas,
+		arg(0),
+		FirstAccess(op),
+		method);
+	if (!first) {
+		return JS_EXCEPTION;
+	}
+	const auto target = *first;
+	switch (op) {
+	case Op::ReadText:
+	case Op::ReadBytes: {
+		const auto text = (op == Op::ReadText);
+		return Run(ctx, [=] { return DoRead(areas, target, text, method); });
+	}
+	case Op::WriteText:
+	case Op::WriteBytes: {
+		const auto bytes = WriteData(ctx, op, arg(1), target, method);
+		if (!bytes) {
+			return JS_EXCEPTION;
+		} else if (target.own && bytes->size() > kAreaQuota) {
+			return ThrowTeleError(ctx, "quota-exceeded", QuotaMessage(method));
+		}
+		const auto data = *bytes;
+		const auto append = flag(2);
+		return Run(ctx, [=] {
+			return DoWrite(areas, target, data, append, method);
+		});
+	}
+	case Op::List:
+		return Run(ctx, [=] { return DoList(areas, target, method); });
+	case Op::Stat:
+		return Run(ctx, [=] { return DoStat(areas, target, method); });
+	case Op::Exists:
+		return Run(ctx, [=] { return DoExists(areas, target, method); });
+	case Op::Mkdir: {
+		const auto recursive = flag(1);
+		return Run(ctx, [=] {
+			return DoMkdir(areas, target, recursive, method);
+		});
+	}
+	case Op::Remove: {
+		const auto recursive = flag(1);
+		return Run(ctx, [=] {
+			return DoRemove(areas, target, recursive, method);
+		});
+	}
+	case Op::Rename:
+	case Op::Copy: {
+		const auto second = ResolveTarget(
+			ctx,
+			areas,
+			arg(1),
+			Access::Destroy,
+			method);
+		if (!second) {
+			return JS_EXCEPTION;
+		}
+		const auto to = *second;
+		if (op == Op::Rename) {
+			return Run(ctx, [=] {
+				return DoRename(areas, target, to, method);
+			});
+		}
+		return Run(ctx, [=] { return DoCopy(areas, target, to, method); });
+	}
+	case Op::Root: break;
+	}
+	return JS_UNDEFINED;
+}
+
+} // namespace
+
+void AddFsNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "fsRoot", NativeFs, 0, int(Op::Root) },
+		{ "fsReadText", NativeFs, 1, int(Op::ReadText) },
+		{ "fsReadBytes", NativeFs, 1, int(Op::ReadBytes) },
+		{ "fsWriteText", NativeFs, 3, int(Op::WriteText) },
+		{ "fsWriteBytes", NativeFs, 3, int(Op::WriteBytes) },
+		{ "fsList", NativeFs, 1, int(Op::List) },
+		{ "fsStat", NativeFs, 1, int(Op::Stat) },
+		{ "fsExists", NativeFs, 1, int(Op::Exists) },
+		{ "fsMkdir", NativeFs, 2, int(Op::Mkdir) },
+		{ "fsRemove", NativeFs, 2, int(Op::Remove) },
+		{ "fsRename", NativeFs, 2, int(Op::Rename) },
+		{ "fsCopy", NativeFs, 2, int(Op::Copy) },
+	});
+}
+
+QString FsAreaFolder(const QString &scriptId) {
+	return AreaOf(DataRoot(), scriptId);
+}
+
+std::string_view FsTypings() {
+	return R"TS(
+declare module 'tele' {
+  export interface Tg {
+    readonly fs: Fs
+  }
+
+  export interface FsEntry {
+    name: string
+    kind: 'file' | 'folder'
+    size: number
+    modified: number
+  }
+
+  export interface FsStat {
+    kind: 'file' | 'folder'
+    size: number
+    modified: number
+    created: number
+  }
+
+  export interface Fs {
+    readonly root: string
+    readText(path: string): Promise<string>
+    readBytes(path: string): Promise<Uint8Array>
+    writeText(path: string, text: string, options?: { append?: boolean }): Promise<void>
+    writeBytes(
+      path: string,
+      bytes: Uint8Array | ArrayBuffer | ArrayBufferView,
+      options?: { append?: boolean },
+    ): Promise<void>
+    list(path?: string): Promise<FsEntry[]>
+    stat(path: string): Promise<FsStat | null>
+    exists(path: string): Promise<boolean>
+    mkdir(path: string, options?: { recursive?: boolean }): Promise<void>
+    remove(path: string, options?: { recursive?: boolean }): Promise<void>
+    rename(from: string, to: string): Promise<void>
+    copy(from: string, to: string): Promise<void>
+  }
+}
+)TS";
+}
+
+} // namespace Tele::Scripting
