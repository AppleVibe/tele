+
+void AddDialogsNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "dialogsRegisterProvider", NativeDialogs, 2, 0 },
+		{ "dialogsInterceptSearch", NativeDialogs, 1, 1 },
+		{ "dialogsBanner", NativeDialogs, 2, 2 },
+		{ "dialogsRemove", NativeDialogs, 1, 3 },
+		{ "dialogsAnswer", NativeDialogs, 2, 4 },
+	});
+}
