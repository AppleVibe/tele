+		{ "cryptoExportJwk", NativeCrypto, 1, int(Op::ExportJwk) },
+		{ "cryptoInfo", NativeCrypto, 1, int(Op::Info) },
+		{ "cryptoSign", NativeCrypto, 5, int(Op::Sign) },
+		{ "cryptoVerify", NativeCrypto, 6, int(Op::Verify) },
+		{ "cryptoEncrypt", NativeCrypto, 6, int(Op::Encrypt) },
