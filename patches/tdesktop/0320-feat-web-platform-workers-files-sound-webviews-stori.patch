+
+bool ChooseInlineScriptResult(
+		not_null<const QWidget*> inner,
+		const std::shared_ptr<InlineBots::Result> &result,
+		const Api::SendOptions &options) {
+	const auto surface = FindPanel(inner);
+	if (!surface) {
+		return false;
+	}
+	surface->choose(result, options);
+	return true;
+}
+
+QString InlineEmptyText(
+		not_null<const QWidget*> inner,
+		const QString &fallback) {
+	const auto surface = FindPanel(inner);
+	const auto text = surface
+		? surface->emptyText(inner->width() - 2 * st::stickerPanPadding)
+		: QString();
+	return text.isEmpty() ? fallback : text;
+}
+
+std::string_view InlineTypings() {
+	return R"TS(
+declare module 'tele' {
+  export interface InlineMediaMessage {
+    media: Uint8Array | tl.TypeInputMedia
+    caption?: InputText
+  }
+
+  export interface InlineResult {
+    id: string
+    title: string
+    description?: string
+    thumb?: Uint8Array
+    message: InputText | InlineMediaMessage
+  }
+
+  export interface InlineQueryContext {
+    readonly chat: bigint
+    readonly signal: AbortSignal
+  }
+
+  export interface InlineAnswerer {
+    trigger: string
+    title?: string
+    results(
+      query: string,
+      context: InlineQueryContext,
+    ):
+      | readonly InlineResult[]
+      | null
+      | void
+      | Promise<readonly InlineResult[] | null | void>
+  }
+
+  export interface Tg {
+    registerInline(answerer: InlineAnswerer): Disposer
+  }
+}
+)TS";
+}
