@@ -0,0 +1,152 @@
+(() => {
+	const minSize = 120;
+	const maxSize = 4096;
+
+	const dispatch = (list, ...args) => {
+		let failure = null;
+		const waits = [];
+		for (const callback of [...list]) {
+			try {
+				const result = callback(...args);
+				if (result && typeof result.then === 'function') {
+					waits.push(result);
+				}
+			} catch (error) {
+				failure ??= { error };
+			}
+		}
+		if (failure) {
+			throw failure.error;
+		}
+		return waits.length ? Promise.all(waits) : undefined;
+	};
+
+	const open = (natives, options) => {
+		if (typeof options !== 'object' || options === null) {
+			throw new TypeError('tg.ui.webview needs { title, html | url }');
+		}
+		const { title, html, url, width, height, resizable } = options;
+		if (typeof title !== 'string' || !title) {
+			throw new TypeError('tg.ui.webview needs a title');
+		}
+		const hasHtml = (html !== undefined);
+		const hasUrl = (url !== undefined);
+		if (hasHtml === hasUrl) {
+			throw new TypeError('tg.ui.webview needs either html or url');
+		} else if (hasHtml && typeof html !== 'string') {
+			throw new TypeError('tg.ui.webview: html is a string');
+		} else if (hasUrl && (typeof url !== 'string' || !url)) {
+			throw new TypeError('tg.ui.webview: url is a string');
+		}
+		for (const [name, value] of [['width', width], ['height', height]]) {
+			if (value !== undefined
+				&& (typeof value !== 'number'
+					|| !Number.isFinite(value)
+					|| value < minSize
+					|| value > maxSize)) {
+				throw new TypeError(`tg.ui.webview: ${name} is a number from ${minSize} to ${maxSize}`);
+			}
+		}
+		if (resizable !== undefined && typeof resizable !== 'boolean') {
+			throw new TypeError('tg.ui.webview: resizable is a boolean');
+		}
+		const messages = new Set();
+		const closes = new Set();
+		let closed = false;
+		const finish = () => {
+			if (closed) {
+				return undefined;
+			}
+			closed = true;
+			messages.clear();
+			const list = [...closes];
+			closes.clear();
+			return dispatch(list);
+		};
+		const id = natives.webviewOpen({
+			title,
+			html: hasHtml ? html : undefined,
+			url: hasUrl ? url : undefined,
+			width,
+			height,
+			resizable,
+		}, (event) => {
+			if (event.type === 'close') {
+				return finish();
+			} else if (event.type !== 'message' || closed || !messages.size) {
+				return undefined;
+			}
+			let data;
+			try {
+				data = JSON.parse(event.text);
+			} catch {
+				return undefined;
+			}
+			return dispatch(messages, data);
+		});
+		return Object.freeze({
+			postMessage(data) {
+				let text;
+				try {
+					text = JSON.stringify(data);
+				} catch (error) {
+					throw new TypeError(`WebviewPanel.postMessage needs JSON-serializable data: ${error?.message ?? error}`);
+				}
+				if (typeof text !== 'string') {
+					throw new TypeError('WebviewPanel.postMessage needs JSON-serializable data');
+				}
+				if (!closed) {
+					natives.webviewPost(id, text);
+				}
+			},
+			onMessage(callback) {
+				if (typeof callback !== 'function') {
+					throw new TypeError('WebviewPanel.onMessage needs a function');
+				}
+				const entry = (data) => callback(data);
