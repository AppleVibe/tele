+    [Symbol.dispose](): void
+  }
+
+  export interface App {
+    playSound(source: SoundSource, options?: PlaySoundOptions): SoundPlayback
+  }
+
+  export interface NotifySoundInfo {
+    kind: 'default' | 'none' | 'custom'
+    id?: bigint
+    title?: string
+  }
+
+  export type NotifySoundChoice =
+    | 'default'
+    | 'none'
+    | { bytes: Uint8Array | ArrayBuffer, name: string }
+
+  export interface Notifications {
+    getSound(peer: InputPeerLike): Promise<NotifySoundInfo>
+    setSound(peer: InputPeerLike, sound: NotifySoundChoice): Promise<NotifySoundInfo>
+  }
+
+  export interface Tg {
+    readonly notifications: Notifications
+  }
+}
+)ts";
+
+struct Playing {
+	std::shared_ptr<Media::Audio::Track> track;
+	Pending pending;
+	float64 volume = -1.;
+	bool suppress = false;
+};
+
+struct Upload {
+	~Upload() {
+		lifetime.destroy();
+		if (finished) {
+			return;
+		} else if (const auto strong = uploader.get()) {
+			strong->cancel(fakeId);
+		}
+	}
+
+	base::weak_ptr<Storage::Uploader> uploader;
+	FullMsgId fakeId;
+	rpl::lifetime lifetime;
+	bool finished = false;
+};
+
+struct Sounds {
+	base::flat_map<int, std::unique_ptr<Playing>> playing;
+	base::flat_map<int, std::unique_ptr<Upload>> uploads;
+	int next = 0;
+};
+
+struct SoundInfo {
+	const char *kind = "default";
+	DocumentId id = 0;
+	QString title;
+};
+
+[[nodiscard]] base::flat_map<Instance*, std::unique_ptr<Sounds>> &AllSounds() {
+	static auto result = base::flat_map<Instance*, std::unique_ptr<Sounds>>();
+	return result;
+}
+
+[[nodiscard]] Sounds &SoundsOf(not_null<Instance*> instance) {
+	auto &all = AllSounds();
+	const auto i = all.find(instance.get());
+	if (i != end(all)) {
+		return *i->second;
+	}
+	const auto raw = instance.get();
+	ScriptLifetime(instance).add([=] {
+		AllSounds().remove(raw);
+	});
+	return *all.emplace(raw, std::make_unique<Sounds>()).first->second;
+}
+
+[[nodiscard]] Sounds *FindSounds(const base::weak_ptr<Instance> &weak) {
+	const auto strong = weak.get();
+	if (!strong) {
+		return nullptr;
+	}
+	const auto &all = AllSounds();
+	const auto i = all.find(strong);
+	return (i != end(all)) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] JSValue NoValue(JSContext *) {
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] std::optional<std::uint64_t> InputBigField(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	auto result = std::optional<std::uint64_t>();
+	if (JS_IsBigInt(value)) {
+		auto number = std::int64_t();
+		JS_ToBigInt64(ctx, &number, value);
+		result = std::uint64_t(number);
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+[[nodiscard]] std::optional<PeerId> InputPeerId(
+		JSContext *ctx,
+		JSValueConst value,
+		PeerId self) {
+	if (!JS_IsObject(value)) {
+		return std::nullopt;
+	}
+	auto name = JS_GetPropertyStr(ctx, value, "_");
+	const auto type = ToStd(ctx, name);
+	JS_FreeValue(ctx, name);
+	if (type == "inputPeerSelf") {
+		return self;
+	} else if (const auto user = InputBigField(ctx, value, "userId")) {
+		return peerFromUser(UserId(*user));
+	} else if (const auto chat = InputBigField(ctx, value, "chatId")) {
+		return peerFromChat(ChatId(*chat));
+	} else if (const auto channel = InputBigField(ctx, value, "channelId")) {
+		return peerFromChannel(ChannelId(*channel));
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] SoundInfo DescribeSound(
+		not_null<Main::Session*> session,
+		const std::optional<Data::NotifySound> &sound) {
+	if (!sound) {
+		return {};
+	} else if (sound->none) {
+		return { .kind = "none" };
+	} else if (sound->id) {
+		const auto document = session->data().document(sound->id);
+		return {
+			.kind = "custom",
+			.id = sound->id,
+			.title = ExtractRingtoneName(document),
+		};
+	} else if (sound->data.compare(u"default"_q, Qt::CaseInsensitive) == 0
+		|| sound->title.compare(u"default"_q, Qt::CaseInsensitive) == 0) {
+		return {};
+	} else if (!sound->title.isEmpty()) {
+		return { .kind = "custom", .title = sound->title };
+	}
+	return {};
+}
+
+[[nodiscard]] JSValue SoundValue(JSContext *ctx, const SoundInfo &info) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "kind", JS_NewString(ctx, info.kind));
+	if (info.id) {
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"id",
+			JS_NewBigInt64(ctx, std::int64_t(info.id)));
+	}
+	if (!info.title.isEmpty()) {
+		JS_SetPropertyStr(ctx, result, "title", NewString(ctx, info.title));
+	}
+	return result;
+}
+
+void ResolveSoundLater(const Pending &pending, SoundInfo info) {
+	crl::on_main([=] {
+		Resolve(pending, [=](JSContext *ctx) {
+			return SoundValue(ctx, info);
+		});
+	});
+}
+
+[[nodiscard]] const char *UploadErrorCode(const QString &type) {
+	if (type == u"RINGTONE_MIME_INVALID"_q) {
+		return "unsupported";
+	} else if (type == u"RINGTONE_SIZE_TOO_BIG"_q
+		|| type == u"RINGTONE_DURATION_TOO_LONG"_q) {
+		return "quota-exceeded";
+	}
+	return "network";
+}
+
+[[nodiscard]] std::shared_ptr<FilePrepareResult> PrepareRingtone(
+		MTP::DcId dcId,
+		const QString &name,
+		const QString &mime,
+		const QByteArray &content) {
+	const auto id = base::RandomValue<DocumentId>();
+	auto attributes = QVector<MTPDocumentAttribute>(
+		1,
+		MTP_documentAttributeFilename(MTP_string(name)));
+	auto result = MakePreparedFile({
+		.id = id,
+		.type = SendMediaType::File,
+	});
+	result->filename = name;
+	result->content = content;
+	result->filesize = content.size();
+	result->setFileData(content);
+	result->document = MTP_document(
+		MTP_flags(0),
+		MTP_long(id),
+		MTP_long(0),
+		MTP_bytes(),
+		MTP_int(base::unixtime::now()),
+		MTP_string(mime),
+		MTP_long(content.size()),
+		MTP_vector<MTPPhotoSize>(),
+		MTPVector<MTPVideoSize>(),
+		MTP_int(dcId),
+		MTP_vector<MTPDocumentAttribute>(std::move(attributes)));
+	return result;
+}
+
+void PollSound(base::weak_ptr<Instance> weak, int id) {
+	base::call_delayed(kPollDelay, [=] {
+		const auto sounds = FindSounds(weak);
+		if (!sounds) {
+			return;
+		}
+		const auto i = sounds->playing.find(id);
+		if (i == end(sounds->playing)) {
+			return;
+		} else if (i->second->track->failed()) {
+			const auto pending = i->second->pending;
+			sounds->playing.erase(i);
+			Reject(
+				pending,
+				"unsupported",
+				u"tg.app.playSound: no audio output device"_q);
+			return;
+		} else if (i->second->track->isActive()) {
+			PollSound(weak, id);
+			return;
+		}
+		const auto pending = i->second->pending;
+		sounds->playing.erase(i);
+		Resolve(pending, NoValue);
+	});
+}
+
+void SoundDecoded(
+		base::weak_ptr<Instance> weak,
+		int id,
+		std::shared_ptr<Media::Audio::Track> track) {
+	const auto sounds = FindSounds(weak);
+	if (!sounds) {
+		return;
+	}
+	const auto i = sounds->playing.find(id);
+	if (i == end(sounds->playing)) {
+		return;
+	} else if (track->failed()) {
+		const auto pending = i->second->pending;
+		sounds->playing.erase(i);
+		Reject(
+			pending,
+			"unsupported",
+			u"tg.app.playSound: tele can't decode this audio"_q);
+		return;
+	}
+	const auto playing = i->second.get();
+	playing->track = std::move(track);
+	playing->track->playOnce(playing->volume);
+	if (playing->track->failed()) {
+		const auto pending = playing->pending;
+		sounds->playing.erase(i);
+		Reject(
+			pending,
+			"unsupported",
+			u"tg.app.playSound: no audio output device"_q);
+		return;
+	}
+	if (playing->suppress) {
+		if (const auto mixer = Media::Player::mixer()) {
+			mixer->suppressAll(playing->track->getLengthMs());
+			mixer->scheduleFaderCallback();
+		}
+	}
+	PollSound(weak, id);
+}
+
+[[nodiscard]] JSValue StartSound(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		QByteArray content,
+		float64 volume,
+		bool suppress) {
+	auto created = NewPending(ctx);
+	const auto pending = created.first;
+	const auto promise = created.second;
+	if (JS_IsException(promise)) {
+		return promise;
+	}
+	auto &sounds = SoundsOf(instance);
+	const auto id = ++sounds.next;
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "id", JS_NewInt32(ctx, id));
+	JS_SetPropertyStr(ctx, result, "done", promise);
+	if (content.isEmpty() || volume == 0.) {
+		crl::on_main([=] {
+			Resolve(pending, NoValue);
+		});
+		return result;
+	}
+	auto playing = std::make_unique<Playing>();
+	playing->pending = pending;
+	playing->volume = volume;
+	playing->suppress = suppress;
+	sounds.playing.emplace(id, std::move(playing));
+	auto track = std::shared_ptr<Media::Audio::Track>(
+		Media::Audio::Current().createTrack());
+	const auto weak = base::make_weak(instance.get());
+	crl::async([
+		=,
+		track = std::move(track),
+		data = std::move(content)
+	]() mutable {
+		track->fillFromData(bytes::make_vector(data));
+		crl::on_main([=, track = std::move(track)]() mutable {
+			SoundDecoded(weak, id, std::move(track));
+		});
+	});
+	return result;
+}
+
+[[nodiscard]] JSValue SoundPlay(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	auto volume = -1.;
+	if (argc > 1 && !JS_IsUndefined(argv[1])) {
+		if (!JS_IsNumber(argv[1])
+			|| JS_ToFloat64(ctx, &volume, argv[1])
+			|| !(volume >= 0. && volume <= 1.)) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.app.playSound: volume must be a number from 0 to 1");
+		}
+	}
+	if (argc > 0 && JS_IsString(argv[0])) {
+		if (ToStd(ctx, argv[0]) != "notification") {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.app.playSound: the source is audio bytes "
+				"(Uint8Array or ArrayBuffer) or 'notification'");
+		}
+		const auto session = ScriptSession(instance);
+		const auto owner = &session->data();
+		const auto sound = owner->notifySettings().defaultSettings(
+			Data::DefaultNotify::User).sound();
+		if (sound && sound->none) {
+			return StartSound(ctx, instance, QByteArray(), volume, true);
+		}
+		const auto id = sound ? sound->id : DocumentId(0);
+		auto &notifications = Core::App().notifications();
+		auto bytes = notifications.lookupSoundBytes(owner, id);
+		if (bytes.isEmpty() && id) {
+			bytes = notifications.lookupSoundBytes(owner, 0);
+		}
+		if (volume < 0.) {
+			const auto ringtone = session->settings().ringtoneVolume(
+				Data::DefaultNotify::User);
+			if (ringtone) {
+				volume = ringtone * 0.01;
+			}
+		}
+		return StartSound(ctx, instance, std::move(bytes), volume, true);
+	}
+	auto bytes = (argc > 0)
+		? BytesFrom(ctx, argv[0])
+		: std::optional<QByteArray>();
+	if (!bytes) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.app.playSound: the source is audio bytes "
+			"(Uint8Array or ArrayBuffer) or 'notification'");
+	} else if (bytes->isEmpty()) {
+		return JS_ThrowTypeError(ctx, "tg.app.playSound: the audio is empty");
+	} else if (bytes->size() > kMaxSoundBytes) {
+		return ThrowTeleError(
+			ctx,
+			"quota-exceeded",
+			u"tg.app.playSound: the audio is over 10 MB"_q);
+	}
+	return StartSound(ctx, instance, std::move(*bytes), volume, false);
+}
+
+[[nodiscard]] JSValue SoundStop(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	auto id = 0;
+	if (!instance || argc < 1 || JS_ToInt32(ctx, &id, argv[0])) {
+		return JS_UNDEFINED;
+	}
+	auto &sounds = SoundsOf(instance);
+	if (auto playing = sounds.playing.take(id)) {
+		const auto pending = (*playing)->pending;
+		crl::on_main([=] {
+			Resolve(pending, NoValue);
+		});
+	}
+	return JS_UNDEFINED;
+}
+
+void AnswerSound(
+		base::weak_ptr<Instance> weak,
+		PeerId peerId,
+		Pending pending,
+		int left,
+		bool listed) {
+	const auto strong = weak.get();
+	if (!strong) {
+		return;
+	}
+	const auto session = ScriptSession(strong);
+	const auto peer = session->data().peerLoaded(peerId);
+	if (!peer) {
+		Reject(
+			pending,
+			"not-found",
+			u"tg.notifications.getSound: the chat is gone"_q);
+		return;
+	}
+	const auto unknown = peer->notify().settingsUnknown();
+	const auto sound = peer->notify().sound();
+	const auto missing = sound
+		&& !sound->none
+		&& sound->id
+		&& session->data().document(sound->id)->isNull();
+	if (missing && !listed) {
+		session->api().ringtones().requestList();
+	}
+	if ((unknown || missing) && left > 0) {
+		base::call_delayed(kPollDelay, [=] {
+			AnswerSound(weak, peerId, pending, left - 1, listed || missing);
+		});
+		return;
+	} else if (unknown) {
+		Reject(
+			pending,
+			"timed-out",
+			u"tg.notifications.getSound: "
+			"the chat's notification settings didn't load"_q);
+		return;
+	}
+	const auto info = DescribeSound(session, sound);
+	Resolve(pending, [=](JSContext *ctx) {
+		return SoundValue(ctx, info);
+	});
+}
+
+[[nodiscard]] JSValue SoundGet(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto session = ScriptSession(instance);
+	const auto peerId = (argc > 0)
+		? InputPeerId(ctx, argv[0], session->userPeerId())
+		: std::optional<PeerId>();
+	if (!peerId) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.notifications.getSound: expected a peer");
+	}
+	const auto loaded = session->data().peerLoaded(*peerId);
+	if (!loaded) {
+		return ThrowTeleError(
+			ctx,
+			"not-found",
+			u"tg.notifications.getSound: the chat isn't in tele's cache"_q);
+	}
+	const auto peer = not_null<PeerData*>(loaded);
+	auto created = NewPending(ctx);
+	const auto pending = created.first;
+	const auto promise = created.second;
+	if (JS_IsException(promise)) {
+		return promise;
+	}
+	session->data().notifySettings().request(peer);
+	const auto weak = base::make_weak(instance);
+	const auto id = *peerId;
+	crl::on_main([=] {
+		AnswerSound(weak, id, pending, kAnswerAttempts, false);
+	});
+	return promise;
+}
+
+void SoundUploaded(
+		base::weak_ptr<Instance> weak,
+		int key,
+		PeerId peerId,
+		MTPInputFile file,
+		QString name,
+		QString mime,
+		QByteArray content,
+		Pending pending) {
+	const auto sounds = FindSounds(weak);
+	if (!sounds) {
+		return;
+	}
+	auto upload = sounds->uploads.take(key);
+	if (!upload) {
+		return;
+	}
+	(*upload)->finished = true;
+	upload = std::nullopt;
+	const auto session = ScriptSession(weak.get());
+	session->api().request(MTPaccount_UploadRingtone(
+		file,
+		MTP_string(name),
+		MTP_string(mime)
+	)).done([=](const MTPDocument &result) {
+		const auto document = session->data().processDocument(result);
+		const auto media = document->createMediaView();
+		media->setBytes(content);
+		document->owner().notifySettings().cacheSound(document);
+		session->api().ringtones().applyUpdate();
+		if (!FindSounds(weak)) {
+			return;
+		}
+		const auto loaded = session->data().peerLoaded(peerId);
+		if (!loaded) {
+			Reject(
+				pending,
+				"not-found",
+				u"tg.notifications.setSound: the chat is gone"_q);
+			return;
+		}
+		const auto peer = not_null<PeerData*>(loaded);
+		const auto sound = Data::NotifySound{ .id = document->id };
+		session->data().notifySettings().update(peer, {}, {}, sound);
+		const auto info = DescribeSound(session, sound);
+		Resolve(pending, [=](JSContext *ctx) {
+			return SoundValue(ctx, info);
+		});
+	}).fail([=](const MTP::Error &error) {
+		const auto type = error.type();
+		Reject(
+			pending,
+			UploadErrorCode(type),
+			u"tg.notifications.setSound: "_q + type);
+	}).send();
+}
+
+[[nodiscard]] JSValue UploadSound(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		not_null<PeerData*> peer,
+		JSValueConst sound) {
+	auto value = JS_GetPropertyStr(ctx, sound, "bytes");
+	const auto bytes = BytesFrom(ctx, value);
+	JS_FreeValue(ctx, value);
+	const auto name = StringProperty(ctx, sound, "name").trimmed();
+	if (!bytes || bytes->isEmpty() || name.isEmpty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.notifications.setSound: a custom sound is "
+			"{ bytes: Uint8Array | ArrayBuffer, name: string }, "
+			"both non-empty");
+	}
+	const auto session = ScriptSession(instance);
+	const auto max = session->api().ringtones().maxSize();
+	if (bytes->size() > max) {
+		return ThrowTeleError(
+			ctx,
+			"quota-exceeded",
+			u"tg.notifications.setSound: the sound is over %1 bytes"_q.arg(
+				max));
+	}
+	auto created = NewPending(ctx);
+	const auto pending = created.first;
+	const auto promise = created.second;
+	if (JS_IsException(promise)) {
+		return promise;
+	}
+	const auto content = *bytes;
+	const auto mime = Core::MimeTypeForData(content).name();
+	auto &sounds = SoundsOf(instance);
+	const auto key = ++sounds.next;
+	const auto fakeId = FullMsgId(
+		session->userPeerId(),
+		session->data().nextLocalMessageId());
+	auto upload = std::make_unique<Upload>();
+	upload->uploader = base::make_weak(&session->uploader());
+	upload->fakeId = fakeId;
+	const auto weak = base::make_weak(instance.get());
+	const auto peerId = peer->id;
+	session->uploader().documentReady(
+	) | rpl::filter([=](const Storage::UploadedMedia &data) {
+		return (data.fullId == fakeId);
+	}) | rpl::on_next([=](const Storage::UploadedMedia &data) {
+		const auto file = data.info.file;
+		crl::on_main([=] {
+			SoundUploaded(
+				weak,
+				key,
+				peerId,
+				file,
+				name,
+				mime,
+				content,
+				pending);
+		});
+	}, upload->lifetime);
+	session->uploader().documentFailed(
+	) | rpl::filter([=](const FullMsgId &id) {
+		return (id == fakeId);
+	}) | rpl::on_next([=] {
+		crl::on_main([=] {
+			if (const auto sounds = FindSounds(weak)) {
+				if (auto upload = sounds->uploads.take(key)) {
+					(*upload)->finished = true;
+					Reject(
+						pending,
+						"network",
+						u"tg.notifications.setSound: the upload failed"_q);
+				}
+			}
+		});
+	}, upload->lifetime);
+	sounds.uploads.emplace(key, std::move(upload));
+	session->uploader().upload(
+		fakeId,
+		PrepareRingtone(session->mtp().mainDcId(), name, mime, content));
+	return promise;
+}
+
+[[nodiscard]] JSValue SoundSet(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountWrite,
+		"notify",
+		"tg.notifications.setSound");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = ScriptSession(instance);
+	const auto peerId = (argc > 0)
+		? InputPeerId(ctx, argv[0], session->userPeerId())
+		: std::optional<PeerId>();
+	if (!peerId) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.notifications.setSound: expected a peer");
+	}
+	const auto loaded = session->data().peerLoaded(*peerId);
+	if (!loaded) {
+		return ThrowTeleError(
+			ctx,
+			"not-found",
+			u"tg.notifications.setSound: the chat isn't in tele's cache"_q);
+	}
+	const auto peer = not_null<PeerData*>(loaded);
+	if (argc > 1 && JS_IsObject(argv[1])) {
+		return UploadSound(ctx, instance, peer, argv[1]);
+	}
+	const auto kind = (argc > 1 && JS_IsString(argv[1]))
+		? ToStd(ctx, argv[1])
+		: std::string();
+	if (kind != "default" && kind != "none") {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.notifications.setSound: the sound is 'default', 'none' "
+			"or { bytes, name }");
+	}
+	auto created = NewPending(ctx);
+	const auto pending = created.first;
+	const auto promise = created.second;
+	if (JS_IsException(promise)) {
+		return promise;
+	}
+	const auto sound = (kind == "none")
+		? Data::NotifySound{ .none = true }
+		: Data::NotifySound();
+	session->data().notifySettings().update(peer, {}, {}, sound);
+	ResolveSoundLater(pending, DescribeSound(session, sound));
+	return promise;
+}
+
+JSValue NativeSound(
+		JSContext *ctx,
+		JSValueConst thisValue,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	switch (magic) {
+	case 0: return SoundPlay(ctx, argc, argv);
+	case 1: return SoundStop(ctx, argc, argv);
+	case 2: return SoundGet(ctx, argc, argv);
+	case 3: return SoundSet(ctx, argc, argv);
+	}
+	return JS_UNDEFINED;
+}
+
+} // namespace
+
+void AddSoundNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "soundPlay", NativeSound, 2, 0 },
+		{ "soundStop", NativeSound, 1, 1 },
+		{ "soundGet", NativeSound, 1, 2 },
+		{ "soundSet", NativeSound, 2, 3 },
+	});
+}
+
+std::string_view SoundTypings() {
+	return kTypings;
+}
+
