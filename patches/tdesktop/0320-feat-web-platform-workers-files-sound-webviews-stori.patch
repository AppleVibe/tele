+constexpr auto kTypings = R"ts(
+declare module 'tele' {
+  export type SoundSource = Uint8Array | ArrayBuffer | 'notification'
+
+  export interface PlaySoundOptions {
+    volume?: number
+  }
+
+  export interface SoundPlayback {
+    readonly done: Promise<void>
