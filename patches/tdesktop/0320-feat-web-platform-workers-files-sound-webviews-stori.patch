+bool Socket::secure() const {
+	return (_url.scheme().toLower() == u"wss"_q);
+}
+
+void Socket::start() {
+	if (_state != State::Connecting || _socket) {
+		return;
+	}
+	_context = std::make_unique<QObject>();
+	_socket = new QSslSocket();
+	const auto context = _context.get();
+	if (secure()) {
+		QObject::connect(_socket, &QSslSocket::encrypted, context, [=] {
+			handshake();
+		});
+	} else {
+		QObject::connect(_socket, &QAbstractSocket::connected, context, [=] {
+			handshake();
+		});
+	}
+	QObject::connect(_socket, &QIODevice::readyRead, context, [=] {
+		read();
+	});
+	QObject::connect(
+		_socket,
+		&QAbstractSocket::errorOccurred,
+		context,
+		[=](QAbstractSocket::SocketError error) { socketError(error); });
+	QObject::connect(
+		_socket,
+		&QAbstractSocket::disconnected,
+		context,
+		[=] { disconnected(); });
+	_timer.callOnce(kConnectTimeout);
+	const auto host = _url.host(QUrl::FullyEncoded);
+	const auto port = quint16(_url.port(secure() ? 443 : 80));
+	if (secure()) {
+		_socket->connectToHostEncrypted(host, port);
+	} else {
+		_socket->connectToHost(host, port);
+	}
+}
+
+void Socket::handshake() {
+	if (_done || _state != State::Connecting) {
+		return;
+	}
+	auto path = _url.path(QUrl::FullyEncoded).toUtf8();
+	if (path.isEmpty()) {
+		path = "/";
+	}
+	if (_url.hasQuery()) {
+		path.append('?').append(_url.query(QUrl::FullyEncoded).toUtf8());
+	}
+	auto host = _url.host(QUrl::FullyEncoded).toUtf8();
+	if (host.contains(':')) {
+		host = QByteArray("[").append(host).append(']');
+	}
+	const auto port = _url.port();
+	if (port >= 0 && port != (secure() ? 443 : 80)) {
+		host.append(':').append(QByteArray::number(port));
+	}
+	auto request = QByteArray();
+	request.append("GET ").append(path).append(" HTTP/1.1\r\n");
+	request.append("Host: ").append(host).append("\r\n");
+	request.append("Upgrade: websocket\r\n");
+	request.append("Connection: Upgrade\r\n");
+	request.append("Sec-WebSocket-Key: ").append(_key).append("\r\n");
+	request.append("Sec-WebSocket-Version: 13\r\n");
+	if (!_protocols.isEmpty()) {
+		request.append("Sec-WebSocket-Protocol: ");
+		request.append(_protocols.join(u", "_q).toLatin1());
+		request.append("\r\n");
+	}
+	request.append("User-Agent: Mozilla/5.0\r\n");
+	request.append("Cache-Control: no-cache\r\n");
+	request.append("Pragma: no-cache\r\n");
+	request.append("\r\n");
+	_socket->write(request);
+}
+
+void Socket::read() {
+	if (_done || !_socket) {
+		return;
+	}
+	_incoming.append(_socket->readAll());
+	if (!_upgraded) {
+		if (_state != State::Connecting) {
+			_incoming.clear();
+			return;
+		}
+		const auto end = _incoming.indexOf("\r\n\r\n");
+		if (end < 0) {
+			if (_incoming.size() > kMaxHead) {
+				fail(u"the handshake response is too long"_q, 0);
+			}
+			return;
+		}
+		const auto error = upgrade(_incoming.left(end));
+		if (!error.isEmpty()) {
+			fail(error, 0);
+			return;
+		}
+		_offset = end + 4;
+		_upgraded = true;
+		_state = State::Open;
+		_timer.cancel();
+		const auto weak = base::make_weak(this);
+		const auto protocol = _protocol;
+		emitEvent([=](JSContext *ctx) {
+			auto result = EventObject(ctx, "open");
+			JS_SetPropertyStr(ctx, result, "protocol", NewString(ctx, protocol));
+			return result;
+		});
+		if (!weak) {
+			return;
+		}
+	}
+	frames();
+}
+
+QString Socket::upgrade(const QByteArray &head) {
+	const auto lines = head.split('\n');
+	const auto status = lines.front().trimmed();
+	const auto parts = status.split(' ');
+	if (parts.size() < 2
+		|| !parts[0].startsWith("HTTP/")
+		|| parts[1] != "101") {
+		return u"the server refused the upgrade: %1"_q.arg(
+			QString::fromLatin1(status));
+	}
+	auto headers = std::map<QByteArray, QByteArray>();
+	for (auto i = 1; i < int(lines.size()); ++i) {
+		const auto &line = lines[i];
+		const auto colon = line.indexOf(':');
+		if (colon <= 0) {
+			continue;
+		}
+		const auto name = line.left(colon).trimmed().toLower();
+		const auto value = line.mid(colon + 1).trimmed();
+		auto &field = headers[name];
+		if (field.isEmpty()) {
+			field = value;
+		} else {
+			field.append(", ").append(value);
+		}
+	}
+	const auto header = [&](const char *name) {
+		const auto i = headers.find(QByteArray(name));
+		return (i != end(headers)) ? i->second : QByteArray();
+	};
+	if (header("upgrade").toLower() != "websocket") {
+		return u"the server did not upgrade to websocket"_q;
+	}
+	auto upgraded = false;
+	for (const auto &token : header("connection").split(',')) {
+		if (token.trimmed().toLower() == "upgrade") {
+			upgraded = true;
+		}
+	}
+	if (!upgraded) {
+		return u"the server did not upgrade the connection"_q;
+	}
+	const auto expected = QCryptographicHash::hash(
+		QByteArray(_key).append(kAcceptGuid),
+		QCryptographicHash::Sha1).toBase64();
+	if (header("sec-websocket-accept") != expected) {
+		return u"the server sent a wrong Sec-WebSocket-Accept"_q;
+	}
+	if (!header("sec-websocket-extensions").isEmpty()) {
+		return u"the server chose an extension that was not offered"_q;
+	}
+	const auto protocol = QString::fromLatin1(
+		header("sec-websocket-protocol"));
+	if (!protocol.isEmpty() && !_protocols.contains(protocol)) {
+		return u"the server chose the subprotocol '%1' that was not offered"_q
+			.arg(protocol);
+	}
+	_protocol = protocol;
+	return QString();
+}
+
+void Socket::frames() {
+	const auto weak = base::make_weak(this);
+	while (!_done) {
+		const auto available = qint64(_incoming.size()) - _offset;
+		if (available < 2) {
+			break;
+		}
+		const auto data = reinterpret_cast<const uchar*>(
+			_incoming.constData()) + _offset;
+		const auto fin = (data[0] & 0x80) != 0;
+		const auto opcode = uchar(data[0] & 0x0F);
+		const auto isControl = (opcode & 0x08) != 0;
+		if (data[0] & 0x70) {
+			fail(u"the server set reserved frame bits"_q, 1002);
+			return;
+		} else if (data[1] & 0x80) {
+			fail(u"the server sent a masked frame"_q, 1002);
+			return;
+		} else if (isControl) {
+			if (opcode != kClose && opcode != kPing && opcode != kPong) {
+				fail(
+					u"the server sent the opcode %1"_q.arg(int(opcode)),
+					1002);
+				return;
+			} else if (!fin || (data[1] & 0x7F) > 125) {
+				fail(u"the server sent a broken control frame"_q, 1002);
+				return;
+			}
+		} else if (opcode != kContinuation
+			&& opcode != kText
+			&& opcode != kBinary) {
+			fail(u"the server sent the opcode %1"_q.arg(int(opcode)), 1002);
+			return;
+		} else if (opcode == kContinuation && !_messageOpcode) {
+			fail(u"the server continued a message it never started"_q, 1002);
+			return;
+		} else if (opcode != kContinuation && _messageOpcode) {
+			fail(u"the server interleaved two fragmented messages"_q, 1002);
+			return;
+		}
+		auto length = quint64(data[1] & 0x7F);
+		auto header = qint64(2);
+		if (length == 126) {
+			if (available < 4) {
+				break;
+			}
+			length = (quint64(data[2]) << 8) | quint64(data[3]);
+			header = 4;
+		} else if (length == 127) {
+			if (available < 10) {
+				break;
+			}
+			length = 0;
+			for (auto i = 0; i != 8; ++i) {
+				length = (length << 8) | quint64(data[2 + i]);
+			}
+			header = 10;
+		}
+		if (!isControl
+			&& length > quint64(kMaxMessage - qint64(_message.size()))) {
+			fail(u"a message is over 64 MB"_q, 1009);
+			return;
+		} else if (quint64(available - header) < length) {
+			break;
+		}
+		const auto payload = QByteArray(
+			reinterpret_cast<const char*>(data + header),
+			int(length));
+		_offset += header + qint64(length);
+		if (isControl) {
+			control(opcode, payload);
+		} else {
+			if (opcode != kContinuation) {
+				_messageOpcode = opcode;
+			}
+			_message.append(payload);
+			if (fin) {
+				const auto text = (_messageOpcode == kText);
+				const auto message = std::exchange(_message, QByteArray());
+				_messageOpcode = 0;
+				if (text && !ValidUtf8(message)) {
+					fail(u"a text message is not valid UTF-8"_q, 1007);
+					return;
+				} else if (_state == State::Open) {
+					emitEvent([=](JSContext *ctx) {
+						auto result = EventObject(ctx, "message");
+						JS_SetPropertyStr(
+							ctx,
+							result,
+							"data",
+							text
+								? JS_NewStringLen(
+									ctx,
+									message.constData(),
+									std::size_t(message.size()))
+								: JS_NewArrayBufferCopy(
+									ctx,
+									reinterpret_cast<const uint8_t*>(
+										message.constData()),
+									std::size_t(message.size())));
+						return result;
+					});
+				}
+			}
+		}
+		if (!weak) {
+			return;
+		}
+	}
+	if (_done) {
+		return;
+	} else if (_offset >= qint64(_incoming.size())) {
+		_incoming.clear();
+		_offset = 0;
+	} else if (_offset > 0) {
+		_incoming.remove(0, int(_offset));
+		_offset = 0;
+	}
+}
+
+void Socket::control(uchar opcode, const QByteArray &payload) {
+	if (opcode == kPing) {
+		if (!_closeSent) {
+			write(kPong, payload);
+		}
+	} else if (opcode == kClose) {
+		closeReceived(payload);
+	}
+}
+
+void Socket::closeReceived(const QByteArray &payload) {
+	auto code = 1005;
+	auto reason = QByteArray();
+	if (payload.size() == 1) {
+		fail(u"the server sent a broken close frame"_q, 1002);
+		return;
+	} else if (payload.size() >= 2) {
+		const auto data = reinterpret_cast<const uchar*>(payload.constData());
+		code = (int(data[0]) << 8) | int(data[1]);
+		reason = payload.mid(2);
+		if (!ValidReceivedCode(code)) {
+			fail(u"the server sent the close code %1"_q.arg(code), 1002);
+			return;
+		} else if (!ValidUtf8(reason)) {
+			fail(u"the server sent a close reason that is not UTF-8"_q, 1007);
+			return;
+		}
+	}
+	if (!_closeSent) {
+		_state = State::Closing;
+		writeClose((code == 1005) ? 0 : code, QByteArray());
+	}
+	finish(code, reason, true, QString());
+}
+
+void Socket::write(uchar opcode, const QByteArray &payload) {
+	if (!_socket) {
+		return;
+	}
+	const auto size = quint64(payload.size());
+	auto frame = QByteArray();
+	frame.reserve(int(size) + 14);
+	frame.append(char(0x80 | opcode));
+	if (size < 126) {
+		frame.append(char(0x80 | size));
+	} else if (size <= 0xFFFF) {
+		frame.append(char(0x80 | 126));
+		frame.append(char((size >> 8) & 0xFF));
+		frame.append(char(size & 0xFF));
+	} else {
+		frame.append(char(0x80 | 127));
+		for (auto i = 7; i >= 0; --i) {
+			frame.append(char((size >> (8 * i)) & 0xFF));
+		}
+	}
+	uchar mask[4] = { 0 };
+	base::RandomFill(mask, sizeof(mask));
+	frame.append(reinterpret_cast<const char*>(mask), 4);
+	const auto offset = int(frame.size());
+	frame.resize(offset + int(size));
+	const auto from = reinterpret_cast<const uchar*>(payload.constData());
+	const auto to = reinterpret_cast<uchar*>(frame.data()) + offset;
+	for (auto i = quint64(); i != size; ++i) {
+		to[i] = from[i] ^ mask[i & 3];
+	}
+	_socket->write(frame);
+}
+
+void Socket::writeClose(int code, const QByteArray &reason) {
+	auto payload = QByteArray();
+	if (code) {
+		payload.append(char((code >> 8) & 0xFF));
+		payload.append(char(code & 0xFF));
+		payload.append(reason);
+	}
+	write(kClose, payload);
+	_closeSent = true;
+}
+
+void Socket::socketError(QAbstractSocket::SocketError error) {
+	if (_done || error == QAbstractSocket::RemoteHostClosedError) {
+		return;
+	}
+	fail(_socket->errorString(), 0);
+}
+
+void Socket::disconnected() {
+	if (_done) {
+		return;
+	} else if (_state == State::Connecting) {
+		fail(u"the server closed the connection during the handshake"_q, 0);
+	} else {
+		finish(1006, QByteArray(), false, QString());
+	}
+}
+
+void Socket::timeout() {
+	if (_done) {
+		return;
+	} else if (_state == State::Connecting) {
+		fail(u"the connection timed out"_q, 0);
+	} else if (_state == State::Closing) {
+		finish(1006, QByteArray(), false, QString());
+	}
+}
+
+void Socket::fail(const QString &message, int code) {
+	if (_done) {
+		return;
+	}
+	const auto sent = code && _upgraded;
+	if (sent && !_closeSent) {
+		writeClose(code, QByteArray());
+	}
+	finish(sent ? code : 1006, message.toUtf8(), false, message);
+}
+
+void Socket::finish(
+		int code,
+		const QByteArray &reason,
+		bool clean,
+		const QString &error) {
+	if (_done) {
+		return;
+	}
+	_done = true;
+	_state = State::Closed;
+	_timer.cancel();
+	const auto weak = base::make_weak(this);
+	if (!error.isEmpty()) {
+		emitEvent([=](JSContext *ctx) {
+			auto result = EventObject(ctx, "error");
+			JS_SetPropertyStr(ctx, result, "message", NewString(ctx, error));
+			return result;
+		});
+		if (!weak) {
+			return;
+		}
+	}
+	emitEvent([=](JSContext *ctx) {
+		auto result = EventObject(ctx, "close");
+		JS_SetPropertyStr(ctx, result, "code", JS_NewInt32(ctx, code));
+		JS_SetPropertyStr(
+			ctx,
+			result,
+			"reason",
+			JS_NewStringLen(ctx, reason.constData(), std::size_t(reason.size())));
+		JS_SetPropertyStr(ctx, result, "wasClean", JS_NewBool(ctx, clean));
+		return result;
+	});
+	if (!weak) {
+		return;
+	}
+	ForgetKept(_instance, _callback);
+	_finished();
+}
+
+void Socket::emitEvent(Fn<JSValue(JSContext*)> payload) {
+	CallKept(_instance, _callback, std::move(payload), u"WebSocket"_q);
+}
+
+bool Socket::send(const QByteArray &data, bool text) {
+	if (_done || _state != State::Open || !_socket) {
+		return false;
+	}
+	write(text ? kText : kBinary, data);
+	return true;
+}
+
+void Socket::close(int code, const QByteArray &reason) {
+	if (_done) {
+		return;
+	} else if (_state == State::Connecting) {
+		_state = State::Closing;
+		crl::on_main(this, [=] {
+			fail(u"closed before the connection was established"_q, 0);
+		});
+	} else if (_state == State::Open) {
+		_state = State::Closing;
+		writeClose(code, reason);
+		_timer.callOnce(kCloseTimeout);
+	}
+}
+
+qint64 Socket::buffered() const {
+	return _socket ? qint64(_socket->bytesToWrite()) : 0;
+}
+
+struct Sockets final : public base::has_weak_ptr {
+	explicit Sockets(not_null<Instance*> instance);
+	~Sockets();
+
+	const not_null<Instance*> instance;
+	std::map<int, std::unique_ptr<Socket>> list;
+	int next = 0;
+};
+
+[[nodiscard]] std::map<Instance*, Sockets*> &AllSockets() {
+	static auto result = std::map<Instance*, Sockets*>();
+	return result;
+}
+
+Sockets::Sockets(not_null<Instance*> instance) : instance(instance) {
+}
+
+Sockets::~Sockets() {
+	AllSockets().erase(instance.get());
+}
+
+[[nodiscard]] not_null<Sockets*> SocketsOf(not_null<Instance*> instance) {
+	auto &all = AllSockets();
+	const auto i = all.find(instance.get());
+	if (i != end(all)) {
+		return i->second;
+	}
+	const auto result = ScriptLifetime(instance).make_state<Sockets>(
+		instance);
+	all.emplace(instance.get(), result);
+	return result;
+}
+
+[[nodiscard]] Socket *FindSocket(JSContext *ctx, JSValueConst id) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return nullptr;
+	}
+	const auto &all = AllSockets();
+	const auto i = all.find(instance);
+	if (i == end(all)) {
+		return nullptr;
+	}
+	auto number = int32_t();
+	if (JS_ToInt32(ctx, &number, id)) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		return nullptr;
+	}
+	const auto &list = i->second->list;
+	const auto j = list.find(number);
+	return (j != end(list)) ? j->second.get() : nullptr;
+}
+
+[[nodiscard]] JSValue Open(JSContext *ctx, int argc, JSValueConst *argv) {
+	if (argc < 3
+		|| !JS_IsString(argv[0])
+		|| !JS_IsArray(argv[1])
+		|| !JS_IsFunction(ctx, argv[2])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"websocketOpen needs (url, protocols, callback)");
+	}
+	const auto url = QUrl(FromStd(ToStd(ctx, argv[0])));
+	const auto scheme = url.scheme().toLower();
+	if (!url.isValid()
+		|| (scheme != u"ws"_q && scheme != u"wss"_q)
+		|| url.host().isEmpty()) {
+		return JS_ThrowSyntaxError(ctx, "WebSocket only takes ws and wss urls");
+	}
+	auto length = int64_t();
+	if (JS_GetLength(ctx, argv[1], &length)) {
+		return JS_EXCEPTION;
+	}
+	auto protocols = QStringList();
+	for (auto i = int64_t(); i != length; ++i) {
+		auto item = JS_GetPropertyInt64(ctx, argv[1], i);
+		const auto valid = JS_IsString(item);
+		const auto text = valid ? FromStd(ToStd(ctx, item)) : QString();
+		JS_FreeValue(ctx, item);
+		if (!valid || !ValidToken(text) || protocols.contains(text)) {
+			return JS_ThrowSyntaxError(
+				ctx,
+				"WebSocket: '%s' is not a valid subprotocol",
+				text.toUtf8().constData());
+		}
+		protocols.push_back(text);
+	}
+	const auto host = url.host().toLower().toStdString();
+	const auto instance = Permitted(ctx, Capability::Fetch, host, "WebSocket");
+	if (!instance) {
+		return JS_EXCEPTION;
+	} else if (scheme == u"wss"_q && !QSslSocket::supportsSsl()) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"WebSocket: TLS is not available in this build"_q);
+	}
+	const auto callback = KeepFunction(instance, argv[2]);
+	const auto sockets = SocketsOf(instance);
+	const auto id = ++sockets->next;
+	const auto weak = base::make_weak(sockets.get());
+	const auto socket = sockets->list.emplace(id, std::make_unique<Socket>(
+		instance,
+		url,
+		protocols,
+		callback,
+		[=] {
+			crl::on_main(weak, [=] {
+				weak.get()->list.erase(id);
+			});
+		})).first->second.get();
+	crl::on_main(socket, [=] {
+		socket->start();
+	});
+	return JS_NewInt32(ctx, id);
+}
+
+[[nodiscard]] JSValue Send(JSContext *ctx, int argc, JSValueConst *argv) {
+	if (argc < 2) {
+		return JS_ThrowTypeError(ctx, "websocketSend needs (id, data)");
+	}
+	auto data = QByteArray();
+	auto text = false;
+	if (JS_IsString(argv[1])) {
+		auto size = std::size_t();
+		const auto chars = JS_ToCStringLen(ctx, &size, argv[1]);
+		if (!chars) {
+			return JS_EXCEPTION;
+		} else if (qint64(size) > kMaxMessage) {
+			JS_FreeCString(ctx, chars);
+			return JS_ThrowRangeError(ctx, "WebSocket: a message is over 64 MB");
+		}
+		data = QByteArray(chars, int(size));
+		JS_FreeCString(ctx, chars);
+		text = true;
+	} else if (auto bytes = BytesFrom(ctx, argv[1])) {
+		if (qint64(bytes->size()) > kMaxMessage) {
+			return JS_ThrowRangeError(ctx, "WebSocket: a message is over 64 MB");
+		}
+		data = std::move(*bytes);
+	} else {
+		return JS_ThrowTypeError(
+			ctx,
+			"WebSocket: send takes a string, an ArrayBuffer or a view");
+	}
+	const auto socket = FindSocket(ctx, argv[0]);
+	return JS_NewBool(ctx, socket && socket->send(data, text));
+}
+
+[[nodiscard]] JSValue Close(JSContext *ctx, int argc, JSValueConst *argv) {
+	if (argc < 3 || !JS_IsNumber(argv[1]) || !JS_IsString(argv[2])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"websocketClose needs (id, code, reason)");
+	}
+	auto code = int32_t();
+	if (JS_ToInt32(ctx, &code, argv[1])) {
+		return JS_EXCEPTION;
+	} else if (!ValidSentCode(code)) {
+		return JS_ThrowRangeError(
+			ctx,
+			"WebSocket: the close code must be 1000 or 3000-4999, not %d",
+			code);
+	}
+	const auto reason = QByteArray::fromStdString(ToStd(ctx, argv[2]));
+	if (reason.size() > kMaxReason) {
+		return JS_ThrowSyntaxError(
+			ctx,
+			"WebSocket: the close reason is over %d bytes",
+			kMaxReason);
+	} else if (!code && !reason.isEmpty()) {
+		code = 1000;
+	}
+	if (const auto socket = FindSocket(ctx, argv[0])) {
+		socket->close(code, reason);
+	}
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] JSValue Buffered(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto socket = (argc > 0) ? FindSocket(ctx, argv[0]) : nullptr;
+	return JS_NewInt64(ctx, socket ? int64_t(socket->buffered()) : 0);
+}
+
+JSValue NativeWebSocket(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	switch (Op(magic)) {
+	case Op::Open: return Open(ctx, argc, argv);
+	case Op::Send: return Send(ctx, argc, argv);
+	case Op::Close: return Close(ctx, argc, argv);
+	case Op::Buffered: return Buffered(ctx, argc, argv);
+	}
+	return JS_UNDEFINED;
+}
+
+constexpr auto kTypings = std::string_view(R"TS(
+interface MessageEventInit<T = unknown> extends EventInit {
+  data?: T
+  origin?: string
+  lastEventId?: string
+  source?: null
+  ports?: unknown[]
+}
+
+declare class MessageEvent<T = unknown> extends Event {
+  constructor(type: string, init?: MessageEventInit<T>)
+  readonly data: T
+  readonly origin: string
+  readonly lastEventId: string
+  readonly source: null
+  readonly ports: readonly unknown[]
+}
+
+interface CloseEventInit extends EventInit {
+  code?: number
+  reason?: string
+  wasClean?: boolean
+}
+
+declare class CloseEvent extends Event {
+  constructor(type: string, init?: CloseEventInit)
+  readonly code: number
+  readonly reason: string
+  readonly wasClean: boolean
+}
+
+interface WebSocketEventMap {
+  open: Event
+  message: MessageEvent<string | ArrayBuffer>
+  error: Event
+  close: CloseEvent
+}
+
+type WebSocketBinaryType = 'arraybuffer'
+
+declare class WebSocket extends EventTarget {
+  constructor(url: string | URL, protocols?: string | string[])
+  static readonly CONNECTING: 0
+  static readonly OPEN: 1
+  static readonly CLOSING: 2
+  static readonly CLOSED: 3
+  readonly CONNECTING: 0
+  readonly OPEN: 1
+  readonly CLOSING: 2
+  readonly CLOSED: 3
+  readonly url: string
+  readonly protocol: string
+  readonly extensions: string
+  readonly readyState: number
+  readonly bufferedAmount: number
+  binaryType: WebSocketBinaryType
+  onopen: ((this: WebSocket, event: Event) => unknown) | null
+  onmessage: ((this: WebSocket, event: MessageEvent<string | ArrayBuffer>) => unknown) | null
+  onerror: ((this: WebSocket, event: Event) => unknown) | null
+  onclose: ((this: WebSocket, event: CloseEvent) => unknown) | null
+  send(data: string | ArrayBuffer | ArrayBufferView): void
+  close(code?: number, reason?: string): void
+  addEventListener<K extends keyof WebSocketEventMap>(
+    type: K,
+    listener: (this: WebSocket, event: WebSocketEventMap[K]) => unknown,
+    options?: boolean | AddEventListenerOptions,
+  ): void
+  addEventListener(
+    type: string,
+    listener: EventListenerOrEventListenerObject | null,
+    options?: boolean | AddEventListenerOptions,
+  ): void
+  removeEventListener<K extends keyof WebSocketEventMap>(
+    type: K,
+    listener: (this: WebSocket, event: WebSocketEventMap[K]) => unknown,
+    options?: boolean | EventListenerOptions,
+  ): void
+  removeEventListener(
+    type: string,
+    listener: EventListenerOrEventListenerObject | null,
+    options?: boolean | EventListenerOptions,
+  ): void
+}
+)TS");
+
+} // namespace
+
+void AddWebSocketNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "websocketOpen", NativeWebSocket, 3, int(Op::Open) },
+		{ "websocketSend", NativeWebSocket, 2, int(Op::Send) },
+		{ "websocketClose", NativeWebSocket, 3, int(Op::Close) },
+		{ "websocketBuffered", NativeWebSocket, 1, int(Op::Buffered) },
+	});
+}
+
+std::string_view WebSocketTypings() {
+	return kTypings;
+}
