+namespace {
+
+class Surface final : public base::has_weak_ptr {
+public:
+	explicit Surface(InlineScriptsDescriptor &&descriptor);
+	~Surface();
+
+	[[nodiscard]] bool update(const InlineBotQuery &query);
+	void choose(
+		const std::shared_ptr<InlineBots::Result> &result,
+		const Api::SendOptions &options);
+	[[nodiscard]] QString emptyText(int width) const;
+	void entryRemoved(int id);
+
+private:
+	void activate(
+		int entryId,
+		not_null<PeerData*> peer,
+		const QString &query,
+		int typed);
+	void deactivate();
+	void request();
+	void cancelRequest();
+	void answered(int callId, const QString &query, const Reply &reply);
+	void apply(const Cached &answer);
+	void showMessage(const QString &text);
+	void ensurePanel();
+	void hidePanel();
+	void setLoading(bool loading);
+	void remember(const QString &query, Cached answer);
+	[[nodiscard]] QString triggerText() const;
+
+	const not_null<QWidget*> _parent;
+	const not_null<Ui::InputField*> _field;
+	Window::SessionController * const _controller = nullptr;
+	const Fn<PeerData*()> _peer;
+	const Fn<FullReplyTo()> _replyTo;
+	const Fn<SendMenu::Details()> _sendMenuDetails;
+	const Fn<void(bool)> _loading;
+	const Fn<void()> _placeholder;
+	const Fn<void()> _sent;
+	base::unique_qptr<InlineBots::Layout::Widget> _panel;
+	const QWidget *_inner = nullptr;
+	base::Timer _timer;
+	base::flat_map<QString, Cached> _cache;
+	std::vector<QString> _cached;
+	int _entry = 0;
+	PeerData *_chat = nullptr;
+	QString _query;
+	bool _hasQuery = false;
+	int _callId = 0;
+	QString _message;
+	int _bottom = 0;
+	bool _requesting = false;
+	bool _placeholderSet = false;
+	rpl::lifetime _lifetime;
+
+};
+
+Surface::Surface(InlineScriptsDescriptor &&descriptor)
+: _parent(descriptor.parent)
+, _field(descriptor.field)
+, _controller(descriptor.controller)
+, _peer(std::move(descriptor.peer))
+, _replyTo(std::move(descriptor.replyTo))
+, _sendMenuDetails(std::move(descriptor.sendMenuDetails))
+, _loading(std::move(descriptor.loading))
+, _placeholder(std::move(descriptor.placeholder))
+, _sent(std::move(descriptor.sent))
+, _timer([=] { request(); }) {
+	State().fields[not_null<const QWidget*>(_field.get())] = this;
+	std::move(descriptor.bottom) | rpl::on_next([=](int bottom) {
+		_bottom = bottom;
+		if (_panel) {
+			_panel->moveBottom(bottom);
+		}
+	}, _lifetime);
+	_field->shownValue() | rpl::on_next([=](bool shown) {
+		if (!shown && _panel) {
+			_panel->hideFast();
+		}
+	}, _lifetime);
+}
+
+Surface::~Surface() {
+	auto &data = State();
+	data.fields.remove(not_null<const QWidget*>(_field.get()));
+	if (_inner) {
+		data.panels.remove(not_null<const QWidget*>(_inner));
+	}
+	if (const auto callId = base::take(_callId)) {
+		if (Take(callId)) {
+			SendCancel(_entry, callId);
+		}
+	}
+}
+
+QString Surface::triggerText() const {
+	const auto &entries = State().entries;
+	const auto i = entries.find(_entry);
+	return (i != end(entries)) ? (u"@"_q + i->second.trigger) : QString();
+}
+
+bool Surface::update(const InlineBotQuery &query) {
+	const auto peer = _peer ? _peer() : nullptr;
+	if (!_controller
+		|| !peer
+		|| query.bot
+		|| query.username.isEmpty()
+		|| &peer->session() != &_controller->session()) {
+		deactivate();
+		return false;
+	}
+	const auto &text = _field->getTextWithTags().text;
+	const auto typed = int(query.username.size()) + 1;
+	if (text.size() <= typed
+		|| text[0] != QChar('@')
+		|| !text[typed].isSpace()) {
+		deactivate();
+		return false;
+	}
+	const auto entryId = FindEntry(&peer->session(), query.username);
+	if (!entryId) {
+		deactivate();
+		return false;
+	}
+	activate(entryId, peer, text.mid(typed + 1), typed + 1);
+	return true;
+}
+
+void Surface::activate(
+		int entryId,
+		not_null<PeerData*> peer,
+		const QString &query,
+		int typed) {
+	if (_entry != entryId || _chat != peer.get()) {
+		_timer.cancel();
+		cancelRequest();
+		_cache.clear();
+		_cached.clear();
+		_entry = entryId;
+		_chat = peer.get();
+		_hasQuery = false;
+		hidePanel();
+		const auto &entries = State().entries;
+		const auto i = entries.find(entryId);
+		if (i != end(entries) && !i->second.title.isEmpty()) {
+			_field->setPlaceholder(rpl::single(i->second.title), typed);
+			_placeholderSet = true;
+		} else if (base::take(_placeholderSet) && _placeholder) {
+			_placeholder();
+		}
+	}
+	if (_hasQuery && _query == query) {
+		return;
+	}
+	_query = query;
+	_hasQuery = true;
+	cancelRequest();
+	if (const auto i = _cache.find(query); i != end(_cache)) {
+		_timer.cancel();
+		apply(i->second);
+		return;
+	}
+	_timer.callOnce(kDebounce);
+}
+
+void Surface::deactivate() {
+	if (!_entry) {
+		return;
+	}
+	_timer.cancel();
+	cancelRequest();
+	_cache.clear();
+	_cached.clear();
+	_entry = 0;
+	_chat = nullptr;
+	_hasQuery = false;
+	hidePanel();
+	if (base::take(_placeholderSet) && _placeholder) {
+		_placeholder();
+	}
+}
+
+void Surface::entryRemoved(int id) {
+	if (_entry == id) {
+		deactivate();
+	}
+}
+
+void Surface::cancelRequest() {
+	if (const auto callId = base::take(_callId)) {
+		if (Take(callId)) {
+			SendCancel(_entry, callId);
+		}
+	}
+	setLoading(false);
+}
+
+void Surface::setLoading(bool loading) {
+	if (_requesting == loading) {
+		return;
+	}
+	_requesting = loading;
+	if (_loading) {
+		_loading(loading);
+	}
+}
+
+void Surface::request() {
+	const auto &entries = State().entries;
+	const auto i = entries.find(_entry);
+	if (i == end(entries) || !_chat || !_hasQuery) {
+		deactivate();
+		return;
+	}
+	cancelRequest();
+	const auto entryId = _entry;
+	const auto query = _query;
+	const auto chat = MarkedId(_chat->id);
+	const auto weak = base::make_weak(this);
+	setLoading(true);
+	_callId = Ask(i->second, [=](JSContext *ctx, int callId) {
+		auto result = CallPayload(ctx, "query", callId);
+		JS_SetPropertyStr(ctx, result, "query", NewString(ctx, query));
+		JS_SetPropertyStr(ctx, result, "chat", JS_NewBigInt64(ctx, chat));
+		return result;
+	}, [=](JSContext *ctx, JSValueConst value, int callId) {
+		const auto parsed = ParseReply(ctx, value);
+		crl::async([=] {
+			auto reply = parsed;
+			for (auto &item : reply.items) {
+				if (!item.thumbBytes.isEmpty()) {
+					item.thumb = ReadThumb(item.thumbBytes);
+					if (item.thumb.isNull()) {
+						item.thumbBytes = QByteArray();
+					}
+				}
+			}
+			crl::on_main([=] {
+				if (const auto strong = weak.get()) {
+					strong->answered(callId, query, reply);
+				}
+			});
+		});
+	}, [=](int callId) {
+		SendCancel(entryId, callId);
+		if (const auto strong = weak.get()) {
+			strong->answered(callId, query, Reply{
+				.error = Lower(u"didn't answer in time"_q),
+			});
+		}
+	});
+}
+
+void Surface::answered(
+		int callId,
+		const QString &query,
+		const Reply &reply) {
+	if (callId != _callId || !_chat) {
+		return;
+	} else if (!State().entries.contains(_entry)) {
+		deactivate();
+		return;
+	}
+	_callId = 0;
+	setLoading(false);
+	auto answer = Cached{ .callId = callId, .error = reply.error };
+	if (answer.error.isEmpty()) {
+		answer.entry = BuildEntry(&_chat->session(), callId, reply.items);
+		remember(query, answer);
+	}
+	if (_hasQuery && _query == query) {
+		apply(answer);
+	}
+}
+
+void Surface::remember(const QString &query, Cached answer) {
+	if (!_cache.contains(query)) {
+		_cached.push_back(query);
+	}
+	_cache[query] = std::move(answer);
+	while (int(_cached.size()) > kKeptAnswers) {
+		_cache.remove(_cached.front());
+		_cached.erase(begin(_cached));
+	}
+}
+
+void Surface::apply(const Cached &answer) {
+	if (!answer.error.isEmpty()) {
+		showMessage(u"%1: %2"_q.arg(triggerText(), answer.error));
+		return;
+	}
+	_message = QString();
+	if (answer.entry.results.empty()) {
+		hidePanel();
+		return;
+	}
+	ensurePanel();
+	InlineAccess::ShowResults(_panel.get(), answer.entry);
+	_panel->raise();
+}
+
+void Surface::showMessage(const QString &text) {
+	_message = text;
+	ensurePanel();
+	InlineAccess::ShowMessage(_panel.get());
+	_panel->raise();
+}
+
+void Surface::hidePanel() {
+	_message = QString();
+	if (_panel) {
+		InlineAccess::Hide(_panel.get());
+	}
+}
+
+void Surface::ensurePanel() {
+	if (_panel || !_controller) {
+		return;
+	}
+	_panel = base::make_unique_q<InlineBots::Layout::Widget>(
+		_parent,
+		not_null<Window::SessionController*>(_controller));
+	_panel->hide();
+	_panel->setResultSelectedCallback([](InlineBots::ResultSelected) {
+	});
+	if (_sendMenuDetails) {
+		auto details = _sendMenuDetails;
+		_panel->setSendMenuDetails(std::move(details));
+	}
+	const auto inner = InlineAccess::Inner(_panel.get());
+	const auto raw = static_cast<const QWidget*>(inner.get());
+	_inner = raw;
+	State().panels[not_null<const QWidget*>(raw)] = this;
+	inner->lifetime().add([=] {
+		State().panels.remove(not_null<const QWidget*>(raw));
+	});
+	_panel->moveBottom(_bottom);
+}
+
+void Surface::choose(
+		const std::shared_ptr<InlineBots::Result> &result,
+		const Api::SendOptions &options) {
+	const auto &entries = State().entries;
+	const auto i = entries.find(_entry);
+	const auto instance = (i != end(entries))
+		? i->second.instance.get()
+		: nullptr;
+	if (!result || !_chat || !_controller || !instance) {
+		return;
+	} else if (!instance->permissions().allows(
+			Capability::AccountWrite,
+			"send")) {
+		_controller->showToast(Lower(
+			u"\"%1\" needs the grant %2 to send an inline result. "
+			"Allow it on the script's page in the Scripts manager."_q
+		).arg(
+			instance->name(),
+			GrantText(Capability::AccountWrite, "send")));
+		return;
+	}
+	const auto callId = int(result->getQueryId());
+	const auto index = result->getId().toInt();
+	const auto chat = MarkedId(_chat->id);
+	const auto reply = _replyTo ? _replyTo() : FullReplyTo();
+	const auto replyTo = (reply.messageId.peer == _chat->id)
+		? std::int64_t(reply.messageId.msg.bare)
+		: std::int64_t();
+	const auto topicId = std::int64_t(reply.topicRootId.bare);
+	const auto silent = options.silent;
+	const auto scheduled = std::int64_t(options.scheduled);
+	CallKept(i->second.instance, i->second.function, [=](JSContext *ctx) {
+		auto payload = CallPayload(ctx, "choose", callId);
+		JS_SetPropertyStr(ctx, payload, "index", JS_NewInt32(ctx, index));
+		JS_SetPropertyStr(ctx, payload, "chat", JS_NewBigInt64(ctx, chat));
+		const auto set = [&](const char *name, JSValue value) {
+			JS_SetPropertyStr(ctx, payload, name, value);
+		};
+		if (replyTo > 0) {
+			set("replyTo", JS_NewInt64(ctx, replyTo));
+		}
+		if (topicId > 0) {
+			set("topicId", JS_NewInt64(ctx, topicId));
+		}
+		if (silent) {
+			set("silent", JS_NewBool(ctx, true));
+		}
+		if (scheduled > 0) {
+			set("scheduleDate", JS_NewInt64(ctx, scheduled));
+		}
+		return payload;
+	}, u"tg.registerInline"_q);
+	if (_sent) {
+		_sent();
+	}
+}
+
+QString Surface::emptyText(int width) const {
+	return _message.isEmpty()
+		? QString()
+		: st::normalFont->elided(_message, std::max(width, 1));
+}
+
+[[nodiscard]] Surface *FindPanel(not_null<const QWidget*> inner) {
+	const auto &panels = State().panels;
+	const auto i = panels.find(inner);
+	return (i != end(panels)) ? i->second : nullptr;
+}
+
+void EntriesRemoved(std::vector<int> ids) {
+	if (ids.empty()) {
+		return;
+	}
+	crl::on_main([ids = std::move(ids)] {
+		auto surfaces = std::vector<base::weak_ptr<Surface>>();
+		for (const auto &[field, surface] : State().fields) {
+			surfaces.push_back(base::make_weak(surface));
+		}
+		for (const auto &weak : surfaces) {
+			for (const auto id : ids) {
+				if (const auto strong = weak.get()) {
+					strong->entryRemoved(id);
+				}
+			}
+		}
+	});
+}
+
+void RemoveOwner(Instance *owner) {
+	auto &data = State();
+	data.tracked.remove(owner);
+	auto removed = std::vector<int>();
+	for (auto i = begin(data.entries); i != end(data.entries);) {
+		if (i->second.owner != owner) {
+			++i;
+			continue;
+		}
+		removed.push_back(i->first);
+		i = data.entries.erase(i);
+	}
+	auto fallbacks = std::vector<std::pair<int, Fn<void(int)>>>();
+	for (auto i = begin(data.waiting); i != end(data.waiting);) {
+		if (i->second.owner == owner) {
+			fallbacks.emplace_back(i->first, std::move(i->second.fallback));
+			i = data.waiting.erase(i);
+		} else {
+			++i;
+		}
+	}
+	for (auto &[callId, fallback] : fallbacks) {
+		crl::on_main([callId, fallback = std::move(fallback)] {
+			fallback(callId);
+		});
+	}
+	EntriesRemoved(std::move(removed));
+}
+
+void Track(not_null<Instance*> instance) {
+	auto &data = State();
+	const auto raw = instance.get();
+	if (data.tracked.contains(raw)) {
+		return;
+	}
+	data.tracked.emplace(raw);
+	ScriptLifetime(instance).add([=] {
+		RemoveOwner(raw);
+	});
+}
+
+[[nodiscard]] JSValue Register(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	} else if (argc < 3
+		|| !JS_IsString(argv[0])
+		|| !JS_IsString(argv[1])
+		|| !JS_IsFunction(ctx, argv[2])) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.registerInline({ trigger, title?, results })");
+	}
+	const auto trigger = FromStd(ToStd(ctx, argv[0]));
+	if (!ValidTrigger(trigger)) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.registerInline: trigger is 2-32 characters of a-z, 0-9 "
+			"and _, starting with a letter");
+	}
+	const auto session = ScriptSession(instance);
+	for (const auto &[id, entry] : State().entries) {
+		if (entry.session == session.get() && entry.trigger == trigger) {
+			const auto owner = entry.instance.get();
+			return ThrowTeleError(
+				ctx,
+				"forbidden",
+				u"the trigger @%1 is taken by \"%2\""_q.arg(
+					trigger,
+					owner ? owner->name() : QString()));
+		}
+	}
+	Track(instance);
+	auto &data = State();
+	const auto id = ++data.nextEntry;
+	data.entries.emplace(id, Entry{
+		.owner = instance,
+		.instance = base::make_weak(instance),
+		.session = session.get(),
+		.function = KeepFunction(instance, argv[2]),
+		.trigger = trigger,
+		.title = FromStd(ToStd(ctx, argv[1])).trimmed().left(kMaxTitle),
+	});
+	return JS_NewInt32(ctx, id);
+}
+
+void Remove(not_null<Instance*> instance, int id) {
+	auto &data = State();
+	const auto i = data.entries.find(id);
+	if (i == end(data.entries) || i->second.owner != instance.get()) {
+		return;
+	}
+	const auto weak = i->second.instance;
+	const auto function = i->second.function;
+	data.entries.erase(i);
+	ForgetKept(weak, function);
+	EntriesRemoved({ id });
+}
+
+[[nodiscard]] JSValue TakeAnswer(
+		JSContext *ctx,
+		int argc,
+		JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	auto callId = 0;
+	if (!instance || argc < 1 || JS_ToInt32(ctx, &callId, argv[0]) < 0) {
+		return JS_UNDEFINED;
+	}
+	const auto &waiting = State().waiting;
+	const auto i = waiting.find(callId);
+	if (i == end(waiting) || i->second.owner != instance) {
+		return JS_UNDEFINED;
+	}
+	if (const auto taken = Take(callId)) {
+		taken->answer(ctx, (argc > 1) ? argv[1] : JS_UNDEFINED, callId);
+	}
+	return JS_UNDEFINED;
+}
+
+JSValue NativeInline(
+		JSContext *ctx,
+		JSValueConst thisValue,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	switch (magic) {
+	case 0: return Register(ctx, argc, argv);
+	case 1: {
+		const auto instance = Instance::From(ctx);
+		auto id = 0;
+		if (instance
+			&& argc > 0
+			&& JS_IsNumber(argv[0])
+			&& !JS_ToInt32(ctx, &id, argv[0])) {
+			Remove(instance, id);
+		}
+		return JS_UNDEFINED;
+	}
+	case 2: return TakeAnswer(ctx, argc, argv);
+	}
+	return JS_UNDEFINED;
+}
+
+} // namespace
+
+void AddInlineNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "inlineRegister", NativeInline, 3, 0 },
+		{ "inlineRemove", NativeInline, 1, 1 },
+		{ "inlineAnswer", NativeInline, 2, 2 },
+	});
+}
