+		return;
+	}
+	const auto peek = PeekScriptContent(download.content);
+	const auto added = GrantsBeyond(state->declared, peek.grants);
+	const auto removed = GrantsBeyond(peek.grants, state->declared);
+	auto paragraphs = QStringList();
+	paragraphs.push_back((state->version.isEmpty() || peek.version.isEmpty())
+		? Lower(u"Update %1? Its file is replaced and the old one goes "
+			"to the recycle bin."_q).arg(state->name)
+		: Lower(u"Update %1 from %2 to %3? Its file is replaced and the "
+			"old one goes to the recycle bin."_q).arg(
+				state->name,
+				state->version,
+				peek.version));
+	if (!added.isEmpty()) {
+		paragraphs.push_back(Lower(u"New grants:"_q)
+			+ u"\n"_q
+			+ added.join('\n')
+			+ (state->enabled
+				? (u"\n"_q + Lower(u"It waits for your approval of "
+					"them before it runs again."_q))
+				: QString()));
+	}
+	if (!removed.isEmpty()) {
+		paragraphs.push_back(Lower(u"No longer asks for:"_q)
+			+ u"\n"_q
+			+ removed.join('\n'));
+	}
+	if (added.isEmpty() && removed.isEmpty()) {
+		paragraphs.push_back(Lower(u"It asks for the same grants."_q));
+	}
+	const auto name = state->name;
+	const auto content = download.content;
+	const auto etag = download.etag;
+	const auto version = peek.version;
+	manager->show->show(Ui::MakeConfirmBox({
+		.text = paragraphs.join(u"\n\n"_q),
+		.confirmed = [=](Fn<void()> close) {
+			close();
+			const auto error = UpdateScript(id, content);
+			if (!error.isEmpty()) {
+				Toast(manager, error);
+				return;
+			}
+			SetScriptSource(id, source, etag, version);
+			Toast(manager, version.isEmpty()
+				? Lower(u"Updated %1."_q).arg(name)
+				: Lower(u"Updated %1 to %2."_q).arg(name, version));
+		},
+		.confirmText = Lower(u"Update"_q),
+	}));
+}
+
+void UpdateFromSource(std::shared_ptr<Manager> manager, const QString &id) {
+	const auto state = FindScript(manager->session, id);
+	const auto url = state ? ParseLink(state->source) : std::nullopt;
+	if (!url) {
+		return;
+	}
+	const auto source = state->source;
+	Toast(manager, Lower(u"Downloading %1\u2026"_q).arg(url->fileName()));
+	DownloadScript(*url, QString(), kMaxUpdate, [=](ScriptDownload result) {
+		if (!result.error.isEmpty()) {
+			Toast(manager, Lower(u"Can't download it: %1"_q).arg(
+				result.error));
+			return;
+		}
+		ConfirmUpdate(manager, id, source, std::move(result));
+	});
+}
