+++ b/Telegram/Resources/tele/scripting/dialogs.js
@@ -0,0 +1,220 @@
+(() => {
+	const kMaxResults = 20;
+	const kMaxButtons = 3;
+	const kKeptAnswers = 32;
+
+	const report = (where, error) => {
+		console.error(`${where}: ${error?.stack ?? error}`);
+	};
+
+	const run = (where, callback) => {
+		try {
+			const value = callback();
+			if (value && typeof value.then === 'function') {
+				value.then(undefined, (error) => report(where, error));
+			}
+		} catch (error) {
+			report(where, error);
+		}
+	};
+
+	const checkResult = (item) => {
+		if (item === null || typeof item !== 'object') {
+			return 'a result must be an object';
+		} else if (typeof item.title !== 'string' || !item.title.trim()) {
+			return 'a result needs a non-empty title';
+		} else if (item.subtitle !== undefined && typeof item.subtitle !== 'string') {
+			return 'subtitle must be a string';
+		} else if (item.messageId !== undefined && (!Number.isSafeInteger(item.messageId) || item.messageId <= 0)) {
+			return 'messageId must be a positive integer';
+		} else if (item.onClick !== undefined && typeof item.onClick !== 'function') {
+			return 'onClick must be a function';
+		}
+		return null;
+	};
+
+	globalThis.__teleExtensions.push({
+		name: 'dialogs',
+		tg(tg, natives, { resolvePeer }) {
+			const searches = new Map();
+			const answered = new Map();
+
+			const remember = (callId, results) => {
+				answered.set(callId, results);
+				while (answered.size > kKeptAnswers) {
+					answered.delete(answered.keys().next().value);
+				}
+			};
+
+			const normalize = async (found, where) => {
+				if (found === undefined || found === null) {
+					return [];
+				} else if (!Array.isArray(found)) {
+					throw new TypeError(`${where}: search must return an array of results or nothing`);
+				}
+				const valid = found.filter((item) => {
+					const problem = checkResult(item);
+					if (problem) {
+						report(where, new TypeError(problem));
+					}
+					return !problem;
+				}).slice(0, kMaxResults);
+				return Promise.all(valid.map(async (item) => {
+					let peer = null;
+					if (item.peer !== undefined && item.peer !== null) {
+						try {
+							peer = await resolvePeer(item.peer);
+						} catch (error) {
+							report(where, error);
+						}
+					}
+					return {
+						title: item.title,
+						subtitle: item.subtitle ?? '',
+						peer,
+						messageId: item.messageId,
+						click: typeof item.onClick === 'function',
+						onClick: item.onClick,
+					};
+				}));
+			};
+
+			tg.ui.registerSearchProvider = (provider) => {
+				if (provider === null || typeof provider !== 'object' || typeof provider.search !== 'function') {
+					throw new TypeError('tg.ui.registerSearchProvider({ title, search })');
+				} else if (typeof provider.title !== 'string' || !provider.title.trim()) {
