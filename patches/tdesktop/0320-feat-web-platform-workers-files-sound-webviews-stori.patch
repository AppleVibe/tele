+int ChatBanners::resizeGetHeight(int newWidth) {
+	auto top = 0;
+	for (const auto &bar : _bars) {
+		bar->resizeToWidth(newWidth);
+		bar->moveToLeft(0, top, newWidth);
+		top += bar->height();
