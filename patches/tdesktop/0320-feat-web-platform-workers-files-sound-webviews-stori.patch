+int BannerBar::resizeGetHeight(int newWidth) {
+	const auto skip = st::historyContactStatusMinSkip;
+	auto right = newWidth - (_close ? _close->width() : skip);
+	auto buttons = 0;
+	for (const auto button : _buttons) {
+		buttons += button->width();
+	}
+	const auto textWidth = right
+		- buttons
+		- (_buttons.empty() ? 0 : skip)
+		- skip;
+	_text->resizeToWidth(std::max(textWidth, 1));
+	const auto height = std::max(
+		st::historyContactStatusButton.height,
+		_text->height() + skip);
+	_text->moveToLeft(skip, (height - _text->height()) / 2, newWidth);
+	for (auto i = int(_buttons.size()); i != 0;) {
+		const auto button = _buttons[--i];
+		right -= button->width();
+		button->moveToLeft(
+			right,
+			(height - button->height()) / 2,
+			newWidth);
+	}
+	if (_close) {
+		_close->moveToLeft(
+			newWidth - _close->width(),
+			(height - _close->height()) / 2,
+			newWidth);
+	}
+	_shadow->setGeometry(0, height - st::lineWidth, newWidth, st::lineWidth);
+	return height;
+}
