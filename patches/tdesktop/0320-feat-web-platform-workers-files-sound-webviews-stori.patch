+constexpr auto kPrefix = std::string_view("tele-script/");
+constexpr auto kPage = std::string_view("index.html");
+constexpr auto kPanelName = "TeleMtpPanel";
+constexpr auto kMinSize = 120;
+constexpr auto kMaxSize = 4096;
+constexpr auto kDefaultWidth = 480;
+constexpr auto kDefaultHeight = 600;
+constexpr auto kWhere = "tg.ui.webview";
+
+constexpr auto kBridge = R"js((() => {
+const lock = (name) => {
+	try {
+		Object.defineProperty(window, name, {
+			value: undefined,
+			configurable: false,
+			writable: false,
+		});
+	} catch (error) {
+	}
+};
+if (__TELE_RESTRICTED__) {
+	for (const name of ['RTCPeerConnection', 'webkitRTCPeerConnection', 'RTCDataChannel']) {
+		lock(name);
+	}
+}
+if (window !== window.top || window.tele) {
+	return;
+}
+let theme = __TELE_THEME__;
+let handler = null;
+let pending = [];
+const report = (error) => {
+	setTimeout(() => {
+		throw error;
+	});
+};
+const run = (callback, data) => {
+	try {
+		callback(data);
+	} catch (error) {
+		report(error);
+	}
+};
+const apply = () => {
+	const root = document.documentElement;
+	if (!root) {
+		return false;
+	}
+	for (const name of Object.keys(theme)) {
+		root.style.setProperty(name, theme[name]);
+	}
+	return true;
+};
+if (!apply()) {
+	const observer = new MutationObserver(() => {
+		if (apply()) {
+			observer.disconnect();
+		}
+	});
+	observer.observe(document, { childList: true });
+}
+const hidden = (name, value) => {
+	Object.defineProperty(window, name, { value });
+};
+hidden('__teleTheme', (value) => {
+	theme = value;
+	apply();
+});
+hidden('__teleDeliver', (text) => {
+	const data = JSON.parse(text);
+	if (handler) {
+		run(handler, data);
+	} else if (pending.length < 1000) {
+		pending.push(data);
+	}
+	try {
+		window.dispatchEvent(new CustomEvent('tele-message', { detail: data }));
+	} catch (error) {
+		report(error);
+	}
+});
+const tele = {};
+Object.defineProperties(tele, {
+	postMessage: {
+		enumerable: true,
+		value: (data) => {
+			const text = JSON.stringify(data);
+			if (typeof text !== 'string') {
+				throw new TypeError('tele.postMessage needs JSON-serializable data');
+			}
+			window.external.invoke(text);
+		},
+	},
+	onMessage: {
+		enumerable: true,
+		get: () => handler,
+		set: (value) => {
+			handler = (typeof value === 'function') ? value : null;
+			if (handler) {
+				const list = pending;
+				pending = [];
+				for (const data of list) {
+					run(handler, data);
+				}
+			}
+		},
+	},
+});
+hidden('tele', Object.seal(tele));
+})();)js";
+
+struct Options {
+	QString title;
+	QByteArray html;
+	QString url;
+	QSize size;
+	bool resizable = true;
+};
+
+[[nodiscard]] Window::SessionController *WindowOf(
+		not_null<Main::Session*> session) {
+	auto result = (Window::SessionController*)nullptr;
+	for (const auto &window : session->windows()) {
+		if (window->isPrimary()) {
+			return window;
+		} else if (!result) {
+			result = window;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString Css(const style::color &color) {
+	const auto value = color->c;
+	if (value.alpha() == 255) {
+		return value.name(QColor::HexRgb);
+	}
+	return u"rgba(%1,%2,%3,%4)"_q
+		.arg(value.red())
+		.arg(value.green())
+		.arg(value.blue())
+		.arg(value.alpha() / 255.);
+}
+
+[[nodiscard]] QByteArray ThemeJson() {
+	return QJsonDocument(QJsonObject{
+		{ u"--tele-bg"_q, Css(st::windowBg) },
+		{ u"--tele-text"_q, Css(st::windowFg) },
+		{ u"--tele-accent"_q, Css(st::activeButtonBg) },
+		{ u"--tele-secondary-bg"_q, Css(st::windowBgOver) },
+		{ u"--tele-hint"_q, Css(st::windowSubTextFg) },
+		{ u"--tele-link"_q, Css(st::windowActiveTextFg) },
+	}).toJson(QJsonDocument::Compact);
+}
+
+[[nodiscard]] QByteArray BridgeScript(bool restricted) {
+	auto result = QByteArray(kBridge);
+	result.replace("__TELE_RESTRICTED__", restricted ? "true" : "false");
+	result.replace("__TELE_THEME__", ThemeJson());
+	return result;
+}
+
+[[nodiscard]] QByteArray PolicyFor(const Permissions &permissions) {
+	auto sources = QByteArray();
+	for (const auto &grant : permissions.grants()) {
+		if (grant.capability != Capability::Fetch) {
+			continue;
+		} else if (grant.scope.empty()) {
+			sources += " https: http: wss: ws:";
+			continue;
+		}
+		const auto host = QByteArray::fromStdString(grant.scope);
+		for (const auto scheme : { "https://", "http://", "wss://", "ws://" }) {
+			sources += ' ' + QByteArray(scheme) + host;
+			sources += ' ' + QByteArray(scheme) + "*." + host;
+		}
+	}
+	return "default-src 'self' data: blob: 'unsafe-inline' 'unsafe-eval'"
+		+ sources
+		+ "; base-uri 'self'; form-action 'none'";
+}
+
+[[nodiscard]] QByteArray WithPolicy(
+		QByteArray html,
+		const QByteArray &policy) {
+	const auto head = QByteArray("<meta http-equiv=\"x-dns-prefetch-control\" "
+		"content=\"off\"><meta http-equiv=\"Content-Security-Policy\" "
+		"content=\"")
+		+ Ui::EscapeForAttribute(policy)
+		+ "\">";
+	auto start = 0;
+	if (html.startsWith("\xEF\xBB\xBF")) {
+		start = 3;
+	}
+	while (start < html.size() && QChar::isSpace(uint(uchar(html[start])))) {
+		++start;
+	}
+	auto position = 0;
+	if (html.mid(start, 9).toLower() == "<!doctype") {
+		const auto end = html.indexOf('>', start);
+		if (end >= 0) {
+			position = end + 1;
+		}
+	}
+	html.insert(position, head);
+	return html;
+}
+
+[[nodiscard]] Webview::StorageId StorageFor(not_null<Instance*> instance) {
+	const auto key = QCryptographicHash::hash(
+		(u"tele-script-webview:"_q + ScriptId(instance)).toUtf8(),
+		QCryptographicHash::Md5);
+	auto result = ScriptSession(instance)->local().resolveStorageIdOther();
+	result.path += u"-scripts/"_q + QString::fromLatin1(key.toHex());
+	result.token = key;
+	return result;
+}
+
+void PlaceOver(
+		not_null<Ui::SeparatePanel*> panel,
+		not_null<QWidget*> parent) {
+	if (!parent->isVisible() || parent->isMinimized()) {
+		return;
+	}
+	const auto screen = parent->screen();
+	const auto available = screen ? screen->availableGeometry() : QRect();
+	auto rect = panel->geometry();
+	rect.moveCenter(parent->geometry().center());
+	if (!available.isEmpty()) {
+		rect.moveLeft(std::max(
+			available.left(),
+			std::min(
+				rect.left(),
+				available.left() + available.width() - rect.width())));
+		rect.moveTop(std::max(
+			available.top(),
+			std::min(
+				rect.top(),
+				available.top() + available.height() - rect.height())));
+	}
+	Ui::SetGeometryAndScreen(panel, rect);
+}
+
+void ClosedByUser(base::weak_ptr<Instance> weak, int id);
+
+class Panel final : public base::has_weak_ptr {
+public:
+	Panel(
+		not_null<Instance*> instance,
+		not_null<Window::SessionController*> window,
+		int id,
+		int handler,
+		Options options);
+	~Panel();
+
+	[[nodiscard]] bool valid() const;
+	[[nodiscard]] int handler() const;
+	void post(QByteArray json);
+	void setTitle(const QString &title);
+
+private:
+	void createPanel(not_null<QWidget*> parent, const Options &options);
+	bool createWebview(not_null<Instance*> instance, Options options);
+	void activate();
+	void loaded();
+	void deliver(const QByteArray &json);
+	void updateTheme();
+	void closed();
+
+	const base::weak_ptr<Instance> _instance;
+	const int _id = 0;
+	const int _handler = 0;
+	rpl::variable<QString> _title;
+	std::unique_ptr<Ui::SeparatePanel> _panel;
+	Ui::RpWidget *_container = nullptr;
+	std::unique_ptr<Webview::Window> _webview;
+	std::vector<QByteArray> _queue;
+	bool _loaded = false;
+	bool _closing = false;
+
+};
+
+struct Panels {
+	explicit Panels(not_null<Instance*> instance);
+	~Panels();
+
+	const not_null<Instance*> instance;
+	base::flat_map<int, std::unique_ptr<Panel>> list;
+	int next = 0;
+};
+
+[[nodiscard]] base::flat_map<not_null<Instance*>, not_null<Panels*>> &All() {
+	static auto result = base::flat_map<
+		not_null<Instance*>,
+		not_null<Panels*>>();
+	return result;
+}
+
+Panels::Panels(not_null<Instance*> instance) : instance(instance) {
+	All().emplace(instance, this);
+}
+
+Panels::~Panels() {
+	All().remove(instance);
+}
+
+[[nodiscard]] Panels *FindPanels(not_null<Instance*> instance) {
+	const auto i = All().find(instance);
+	return (i != end(All())) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] not_null<Panels*> PanelsFor(not_null<Instance*> instance) {
+	if (const auto found = FindPanels(instance)) {
+		return found;
+	}
+	return ScriptLifetime(instance).make_state<Panels>(instance);
+}
+
+[[nodiscard]] Panel *FindPanel(not_null<Instance*> instance, int id) {
+	const auto panels = FindPanels(instance);
+	if (!panels) {
+		return nullptr;
+	}
+	const auto i = panels->list.find(id);
+	return (i != end(panels->list)) ? i->second.get() : nullptr;
+}
+
+[[nodiscard]] std::unique_ptr<Panel> TakePanel(
+		not_null<Instance*> instance,
+		int id) {
+	const auto panels = FindPanels(instance);
+	if (!panels) {
+		return nullptr;
+	}
+	const auto i = panels->list.find(id);
+	if (i == end(panels->list)) {
+		return nullptr;
+	}
+	auto result = std::move(i->second);
+	panels->list.erase(i);
+	return result;
+}
+
+void ClosedByUser(base::weak_ptr<Instance> weak, int id) {
+	const auto strong = weak.get();
+	if (!strong) {
+		return;
+	}
+	auto panel = TakePanel(strong, id);
+	if (!panel) {
+		return;
+	}
+	const auto handler = panel->handler();
+	panel = nullptr;
+	CallKept(weak, handler, [](JSContext *ctx) {
+		auto result = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, result, "type", JS_NewString(ctx, "close"));
+		return result;
+	}, QString::fromLatin1(kWhere));
+	ForgetKept(weak, handler);
+}
+
+Panel::Panel(
+	not_null<Instance*> instance,
+	not_null<Window::SessionController*> window,
