+[[nodiscard]] bool ValidUtf8(const QByteArray &bytes) {
+	const auto data = reinterpret_cast<const uchar*>(bytes.constData());
+	const auto size = qint64(bytes.size());
+	auto i = qint64();
+	while (i < size) {
+		const auto lead = data[i];
+		if (lead < 0x80) {
+			++i;
+			continue;
+		}
+		auto count = 0;
+		auto minimal = uint32();
+		auto code = uint32();
+		if ((lead & 0xE0) == 0xC0) {
+			count = 1;
+			minimal = 0x80;
+			code = lead & 0x1F;
+		} else if ((lead & 0xF0) == 0xE0) {
+			count = 2;
+			minimal = 0x800;
+			code = lead & 0x0F;
+		} else if ((lead & 0xF8) == 0xF0) {
+			count = 3;
+			minimal = 0x10000;
+			code = lead & 0x07;
+		} else {
+			return false;
+		}
+		if (size - i <= count) {
+			return false;
+		}
+		for (auto j = 1; j <= count; ++j) {
+			const auto next = data[i + j];
+			if ((next & 0xC0) != 0x80) {
+				return false;
+			}
+			code = (code << 6) | (next & 0x3F);
+		}
+		if (code < minimal
+			|| code > 0x10FFFF
+			|| (code >= 0xD800 && code <= 0xDFFF)) {
+			return false;
+		}
+		i += count + 1;
+	}
+	return true;
+}
+
+[[nodiscard]] bool ValidToken(const QString &text) {
+	static const auto separators = u"()<>@,;:\\\"/[]?={}"_q;
+	if (text.isEmpty()) {
+		return false;
+	}
+	for (const auto ch : text) {
+		const auto code = ch.unicode();
+		if (code <= 0x20 || code >= 0x7F || separators.contains(ch)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] bool ValidReceivedCode(int code) {
+	return (code >= 1000 && code <= 1003)
+		|| (code >= 1007 && code <= 1014)
+		|| (code >= 3000 && code <= 4999);
+}
+
+[[nodiscard]] bool ValidSentCode(int code) {
+	return !code || (code == 1000) || (code >= 3000 && code <= 4999);
