+			throw new TypeError(`${what} needs a unique gift slug or a t.me/nft/ link`);
+		}
+		return slug;
+	};
+
+	const limitOf = (value, what) => {
+		if (value === undefined || value === null) {
+			return DEFAULT_LIMIT;
+		} else if (!Number.isInteger(value) || value < 1 || value > MAX_LIMIT) {
+			throw new TypeError(`${what}: limit is a whole number from 1 to ${MAX_LIMIT}`);
+		}
+		return value;
+	};
+
+	const offsetOf = (value, what) => {
+		if (value === undefined || value === null) {
+			return '';
+		} else if (typeof value !== 'string') {
+			throw new TypeError(`${what}: offset is the nextOffset string of the previous page`);
+		}
+		return value;
+	};
+
+	const giftOf = (raw, names) => {
+		if (raw._ === 'starGiftUnique') {
+			const find = (type) => raw.attributes.find((attribute) => attribute._ === type);
+			const model = find('starGiftAttributeModel');
+			const pattern = find('starGiftAttributePattern');
+			const backdrop = find('starGiftAttributeBackdrop');
+			const details = find('starGiftAttributeOriginalDetails');
+			const owner = markedId(raw.ownerId);
+			return {
+				unique: true,
+				id: raw.id,
+				giftId: raw.giftId,
+				slug: raw.slug,
+				link: `https://t.me/nft/${raw.slug}`,
+				title: raw.title,
+				number: raw.num,
+				owner,
+				ownerName: raw.ownerName ?? ((owner === null) ? null : (names.get(owner) ?? null)),
+				model: model
+					? {
+						name: model.name,
+						rarity: rarityOf(model.rarity),
+						document: model.document,
+						crafted: model.crafted === true,
+					}
+					: null,
+				pattern: pattern
+					? { name: pattern.name, rarity: rarityOf(pattern.rarity), document: pattern.document }
+					: null,
+				backdrop: backdrop
+					? {
+						name: backdrop.name,
+						rarity: rarityOf(backdrop.rarity),
+						centerColor: backdrop.centerColor,
+						edgeColor: backdrop.edgeColor,
+						patternColor: backdrop.patternColor,
+						textColor: backdrop.textColor,
+					}
+					: null,
+				originalDetails: details
+					? {
+						sender: markedId(details.senderId),
+						recipient: markedId(details.recipientId),
+						date: details.date,
+						message: textOf(details.message),
+					}
+					: null,
+				attributes: raw.attributes,
+				sticker: model?.document ?? null,
+				stars: null,
+				convertStars: null,
+				upgradeStars: null,
+				resaleStars: raw.resellAmount?.find((amount) => amount._ === 'starsAmount')?.amount ?? null,
+				limited: true,
+				soldOut: false,
+				availability: { total: raw.availabilityTotal, remains: null, issued: raw.availabilityIssued },
+				value: (raw.valueAmount === undefined)
+					? null
