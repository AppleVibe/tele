+			throw new TypeError(`${what}: format is a name like 'jpeg', 'png', 'webp' or 'bmp'`);
+		}
+		const lower = value.toLowerCase();
+		return (lower === 'jpg') ? 'jpeg' : lower;
+	};
+	const encoding = (what, given) => ({
+		format: format(what, given.format),
+		quality: integer(what, 'quality', given.quality, 0, 100, -1),
+	});
+	const color = (what, value) => {
+		if (value === undefined) {
+			return undefined;
+		} else if (value === 'transparent') {
+			return 0;
+		}
+		const match = (typeof value === 'string')
