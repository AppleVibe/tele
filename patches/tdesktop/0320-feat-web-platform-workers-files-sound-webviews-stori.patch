+void CloseBanner(int id) {
+	auto &banners = Banners();
+	const auto i = ranges::find(banners, id, &Banner::id);
+	if (i == end(banners)) {
+		return;
+	}
+	const auto instance = i->instance;
+	const auto handler = i->handler;
+	banners.erase(i);
+	BannerChanges().fire({});
+	crl::on_main([=] {
+		CallKept(instance, handler, [](JSContext *ctx) {
+			auto result = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, result, "closed", JS_TRUE);
+			return result;
