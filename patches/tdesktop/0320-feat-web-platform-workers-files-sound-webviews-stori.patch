+JSValue FoldersList(JSContext *ctx) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	const auto chats = instance->permissions().allows(
+		Capability::AccountRead,
+		"dialogs");
+	auto result = JS_NewArray(ctx);
+	auto index = uint32_t();
+	const auto marked = [&](const auto &histories, const auto &skip) {
+		auto ids = std::vector<PeerId>();
+		for (const auto &history : histories) {
+			if (!ranges::contains(skip, history)) {
+				ids.push_back(history->peer->id);
+			}
+		}
+		return ChatsArray(ctx, ids);
+	};
+	const auto none = std::vector<not_null<History*>>();
+	for (const auto &filter : instance->session()->data().chatsFilters().list()) {
+		const auto id = filter.id();
+		if (!id) {
+			continue;
+		}
+		auto item = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, item, "id", JS_NewInt32(ctx, id));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"title",
+			NewString(ctx, filter.titleText().text));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"emoji",
+			NewString(ctx, filter.iconEmoji()));
+		const auto color = filter.colorIndex();
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"color",
+			color ? JS_NewInt32(ctx, *color) : JS_NULL);
+		auto flags = JS_NewObject(ctx);
+		for (const auto &[name, flag] : kFolderFlags) {
+			JS_SetPropertyStr(
+				ctx,
+				flags,
+				name,
+				JS_NewBool(ctx, bool(filter.flags() & flag)));
+		}
+		JS_SetPropertyStr(ctx, item, "flags", flags);
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"shared",
+			JS_NewBool(ctx, filter.chatlist()));
+		JS_SetPropertyStr(
+			ctx,
+			item,
+			"local",
+			JS_NewBool(ctx, IsLocalFolder(id)));
+		if (chats) {
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"include",
+				marked(filter.always(), filter.pinned()));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"exclude",
+				marked(filter.never(), none));
+			JS_SetPropertyStr(
+				ctx,
+				item,
+				"pinned",
+				marked(filter.pinned(), none));
+		}
+		JS_SetPropertyUint32(ctx, result, index++, item);
+	}
+	return result;
+}
+
+enum class Parsed {
+	Missing,
+	Done,
+	Bad,
+};
+
+[[nodiscard]] Parsed HistoriesProperty(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name,
+		not_null<Data::Session*> owner,
+		std::vector<not_null<History*>> &result) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	if (JS_IsUndefined(value)) {
+		return Parsed::Missing;
+	}
+	auto length = std::int64_t();
+	if (!JS_IsArray(value) || JS_GetLength(ctx, value, &length) < 0) {
+		JS_FreeValue(ctx, value);
+		return Parsed::Bad;
+	}
+	result.clear();
+	for (auto i = std::int64_t(); i != length; ++i) {
+		auto entry = JS_GetPropertyUint32(ctx, value, uint32_t(i));
+		const auto id = PeerOf(ctx, entry);
+		JS_FreeValue(ctx, entry);
+		const auto peer = id ? owner->peerLoaded(*id) : nullptr;
+		if (!peer) {
+			JS_FreeValue(ctx, value);
+			return Parsed::Bad;
+		}
+		const auto history = owner->history(peer);
+		if (!ranges::contains(result, history)) {
+			result.push_back(history);
+		}
+	}
+	JS_FreeValue(ctx, value);
+	return Parsed::Done;
+}
+
+[[nodiscard]] FilterId NextFolderId(not_null<Main::Session*> session) {
+	if (const auto local = NewFolderId(session)) {
+		return local;
+	}
+	const auto &list = session->data().chatsFilters().list();
+	auto id = FilterId(2);
+	while (ranges::contains(list, id, &Data::ChatFilter::id)) {
+		++id;
+	}
+	return id;
+}
+
+JSValue FoldersSave(JSContext *ctx, int argc, JSValueConst *argv) {
+	auto id = std::int32_t();
+	if (argc > 0) {
+		JS_ToInt32(ctx, &id, argv[0]);
+	}
+	const auto creating = (id == 0);
+	const auto what = creating
+		? "tg.tele.folders.create"
+		: "tg.tele.folders.edit";
+	const auto instance = Permitted(ctx, Capability::Options, {}, what);
+	if (!instance) {
+		return JS_EXCEPTION;
+	} else if (argc < 2 || !JS_IsObject(argv[1]) || id < 0) {
+		return JS_ThrowTypeError(ctx, "%s needs a folder object", what);
+	}
+	const auto spec = argv[1];
+	const auto session = instance->session();
+	const auto owner = &session->data();
+	const auto &list = owner->chatsFilters().list();
+	const auto i = ranges::find(list, FilterId(id), &Data::ChatFilter::id);
+	if (!creating && i == end(list)) {
+		return ThrowTeleError(
+			ctx,
+			"not-found",
+			u"%1: no folder %2"_q.arg(QString::fromLatin1(what)).arg(id));
+	} else if (!creating && IsUnsortedFolder(id)) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"%1: tele's unsorted folder can't be edited"_q.arg(
+				QString::fromLatin1(what)));
+	}
+	const auto was = creating ? Data::ChatFilter() : *i;
+	auto error = QString();
+	auto title = creating ? Data::ChatFilterTitle() : was.title();
+	auto value = JS_GetPropertyStr(ctx, spec, "title");
+	if (JS_IsString(value)) {
+		const auto text = FromStd(ToStd(ctx, value)).trimmed();
+		if (text.isEmpty()) {
+			error = u"title can't be empty"_q;
+		} else if (text != title.text.text) {
+			title = Data::ChatFilterTitle{
+				.text = TextWithEntities{ .text = text },
+				.isStatic = title.isStatic,
+			};
+		}
+	} else if (!JS_IsUndefined(value)) {
+		error = u"title is a string"_q;
+	} else if (creating) {
+		error = u"a new folder needs a title"_q;
+	}
+	JS_FreeValue(ctx, value);
+	auto emoji = was.iconEmoji();
+	value = JS_GetPropertyStr(ctx, spec, "emoji");
+	if (JS_IsString(value)) {
+		emoji = FromStd(ToStd(ctx, value));
+	} else if (!JS_IsUndefined(value)) {
+		error = u"emoji is a string"_q;
+	}
+	JS_FreeValue(ctx, value);
+	auto color = was.colorIndex();
+	value = JS_GetPropertyStr(ctx, spec, "color");
+	if (JS_IsNull(value)) {
+		color = std::nullopt;
+	} else if (JS_IsNumber(value)) {
+		auto number = 0.;
+		JS_ToFloat64(ctx, &number, value);
+		if (number != std::floor(number) || number < 0. || number > 255.) {
+			error = u"color is a color index (0 to 255) or null"_q;
+		} else {
+			color = uint8(number);
+		}
+	} else if (!JS_IsUndefined(value)) {
+		error = u"color is a color index (0 to 255) or null"_q;
+	}
+	JS_FreeValue(ctx, value);
+	auto flags = was.flags();
+	value = JS_GetPropertyStr(ctx, spec, "flags");
+	if (JS_IsObject(value)) {
+		for (const auto &[name, flag] : kFolderFlags) {
+			auto one = JS_GetPropertyStr(ctx, value, name);
+			if (JS_IsBool(one)) {
+				if (JS_ToBool(ctx, one) > 0) {
+					flags |= flag;
+				} else {
+					flags &= ~flag;
+				}
+			} else if (!JS_IsUndefined(one)) {
+				error = u"flags.%1 is a boolean"_q.arg(
+					QString::fromLatin1(name));
+			}
+			JS_FreeValue(ctx, one);
+		}
+	} else if (!JS_IsUndefined(value)) {
+		error = u"flags is an object of booleans"_q;
+	}
+	JS_FreeValue(ctx, value);
+	auto include = std::vector<not_null<History*>>();
+	for (const auto &history : was.always()) {
+		if (!ranges::contains(was.pinned(), history)) {
+			include.push_back(history);
+		}
+	}
+	auto pinned = was.pinned();
+	auto exclude = std::vector<not_null<History*>>(
+		was.never().begin(),
+		was.never().end());
+	const auto lists = std::array<
+		std::pair<const char*, std::vector<not_null<History*>>*>,
+		3>{ {
+		{ "include", &include },
+		{ "exclude", &exclude },
+		{ "pinned", &pinned },
+	} };
+	for (const auto &[name, target] : lists) {
+		const auto parsed = HistoriesProperty(ctx, spec, name, owner, *target);
+		if (parsed == Parsed::Bad) {
+			error = u"%1 is an array of chats in tele's cache"_q.arg(
+				QString::fromLatin1(name));
+		}
+	}
+	if (!error.isEmpty()) {
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: %s",
+			what,
+			error.toUtf8().constData());
+	}
+	auto always = base::flat_set<not_null<History*>>(
+		include.begin(),
+		include.end());
+	for (const auto &history : pinned) {
+		always.emplace(history);
+	}
+	const auto never = base::flat_set<not_null<History*>>(
+		exclude.begin(),
+		exclude.end());
+	const auto folderId = creating ? NextFolderId(session) : FilterId(id);
+	const auto filter = Data::ChatFilter(
+		folderId,
+		title,
+		emoji,
+		color,
+		flags,
+		std::move(always),
+		std::move(pinned),
+		never);
+	auto created = NewPending(ctx);
+	if (JS_IsException(created.second)) {
+		return created.second;
+	}
+	const auto pending = created.first;
+	const auto done = [=] {
+		Resolve(pending, [=](JSContext *context) {
+			return JS_NewInt32(context, folderId);
+		});
+	};
+	if (SaveLocalFolder(session, filter)) {
+		done();
+		return created.second;
+	}
+	const auto tl = filter.tl();
+	owner->chatsFilters().apply(MTP_updateDialogFilter(
+		MTP_flags(MTPDupdateDialogFilter::Flag::f_filter),
+		MTP_int(folderId),
+		tl));
+	const auto name = QString::fromLatin1(what);
+	session->api().request(MTPmessages_UpdateDialogFilter(
+		MTP_flags(MTPmessages_UpdateDialogFilter::Flag::f_filter),
+		MTP_int(folderId),
+		tl
+	)).done(done).fail([=](const MTP::Error &failure) {
+		if (creating) {
+			owner->chatsFilters().remove(folderId);
+		} else {
+			owner->chatsFilters().set(was);
+		}
+		Reject(
+			pending,
+			RefusalCode(failure.type()),
+			u"%1: the server refused: %2"_q.arg(name, failure.type()));
+	}).send();
+	return created.second;
+}
+
+JSValue FoldersDelete(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::Options,
+		{},
+		"tg.tele.folders.delete");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	auto id = std::int32_t();
+	if (argc < 1 || !JS_IsNumber(argv[0]) || JS_ToInt32(ctx, &id, argv[0])) {
+		return JS_ThrowTypeError(ctx, "tg.tele.folders.delete(id)");
+	}
+	const auto session = instance->session();
+	const auto owner = &session->data();
+	const auto &list = owner->chatsFilters().list();
+	const auto i = ranges::find(list, FilterId(id), &Data::ChatFilter::id);
+	if (!id || i == end(list)) {
+		return ThrowTeleError(
+			ctx,
+			"not-found",
+			u"tg.tele.folders.delete: no folder %1"_q.arg(id));
+	} else if (IsUnsortedFolder(id)) {
+		return ThrowTeleError(
+			ctx,
+			"unsupported",
+			u"tg.tele.folders.delete: tele's unsorted folder is a setting"_q);
+	}
+	const auto was = *i;
+	auto created = NewPending(ctx);
+	if (JS_IsException(created.second)) {
+		return created.second;
+	}
+	const auto pending = created.first;
+	const auto done = [=] {
+		Resolve(pending, [](JSContext*) {
+			return JS_UNDEFINED;
+		});
+	};
+	owner->chatsFilters().apply(MTP_updateDialogFilter(
+		MTP_flags(MTPDupdateDialogFilter::Flag(0)),
+		MTP_int(id),
+		MTPDialogFilter()));
+	if (IsLocalFolder(id)) {
+		done();
+		return created.second;
+	}
+	session->api().request(MTPmessages_UpdateDialogFilter(
+		MTP_flags(MTPmessages_UpdateDialogFilter::Flag(0)),
+		MTP_int(id),
+		MTPDialogFilter()
+	)).done(done).fail([=](const MTP::Error &failure) {
+		owner->chatsFilters().set(was);
+		Reject(
+			pending,
+			RefusalCode(failure.type()),
+			u"tg.tele.folders.delete: the server refused: %1"_q.arg(
+				failure.type()));
+	}).send();
+	return created.second;
+}
+
+JSValue FoldersReorder(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::Options,
+		{},
+		"tg.tele.folders.reorder");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	auto order = std::vector<FilterId>();
+	auto length = std::int64_t();
+	auto bad = (argc < 1)
+		|| !JS_IsArray(argv[0])
+		|| (JS_GetLength(ctx, argv[0], &length) < 0);
+	for (auto i = std::int64_t(); !bad && i != length; ++i) {
+		auto entry = JS_GetPropertyUint32(ctx, argv[0], uint32_t(i));
+		auto id = std::int32_t();
+		bad = !JS_IsNumber(entry) || JS_ToInt32(ctx, &id, entry) < 0;
+		JS_FreeValue(ctx, entry);
+		order.push_back(FilterId(id));
+	}
+	const auto filters = &instance->session()->data().chatsFilters();
+	const auto &list = filters->list();
+	auto existing = std::vector<FilterId>();
+	for (const auto &filter : list) {
+		if (filter.id()) {
+			existing.push_back(filter.id());
+		}
+	}
+	auto given = order;
+	given.erase(ranges::remove(given, FilterId()), end(given));
+	if (bad || !ranges::is_permutation(given, existing)) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.tele.folders.reorder needs every folder id from "
+			"tg.tele.folders.list() exactly once");
+	}
+	if (!ranges::contains(order, FilterId())) {
+		auto position = 0;
+		for (const auto &filter : list) {
+			const auto id = filter.id();
+			if (!id) {
+				break;
+			} else if (const auto i = ranges::find(order, id)
+				; i != end(order)) {
+				position = int(i - begin(order)) + 1;
+			}
+		}
+		order.insert(begin(order) + position, FilterId());
+	}
+	filters->saveOrder(order);
+	return JS_UNDEFINED;
+}
+
+[[nodiscard]] QStringList RuleLines(const QString &value) {
+	auto result = QStringList();
+	for (const auto &line : value.split(QChar('\n'))) {
+		if (!line.isEmpty()) {
+			result.push_back(line);
+		}
+	}
+	return result;
+}
+
+JSValue HiddenWordsList(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Instance::From(ctx);
+	if (!instance) {
+		return JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	auto value = NormalizeHiddenWords(HiddenWords());
+	if (argc > 0 && !JS_IsNull(argv[0]) && !JS_IsUndefined(argv[0])) {
+		const auto id = PeerOf(ctx, argv[0]);
+		const auto peer = id
+			? instance->session()->data().peerLoaded(*id)
+			: nullptr;
+		if (!peer) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.tele.hiddenWords.list needs a chat in tele's cache");
+		}
+		value = ChatHiddenWords(peer);
+	}
+	auto result = JS_NewArray(ctx);
+	auto index = uint32_t();
+	for (const auto &line : RuleLines(value)) {
+		JS_SetPropertyUint32(ctx, result, index++, NewString(ctx, line));
+	}
+	return result;
+}
+
+JSValue HiddenWordsChange(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto add = (argc > 2) && JS_ToBool(ctx, argv[2]) > 0;
+	const auto what = add
+		? "tg.tele.hiddenWords.add"
+		: "tg.tele.hiddenWords.remove";
+	const auto instance = Permitted(ctx, Capability::Options, {}, what);
+	if (!instance) {
+		return JS_EXCEPTION;
+	} else if (argc < 2 || !JS_IsString(argv[1])) {
+		return JS_ThrowTypeError(ctx, "%s(rule, chat?): rule is a string", what);
+	}
+	const auto rule = FromStd(ToStd(ctx, argv[1])).trimmed();
+	if (rule.isEmpty()
+		|| rule.contains(QChar('\n'))
+		|| NormalizeHiddenWords(rule) != rule) {
+		return JS_ThrowTypeError(
+			ctx,
+			"%s: a rule is one line of text or a valid /regex/",
+			what);
+	}
+	auto peer = (PeerData*)nullptr;
+	if (!JS_IsNull(argv[0]) && !JS_IsUndefined(argv[0])) {
+		const auto id = PeerOf(ctx, argv[0]);
+		peer = id ? instance->session()->data().peerLoaded(*id) : nullptr;
+		if (!peer) {
+			return JS_ThrowTypeError(ctx, "%s needs a chat in tele's cache", what);
+		}
+	}
+	auto lines = RuleLines(peer
+		? ChatHiddenWords(peer)
+		: NormalizeHiddenWords(HiddenWords()));
+	if (add) {
+		if (lines.contains(rule)) {
+			return JS_FALSE;
+		}
+		lines.push_back(rule);
+	} else if (!lines.removeOne(rule)) {
+		return JS_FALSE;
+	}
+	const auto value = lines.join(QChar('\n'));
+	if (peer) {
+		SetChatHiddenWords(peer, value);
+	} else {
+		SetHiddenWords(value);
+	}
+	return JS_TRUE;
+}
+
+JSValue EditHistoryOf(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"messages",
+		"tg.tele.editHistory");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto peerId = PeerAt(ctx, argc, argv, 0);
+	const auto msgId = MsgIdAt(ctx, argc, argv, 1);
+	if (!peerId || !msgId) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.tele.editHistory needs a chat and a message id");
+	}
+	auto result = JS_NewArray(ctx);
+	const auto item = instance->session()->data().message(
+		FullMsgId(*peerId, *msgId));
+	if (!item) {
+		return result;
+	}
+	auto index = uint32_t();
+	for (const auto &version : EditVersions(item)) {
+		auto raw = DecodeMessage(
+			ctx,
+			instance,
+			Synthesized(
+				item,
+				version.item->originalText(),
+				version.original ? TimeId() : version.date));
+		if (JS_IsNull(raw)) {
+			continue;
+		}
+		auto entry = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, entry, "date", JS_NewInt64(ctx, version.date));
+		JS_SetPropertyStr(
+			ctx,
+			entry,
+			"original",
+			JS_NewBool(ctx, version.original));
+		JS_SetPropertyStr(
+			ctx,
+			entry,
+			"current",
+			JS_NewBool(ctx, version.current));
+		JS_SetPropertyStr(ctx, entry, "raw", raw);
+		JS_SetPropertyUint32(ctx, result, index++, entry);
+	}
+	return result;
+}
+
+JSValue DeletedList(JSContext *ctx, int argc, JSValueConst *argv) {
+	const auto instance = Permitted(
+		ctx,
+		Capability::AccountRead,
+		"messages",
+		"tg.tele.deleted.list");
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = instance->session();
+	const auto peerId = PeerAt(ctx, argc, argv, 0);
+	const auto peer = peerId ? session->data().peerLoaded(*peerId) : nullptr;
+	if (!peer) {
+		return JS_ThrowTypeError(
+			ctx,
+			"tg.tele.deleted.list needs a chat in tele's cache");
+	}
+	auto result = JS_NewArray(ctx);
+	auto index = uint32_t();
+	const auto history = session->data().history(peer);
+	for (const auto &item : KeptDeletedItems(history)) {
+		auto raw = KeptRaw(ctx, instance, item);
+		if (!JS_IsNull(raw)) {
+			JS_SetPropertyUint32(ctx, result, index++, raw);
+		}
+	}
+	return result;
+}
+
+JSValue DeletedAnswer(
+		JSContext *ctx,
+		not_null<Instance*> instance,
+		int argc,
+		JSValueConst *argv) {
+	auto callId = std::int32_t();
+	if (argc < 2 || JS_ToInt32(ctx, &callId, argv[0]) < 0) {
+		return JS_ThrowTypeError(ctx, "needs a call id and a verdict");
+	}
+	auto &verdicts = Get().verdicts;
+	const auto i = verdicts.find(callId);
+	if (i == end(verdicts) || i->second.owner != instance.get()) {
+		return JS_FALSE;
+	}
+	const auto verdict = i->second;
+	verdicts.erase(i);
+	if (ToStd(ctx, argv[1]) == "discard") {
+		if (const auto session = verdict.session.get()) {
+			const auto id = verdict.id;
+			crl::on_main(session, [=] {
+				Discard(session, id);
+			});
+		}
+	}
+	return JS_TRUE;
+}
+
+JSValue NativeTeledata(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	switch (magic) {
+	case kBookmarksList: return BookmarksList(ctx);
+	case kBookmarksAdd: return BookmarksAdd(ctx, argc, argv);
+	case kBookmarksRemove: return BookmarksRemove(ctx, argc, argv);
+	case kPinsList: return PinsList(ctx, argc, argv);
+	case kPinsSet: return PinsSet(ctx, argc, argv);
+	case kFoldersList: return FoldersList(ctx);
+	case kFoldersSave: return FoldersSave(ctx, argc, argv);
+	case kFoldersDelete: return FoldersDelete(ctx, argc, argv);
+	case kFoldersReorder: return FoldersReorder(ctx, argc, argv);
+	case kHiddenWordsList: return HiddenWordsList(ctx, argc, argv);
+	case kHiddenWordsChange: return HiddenWordsChange(ctx, argc, argv);
+	case kEditHistory: return EditHistoryOf(ctx, argc, argv);
+	case kDeletedList: return DeletedList(ctx, argc, argv);
+	}
+	const auto listening = (magic == kDeletedOnKept)
+		|| (magic == kDeletedIntercept);
+	const auto instance = listening
+		? Permitted(
+			ctx,
+			Capability::AccountRead,
+			"messages",
+			((magic == kDeletedOnKept)
+				? "tg.tele.deleted.onKept"
+				: "tg.tele.deleted.interceptKeep"))
+		: Instance::From(ctx);
+	if (!instance) {
+		return listening
+			? JS_EXCEPTION
+			: JS_ThrowInternalError(ctx, "the script was stopped");
+	}
+	switch (magic) {
+	case kBookmarksOnChange:
+		return AddListener(
+			ctx,
+			instance,
+			argc,
+			argv,
+			ListenerKind::Bookmarks,
+			"tg.tele.bookmarks.onChange");
+	case kOff:
+		return RemoveListener(ctx, instance, argc, argv);
+	case kDeletedOnKept:
+		return AddListener(
+			ctx,
+			instance,
+			argc,
+			argv,
+			ListenerKind::Kept,
+			"tg.tele.deleted.onKept");
+	case kDeletedIntercept:
+		if (!Permitted(
+				ctx,
+				Capability::Options,
+				{},
+				"tg.tele.deleted.interceptKeep")) {
+			return JS_EXCEPTION;
+		}
+		return AddListener(
+			ctx,
+			instance,
+			argc,
+			argv,
+			ListenerKind::Intercept,
+			"tg.tele.deleted.interceptKeep");
+	case kDeletedAnswer:
+		return DeletedAnswer(ctx, instance, argc, argv);
+	}
+	return JS_UNDEFINED;
+}
+
+} // namespace
+
+void AddTeledataNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "teledataBookmarks", NativeTeledata, 0, kBookmarksList },
+		{ "teledataBookmarkAdd", NativeTeledata, 3, kBookmarksAdd },
+		{ "teledataBookmarkRemove", NativeTeledata, 2, kBookmarksRemove },
+		{
+			"teledataBookmarksOnChange",
+			NativeTeledata,
+			1,
+			kBookmarksOnChange,
+		},
+		{ "teledataOff", NativeTeledata, 1, kOff },
+		{ "teledataPins", NativeTeledata, 1, kPinsList },
+		{ "teledataPinSet", NativeTeledata, 3, kPinsSet },
+		{ "teledataFolders", NativeTeledata, 0, kFoldersList },
+		{ "teledataFolderSave", NativeTeledata, 2, kFoldersSave },
+		{ "teledataFolderDelete", NativeTeledata, 1, kFoldersDelete },
+		{ "teledataFoldersReorder", NativeTeledata, 1, kFoldersReorder },
+		{ "teledataHiddenWords", NativeTeledata, 1, kHiddenWordsList },
+		{
+			"teledataHiddenWordChange",
+			NativeTeledata,
+			3,
+			kHiddenWordsChange,
+		},
+		{ "teledataEditHistory", NativeTeledata, 2, kEditHistory },
+		{ "teledataDeleted", NativeTeledata, 1, kDeletedList },
+		{ "teledataDeletedOnKept", NativeTeledata, 1, kDeletedOnKept },
+		{
+			"teledataDeletedIntercept",
+			NativeTeledata,
+			1,
+			kDeletedIntercept,
+		},
+		{ "teledataDeletedAnswer", NativeTeledata, 2, kDeletedAnswer },
+	});
+}
