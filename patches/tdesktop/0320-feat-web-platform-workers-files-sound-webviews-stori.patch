+
+void SearchPanelGifs(not_null<Main::Session*> session, const QString &query) {
+	auto &panels = Panels();
+	auto sources = std::vector<not_null<Registration*>>();
+	for (const auto &entry : panels.list) {
+		if (entry->kind == Kind::Gifs && entry->session == session) {
+			sources.push_back(entry.get());
+		}
+	}
+	if (query.isEmpty() || sources.empty()) {
+		return;
+	}
+	auto found = FindQuery(session, query);
+	if (!found) {
+		if (int(panels.queries.size()) >= kMaxQueries) {
+			panels.queries.erase(begin(panels.queries));
+		}
+		panels.queries.push_back(GifQuery{
+			.session = session,
+			.query = query,
+		});
+		found = &panels.queries.back();
+	}
+	struct Ask {
+		int callId = 0;
+		base::weak_ptr<Instance> weak;
+		int search = 0;
+	};
+	auto asks = std::vector<Ask>();
+	for (const auto source : sources) {
+		if (found->asked.contains(source->id)) {
+			continue;
+		}
+		found->asked.emplace(source->id);
+		const auto callId = ++panels.nextCall;
+		panels.calls.emplace(callId, GifCall{
+			.registration = source->id,
+			.session = session,
+			.query = query,
+		});
+		asks.push_back({ callId, source->weak, source->search });
+	}
+	for (const auto &ask : asks) {
+		const auto callId = ask.callId;
+		CallKept(ask.weak, ask.search, [=](JSContext *ctx) {
+			auto payload = JS_NewObject(ctx);
+			JS_SetPropertyStr(ctx, payload, "callId", JS_NewInt32(ctx, callId));
+			JS_SetPropertyStr(ctx, payload, "query", NewString(ctx, query));
+			return payload;
+		}, u"tg.ui.registerGifSource"_q);
+	}
+}
+
+rpl::producer<QString> PanelGifsUpdated(not_null<Main::Session*> session) {
+	return Panels().gifsUpdated.events(
+	) | rpl::filter([=](const GifsUpdate &update) {
+		return (update.session == session);
+	}) | rpl::map([](const GifsUpdate &update) {
+		return update.query;
+	});
+}
+
+std::vector<std::shared_ptr<InlineBots::Result>> PanelGifResults(
+		not_null<Main::Session*> session,
+		const QString &query) {
+	auto result = std::vector<std::shared_ptr<InlineBots::Result>>();
+	if (const auto found = query.isEmpty()
+			? nullptr
+			: FindQuery(session, query)) {
+		result.reserve(found->entries.size());
+		for (const auto &entry : found->entries) {
+			result.push_back(entry.result);
+		}
+	}
+	return result;
+}
+
+bool IsPanelGif(const InlineBots::Result *result) {
+	return result && result->getId().startsWith(ResultPrefix());
+}
+
+bool PanelGifChosen(
+		std::shared_ptr<ChatHelpers::Show> show,
+		const InlineBots::Result *result,
+		Fn<void(not_null<DocumentData*>)> send) {
+	if (!IsPanelGif(result)) {
+		return false;
+	}
+	for (const auto &query : Panels().queries) {
+		for (const auto &entry : query.entries) {
+			if (entry.result.get() != result) {
+				continue;
+			} else if (const auto registration = FindRegistration(
+					entry.registration)) {
+				Choose(
+					std::move(show),
+					registration,
+					entry.item,
+					std::move(send));
+			}
+			return true;
+		}
+	}
+	show->showToast(Lower(u"This result is gone, search again."_q));
+	return true;
+}
+
+} // namespace Tele::Scripting
