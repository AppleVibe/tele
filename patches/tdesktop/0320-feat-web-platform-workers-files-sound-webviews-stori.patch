diff --git a/Telegram/Resources/tele/scripting/chatui.js b/Telegram/Resources/tele/scripting/chatui.js
new file mode 100644
index 0000000000000000000000000000000000000000..99a039c26d2e3487bfff735e8da742e1b4baab38
--- /dev/null
+++ b/Telegram/Resources/tele/scripting/chatui.js
@@ -0,0 +1,245 @@
+(() => {
+	const CHANNEL_SHIFT = 1000000000000n;
+	const MAX_BUTTONS = 3;
+	const MAX_FILES = 100;
+
+	const isGiven = (value) => (value !== undefined) && (value !== null);
+	const isBytes = (value) => (value instanceof Uint8Array) || (value instanceof ArrayBuffer);
+
+	const markedOf = (peer, tg) => {
+		if (typeof peer === 'bigint') {
+			return peer;
+		} else if (typeof peer === 'number') {
+			return Number.isSafeInteger(peer) ? BigInt(peer) : null;
+		} else if (peer === 'me' || peer === 'self') {
+			return tg.selfId;
+		} else if (typeof peer === 'string') {
+			const trimmed = peer.trim();
+			return /^-?\d+$/.test(trimmed) ? BigInt(trimmed) : null;
+		} else if (peer === null || typeof peer !== 'object') {
+			return null;
+		} else if (typeof tg.Message === 'function' && peer instanceof tg.Message) {
+			return (typeof peer.chatId === 'bigint') ? peer.chatId : null;
+		} else if (typeof peer.id === 'bigint' && peer.input?._) {
+			return peer.id;
+		}
+		switch (peer._) {
+		case 'inputPeerSelf':
+		case 'inputUserSelf':
+			return tg.selfId;
+		case 'inputPeerUser':
+		case 'inputPeerUserFromMessage':
+		case 'inputUser':
+		case 'inputUserFromMessage':
+		case 'peerUser':
+			return peer.userId;
+		case 'inputPeerChat':
+		case 'peerChat':
+			return -peer.chatId;
+		case 'inputPeerChannel':
+		case 'inputPeerChannelFromMessage':
+		case 'inputChannel':
+		case 'inputChannelFromMessage':
+		case 'peerChannel':
+			return -CHANNEL_SHIFT - peer.channelId;
+		}
+		return null;
+	};
+
+	const filesOf = (files, what) => {
+		const fail = () => new TypeError(`${what}: files must be a non-empty array of { name, bytes }`);
+		if (!Array.isArray(files) || files.length === 0) {
+			throw fail();
+		} else if (files.length > MAX_FILES) {
+			throw new TypeError(`${what}: at most ${MAX_FILES} files`);
+		}
+		return files.map((file) => {
+			if (file === null || typeof file !== 'object') {
+				throw fail();
+			}
+			const { name, bytes } = file;
+			if (typeof name !== 'string' || !name.trim()) {
+				throw new TypeError(`${what}: every file needs a non-empty name`);
+			} else if (!isBytes(bytes) || bytes.byteLength === 0) {
+				throw new TypeError(`${what}: every file needs non-empty bytes (Uint8Array or ArrayBuffer)`);
+			}
+			return { name: name.trim(), bytes };
+		});
+	};
+
+	const bannerOf = (options) => {
+		if (options === null || typeof options !== 'object') {
+			throw new TypeError('tg.ui.banner(options)');
+		} else if (options.place !== 'chat' && options.place !== 'chats') {
+			throw new TypeError("tg.ui.banner: place must be 'chat' or 'chats'");
+		} else if (typeof options.text !== 'string' || !options.text.trim()) {
+			throw new TypeError('tg.ui.banner: text must be a non-empty string');
+		} else if (options.icon !== undefined && typeof options.icon !== 'string') {
+			throw new TypeError('tg.ui.banner: icon must be a string');
+		} else if (options.onClose !== undefined && typeof options.onClose !== 'function') {
+			throw new TypeError('tg.ui.banner: onClose must be a function');
+		}
+		const buttons = options.buttons ?? [];
+		if (!Array.isArray(buttons)
+			|| buttons.length > MAX_BUTTONS
+			|| buttons.some((button) => button === null
+				|| typeof button !== 'object'
+				|| typeof button.text !== 'string'
+				|| !button.text.trim()
+				|| typeof button.onClick !== 'function')) {
+			throw new TypeError('tg.ui.banner: buttons must be an array of { text, onClick }');
+		}
+		return {
+			text: options.text.trim(),
+			icon: (options.icon ?? '').trim(),
+			buttons: buttons.map((button) => ({ text: button.text.trim(), onClick: button.onClick })),
+			closable: options.closable !== false,
+			onClose: options.onClose,
+		};
+	};
+
+	const verdictOf = (verdict) => {
+		if (verdict === undefined || verdict === null || verdict === 'keep') {
+			return { kind: 'keep' };
+		} else if (verdict === 'drop') {
+			return { kind: 'drop' };
+		} else if (typeof verdict === 'object' && typeof verdict.text === 'string') {
+			return { kind: 'text', text: verdict.text };
+		} else if (typeof verdict === 'object' && Array.isArray(verdict.files)) {
+			return { kind: 'files', files: filesOf(verdict.files, 'tg.compose.interceptPaste') };
+		}
+		throw new TypeError("an interceptor returns 'keep', 'drop', { text }, { files } or nothing");
+	};
+
+	globalThis.__teleExtensions.push({
+		name: 'chatui',
+		tg(tg, natives, { resolvePeer }) {
+			const chatOf = async (peer) => {
+				if (!isGiven(peer)) {
+					return null;
+				}
+				return markedOf(peer, tg) ?? markedOf(await resolvePeer(peer), tg);
+			};
+			const listen = (callback, what, add) => {
+				if (typeof callback !== 'function') {
+					throw new TypeError(`${what}(function)`);
+				}
+				const id = add(callback);
+				return __teleDisposer(() => natives.chatuiOff(id));
+			};
+
+			Object.assign(tg.ui, {
+				banner(options) {
+					const banner = bannerOf(options);
+					if (options.place === 'chats') {
+						throw new TeleError('unsupported', "tg.ui.banner: place 'chats' isn't available");
+					} else if (!isGiven(options.chat)) {
+						throw new TypeError("tg.ui.banner: place 'chat' needs a chat");
+					}
+					let id = null;
+					let disposed = false;
+					const handler = (event) => {
+						if (event.closed) {
+							disposed = true;
+							id = null;
+							banner.onClose?.();
+						} else {
+							banner.buttons[event.button]?.onClick();
+						}
+					};
+					const show = (chat) => {
+						if (!disposed) {
