+				: null,
+			value: null,
+			raw,
+		};
+	};
+
+	const savedOf = (saved, peer, names, now) => {
+		const gift = giftOf(saved.gift, names);
+		const self = (peer._ === 'inputPeerSelf');
+		const chat = (peer._ === 'inputPeerChat' || peer._.startsWith('inputPeerChannel'));
+		const input = (self && saved.msgId !== undefined)
+			? { _: 'inputSavedStarGiftUser', msgId: saved.msgId }
+			: (chat && saved.savedId !== undefined)
+			? { _: 'inputSavedStarGiftChat', peer, savedId: saved.savedId }
+			: ((self || chat) && gift.slug)
+			? { _: 'inputSavedStarGiftSlug', slug: gift.slug }
+			: null;
+		const from = markedId(saved.fromId);
+		const convertStars = saved.convertStars ?? gift.convertStars;
+		return {
+			...gift,
+			convertStars,
+			input,
+			from,
+			fromName: (from === null) ? null : (names.get(from) ?? null),
+			date: saved.date,
