+void ReadDecorationButtons(
+		not_null<Instance*> instance,
+		JSValueConst value,
+		MessageDecoration &decoration,
+		QString &error) {
+	const auto ctx = instance->context();
+	if (!ctx || !error.isEmpty()) {
+		return;
+	}
+	auto rows = JS_GetPropertyStr(ctx, value, "buttons");
+	if (JS_IsUndefined(rows)) {
+		return;
+	}
+	auto result = std::vector<std::vector<DecorationButton>>();
+	auto functions = std::vector<JSValue>();
+	auto count = int64_t();
+	if (!JS_IsArray(rows)
+		|| JS_GetLength(ctx, rows, &count)
+		|| count > kMaxButtonRows) {
+		error = u"buttons is an array of up to 8 rows"_q;
+	}
+	for (auto i = int64_t(); error.isEmpty() && i != count; ++i) {
+		const auto where = u"buttons[%1]"_q.arg(i);
+		auto row = JS_GetPropertyInt64(ctx, rows, i);
+		auto columns = int64_t();
+		if (!JS_IsArray(row)
+			|| JS_GetLength(ctx, row, &columns)
+			|| columns < 1
+			|| columns > kMaxButtonColumns) {
+			error = where + u" is an array of 1 to 8 buttons"_q;
+		}
+		auto &buttons = result.emplace_back();
+		for (auto j = int64_t(); error.isEmpty() && j != columns; ++j) {
+			const auto at = where + u"[%1]"_q.arg(j);
+			auto button = JS_GetPropertyInt64(ctx, row, j);
+			if (!JS_IsObject(button)) {
+				error = at + u" is { text, onClick, style? }"_q;
+				JS_FreeValue(ctx, button);
+				break;
+			}
+			auto text = JS_GetPropertyStr(ctx, button, "text");
+			auto onClick = JS_GetPropertyStr(ctx, button, "onClick");
+			auto style = JS_GetPropertyStr(ctx, button, "style");
+			const auto label = JS_IsString(text)
+				? FromStd(ToStd(ctx, text))
+				: QString();
+			const auto kind = StyleOf(ctx, style);
+			if (label.trimmed().isEmpty()) {
+				error = at + u".text is a non-empty string"_q;
+			} else if (!JS_IsFunction(ctx, onClick)) {
+				error = at + u".onClick is a function"_q;
+			} else if (!kind) {
+				error = at + u".style is 'default', 'primary' or 'danger'"_q;
+			} else {
+				buttons.push_back({ .text = label, .style = *kind });
+				functions.push_back(JS_DupValue(ctx, onClick));
+			}
+			for (const auto item : { text, onClick, style, button }) {
+				JS_FreeValue(ctx, item);
+			}
+		}
+		JS_FreeValue(ctx, row);
+	}
+	JS_FreeValue(ctx, rows);
+	if (error.isEmpty()) {
+		const auto weak = base::make_weak(instance.get());
+		auto next = begin(functions);
+		for (auto &row : result) {
+			for (auto &button : row) {
+				button.callback = std::make_shared<DecorationCallback>(
+					weak,
+					KeepFunction(instance, *next++));
+			}
+		}
+		decoration.buttons = std::move(result);
+	}
+	for (const auto function : functions) {
+		JS_FreeValue(ctx, function);
+	}
+}
