+: _instance(base::make_weak(instance))
+, _id(id)
+, _handler(handler)
+, _title(options.title)
+, _panel(std::make_unique<Ui::SeparatePanel>()) {
+	createPanel(window->widget(), options);
+	if (createWebview(instance, std::move(options))) {
+		activate();
+	}
+}
+
+Panel::~Panel() {
+	if (_panel) {
+		_panel->hide();
+	}
