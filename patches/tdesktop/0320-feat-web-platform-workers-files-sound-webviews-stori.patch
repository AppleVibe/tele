+	};
+
+	const savedOrNull = (gift) => ((gift !== null && typeof gift === 'object' && gift.saved?._ === 'savedStarGift') ? gift : null);
+
+	const inputOf = (gift, what) => {
+		if (typeof gift === 'string') {
+			return { _: 'inputSavedStarGiftSlug', slug: slugOf(gift, what) };
