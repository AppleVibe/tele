+void PressBanner(int id, int index) {
+	const auto &entries = State().entries;
+	const auto i = entries.find(id);
+	if (i == end(entries)) {
+		return;
+	}
+	CallKept(i->second.instance, i->second.function, [=](JSContext *ctx) {
+		auto result = Payload(ctx, "button");
+		JS_SetPropertyStr(ctx, result, "index", JS_NewInt32(ctx, index));
+		return result;
+	}, u"tg.ui.banner"_q);
+}
+
+void CloseBanner(int id) {
+	auto &data = State();
+	const auto i = data.entries.find(id);
+	if (i == end(data.entries)) {
+		return;
+	}
+	const auto instance = i->second.instance;
+	const auto function = i->second.function;
+	data.entries.erase(i);
+	data.bannersChanged.fire({});
+	CallKept(instance, function, [=](JSContext *ctx) {
+		return Payload(ctx, "close");
+	}, u"tg.ui.banner"_q);
+	ForgetKept(instance, function);
+}
