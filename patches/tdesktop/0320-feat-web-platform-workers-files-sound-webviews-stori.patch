+bool OpenScriptInstallLink(
+		not_null<Window::SessionController*> controller,
+		const QString &url) {
+	const auto parsed = QUrl(url.trimmed());
+	const auto scheme = parsed.scheme().toLower();
+	if (!parsed.isValid()
+		|| parsed.host().isEmpty()
+		|| (scheme != u"http"_q && scheme != u"https"_q)) {
+		controller->window().showToast(
+			Lower(u"This link doesn't point to a script."_q));
+		return true;
+	}
+	ShowScriptInstallFromLink(controller, parsed.toString());
+	return true;
+}
+
+} // namespace Tele::Scripting
