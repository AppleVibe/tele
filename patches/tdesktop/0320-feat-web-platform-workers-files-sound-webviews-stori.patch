+namespace Tele::Scripting {
+namespace {
+
+constexpr auto kChannelShift = std::int64_t(1000000000000);
+constexpr auto kDebounce = crl::time(250);
+constexpr auto kSpeakingInterval = crl::time(1000);
+constexpr auto kJoinTimeout = crl::time(60000);
+constexpr auto kPage = 100;
+constexpr auto kDefaultLimit = 100;
+constexpr auto kMaxLimit = 5000;
+
+enum class Op {
+	Current,
+	OnChange,
+	Off,
+	Join,
+	Leave,
+	SetMuted,
+	RaiseHand,
+	Participants,
+};
+
+constexpr auto kNames = std::array<const char*, 8>{
+	"tg.calls.group",
+	"tg.calls.onGroupChange",
+	"tg.calls.onGroupChange",
+	"tg.calls.join",
+	"tg.calls.leave",
+	"tg.calls.setMuted",
+	"tg.calls.raiseHand",
+	"tg.calls.participants",
+};
+
+enum class Change {
+	State,
+	Participants,
+	RaisedHand,
+	Speaking,
+};
+
+struct ParticipantState {
+	PeerId peer = 0;
+	bool self = false;
+	bool speaking = false;
+	bool muted = false;
+	bool mutedByAdmin = false;
+	bool raisedHand = false;
+	bool video = false;
+	bool screen = false;
+};
+
+struct Snapshot {
+	bool present = false;
+	PeerId peer = 0;
+	PeerId joinAs = 0;
+	QString title;
+	int state = 0;
+	int mute = 0;
+	bool recording = false;
+	TimeId scheduled = 0;
+	int count = 0;
+	std::vector<ParticipantState> participants;
+};
+
+struct Watcher {
+	explicit Watcher(Fn<void()> fire) : timer(std::move(fire)) {
+	}
+
+	base::flat_set<int> callbacks;
+	Snapshot last;
+	crl::time lastSpeaking = 0;
+	base::Timer timer;
+	rpl::lifetime lifetime;
+};
+
+using Watchers = base::flat_map<not_null<Instance*>, std::unique_ptr<Watcher>>;
+
+[[nodiscard]] Watchers &AllWatchers() {
+	static auto result = Watchers();
+	return result;
+}
+
+[[nodiscard]] std::optional<std::uint64_t> BigField(
+		JSContext *ctx,
+		JSValueConst object,
+		const char *name) {
+	auto value = JS_GetPropertyStr(ctx, object, name);
+	auto result = std::optional<std::uint64_t>();
+	if (JS_IsBigInt(value)) {
+		auto number = std::int64_t();
+		JS_ToBigInt64(ctx, &number, value);
+		result = std::uint64_t(number);
+	}
+	JS_FreeValue(ctx, value);
+	return result;
+}
+
+[[nodiscard]] std::optional<PeerId> PeerFromValue(
+		JSContext *ctx,
+		JSValueConst value,
+		PeerId self) {
+	if (JS_IsBigInt(value)) {
+		auto id = std::int64_t();
+		JS_ToBigInt64(ctx, &id, value);
+		if (id > 0) {
+			return peerFromUser(UserId(std::uint64_t(id)));
+		} else if (id <= -kChannelShift) {
+			return peerFromChannel(
+				ChannelId(std::uint64_t(-id - kChannelShift)));
+		} else if (id < 0) {
+			return peerFromChat(ChatId(std::uint64_t(-id)));
+		}
+		return std::nullopt;
+	} else if (!JS_IsObject(value)) {
+		return std::nullopt;
+	}
+	auto name = JS_GetPropertyStr(ctx, value, "_");
+	const auto type = ToStd(ctx, name);
+	JS_FreeValue(ctx, name);
+	if (type == "inputPeerSelf" || type == "inputUserSelf") {
+		return self;
+	} else if (const auto user = BigField(ctx, value, "userId")) {
+		return peerFromUser(UserId(*user));
+	} else if (const auto chat = BigField(ctx, value, "chatId")) {
+		return peerFromChat(ChatId(*chat));
+	} else if (const auto channel = BigField(ctx, value, "channelId")) {
+		return peerFromChannel(ChannelId(*channel));
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] PeerData *PeerAt(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		int argc,
+		JSValueConst *argv,
+		int index) {
+	const auto id = (argc > index)
+		? PeerFromValue(ctx, argv[index], session->userPeerId())
+		: std::nullopt;
+	return id ? session->data().peerLoaded(*id) : nullptr;
+}
+
+[[nodiscard]] bool Present(int argc, JSValueConst *argv, int index) {
+	return (argc > index)
+		&& !JS_IsNull(argv[index])
+		&& !JS_IsUndefined(argv[index]);
+}
+
+[[nodiscard]] std::int64_t MarkedId(PeerId id) {
+	return peerIsUser(id)
+		? std::int64_t(peerToUser(id).bare)
+		: peerIsChat(id)
+		? -std::int64_t(peerToChat(id).bare)
+		: (-kChannelShift - std::int64_t(peerToChannel(id).bare));
+}
+
+[[nodiscard]] std::string_view Bytes(const mtpBuffer &buffer) {
+	return std::string_view(
+		reinterpret_cast<const char*>(buffer.constData()),
+		std::size_t(buffer.size()) * sizeof(mtpPrime));
+}
+
+[[nodiscard]] JSValue PeerValue(JSContext *ctx, not_null<PeerData*> peer) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"id",
+		JS_NewBigInt64(ctx, MarkedId(peer->id)));
+	const auto kind = peer->isUser()
+		? (peer->asUser()->isBot() ? "bot" : "user")
+		: peer->isChat()
+		? "chat"
+		: (peer->isMegagroup() || peer->isGigagroup())
+		? "supergroup"
+		: "channel";
+	JS_SetPropertyStr(ctx, result, "kind", JS_NewString(ctx, kind));
+	JS_SetPropertyStr(ctx, result, "name", NewString(ctx, peer->name()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"verified",
+		JS_NewBool(ctx, peer->isVerified()));
+	JS_SetPropertyStr(ctx, result, "scam", JS_NewBool(ctx, peer->isScam()));
+	JS_SetPropertyStr(ctx, result, "fake", JS_NewBool(ctx, peer->isFake()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"premium",
+		JS_NewBool(ctx, peer->isPremium()));
+	const auto status = peer->emojiStatusId().documentId;
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"emojiStatus",
+		status ? JS_NewBigInt64(ctx, std::int64_t(status)) : JS_NULL);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"color",
+		JS_NewInt32(ctx, peer->colorIndex()));
+	if (const auto username = peer->username(); !username.isEmpty()) {
+		JS_SetPropertyStr(ctx, result, "username", NewString(ctx, username));
+	}
+	auto buffer = mtpBuffer();
+	peer->input().write(buffer);
+	auto decoded = DecodeTl(ctx, Bytes(buffer), "InputPeer");
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"input",
+		decoded.error.empty() ? decoded.value : JS_UNDEFINED);
+	return result;
+}
+
+[[nodiscard]] JSValue RpcErrorValue(
+		JSContext *ctx,
+		int code,
+		const QString &type) {
+	auto global = JS_GetGlobalObject(ctx);
+	auto constructor = JS_GetPropertyStr(ctx, global, "__teleRpcError");
+	JS_FreeValue(ctx, global);
+	const auto text = type.toUtf8();
+	JSValue args[] = {
+		JS_NewInt32(ctx, code),
+		JS_NewStringLen(ctx, text.constData(), text.size()),
+	};
+	auto result = JS_CallConstructor(ctx, constructor, 2, args);
+	JS_FreeValue(ctx, args[1]);
+	JS_FreeValue(ctx, constructor);
+	return result;
+}
+
+void RejectRpc(const Pending &pending, const MTP::Error &error) {
+	const auto code = error.code();
+	const auto type = error.type();
+	RejectWith(pending, [=](JSContext *ctx) {
+		return RpcErrorValue(ctx, code, type);
+	});
+}
+
+[[nodiscard]] QString StateName(Calls::GroupCall::State state) {
+	using State = Calls::GroupCall::State;
+	switch (state) {
+	case State::Creating: return u"creating"_q;
+	case State::Waiting: return u"waiting"_q;
+	case State::Joining: return u"joining"_q;
+	case State::Connecting: return u"connecting"_q;
+	case State::Joined: return u"joined"_q;
+	case State::FailedHangingUp: return u"failedHangingUp"_q;
+	case State::Failed: return u"failed"_q;
+	case State::HangingUp: return u"hangingUp"_q;
+	case State::Ended: return u"ended"_q;
+	}
+	return u"unknown"_q;
+}
+
+[[nodiscard]] QString MuteName(Calls::MuteState mute) {
+	using Calls::MuteState;
+	switch (mute) {
+	case MuteState::Active: return u"active"_q;
+	case MuteState::PushToTalk: return u"pushToTalk"_q;
+	case MuteState::Muted: return u"muted"_q;
+	case MuteState::ForceMuted: return u"forceMuted"_q;
+	case MuteState::RaisedHand: return u"raisedHand"_q;
+	}
+	return u"muted"_q;
+}
+
+[[nodiscard]] const char *ChangeName(Change change) {
+	switch (change) {
+	case Change::State: return "state";
+	case Change::Participants: return "participants";
+	case Change::RaisedHand: return "raisedHand";
+	case Change::Speaking: return "speaking";
+	}
+	return "state";
+}
+
+[[nodiscard]] Calls::GroupCall *CurrentCall(
+		not_null<Main::Session*> session) {
+	const auto call = Core::App().calls().currentGroupCall();
+	return (call && (&call->peer()->session() == session.get()))
+		? call
+		: nullptr;
+}
+
+[[nodiscard]] ParticipantState StateOf(
+		const Data::GroupCallParticipant &participant,
+		not_null<PeerData*> self) {
+	return {
+		.peer = participant.peer->id,
+		.self = (participant.peer == self),
+		.speaking = bool(participant.speaking),
+		.muted = bool(participant.muted),
+		.mutedByAdmin = (participant.muted && !participant.canSelfUnmute),
+		.raisedHand = (participant.raisedHandRating != 0),
+		.video = !participant.cameraEndpoint().empty(),
+		.screen = !participant.screenEndpoint().empty(),
+	};
+}
+
+[[nodiscard]] ParticipantState StateOf(
+		const MTPDgroupCallParticipant &data) {
+	return {
+		.peer = peerFromMTP(data.vpeer()),
+		.self = data.is_self(),
+		.speaking = false,
+		.muted = data.is_muted(),
+		.mutedByAdmin = (data.is_muted() && !data.is_can_self_unmute()),
+		.raisedHand = (data.vraise_hand_rating().value_or_empty() != 0),
+		.video = data.vvideo().has_value(),
+		.screen = data.vpresentation().has_value(),
+	};
+}
+
+[[nodiscard]] std::vector<ParticipantState> CurrentParticipants(
+		not_null<Calls::GroupCall*> call) {
+	auto result = std::vector<ParticipantState>();
+	if (const auto real = call->lookupReal()) {
+		const auto self = call->joinAs();
+		const auto &list = real->participants();
+		result.reserve(list.size());
+		for (const auto &participant : list) {
+			result.push_back(StateOf(participant, self));
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] JSValue ParticipantValue(
+		JSContext *ctx,
+		not_null<PeerData*> peer,
+		const ParticipantState &state) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "peer", PeerValue(ctx, peer));
+	JS_SetPropertyStr(ctx, result, "self", JS_NewBool(ctx, state.self));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"speaking",
+		JS_NewBool(ctx, state.speaking));
+	JS_SetPropertyStr(ctx, result, "muted", JS_NewBool(ctx, state.muted));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"mutedByAdmin",
+		JS_NewBool(ctx, state.mutedByAdmin));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"raisedHand",
+		JS_NewBool(ctx, state.raisedHand));
+	JS_SetPropertyStr(ctx, result, "video", JS_NewBool(ctx, state.video));
+	JS_SetPropertyStr(ctx, result, "screen", JS_NewBool(ctx, state.screen));
+	return result;
+}
+
+[[nodiscard]] JSValue ParticipantsValue(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		const std::vector<ParticipantState> &list) {
+	auto result = JS_NewArray(ctx);
+	auto index = std::uint32_t();
+	for (const auto &state : list) {
+		if (const auto peer = session->data().peerLoaded(state.peer)) {
+			JS_SetPropertyUint32(
+				ctx,
+				result,
+				index++,
+				ParticipantValue(ctx, peer, state));
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] JSValue GroupValue(
+		JSContext *ctx,
+		not_null<Main::Session*> session) {
+	const auto call = CurrentCall(session);
+	if (!call) {
+		return JS_NULL;
+	}
+	const auto real = call->lookupReal();
+	const auto state = call->state();
+	const auto mute = call->muted();
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "peer", PeerValue(ctx, call->peer()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"title",
+		NewString(ctx, real ? real->title() : QString()));
+	JS_SetPropertyStr(ctx, result, "state", NewString(ctx, StateName(state)));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"joined",
+		JS_NewBool(ctx, state == Calls::GroupCall::State::Joined));
+	JS_SetPropertyStr(ctx, result, "joinAs", PeerValue(ctx, call->joinAs()));
+	JS_SetPropertyStr(ctx, result, "mute", NewString(ctx, MuteName(mute)));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"muted",
+		JS_NewBool(
+			ctx,
+			(mute != Calls::MuteState::Active)
+				&& (mute != Calls::MuteState::PushToTalk)));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"mutedByAdmin",
+		JS_NewBool(ctx, call->mutedByAdmin()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"raisedHand",
+		JS_NewBool(ctx, mute == Calls::MuteState::RaisedHand));
+	JS_SetPropertyStr(ctx, result, "stream", JS_NewBool(ctx, call->rtmp()));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"count",
+		JS_NewInt32(ctx, real ? real->fullCount() : 0));
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"recording",
+		JS_NewBool(ctx, real && (real->recordStartDate() != 0)));
+	const auto scheduled = call->scheduleDate();
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"scheduled",
+		scheduled ? JS_NewInt64(ctx, scheduled) : JS_NULL);
+	JS_SetPropertyStr(
+		ctx,
+		result,
+		"participants",
+		ParticipantsValue(ctx, session, CurrentParticipants(call)));
+	return result;
+}
+
+[[nodiscard]] Snapshot TakeSnapshot(not_null<Main::Session*> session) {
+	auto result = Snapshot();
+	const auto call = CurrentCall(session);
+	if (!call) {
+		return result;
+	}
+	const auto real = call->lookupReal();
+	result.present = true;
+	result.peer = call->peer()->id;
+	result.joinAs = call->joinAs()->id;
+	result.title = real ? real->title() : QString();
+	result.state = int(call->state());
+	result.mute = int(call->muted());
+	result.recording = real && (real->recordStartDate() != 0);
+	result.scheduled = call->scheduleDate();
+	result.count = real ? real->fullCount() : 0;
+	result.participants = CurrentParticipants(call);
+	ranges::sort(result.participants, [](
+			const ParticipantState &a,
+			const ParticipantState &b) {
+		return a.peer < b.peer;
+	});
+	return result;
+}
+
+[[nodiscard]] std::vector<Change> Changes(
+		const Snapshot &was,
+		const Snapshot &now) {
+	const auto state = (was.present != now.present)
+		|| (was.peer != now.peer)
+		|| (was.joinAs != now.joinAs)
+		|| (was.title != now.title)
+		|| (was.state != now.state)
+		|| (was.mute != now.mute)
+		|| (was.recording != now.recording)
+		|| (was.scheduled != now.scheduled);
+	auto participants = (was.count != now.count);
+	auto hands = false;
+	auto speaking = false;
+	const auto &a = was.participants;
+	const auto &b = now.participants;
+	auto i = std::size_t();
+	auto j = std::size_t();
+	while (i < a.size() || j < b.size()) {
+		if (j == b.size() || (i < a.size() && a[i].peer < b[j].peer)) {
+			participants = true;
+			hands = hands || a[i].raisedHand;
+			++i;
+		} else if (i == a.size() || b[j].peer < a[i].peer) {
+			participants = true;
+			hands = hands || b[j].raisedHand;
+			++j;
+		} else {
+			participants = participants
+				|| (a[i].muted != b[j].muted)
+				|| (a[i].mutedByAdmin != b[j].mutedByAdmin)
+				|| (a[i].video != b[j].video)
+				|| (a[i].screen != b[j].screen)
+				|| (a[i].self != b[j].self);
+			hands = hands || (a[i].raisedHand != b[j].raisedHand);
+			speaking = speaking || (a[i].speaking != b[j].speaking);
+			++i;
+			++j;
+		}
+	}
+	auto result = std::vector<Change>();
+	if (state) {
+		result.push_back(Change::State);
+	}
+	if (participants) {
+		result.push_back(Change::Participants);
+	}
+	if (hands) {
+		result.push_back(Change::RaisedHand);
+	}
+	if (speaking) {
+		result.push_back(Change::Speaking);
+	}
+	return result;
+}
+
+[[nodiscard]] JSValue ChangeValue(
+		JSContext *ctx,
+		not_null<Main::Session*> session,
+		const std::vector<Change> &changes) {
+	auto result = JS_NewObject(ctx);
+	JS_SetPropertyStr(ctx, result, "call", GroupValue(ctx, session));
+	auto list = JS_NewArray(ctx);
+	auto index = std::uint32_t();
+	for (const auto change : changes) {
+		JS_SetPropertyUint32(
+			ctx,
+			list,
+			index++,
+			JS_NewString(ctx, ChangeName(change)));
+	}
+	JS_SetPropertyStr(ctx, result, "changes", list);
+	return result;
+}
+
+[[nodiscard]] rpl::producer<> CallChanges(not_null<Calls::GroupCall*> call) {
+	auto real = call->real(
+	) | rpl::map([](not_null<Data::GroupCall*> real) {
+		return rpl::merge(
+			real->participantUpdated() | rpl::to_empty,
+			real->participantsReloaded(),
+			real->titleValue() | rpl::to_empty,
+			real->recordStartDateValue() | rpl::to_empty,
+			real->scheduleDateValue() | rpl::to_empty,
+			real->fullCountValue() | rpl::to_empty);
+	}) | rpl::flatten_latest();
+	return rpl::merge(
+		call->stateValue() | rpl::to_empty,
+		call->mutedValue() | rpl::to_empty,
+		call->joinAsValue() | rpl::to_empty,
+		call->titleChanged(),
+		std::move(real));
+}
+
+void Fire(not_null<Instance*> instance) {
+	const auto i = AllWatchers().find(instance);
+	if (i == end(AllWatchers())) {
+		return;
+	}
+	const auto watcher = i->second.get();
+	if (watcher->callbacks.empty()) {
+		return;
+	}
+	const auto session = ScriptSession(instance);
+	auto now = TakeSnapshot(session);
+	const auto changes = Changes(watcher->last, now);
+	if (changes.empty()) {
+		return;
+	}
+	const auto when = crl::now();
+	const auto speaking = ranges::contains(changes, Change::Speaking);
+	if (speaking
+		&& (changes.size() == 1)
+		&& (when - watcher->lastSpeaking < kSpeakingInterval)) {
+		watcher->timer.callOnce(
+			kSpeakingInterval - (when - watcher->lastSpeaking));
+		return;
+	}
+	if (speaking) {
+		watcher->lastSpeaking = when;
+	}
+	watcher->last = std::move(now);
+	const auto ids = std::vector<int>(
+		watcher->callbacks.begin(),
+		watcher->callbacks.end());
+	const auto weak = base::make_weak(instance.get());
+	for (const auto id : ids) {
+		CallKept(weak, id, [=](JSContext *ctx) {
+			return ChangeValue(ctx, session, changes);
+		}, u"calls.onGroupChange"_q);
+	}
+}
+
+[[nodiscard]] not_null<Watcher*> EnsureWatcher(not_null<Instance*> instance) {
+	auto &watchers = AllWatchers();
+	if (const auto i = watchers.find(instance); i != end(watchers)) {
+		return i->second.get();
+	}
+	auto owned = std::make_unique<Watcher>([=] { Fire(instance); });
+	const auto watcher = owned.get();
+	watcher->last = TakeSnapshot(ScriptSession(instance));
+	Core::App().calls().currentGroupCallValue(
+	) | rpl::map([](Calls::GroupCall *call) -> rpl::producer<> {
+		if (!call) {
+			return rpl::single(rpl::empty);
+		}
+		return CallChanges(call);
+	}) | rpl::flatten_latest(
+	) | rpl::on_next([=] {
+		if (!watcher->timer.isActive()
+			|| watcher->timer.remainingTime() > kDebounce) {
+			watcher->timer.callOnce(kDebounce);
+		}
+	}, watcher->lifetime);
+	watchers.emplace(instance, std::move(owned));
+	ScriptLifetime(instance).add([=] {
+		AllWatchers().remove(instance);
+	});
+	return watcher;
+}
+
+void ApplyMuted(not_null<Calls::GroupCall*> call, bool muted) {
+	using Calls::MuteState;
+	const auto now = call->muted();
+	if (muted) {
+		if (now == MuteState::Active || now == MuteState::PushToTalk) {
+			call->setMutedAndUpdate(MuteState::Muted);
+		}
+	} else if (now == MuteState::Muted || now == MuteState::PushToTalk) {
+		call->setMutedAndUpdate(MuteState::Active);
+	}
+}
+
+void SetDefaultJoinAs(not_null<PeerData*> peer, PeerId joinAs) {
+	if (const auto chat = peer->asChat()) {
+		chat->setGroupCallDefaultJoinAs(joinAs);
+	} else if (const auto channel = peer->asChannel()) {
+		channel->setGroupCallDefaultJoinAs(joinAs);
+	}
+}
+
+void FindCall(
+		not_null<PeerData*> peer,
+		Fn<void(Data::GroupCall*)> done,
+		Fn<void(const MTP::Error&)> fail) {
+	if (const auto real = peer->groupCall()) {
+		done(real);
+		return;
+	}
+	const auto api = &peer->session().api();
+	const auto got = [=](const MTPmessages_ChatFull &result) {
+		api->processFullPeer(peer, result);
+		done(peer->groupCall());
+	};
+	const auto failed = [=](const MTP::Error &error) {
+		fail(error);
+	};
+	if (const auto chat = peer->asChat()) {
+		api->request(MTPmessages_GetFullChat(
+			chat->inputChat()
+		)).done(got).fail(failed).send();
+	} else if (const auto channel = peer->asChannel()) {
+		api->request(MTPchannels_GetFullChannel(
+			channel->inputChannel()
+		)).done(got).fail(failed).send();
+	} else {
+		done(nullptr);
+	}
+}
+
+struct FetchState {
+	MTPInputGroupCall input;
+	int limit = 0;
+	std::vector<ParticipantState> list;
+	Fn<void(std::vector<ParticipantState>)> done;
+	Fn<void(const MTP::Error&)> fail;
+};
+
+void FetchPage(
+		not_null<Main::Session*> session,
+		std::shared_ptr<FetchState> state,
+		const QString &offset) {
+	const auto count = std::min(
+		kPage,
+		state->limit - int(state->list.size()));
+	session->api().request(MTPphone_GetGroupParticipants(
+		state->input,
+		MTP_vector<MTPInputPeer>(),
+		MTP_vector<MTPint>(),
+		MTP_string(offset),
+		MTP_int(count)
+	)).done([=](const MTPphone_GroupParticipants &result) {
+		auto next = QString();
+		auto received = 0;
+		result.match([&](const MTPDphone_groupParticipants &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			next = qs(data.vnext_offset());
+			received = data.vparticipants().v.size();
+			for (const auto &participant : data.vparticipants().v) {
+				participant.match([&](const MTPDgroupCallParticipant &fields) {
+					if (!fields.is_left()
+						&& int(state->list.size()) < state->limit) {
+						state->list.push_back(StateOf(fields));
+					}
+				});
+			}
+		});
+		if (next.isEmpty()
+			|| !received
+			|| int(state->list.size()) >= state->limit) {
+			state->done(base::take(state->list));
+		} else {
+			FetchPage(session, state, next);
+		}
+	}).fail([=](const MTP::Error &error) {
+		state->fail(error);
+	}).send();
+}
+
+void LoadParticipants(
+		Pending pending,
+		not_null<Main::Session*> session,
+		PeerData *peer,
+		int limit) {
+	const auto current = CurrentCall(session);
+	if (current
+		&& (!peer || current->peer() == peer)
+		&& current->lookupReal()) {
+		auto list = CurrentParticipants(current);
+		if (int(list.size()) > limit) {
+			list.resize(limit);
+		}
+		Resolve(pending, [=](JSContext *ctx) {
+			return ParticipantsValue(ctx, session, list);
+		});
+		return;
+	} else if (!peer) {
+		Reject(
+			pending,
+			"not-found",
+			Lower(u"There's no video chat right now."_q));
+		return;
+	}
+	const auto name = peer->name();
+	FindCall(peer, [=](Data::GroupCall *real) {
+		if (!real) {
+			Reject(
+				pending,
+				"not-found",
+				Lower(u"%1 has no video chat."_q).arg(name));
+			return;
+		}
+		const auto state = std::make_shared<FetchState>(FetchState{
+			.input = real->input(),
+			.limit = limit,
+			.done = [=](std::vector<ParticipantState> list) {
+				Resolve(pending, [=](JSContext *ctx) {
+					return ParticipantsValue(ctx, session, list);
+				});
+			},
+			.fail = [=](const MTP::Error &error) {
+				RejectRpc(pending, error);
+			},
+		});
+		FetchPage(session, state, QString());
+	}, [=](const MTP::Error &error) {
+		RejectRpc(pending, error);
+	});
+}
+
+void WaitJoined(
+		Pending pending,
+		base::weak_ptr<Instance> weak,
+		not_null<PeerData*> peer,
+		bool muted) {
+	using State = Calls::GroupCall::State;
+	const auto session = &peer->session();
+	const auto lifetime = std::make_shared<rpl::lifetime>();
+	const auto settled = std::make_shared<bool>(false);
+	const auto settle = [=](Fn<void()> action) {
+		if (*settled) {
+			return;
+		}
+		*settled = true;
+		action();
+		crl::on_main([lifetime] {
+			lifetime->destroy();
+		});
+	};
+	Core::App().calls().currentGroupCallValue(
+	) | rpl::map([=](Calls::GroupCall *call) -> rpl::producer<int> {
+		if (!call || call->peer() != peer) {
+			return rpl::single(-1);
+		}
+		return call->stateValue() | rpl::map([](State state) {
+			return int(state);
+		});
+	}) | rpl::flatten_latest(
+	) | rpl::on_next([=](int state) {
+		const auto call = Core::App().calls().currentGroupCall();
+		if (!call || call->peer() != peer) {
+			return;
+		} else if (state == int(State::Joined)
+			|| (state == int(State::Waiting) && call->scheduleDate())) {
+			const auto guard = base::make_weak(call);
+			settle([=] {
+				crl::on_main([=] {
+					if (const auto strong = guard.get()) {
+						ApplyMuted(strong, muted);
+					}
+					if (CurrentCall(session)) {
+						Resolve(pending, [=](JSContext *ctx) {
+							return GroupValue(ctx, session);
+						});
+					} else {
+						Reject(
+							pending,
+							"internal",
+							Lower(u"The video chat ended right after joining."_q));
+					}
+				});
+			});
+		} else if (state == int(State::Failed)
+			|| state == int(State::FailedHangingUp)) {
+			settle([=] {
+				Reject(
+					pending,
+					"internal",
+					Lower(u"Couldn't join the video chat."_q));
+			});
+		} else if (state == int(State::HangingUp)
+			|| state == int(State::Ended)) {
+			settle([=] {
+				Reject(
+					pending,
+					"internal",
+					Lower(u"The video chat ended before joining."_q));
+			});
+		}
+	}, *lifetime);
+	base::timer_once(kJoinTimeout) | rpl::on_next([=] {
+		settle([=] {
+			Reject(
+				pending,
+				"timed-out",
+				Lower(u"Not joined within 60 seconds."_q));
+		});
+	}, *lifetime);
+	if (const auto strong = weak.get()) {
+		const auto weakLifetime = std::weak_ptr<rpl::lifetime>(lifetime);
+		ScriptLifetime(strong).add([=] {
+			if (const auto owned = weakLifetime.lock()) {
+				owned->destroy();
+			}
+		});
+	}
+}
+
+void StartJoin(
+		Pending pending,
+		base::weak_ptr<Instance> weak,
+		not_null<PeerData*> peer,
+		PeerData *joinAs,
+		bool muted) {
+	const auto session = &peer->session();
+	const auto name = peer->name();
+	FindCall(peer, [=](Data::GroupCall *real) {
+		if (!real) {
+			Reject(
+				pending,
+				"not-found",
+				Lower(u"%1 has no video chat."_q).arg(name));
+			return;
+		}
+		if (const auto current = CurrentCall(session)
+			; current && current->peer() == peer) {
+			ApplyMuted(current, muted);
+			Resolve(pending, [=](JSContext *ctx) {
+				return GroupValue(ctx, session);
+			});
+			return;
+		}
+		const auto window = session->tryResolveWindow(peer);
+		if (!window) {
+			Reject(
+				pending,
+				"unsupported",
+				Lower(u"This account has no window to join from."_q));
+			return;
+		}
+		if (joinAs) {
+			SetDefaultJoinAs(peer, joinAs->id);
+		}
+		WaitJoined(pending, weak, peer, muted);
+		window->startOrJoinGroupCall(peer, {});
+	}, [=](const MTP::Error &error) {
+		RejectRpc(pending, error);
+	});
+}
+
+JSValue NativeGroupCalls(
+		JSContext *ctx,
+		JSValueConst self,
+		int argc,
+		JSValueConst *argv,
+		int magic) {
+	const auto op = Op(magic);
+	if (op == Op::Off) {
+		const auto instance = Instance::From(ctx);
+		if (!instance) {
+			return JS_ThrowInternalError(ctx, "the script was stopped");
+		}
+		auto id = 0;
+		if (argc < 1 || JS_ToInt32(ctx, &id, argv[0]) < 0) {
+			return JS_EXCEPTION;
+		}
+		const auto i = AllWatchers().find(instance);
+		if (i != end(AllWatchers())) {
+			i->second->callbacks.remove(id);
+		}
+		ForgetKept(base::make_weak(instance), id);
+		return JS_UNDEFINED;
+	}
+	const auto instance = Permitted(
+		ctx,
+		Capability::Calls,
+		{},
+		kNames[magic]);
+	if (!instance) {
+		return JS_EXCEPTION;
+	}
+	const auto session = ScriptSession(instance);
+	switch (op) {
+	case Op::Current:
+		return GroupValue(ctx, session);
+	case Op::OnChange: {
+		if (argc < 1 || !JS_IsFunction(ctx, argv[0])) {
+			return JS_ThrowTypeError(ctx, "tg.calls.onGroupChange(function)");
+		}
+		const auto watcher = EnsureWatcher(instance);
+		const auto id = KeepFunction(instance, argv[0]);
+		watcher->callbacks.emplace(id);
+		return JS_NewInt32(ctx, id);
+	}
+	case Op::Join: {
+		const auto peer = PeerAt(ctx, session, argc, argv, 0);
+		if (!peer || peer->isUser()) {
+			return JS_ThrowTypeError(
+				ctx,
+				"tg.calls.join needs a group or a channel tele has loaded");
+		}
+		const auto muted = (argc < 2) || (JS_ToBool(ctx, argv[1]) > 0);
+		auto joinAs = (PeerData*)nullptr;
+		if (Present(argc, argv, 2)) {
+			joinAs = PeerAt(ctx, session, argc, argv, 2);
+			if (!joinAs) {
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.calls.join: joinAs must be a peer tele has loaded");
+			}
+		}
+		auto created = NewPending(ctx);
+		if (JS_IsException(created.second)) {
+			return created.second;
+		}
+		const auto pending = created.first;
+		const auto weak = base::make_weak(instance);
+		const auto chat = not_null<PeerData*>(peer);
+		crl::on_main(session, [=] {
+			StartJoin(pending, weak, chat, joinAs, muted);
+		});
+		return created.second;
+	}
+	case Op::Leave: {
+		const auto call = CurrentCall(session);
+		if (!call) {
+			return JS_FALSE;
+		}
+		call->hangup();
+		return JS_TRUE;
+	}
+	case Op::SetMuted: {
+		const auto call = CurrentCall(session);
+		const auto muted = (argc > 0) && (JS_ToBool(ctx, argv[0]) > 0);
+		if (!call || (!muted && call->mutedByAdmin())) {
+			return JS_FALSE;
+		}
+		ApplyMuted(call, muted);
+		return JS_TRUE;
+	}
+	case Op::RaiseHand: {
+		using Calls::MuteState;
+		const auto call = CurrentCall(session);
+		if (!call) {
+			return JS_FALSE;
+		}
+		const auto raised = (argc > 0) && (JS_ToBool(ctx, argv[0]) > 0);
+		const auto now = call->muted();
+		if (raised) {
+			if (now == MuteState::RaisedHand) {
+				return JS_TRUE;
+			} else if (now != MuteState::ForceMuted
+				|| call->conference()
+				|| call->rtmp()) {
+				return JS_FALSE;
+			}
+			call->setMutedAndUpdate(MuteState::RaisedHand);
+		} else if (now == MuteState::RaisedHand) {
+			call->setMutedAndUpdate(MuteState::ForceMuted);
+		}
+		return JS_TRUE;
+	}
+	case Op::Participants: {
+		auto limit = kDefaultLimit;
+		if (argc > 1 && JS_IsNumber(argv[1])) {
+			auto value = 0.;
+			JS_ToFloat64(ctx, &value, argv[1]);
+			if (value != std::floor(value) || value < 1.) {
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.calls.participants: limit must be a positive integer");
+			}
+			limit = int(std::min(value, double(kMaxLimit)));
+		}
+		auto peer = (PeerData*)nullptr;
+		if (Present(argc, argv, 0)) {
+			peer = PeerAt(ctx, session, argc, argv, 0);
+			if (!peer || peer->isUser()) {
+				return JS_ThrowTypeError(
+					ctx,
+					"tg.calls.participants needs a group or a channel tele has loaded");
+			}
+		}
+		auto created = NewPending(ctx);
+		if (JS_IsException(created.second)) {
+			return created.second;
+		}
+		const auto pending = created.first;
+		crl::on_main(session, [=] {
+			LoadParticipants(pending, session, peer, limit);
+		});
+		return created.second;
+	}
+	case Op::Off:
+		break;
+	}
+	return JS_UNDEFINED;
+}
+
+constexpr auto kTypings = std::string_view(R"TS(
+declare module 'tele' {
+  export type GroupCallState =
+    | 'creating'
+    | 'waiting'
+    | 'joining'
+    | 'connecting'
+    | 'joined'
+    | 'failedHangingUp'
+    | 'failed'
+    | 'hangingUp'
+    | 'ended'
+    | 'unknown'
+
+  export type GroupCallMute = 'active' | 'pushToTalk' | 'muted' | 'forceMuted' | 'raisedHand'
+
+  export type GroupCallChange = 'state' | 'participants' | 'raisedHand' | 'speaking'
+
+  export interface GroupCallParticipant {
+    peer: PeerInfo
+    self: boolean
+    speaking: boolean
+    muted: boolean
+    mutedByAdmin: boolean
+    raisedHand: boolean
+    video: boolean
+    screen: boolean
+  }
+
+  export interface GroupCallInfo {
+    peer: PeerInfo
+    title: string
+    state: GroupCallState
+    joined: boolean
+    joinAs: PeerInfo
+    mute: GroupCallMute
+    muted: boolean
+    mutedByAdmin: boolean
+    raisedHand: boolean
+    stream: boolean
+    count: number
+    recording: boolean
+    scheduled: number | null
+    participants: GroupCallParticipant[]
+  }
+
+  export interface Calls {
+    group(): GroupCallInfo | null
+    onGroupChange(callback: (call: GroupCallInfo | null, changes: GroupCallChange[]) => unknown): Disposer
+    join(chat: InputPeerLike, options?: { muted?: boolean, joinAs?: InputPeerLike }): Promise<GroupCallInfo>
+    leave(): boolean
+    raiseHand(raised: boolean): boolean
+    participants(chat?: InputPeerLike, options?: { limit?: number }): Promise<GroupCallParticipant[]>
+  }
+}
+)TS");
+
+} // namespace
+
+void AddGroupCallsNatives(JSContext *ctx, JSValueConst natives) {
+	AddNatives(ctx, natives, {
+		{ "groupcallsCurrent", NativeGroupCalls, 0, int(Op::Current) },
+		{ "groupcallsOnChange", NativeGroupCalls, 1, int(Op::OnChange) },
+		{ "groupcallsOff", NativeGroupCalls, 1, int(Op::Off) },
+		{ "groupcallsJoin", NativeGroupCalls, 3, int(Op::Join) },
+		{ "groupcallsLeave", NativeGroupCalls, 0, int(Op::Leave) },
+		{ "groupcallsSetMuted", NativeGroupCalls, 1, int(Op::SetMuted) },
+		{ "groupcallsRaiseHand", NativeGroupCalls, 1, int(Op::RaiseHand) },
+		{
+			"groupcallsParticipants",
+			NativeGroupCalls,
+			2,
+			int(Op::Participants),
+		},
+	});
+}
+
+std::string_view GroupCallsTypings() {
+	return kTypings;
+}
