+}
+
+Socket::~Socket() {
+	_context = nullptr;
+	if (!_socket) {
+		return;
+	}
+	const auto socket = _socket;
+	if (socket->state() == QAbstractSocket::ConnectedState) {
+		if (_state == State::Open && _upgraded && !_closeSent) {
+			writeClose(1001, QByteArray());
+		}
+		QObject::connect(
+			socket,
+			&QAbstractSocket::disconnected,
+			socket,
+			&QObject::deleteLater);
+		QTimer::singleShot(int(kCloseTimeout), socket, [=] {
+			socket->abort();
+			socket->deleteLater();
+		});
+		socket->disconnectFromHost();
+	} else {
+		socket->abort();
+		socket->deleteLater();
+	}
+}
