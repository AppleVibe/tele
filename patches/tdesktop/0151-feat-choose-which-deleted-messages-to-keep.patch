@@ -61,6 +61,9 @@ extern const char kOptionIgnoredUsers[];
 extern const char kOptionMessageSeconds[];
 extern const char kOptionEditHistory[];
 extern const char kOptionKeepDeleted[];
+extern const char kOptionKeepDeletedBots[];
+extern const char kOptionKeepDeletedSaved[];
+extern const char kOptionKeepDeletedOwn[];
 extern const char kOptionDeletedIcon[];
 extern const char kOptionDeletedReply[];
 extern const char kOptionRevealSpoilers[];
@@ -215,6 +218,9 @@ void SetIgnoredList(const QString &value);
 [[nodiscard]] bool EditHistory();
 [[nodiscard]] rpl::producer<bool> EditHistoryValue();
 [[nodiscard]] bool KeepDeletedMessages();
+[[nodiscard]] bool KeepDeletedBots();
+[[nodiscard]] bool KeepDeletedSaved();
+[[nodiscard]] bool KeepDeletedOwn();
 [[nodiscard]] bool DeletedTrashIcon();
 [[nodiscard]] rpl::producer<bool> DeletedTrashIconValue();
 [[nodiscard]] QString DeletedReply();
diff --git a/Telegram/SourceFiles/tele/tele_settings_io.cpp b/Telegram/SourceFiles/tele/tele_settings_io.cpp
index 5dd538f5e2e829b5bde6e84de3f14b3764e40e8e..03463447def417340d617e0fe84a8c8c9d8e68a5 100644
--- a/Telegram/SourceFiles/tele/tele_settings_io.cpp
