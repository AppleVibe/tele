From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Wed, 30 Sep 2026 04:51:40 +0300
Subject: [PATCH] feat: choose which deleted messages to keep

---
 .../SourceFiles/settings/settings_tele.cpp    | 15 ++++++++
 Telegram/SourceFiles/tele/tele_deleted.cpp    | 16 +++++++--
 Telegram/SourceFiles/tele/tele_options.cpp    | 36 ++++++++++++++++++-
 Telegram/SourceFiles/tele/tele_options.h      |  6 ++++
 .../SourceFiles/tele/tele_settings_io.cpp     |  3 ++
 5 files changed, 73 insertions(+), 3 deletions(-)

diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 0c02009a6a15b2b84ca29c706abb47ee1b92c661..a45635d4258a1836ca9139d1f568b56bda9ad8d2 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1970,6 +1970,21 @@ void FillChats(SectionBuilder &builder) {
 	AddOptionToggle(builder, ::Tele::kOptionMessageSeconds);
 	AddOptionToggle(builder, ::Tele::kOptionEditHistory);
 	AddOptionToggle(builder, ::Tele::kOptionKeepDeleted);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionKeepDeletedBots,
+		{},
+		::Tele::kOptionKeepDeleted);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionKeepDeletedSaved,
+		{},
+		::Tele::kOptionKeepDeleted);
+	AddOptionToggle(
+		builder,
+		::Tele::kOptionKeepDeletedOwn,
+		{ u"own"_q, u"yourself"_q },
+		::Tele::kOptionKeepDeleted);
 	AddOptionToggle(
 		builder,
 		::Tele::kOptionDeletedIcon,
diff --git a/Telegram/SourceFiles/tele/tele_deleted.cpp b/Telegram/SourceFiles/tele/tele_deleted.cpp
index 91b7ebcb69126ba5444c499e9c4db55d78629c59..e3544ee5702026eed648d58b3d806c31cafc8f81 100644
--- a/Telegram/SourceFiles/tele/tele_deleted.cpp
+++ b/Telegram/SourceFiles/tele/tele_deleted.cpp
@@ -3,6 +3,7 @@
 #include "data/data_histories.h"
 #include "data/data_media_types.h"
 #include "data/data_session.h"
+#include "data/data_user.h"
 #include "history/history.h"
 #include "history/history_item.h"
 #include "history/view/history_view_element.h"
@@ -126,6 +127,15 @@ void Forget(
 		&& !(media && media->ttlSeconds());
 }
 
+[[nodiscard]] bool Wanted(not_null<HistoryItem*> item) {
+	const auto peer = item->history()->peer;
+	if (peer->isSelf()) {
+		return KeepDeletedSaved();
+	}
+	const auto user = peer->asUser();
+	return !user || !user->isBot() || KeepDeletedBots();
+}
+
 [[nodiscard]] HistoryItem *FirstLoaded(not_null<History*> history) {
 	for (const auto &block : history->blocks) {
 		for (const auto &view : block->messages) {
@@ -153,12 +163,14 @@ void Forget(
 }
 
 void Keep(std::vector<not_null<HistoryItem*>> &items, bool own) {
-	if (!KeepDeletedMessages()) {
+	if (!KeepDeletedMessages() || (own && !KeepDeletedOwn())) {
 		return;
 	}
 	auto kept = std::vector<not_null<HistoryItem*>>();
 	items.erase(ranges::remove_if(items, [&](not_null<HistoryItem*> item) {
-		if (!Keepable(item) || (own && IsKeptDeleted(item))) {
+		if (!Keepable(item)
+			|| !Wanted(item)
+			|| (own && IsKeptDeleted(item))) {
 			return false;
 		}
 		const auto history = item->history();
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index b2b9f26e20059db0f82a4be272e74869e5fede3d..529ab39c54d54926aaea0a91c5a2581d6504e6b7 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -66,6 +66,9 @@ const char kOptionIgnoredUsers[] = "tele-ignored-users";
 const char kOptionMessageSeconds[] = "tele-message-seconds";
 const char kOptionEditHistory[] = "tele-edit-history";
 const char kOptionKeepDeleted[] = "tele-keep-deleted";
+const char kOptionKeepDeletedBots[] = "tele-keep-deleted-bots";
+const char kOptionKeepDeletedSaved[] = "tele-keep-deleted-saved";
+const char kOptionKeepDeletedOwn[] = "tele-keep-deleted-own";
 const char kOptionDeletedIcon[] = "tele-deleted-icon";
 const char kOptionDeletedReply[] = "tele-deleted-reply";
 const char kOptionRevealSpoilers[] = "tele-reveal-spoilers";
@@ -498,7 +501,26 @@ base::options::toggle EditHistoryOption({
 base::options::toggle KeepDeletedOption({
 	.id = kOptionKeepDeleted,
 	.name = "Keep deleted messages",
-	.description = "Kept until tele restarts, including ones you delete yourself.",
+	.description = "Kept until tele restarts.",
+});
+
+base::options::toggle KeepDeletedBotsOption({
+	.id = kOptionKeepDeletedBots,
+	.name = "In bot chats",
+	.defaultValue = true,
+});
+
+base::options::toggle KeepDeletedSavedOption({
+	.id = kOptionKeepDeletedSaved,
+	.name = "In Saved Messages",
+	.defaultValue = true,
+});
+
+base::options::toggle KeepDeletedOwnOption({
+	.id = kOptionKeepDeletedOwn,
+	.name = "Ones you delete",
+	.description = "Only ones deleted from this device.",
+	.defaultValue = true,
 });
 
 base::options::toggle DeletedIconOption({
@@ -1363,6 +1385,18 @@ bool KeepDeletedMessages() {
 	return KeepDeletedOption.value();
 }
 
+bool KeepDeletedBots() {
+	return KeepDeletedBotsOption.value();
+}
+
+bool KeepDeletedSaved() {
+	return KeepDeletedSavedOption.value();
+}
+
+bool KeepDeletedOwn() {
+	return KeepDeletedOwnOption.value();
+}
+
 bool DeletedTrashIcon() {
 	return DeletedIconOption.value();
 }
