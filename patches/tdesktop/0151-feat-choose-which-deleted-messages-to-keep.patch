@@ -143,6 +143,9 @@ struct Spec {
 		Toggle(kOptionMessageSeconds),
 		Toggle(kOptionEditHistory),
 		Toggle(kOptionKeepDeleted),
+		Toggle(kOptionKeepDeletedBots),
+		Toggle(kOptionKeepDeletedSaved),
+		Toggle(kOptionKeepDeletedOwn),
 		Toggle(kOptionDeletedIcon),
 		Toggle(kOptionRevealSpoilers),
 		Toggle(kOptionCodeLineNumbers),
