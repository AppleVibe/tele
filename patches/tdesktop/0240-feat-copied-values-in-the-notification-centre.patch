+template <typename Target>
+decltype(auto) ShowCopiedToast(
+		const Target &target,
+		Ui::Toast::Config &&config,
+		TextWithEntities copied,
+		std::source_location where = std::source_location::current()) {
+	LogCopiedToast(
+		TeleToastSessionOf(target),
+		config.title,
+		config.text,
+		std::move(copied),
+		where);
+	if constexpr (requires { target->showToast(std::move(config)); }) {
+		return target->showToast(std::move(config));
+	} else {
+		return Ui::Toast::Show(target, std::move(config));
+	}
+}
+
+template <typename Target>
+decltype(auto) ShowCopiedToast(
+		const Target &target,
+		const QString &text,
+		TextWithEntities copied,
+		std::source_location where = std::source_location::current()) {
+	return ShowCopiedToast(
+		target,
+		Ui::Toast::Config{ .text = { text } },
+		std::move(copied),
+		where);
+}
+
 } // namespace Tele
