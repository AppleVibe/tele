+not_null<Main::Session*> MoneyCardStickers::session() const {
+	return _session;
+}
+
+void MoneyCardStickers::paint(QPainter &p, QSize card) {
+	if (_list.empty() || card.isEmpty()) {
+		return;
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	auto path = QPainterPath();
+	path.addRoundedRect(
+		QRectF(QPointF(), QSizeF(card)),
+		st::walletCardRadius,
+		st::walletCardRadius);
+	p.save();
+	p.setClipPath(path, Qt::IntersectClip);
+	for (const auto &sticker : _list) {
+		if (Hidden(_session, sticker.key)) {
+			continue;
+		}
+		const auto image = StickerImage(_session, sticker.modelId);
+		if (image.isNull()) {
+			continue;
+		}
+		const auto size = QSizeF(image.size()) / image.devicePixelRatio();
+		const auto center = CenterIn(sticker, QSizeF(card));
+		p.drawImage(
+			QRectF(
+				center - QPointF(size.width() / 2., size.height() / 2.),
+				size),
+			image);
+	}
+	p.restore();
+}
+
+const MoneyCardSticker *MoneyCardStickers::hit(QPoint point, QSize card) {
+	const auto half = HitSide() / 2.;
+	for (auto i = _list.rbegin(); i != _list.rend(); ++i) {
+		if (Hidden(_session, i->key)) {
+			continue;
+		}
+		const auto center = CenterIn(*i, QSizeF(card));
+		const auto delta = QPointF(point) - center;
+		if (std::abs(delta.x()) > half || std::abs(delta.y()) > half) {
+			continue;
+		}
+		const auto image = StickerImage(_session, i->modelId);
+		if (image.isNull()) {
+			return &*i;
+		}
+		const auto ratio = image.devicePixelRatio();
+		const auto pixel = QPoint(
+			int(image.width() / 2 + delta.x() * ratio),
+			int(image.height() / 2 + delta.y() * ratio));
+		if (image.rect().contains(pixel)
+			&& qAlpha(image.pixel(pixel)) >= kHitAlpha) {
+			return &*i;
+		}
+	}
+	return nullptr;
+}
+
+void SetupMoneyCardStickerDrag(
+		not_null<Ui::RpWidget*> target,
+		not_null<MoneyCardStickers*> stickers,
+		std::shared_ptr<MoneyCardDropTarget> drop) {
+	struct Drag {
+		QString key;
+		DocumentId modelId = 0;
+		QPoint pressed;
+		QPoint global;
+		QPointF grab;
+		crl::time handled = 0;
+		bool active = false;
+		bool swallow = false;
+		base::unique_qptr<Ui::RpWidget> overlay;
+	};
+	const auto drag = target->lifetime().make_state<Drag>();
+	const auto weak = base::make_weak(stickers);
+	const auto session = stickers->session();
+	const auto sessionWeak = base::make_weak(session);
+	const auto reset = [=] {
+		const auto key = base::take(drag->key);
+		const auto active = std::exchange(drag->active, false);
+		drag->overlay = nullptr;
+		if (active && !key.isEmpty()) {
+			if (const auto strong = sessionWeak.get()) {
+				Unhide(strong, key);
+			}
+		}
+	};
+	target->lifetime().add(reset);
+	const auto card = [=] {
+		return DropCard(drop);
+	};
+	const auto droppable = [=](QPointF at) {
+		const auto rect = card();
+		return !rect.isEmpty()
+			&& QRectF(rect).contains(at)
+			&& (!drop->visible || QRectF(drop->visible()).contains(at));
+	};
+	const auto idleCursor = dynamic_cast<Ui::AbstractButton*>(target.get())
+		? style::cur_pointer
+		: style::cur_default;
+	const auto localFor = [=](QPoint global, QRect rect) -> QPoint {
+		const auto overlay = drop->overlay.data();
+		return overlay
+			? (overlay->mapFromGlobal(global) - rect.topLeft())
+			: QPoint();
+	};
+	const auto updateCursor = [=](QPoint global) {
+		const auto strong = weak.get();
+		const auto rect = card();
+		const auto over = strong
+			&& !rect.isEmpty()
+			&& strong->hit(localFor(global, rect), rect.size());
+		target->setCursor(over ? Qt::OpenHandCursor : idleCursor);
+	};
+	const auto finish = [=](QPoint global) {
+		const auto key = drag->key;
+		const auto active = drag->active;
+		const auto grab = drag->grab;
+		const auto rect = card();
+		const auto overlay = drop->overlay.data();
+		const auto release = overlay
+			? (QPointF(overlay->mapFromGlobal(global)) - grab)
+			: QPointF();
+		reset();
+		if (!active) {
+			drag->handled = crl::now();
+			RemoveAnimated(session, key, drop, std::nullopt);
+		} else if (!rect.isEmpty() && overlay) {
+			const auto center = release - QPointF(rect.topLeft());
+			const auto size = QSizeF(rect.size());
+			if (droppable(release)) {
+				RaiseSticker(session, key, Clamped(center, size));
+			} else {
+				RemoveAnimated(session, key, drop, release);
+			}
+		}
+		updateCursor(global);
+	};
+	base::install_event_filter(target, [=](not_null<QEvent*> e) {
+		const auto type = e->type();
+		if (type != QEvent::MouseButtonPress
+			&& type != QEvent::MouseButtonDblClick
+			&& type != QEvent::MouseMove
+			&& type != QEvent::MouseButtonRelease) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto strong = weak.get();
+		if (!strong) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto mouse = static_cast<QMouseEvent*>(e.get());
+		const auto global = mouse->globalPos();
+		if (type == QEvent::MouseButtonPress
+			|| type == QEvent::MouseButtonDblClick) {
+			reset();
+			drag->swallow = false;
+			if (mouse->button() != Qt::LeftButton) {
+				return base::EventFilterResult::Continue;
+			}
+			if (type == QEvent::MouseButtonDblClick
+				&& drag->handled
+				&& (crl::now() - drag->handled
+					<= QApplication::doubleClickInterval())) {
+				drag->handled = 0;
+				drag->swallow = true;
+				return base::EventFilterResult::Cancel;
+			}
+			const auto rect = card();
+			if (rect.isEmpty()) {
+				return base::EventFilterResult::Continue;
+			}
+			const auto local = localFor(global, rect);
+			const auto sticker = strong->hit(local, rect.size());
+			if (!sticker) {
+				return base::EventFilterResult::Continue;
+			}
+			drag->key = sticker->key;
+			drag->modelId = sticker->modelId;
+			drag->pressed = drag->global = global;
+			drag->grab = QPointF(local) - CenterIn(*sticker, rect.size());
+			target->setCursor(Qt::ClosedHandCursor);
+			return base::EventFilterResult::Cancel;
+		} else if (drag->swallow) {
+			if (type == QEvent::MouseButtonRelease) {
+				drag->swallow = false;
+			}
+			return base::EventFilterResult::Cancel;
+		} else if (drag->key.isEmpty()) {
+			if (type == QEvent::MouseMove) {
+				updateCursor(global);
+			}
+			return base::EventFilterResult::Continue;
+		} else if (type == QEvent::MouseMove) {
+			if (!(mouse->buttons() & Qt::LeftButton)) {
+				reset();
+				updateCursor(global);
+				return base::EventFilterResult::Continue;
+			}
+			drag->global = global;
+			if (!drag->active) {
+				const auto distance = (global - drag->pressed).manhattanLength();
+				const auto overlay = drop->overlay.data();
+				if (distance < QApplication::startDragDistance()) {
+					return base::EventFilterResult::Cancel;
+				} else if (!overlay) {
+					reset();
+					return base::EventFilterResult::Cancel;
+				}
+				drag->active = true;
+				Hide(session, drag->key);
+				drag->overlay = CreateFloating(
+					overlay,
+					session,
+					drag->modelId,
+					[=] {
+						const auto overlay = drop->overlay.data();
+						return overlay
+							? (QPointF(overlay->mapFromGlobal(drag->global))
+								- drag->grab)
+							: QPointF();
+					},
+					droppable);
+			}
+			if (drag->overlay) {
+				drag->overlay->update();
+			}
+			return base::EventFilterResult::Cancel;
+		} else if (mouse->button() == Qt::LeftButton) {
+			finish(global);
+		}
+		return base::EventFilterResult::Cancel;
+	});
+}
