+void SetupMoneyCardCollectible(
+		not_null<Ui::RpWidget*> row,
+		not_null<Main::Session*> session,
+		Fn<std::shared_ptr<Data::UniqueGift>()> gift,
+		Fn<void()> refresh,
+		Fn<QRect()> model,
+		std::shared_ptr<MoneyCardDropTarget> target) {
+	if (target) {
+		SetupMoneyCardGiftDrag(row, session, gift, true, target);
+	}
+	RegisterMoneyCardGiftSource(row, session, [=] {
+		const auto unique = gift();
+		return unique ? unique->slug : QString();
+	}, std::move(model));
+	MoneyCardStickersUpdates(
+		session
+	) | rpl::on_next([=] {
+		refresh();
+		row->update();
+	}, row->lifetime());
+	FramesFor(session).ready.events(
+	) | rpl::on_next([=] {
+		row->update();
+	}, row->lifetime());
+
+	const auto menu = row->lifetime().make_state<
+		base::unique_qptr<Ui::PopupMenu>>();
+	base::install_event_filter(row, [=](not_null<QEvent*> e) {
+		if (e->type() != QEvent::ContextMenu || !MoneyCardDesigns()) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto unique = gift();
+		if (!unique) {
+			return base::EventFilterResult::Continue;
+		}
+		*menu = base::make_unique_q<Ui::PopupMenu>(
+			row,
+			st::popupMenuWithIcons);
+		FillMoneyCardGiftMenu(menu->get(), session, unique, true, target);
+		(*menu)->popup(QCursor::pos());
+		return base::EventFilterResult::Cancel;
+	});
+}
+
+void SetupMoneyCardGiftDrag(
+		not_null<Ui::RpWidget*> source,
+		not_null<Main::Session*> session,
+		Fn<std::shared_ptr<Data::UniqueGift>()> gift,
+		bool chain,
+		std::shared_ptr<MoneyCardDropTarget> target) {
+	struct Drag {
+		std::shared_ptr<Data::UniqueGift> gift;
+		QString hidden;
+		QPoint pressed;
+		QPoint global;
+		bool active = false;
+		base::unique_qptr<Ui::RpWidget> overlay;
+	};
+	const auto drag = source->lifetime().make_state<Drag>();
+	const auto weak = base::make_weak(session);
+	const auto reset = [=] {
+		drag->active = false;
+		drag->gift = nullptr;
+		drag->overlay = nullptr;
+		if (const auto key = base::take(drag->hidden); !key.isEmpty()) {
+			if (const auto strong = weak.get()) {
+				Unhide(strong, key);
+			}
+		}
+	};
+	source->lifetime().add(reset);
+	const auto point = [=](QPoint global) -> std::optional<QPointF> {
+		const auto overlay = target->overlay.data();
+		if (!overlay) {
+			return std::nullopt;
+		}
+		return QPointF(overlay->mapFromGlobal(global));
+	};
+	const auto dropRect = [=](QPointF at) -> QRect {
+		const auto card = DropCard(target);
+		if (card.isEmpty() || !QRectF(card).contains(at)) {
+			return QRect();
+		} else if (target->visible
+			&& !QRectF(target->visible()).contains(at)) {
+			return QRect();
+		}
+		return card;
+	};
+	base::install_event_filter(source, [=](not_null<QEvent*> e) {
+		const auto type = e->type();
+		if (type != QEvent::MouseButtonPress
+			&& type != QEvent::MouseButtonDblClick
+			&& type != QEvent::MouseMove
+			&& type != QEvent::MouseButtonRelease) {
+			return base::EventFilterResult::Continue;
+		}
+		const auto mouse = static_cast<QMouseEvent*>(e.get());
+		const auto global = mouse->globalPos();
+		if (type == QEvent::MouseButtonPress
+			|| type == QEvent::MouseButtonDblClick) {
+			reset();
+			if (mouse->button() == Qt::LeftButton && MoneyCardDesigns()) {
+				drag->gift = gift();
+				drag->pressed = global;
+			}
+			return base::EventFilterResult::Continue;
+		} else if (!drag->gift) {
+			return base::EventFilterResult::Continue;
+		} else if (type == QEvent::MouseMove) {
+			const auto active = drag->active;
+			if (!(mouse->buttons() & Qt::LeftButton)) {
+				reset();
+				return active
+					? base::EventFilterResult::Cancel
+					: base::EventFilterResult::Continue;
+			}
+			drag->global = global;
+			if (!active) {
+				const auto distance = (global - drag->pressed).manhattanLength();
+				const auto overlay = target->overlay.data();
+				if (distance < QApplication::startDragDistance()) {
+					return base::EventFilterResult::Continue;
+				} else if (!overlay) {
+					reset();
+					return base::EventFilterResult::Continue;
+				}
+				drag->active = true;
+				if (const auto button = dynamic_cast<Ui::AbstractButton*>(
+						source.get())) {
+					button->clearState();
+				}
+				if (MoneyCardStickerOn(session, drag->gift->slug)) {
+					drag->hidden = drag->gift->slug;
+					Hide(session, drag->hidden);
+				}
+				drag->overlay = CreateFloating(
+					overlay,
+					session,
+					drag->gift->model.document->id,
+					[=] { return point(drag->global).value_or(QPointF()); },
+					[=](QPointF at) { return !dropRect(at).isEmpty(); });
+			}
+			if (drag->overlay) {
+				drag->overlay->update();
+			}
+			return base::EventFilterResult::Cancel;
+		} else if (mouse->button() != Qt::LeftButton) {
+			return drag->active
+				? base::EventFilterResult::Cancel
+				: base::EventFilterResult::Continue;
+		} else if (!drag->active) {
+			reset();
+			return base::EventFilterResult::Continue;
+		}
+		const auto unique = drag->gift;
+		const auto at = point(global);
+		const auto card = at ? dropRect(*at) : QRect();
+		if (unique && !card.isEmpty()) {
+			PlaceMoneyCardSticker(
+				session,
+				*unique,
+				chain,
+				Clamped(*at - QPointF(card.topLeft()), QSizeF(card.size())));
+			AnimateLanding(session, unique->slug, target, false);
+		}
+		reset();
+		return base::EventFilterResult::Cancel;
+	});
+}
+
+MoneyCardStickers::MoneyCardStickers(
+	not_null<Main::Session*> session,
+	Fn<void()> repaint)
+: _session(session)
+, _repaint(std::move(repaint)) {
+	MoneyCardStickersValue(
+		session
+	) | rpl::on_next([=](std::vector<MoneyCardSticker> list) {
+		_list = std::move(list);
+		_repaint();
+	}, _lifetime);
+	rpl::merge(
+		FramesFor(session).ready.events(),
+		FramesFor(session).hiddenChanges.events()
+	) | rpl::on_next([=] {
+		if (!_list.empty()) {
+			_repaint();
+		}
+	}, _lifetime);
+
+	const auto wallet = &session->wallet();
+	rpl::single(rpl::empty) | rpl::then(
+		wallet->collectiblesUpdates()
+	) | rpl::on_next([=] {
+		const auto &list = wallet->collectibles();
+		if (list.empty()) {
+			return;
+		} else if (wallet->collectiblesHasNext()) {
+			if (MoneyCardNeedsChainList(session)) {
+				wallet->loadMoreCollectibles();
+			}
+			return;
+		}
+		auto slugs = base::flat_set<QString>();
+		for (const auto &item : list) {
+			if (item.kind == Gram::NftKind::TelegramGift
+				&& !item.key.isEmpty()) {
+				slugs.emplace(item.key);
+			}
+		}
+		SetMoneyCardChainSlugs(session, std::move(slugs));
+	}, _lifetime);
+}
