-[[nodiscard]] MoneyCardChoice Deserialize(const QString &value) {
+[[nodiscard]] float64 Fraction(const QJsonValue &value) {
+	const auto result = value.toDouble(0.5);
+	return std::isfinite(result) ? std::clamp(result, 0., 1.) : 0.5;
+}
+
+[[nodiscard]] std::vector<MoneyCardSticker> DeserializeStickers(
+		const QJsonValue &value) {
+	auto result = std::vector<MoneyCardSticker>();
+	auto keys = base::flat_set<QString>();
+	for (const auto &item : value.toArray()) {
+		const auto entry = item.toObject();
+		auto sticker = MoneyCardSticker{
+			.key = entry.value(u"key"_q).toString(),
+			.modelId = entry.value(u"model"_q).toString().toULongLong(),
+			.center = QPointF(
+				Fraction(entry.value(u"x"_q)),
+				Fraction(entry.value(u"y"_q))),
+			.chain = entry.value(u"chain"_q).toBool(),
+		};
+		if (!sticker.key.isEmpty()
+			&& sticker.modelId
+			&& keys.emplace(sticker.key).second) {
+			result.push_back(std::move(sticker));
+		}
+	}
+	return result;
+}
