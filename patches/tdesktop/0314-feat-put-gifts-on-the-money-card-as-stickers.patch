+void AddOnCardBadge(
+		not_null<Info::PeerGifts::GiftButton*> button,
+		not_null<Main::Session*> session,
+		QString slug,
+		QMargins extend) {
+	const auto badge = Ui::CreateChild<Ui::RpWidget>(button.get());
+	badge->setAttribute(Qt::WA_TransparentForMouseEvents);
+	button->sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		badge->setGeometry(QRect(QPoint(), size).marginsRemoved(extend));
+	}, badge->lifetime());
+	badge->paintRequest(
+	) | rpl::on_next([=] {
+		if (!MoneyCardStickerOn(session, slug)) {
+			return;
+		}
+		auto p = QPainter(badge);
+		auto hq = PainterHighQualityEnabler(p);
+		const auto &font = st::semiboldFont;
+		const auto text = Lower(u"on card"_q);
+		const auto padding = font->height / 2;
+		const auto width = font->width(text) + 2 * padding;
+		const auto height = font->height + padding / 2;
+		const auto rect = QRect(
+			(badge->width() - width) / 2,
+			badge->height() - height - padding,
+			width,
+			height);
+		p.setPen(Qt::NoPen);
+		p.setBrush(QColor(0, 0, 0, 96));
+		p.drawRoundedRect(rect, height / 2., height / 2.);
+		p.setPen(QColor(255, 255, 255));
+		p.setFont(font);
+		p.drawText(rect, text, style::al_center);
+	}, badge->lifetime());
+	MoneyCardStickersUpdates(
+		session
+	) | rpl::on_next([=] {
+		badge->update();
+	}, badge->lifetime());
+	badge->show();
+}
