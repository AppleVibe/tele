+
+void AddMoneyCardSticker(
+		not_null<Main::Session*> session,
+		const Data::UniqueGift &gift,
+		bool chain,
+		std::shared_ptr<MoneyCardDropTarget> target) {
+	auto list = MoneyCardStickersFor(session);
+	if (gift.slug.isEmpty()
+		|| (ranges::find(list, gift.slug, &MoneyCardSticker::key)
+			!= end(list))) {
+		return;
+	}
+	const auto center = FreeSpot(list);
+	list.push_back({
+		.key = gift.slug,
+		.modelId = gift.model.document->id,
+		.center = center,
+		.chain = chain,
+	});
+	SetMoneyCardStickers(session, std::move(list));
+	ValidateMoneyCardChoice(session);
+	AnimateLanding(session, gift.slug, target, true);
+}
+
+void PlaceMoneyCardSticker(
+		not_null<Main::Session*> session,
+		const Data::UniqueGift &gift,
+		bool chain,
+		QPointF center) {
+	const auto list = MoneyCardStickersFor(session);
+	if (ranges::find(list, gift.slug, &MoneyCardSticker::key) != end(list)) {
+		RaiseSticker(session, gift.slug, center);
+		return;
+	} else if (gift.slug.isEmpty()) {
+		return;
+	}
+	auto updated = list;
+	updated.push_back({
+		.key = gift.slug,
+		.modelId = gift.model.document->id,
+		.center = center,
+		.chain = chain,
+	});
+	SetMoneyCardStickers(session, std::move(updated));
+	ValidateMoneyCardChoice(session);
+}
+
+void RemoveMoneyCardSticker(
+		not_null<Main::Session*> session,
+		const QString &key) {
+	auto list = MoneyCardStickersFor(session);
+	const auto removed = ranges::remove(list, key, &MoneyCardSticker::key);
+	if (removed == end(list)) {
+		return;
+	}
+	list.erase(removed, end(list));
+	SetMoneyCardStickers(session, std::move(list));
+}
+
+void RegisterMoneyCardGiftSource(
+		not_null<Ui::RpWidget*> widget,
+		not_null<Main::Session*> session,
+		Fn<QString()> slug,
+		Fn<QRect()> model) {
+	auto &frames = FramesFor(session);
+	const auto id = ++frames.sourceId;
+	frames.sources.push_back({
+		.id = id,
+		.widget = widget.get(),
+		.slug = std::move(slug),
+		.model = std::move(model),
+	});
+	const auto weak = base::make_weak(session);
+	widget->lifetime().add([=] {
+		if (const auto strong = weak.get()) {
+			auto &sources = FramesFor(strong).sources;
+			sources.erase(
+				ranges::remove(sources, id, &Frames::Source::id),
+				end(sources));
+		}
+	});
+}
+
+void FillMoneyCardGiftMenu(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<Main::Session*> session,
+		std::shared_ptr<Data::UniqueGift> gift,
+		bool chain,
+		std::shared_ptr<MoneyCardDropTarget> target,
+		Fn<void(MoneyCardLook)> applyColor) {
+	if (!gift || !MoneyCardDesigns()) {
+		return;
+	}
+	menu->addAction(Lower(u"Apply color"_q), [=] {
+		const auto look = MoneyCardLookFrom(*gift);
+		if (applyColor) {
+			applyColor(look);
+		} else {
+			SetMoneyCardChoice(session, {
+				.gift = look,
+				.sync = false,
+				.chain = chain,
+			});
+		}
+	}, &st::menuIconPalette);
+	if (MoneyCardStickerOn(session, gift->slug)) {
+		menu->addAction(Lower(u"Remove from card"_q), [=] {
+			if (!Hidden(session, gift->slug)) {
+				RemoveAnimated(session, gift->slug, target, std::nullopt);
+			}
+		}, &st::menuIconRemove);
+	} else {
+		menu->addAction(Lower(u"Add to card"_q), [=] {
+			AddMoneyCardSticker(session, *gift, chain, target);
+		}, &st::menuIconStickerAdd);
+	}
+}
