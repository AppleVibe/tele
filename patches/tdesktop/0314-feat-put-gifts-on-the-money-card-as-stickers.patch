+constexpr auto kModelSide = 60;
+constexpr auto kOutline = 2;
+constexpr auto kShadowBlur = 4;
+constexpr auto kShadowShift = 2;
+constexpr auto kShadowAlpha = 80;
+constexpr auto kOutlineSteps = 24;
+constexpr auto kHitAlpha = 128;
+constexpr auto kSilhouetteDarken = 0.3;
+constexpr auto kOutsideOpacity = 0.5;
+constexpr auto kFlyDuration = crl::time(300);
+constexpr auto kPopDuration = crl::time(280);
+constexpr auto kOutDuration = crl::time(250);
+constexpr auto kArc = 0.2;
+constexpr auto kPop = 0.08;
+constexpr auto kOutScale = 0.6;
+constexpr auto kRippleAlpha = 0.55;
