+struct FrameLoader {
+	std::shared_ptr<Data::DocumentMedia> media;
+	std::unique_ptr<HistoryView::StickerPlayer> player;
+	rpl::lifetime lifetime;
+	bool done = false;
+};
+
+struct Frames {
+	base::flat_map<DocumentId, QImage> raw;
+	base::flat_map<DocumentId, std::unique_ptr<FrameLoader>> loading;
+	base::flat_set<DocumentId> failed;
+	base::flat_map<std::pair<DocumentId, int>, QImage> stickers;
+	base::flat_map<std::tuple<DocumentId, QRgb, int>, QImage> silhouettes;
+	rpl::event_stream<> ready;
+	base::flat_map<QString, int> hidden;
+	rpl::event_stream<> hiddenChanges;
+	struct Source {
+		uint64 id = 0;
+		QPointer<QWidget> widget;
+		Fn<QString()> slug;
+		Fn<QRect()> model;
+	};
+	std::vector<Source> sources;
+	uint64 sourceId = 0;
+};
+
+[[nodiscard]] Frames &FramesFor(not_null<Main::Session*> session) {
+	static auto map = base::flat_map<
+		not_null<Main::Session*>,
+		std::unique_ptr<Frames>>();
+	auto i = map.find(session);
+	if (i == end(map)) {
+		i = map.emplace(session, std::make_unique<Frames>()).first;
+		session->lifetime().add([=] {
+			map.remove(session);
+		});
+	}
+	return *i->second;
+}
+
+void RequestFrame(not_null<Main::Session*> session, DocumentId id) {
+	auto &frames = FramesFor(session);
+	if (!id
+		|| frames.raw.contains(id)
+		|| frames.loading.contains(id)
+		|| frames.failed.contains(id)) {
+		return;
+	}
+	const auto loader = frames.loading.emplace(
+		id,
+		std::make_unique<FrameLoader>()).first->second.get();
+	const auto raw = session.get();
+	const auto finish = [=](QImage image) {
+		crl::on_main(raw, [=] {
+			auto &frames = FramesFor(raw);
+			frames.loading.remove(id);
+			if (image.isNull()) {
+				frames.failed.emplace(id);
+			} else {
+				frames.raw[id] = image;
+				frames.ready.fire({});
+			}
+		});
+	};
+	const auto side = style::ConvertScale(kModelSide);
+	const auto size = QSize(side, side);
+	session->data().customEmojiManager().resolve(
+		id
+	) | rpl::take(
+		1
+	) | rpl::on_next_error([=](not_null<DocumentData*> document) {
+		const auto media = document->createMediaView();
+		media->checkStickerLarge();
+		loader->media = media;
+		rpl::single(rpl::empty) | rpl::then(
+			raw->downloaderTaskFinished()
+		) | rpl::filter([=] {
+			return media->loaded();
+		}) | rpl::take(1) | rpl::on_next([=] {
+			loader->player = MakeMoneyCardModelPlayer(
+				document,
+				media.get(),
+				size);
+			if (!loader->player) {
+				loader->done = true;
+				finish(QImage());
+				return;
+			}
+			const auto grab = [=] {
+				if (loader->done
+					|| !loader->player
+					|| !loader->player->ready()) {
+					return;
+				}
+				auto info = loader->player->frame(
+					size,
+					QColor(0, 0, 0, 0),
+					false,
+					crl::now(),
+					true);
+				if (info.image.isNull()) {
+					return;
+				}
+				loader->done = true;
+				auto image = info.image.copy();
+				image.setDevicePixelRatio(1.);
+				finish(std::move(image));
+			};
+			loader->player->setRepaintCallback(grab);
+			grab();
+		}, loader->lifetime);
+	}, [=] {
+		loader->done = true;
+		finish(QImage());
+	}, loader->lifetime);
+}
+
+[[nodiscard]] QImage TintedCopy(const QImage &image, QColor color) {
+	auto result = image.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+	auto q = QPainter(&result);
+	q.setCompositionMode(QPainter::CompositionMode_SourceIn);
+	q.fillRect(result.rect(), color);
+	q.end();
+	return result;
+}
+
+[[nodiscard]] QImage ComposeSticker(const QImage &frame, int ratio) {
+	const auto model = style::ConvertScale(kModelSide) * ratio;
+	const auto outline = std::max(style::ConvertScale(kOutline) * ratio, 1);
+	const auto blur = std::max(style::ConvertScale(kShadowBlur) * ratio, 1);
+	const auto shift = style::ConvertScale(kShadowShift) * ratio;
+	const auto side = model + 2 * (outline + blur + shift);
+	const auto scaled = frame.scaled(
+		model,
+		model,
+		Qt::KeepAspectRatio,
+		Qt::SmoothTransformation
+	).convertToFormat(QImage::Format_ARGB32_Premultiplied);
+	const auto origin = QPoint(
+		(side - scaled.width()) / 2,
+		(side - scaled.height()) / 2);
+	const auto white = TintedCopy(scaled, Qt::white);
+	auto outlined = QImage(
+		side,
+		side,
+		QImage::Format_ARGB32_Premultiplied);
+	outlined.fill(Qt::transparent);
+	{
+		auto q = QPainter(&outlined);
+		for (const auto radius : { outline, outline / 2 }) {
+			if (!radius) {
+				continue;
+			}
+			for (auto i = 0; i != kOutlineSteps; ++i) {
+				const auto angle = 2. * M_PI * i / kOutlineSteps;
+				q.drawImage(
+					origin + QPoint(
+						int(std::round(std::cos(angle) * radius)),
+						int(std::round(std::sin(angle) * radius))),
+					white);
+			}
+		}
+		q.drawImage(origin, white);
+	}
+	auto shadow = Images::BlurLargeImage(
+		TintedCopy(outlined, QColor(0, 0, 0, kShadowAlpha)),
+		blur);
+	auto result = QImage(side, side, QImage::Format_ARGB32_Premultiplied);
+	result.fill(Qt::transparent);
+	{
+		auto q = QPainter(&result);
+		q.drawImage(QPoint(0, shift), shadow);
+		q.drawImage(0, 0, outlined);
+		q.drawImage(origin, scaled);
+	}
+	result.setDevicePixelRatio(ratio);
+	return result;
+}
+
+[[nodiscard]] QImage StickerImage(
+		not_null<Main::Session*> session,
+		DocumentId modelId) {
+	auto &frames = FramesFor(session);
+	const auto ratio = style::DevicePixelRatio();
+	const auto key = std::make_pair(modelId, ratio);
+	if (const auto i = frames.stickers.find(key); i != end(frames.stickers)) {
+		return i->second;
+	}
+	const auto raw = frames.raw.find(modelId);
+	if (raw == end(frames.raw)) {
+		RequestFrame(session, modelId);
+		return QImage();
+	}
+	return frames.stickers.emplace(
+		key,
+		ComposeSticker(raw->second, ratio)).first->second;
+}
+
+[[nodiscard]] QImage Silhouette(
+		not_null<Main::Session*> session,
+		DocumentId modelId,
+		QColor color,
+		int side) {
+	auto &frames = FramesFor(session);
+	const auto ratio = style::DevicePixelRatio();
+	const auto key = std::make_tuple(modelId, color.rgba(), side * ratio);
+	const auto i = frames.silhouettes.find(key);
+	if (i != end(frames.silhouettes)) {
+		return i->second;
+	}
+	const auto raw = frames.raw.find(modelId);
+	if (raw == end(frames.raw)) {
+		RequestFrame(session, modelId);
+		return QImage();
+	}
+	auto result = TintedCopy(
+		raw->second.scaled(
+			side * ratio,
+			side * ratio,
+			Qt::KeepAspectRatio,
+			Qt::SmoothTransformation),
+		color);
+	result.setDevicePixelRatio(ratio);
+	return frames.silhouettes.emplace(key, std::move(result)).first->second;
+}
+
+[[nodiscard]] int HitSide() {
+	return style::ConvertScale(kModelSide) + 2 * style::ConvertScale(kOutline);
+}
+
+[[nodiscard]] QSizeF ReferenceCard() {
+	return QSizeF(
+		st::walletPanelSize.width()
+			- st::walletCardMargin.left()
+			- st::walletCardMargin.right(),
+		st::walletCardHeight);
+}
+
+[[nodiscard]] bool Hidden(not_null<Main::Session*> session, const QString &key) {
+	return FramesFor(session).hidden.contains(key);
+}
+
+void Hide(not_null<Main::Session*> session, const QString &key) {
+	if (key.isEmpty()) {
+		return;
+	}
+	auto &frames = FramesFor(session);
+	if (++frames.hidden[key] == 1) {
+		frames.hiddenChanges.fire({});
+	}
+}
+
+void Unhide(not_null<Main::Session*> session, const QString &key) {
+	auto &frames = FramesFor(session);
+	const auto i = frames.hidden.find(key);
+	if (i == end(frames.hidden)) {
+		return;
+	} else if (--i->second <= 0) {
+		frames.hidden.erase(i);
+		frames.hiddenChanges.fire({});
+	}
+}
+
+[[nodiscard]] QRect ClippedIn(
+		not_null<QWidget*> widget,
+		QRect local,
+		not_null<QWidget*> ancestor) {
+	if (!widget->isVisible()) {
+		return QRect();
+	}
+	auto result = QRect(widget->mapTo(ancestor, local.topLeft()), local.size());
+	for (auto parent = widget.get(); parent; parent = parent->parentWidget()) {
+		result &= QRect(parent->mapTo(ancestor, QPoint()), parent->size());
+		if (parent == ancestor) {
+			break;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] std::optional<QRect> FindSource(
+		not_null<Main::Session*> session,
+		const QString &key,
+		not_null<QWidget*> overlay) {
+	const auto &sources = FramesFor(session).sources;
+	for (auto i = sources.rbegin(); i != sources.rend(); ++i) {
+		const auto widget = i->widget.data();
+		if (!widget
+			|| !overlay->isAncestorOf(widget)
+			|| i->slug() != key) {
+			continue;
+		}
+		const auto model = i->model();
+		if (model.isEmpty()
+			|| ClippedIn(widget, model, overlay).isEmpty()) {
+			continue;
+		}
+		return QRect(widget->mapTo(overlay, model.topLeft()), model.size());
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] QPointF CenterIn(const MoneyCardSticker &sticker, QSizeF card) {
+	return QPointF(
+		sticker.center.x() * card.width(),
+		sticker.center.y() * card.height());
+}
+
+[[nodiscard]] QPointF Clamped(QPointF center, QSizeF card) {
+	const auto half = HitSide() / 2.;
+	const auto clamp = [=](float64 value, float64 full) {
+		return (full > 2 * half)
+			? std::clamp(value, half, full - half) / full
+			: 0.5;
+	};
+	return QPointF(
+		clamp(center.x(), card.width()),
+		clamp(center.y(), card.height()));
+}
+
+[[nodiscard]] QPointF FreeSpot(const std::vector<MoneyCardSticker> &list) {
+	static constexpr auto kSlots = std::array<std::pair<float64, float64>, 6>{ {
+		{ 0.15, 0.21 },
+		{ 0.39, 0.19 },
+		{ 0.62, 0.21 },
+		{ 0.82, 0.22 },
+		{ 0.58, 0.78 },
+		{ 0.80, 0.80 },
+	} };
+	const auto card = ReferenceCard();
+	const auto distance = HitSide() * 0.8;
+	const auto free = [&](QPointF center) {
+		const auto at = QPointF(
+			center.x() * card.width(),
+			center.y() * card.height());
+		return ranges::none_of(list, [&](const MoneyCardSticker &sticker) {
+			const auto other = CenterIn(sticker, card);
+			return std::hypot(at.x() - other.x(), at.y() - other.y())
+				< distance;
+		});
+	};
+	for (const auto &[x, y] : kSlots) {
+		if (free(QPointF(x, y))) {
+			return QPointF(x, y);
+		}
+	}
+	const auto half = HitSide() / 2;
+	const auto width = std::max(int(card.width()) - 2 * half, 1);
+	const auto height = std::max(int(card.height()) - 2 * half, 1);
+	return Clamped(
+		QPointF(
+			half + base::RandomIndex(width),
+			half + base::RandomIndex(height)),
+		card);
+}
+
+void RaiseSticker(
+		not_null<Main::Session*> session,
+		const QString &key,
+		std::optional<QPointF> center) {
+	auto list = MoneyCardStickersFor(session);
+	const auto i = ranges::find(list, key, &MoneyCardSticker::key);
+	if (i == end(list)) {
+		return;
+	}
+	auto sticker = *i;
+	list.erase(i);
+	if (center) {
+		sticker.center = *center;
+	}
+	list.push_back(std::move(sticker));
+	SetMoneyCardStickers(session, std::move(list));
+}
+
+[[nodiscard]] std::optional<MoneyCardSticker> FindSticker(
+		not_null<Main::Session*> session,
+		const QString &key) {
+	const auto list = MoneyCardStickersFor(session);
+	const auto i = ranges::find(list, key, &MoneyCardSticker::key);
+	return (i != end(list)) ? std::make_optional(*i) : std::nullopt;
+}
+
+[[nodiscard]] base::unique_qptr<Ui::RpWidget> CreateFloating(
+		not_null<QWidget*> parent,
+		not_null<Main::Session*> session,
+		DocumentId modelId,
+		Fn<QPointF()> center,
+		Fn<bool(QPointF)> inside) {
+	auto result = base::make_unique_q<Ui::RpWidget>(parent.get());
+	const auto raw = result.get();
+	raw->setAttribute(Qt::WA_TransparentForMouseEvents);
+	raw->setGeometry(parent->rect());
+	raw->show();
+	raw->raise();
+	raw->paintRequest(
+	) | rpl::on_next([=] {
+		const auto image = StickerImage(session, modelId);
+		if (image.isNull()) {
+			return;
+		}
+		const auto at = center();
+		auto p = QPainter(raw);
+		auto hq = PainterHighQualityEnabler(p);
+		if (!inside(at)) {
+			p.setOpacity(kOutsideOpacity);
+		}
+		const auto size = QSizeF(image.size()) / image.devicePixelRatio();
+		p.drawImage(
+			QRectF(at - QPointF(size.width() / 2., size.height() / 2.), size),
+			image);
+	}, raw->lifetime());
+	FramesFor(session).ready.events(
+	) | rpl::on_next([=] {
+		raw->update();
+	}, raw->lifetime());
+	return result;
+}
+
+enum class Ending : uchar {
+	Land,
+	Out,
+	Arrive,
+};
+
+struct Flight {
+	QPointF from;
+	QPointF to;
+	float64 fromScale = 1.;
+	float64 toScale = 1.;
+};
+
+[[nodiscard]] float64 ModelScale(QRect model) {
+	return model.width() / float64(style::ConvertScale(kModelSide));
+}
+
+[[nodiscard]] QPointF FlightPoint(const Flight &flight, float64 progress) {
+	const auto delta = flight.to - flight.from;
+	const auto length = std::hypot(delta.x(), delta.y());
+	const auto middle = (flight.from + flight.to) / 2.;
+	auto normal = (length > 0.)
+		? QPointF(delta.y(), -delta.x()) / length
+		: QPointF();
+	if (normal.y() > 0.) {
+		normal = -normal;
+	}
+	const auto control = middle + normal * (length * kArc);
+	const auto rest = 1. - progress;
+	return flight.from * (rest * rest)
+		+ control * (2. * rest * progress)
+		+ flight.to * (progress * progress);
+}
+
+void Animate(
+		not_null<Main::Session*> session,
+		not_null<QWidget*> overlay,
+		DocumentId modelId,
+		std::optional<Flight> flight,
+		QPointF position,
+		Ending ending,
+		QString hide,
+		Fn<void()> done) {
+	if (anim::Disabled()) {
+		if (done) {
+			done();
+		}
+		return;
+	}
+	Hide(session, hide);
+	const auto raw = Ui::CreateChild<Ui::RpWidget>(overlay.get());
+	raw->setAttribute(Qt::WA_TransparentForMouseEvents);
+	raw->setGeometry(overlay->rect());
+	raw->show();
+	raw->raise();
+
+	struct State {
+		Ui::Animations::Basic animation;
+		crl::time started = 0;
+		bool finished = false;
+	};
+	const auto state = raw->lifetime().make_state<State>();
+	const auto weak = base::make_weak(session);
+	const auto fly = flight ? kFlyDuration : crl::time(0);
+	const auto tail = (ending == Ending::Land)
+		? kPopDuration
+		: (ending == Ending::Out)
+		? kOutDuration
+		: crl::time(0);
+	const auto total = std::max(fly + tail, crl::time(1));
+	const auto finish = [=] {
+		if (state->finished) {
+			return;
+		}
+		state->finished = true;
+		if (const auto strong = weak.get()) {
+			if (done) {
+				done();
+			}
+			Unhide(strong, hide);
+		}
+	};
+	raw->lifetime().add(finish);
+
+	raw->paintRequest(
+	) | rpl::on_next([=] {
+		const auto strong = weak.get();
+		if (!strong || state->finished) {
+			return;
+		}
+		const auto image = StickerImage(strong, modelId);
+		if (image.isNull()) {
+			return;
+		}
+		const auto elapsed = std::clamp(
+			crl::now() - state->started,
+			crl::time(0),
+			total);
+		auto center = position;
+		auto scale = 1.;
+		auto opacity = 1.;
+		auto ripple = -1.;
+		if (flight && elapsed < fly) {
+			const auto progress = anim::easeOutCubic(
+				1.,
+				elapsed / float64(fly));
+			center = FlightPoint(*flight, progress);
+			scale = flight->fromScale
+				+ (flight->toScale - flight->fromScale) * progress;
+		} else if (ending == Ending::Land) {
+			const auto local = (elapsed - fly)
+				/ float64(std::max(tail, crl::time(1)));
+			scale = 1. + kPop * std::sin(M_PI * local);
+			ripple = local;
+		} else if (ending == Ending::Out) {
+			const auto local = anim::easeOutCubic(
+				1.,
+				(elapsed - fly) / float64(std::max(tail, crl::time(1))));
+			scale = 1. - (1. - kOutScale) * local;
+			opacity = 1. - local;
+		} else {
+			return;
+		}
+		auto p = QPainter(raw);
+		auto hq = PainterHighQualityEnabler(p);
+		if (ripple >= 0.) {
+			const auto progress = anim::easeOutCubic(1., ripple);
+			const auto side = style::ConvertScale(kModelSide);
+			const auto radius = side * (0.45 + 0.5 * progress);
+			auto color = QColor(255, 255, 255);
+			color.setAlphaF(kRippleAlpha * (1. - ripple));
+			auto pen = QPen(color);
+			pen.setWidthF(style::ConvertScaleExact(2.));
+			p.setPen(pen);
+			p.setBrush(Qt::NoBrush);
+			p.drawEllipse(center, radius, radius);
+		}
+		p.setOpacity(opacity);
+		const auto size = QSizeF(image.size()) / image.devicePixelRatio()
+			* scale;
+		p.drawImage(
+			QRectF(
+				center - QPointF(size.width() / 2., size.height() / 2.),
+				size),
+			image);
+	}, raw->lifetime());
+
+	state->started = crl::now();
+	state->animation.init([=](crl::time now) {
+		raw->update();
+		if (now - state->started < total) {
+			return true;
+		}
+		finish();
+		crl::on_main(raw, [=] {
+			delete raw;
+		});
+		return false;
+	});
+	state->animation.start();
+}
+
+[[nodiscard]] QRect DropCard(
+		const std::shared_ptr<MoneyCardDropTarget> &target) {
+	return (target && target->overlay && target->card)
+		? target->card()
+		: QRect();
+}
+
+void AnimateLanding(
+		not_null<Main::Session*> session,
+		const QString &key,
+		const std::shared_ptr<MoneyCardDropTarget> &target,
+		bool fromSource) {
+	const auto sticker = FindSticker(session, key);
+	const auto card = DropCard(target);
+	if (!sticker || card.isEmpty()) {
+		return;
+	}
+	const auto overlay = target->overlay.data();
+	const auto to = QPointF(card.topLeft())
+		+ CenterIn(*sticker, QSizeF(card.size()));
+	auto flight = std::optional<Flight>();
+	if (fromSource) {
+		if (const auto source = FindSource(session, key, overlay)) {
+			flight = Flight{
+				.from = QRectF(*source).center(),
+				.to = to,
+				.fromScale = ModelScale(*source),
+				.toScale = 1.,
+			};
+		}
+	}
+	Animate(
+		session,
+		overlay,
+		sticker->modelId,
+		flight,
+		to,
+		Ending::Land,
+		key,
+		nullptr);
+}
+
+void RemoveAnimated(
+		not_null<Main::Session*> session,
+		const QString &key,
+		const std::shared_ptr<MoneyCardDropTarget> &target,
+		std::optional<QPointF> from) {
+	const auto sticker = FindSticker(session, key);
+	if (!sticker) {
+		return;
+	}
+	const auto remove = [=] {
+		RemoveMoneyCardSticker(session, key);
+	};
+	const auto card = DropCard(target);
+	if (!from && !card.isEmpty()) {
+		from = QPointF(card.topLeft())
+			+ CenterIn(*sticker, QSizeF(card.size()));
+	}
+	const auto overlay = target ? target->overlay.data() : nullptr;
+	if (!from || !overlay) {
+		remove();
+		return;
+	}
+	if (const auto source = FindSource(session, key, overlay)) {
+		Animate(
+			session,
+			overlay,
+			sticker->modelId,
+			Flight{
+				.from = *from,
+				.to = QRectF(*source).center(),
+				.fromScale = 1.,
+				.toScale = ModelScale(*source),
+			},
+			*from,
+			Ending::Arrive,
+			key,
+			remove);
+	} else {
+		Animate(
+			session,
+			overlay,
+			sticker->modelId,
+			std::nullopt,
+			*from,
+			Ending::Out,
+			key,
+			remove);
+	}
+}
