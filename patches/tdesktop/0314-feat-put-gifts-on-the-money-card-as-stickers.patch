+bool MoneyCardStickerOn(
+		not_null<Main::Session*> session,
+		const QString &key) {
+	if (key.isEmpty() || !MoneyCardDesigns()) {
+		return false;
+	}
+	return FindSticker(session, key).has_value();
+}
