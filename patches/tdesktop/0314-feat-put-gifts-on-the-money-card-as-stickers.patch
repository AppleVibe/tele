+}
+
+struct Needs {
+	bool telegram = false;
+	bool chain = false;
+};
+
+[[nodiscard]] bool Lost(
+		const SessionState &state,
+		const QString &slug,
+		bool chain,
+		Needs &needs) {
+	const auto &own = chain ? state.chainSlugs : state.telegramSlugs;
+	const auto &other = chain ? state.telegramSlugs : state.chainSlugs;
+	if (own && other) {
+		return !own->contains(slug) && !other->contains(slug);
+	} else if (own && !own->contains(slug)) {
+		(chain ? needs.telegram : needs.chain) = true;
+	}
+	return false;
+}
+
+void PruneOwned(not_null<Main::Session*> session) {
+	auto &state = StateFor(session);
+	auto needs = Needs();
+	auto changed = false;
+	auto choice = state.choice.current();
+	if (choice.gift && Lost(state, choice.gift.slug, choice.chain, needs)) {
 		choice.gift = MoneyCardLook();
-		SetMoneyCardChoice(session, choice);
+		choice.chain = false;
+		state.choice = choice;
+		changed = true;
+	}
+	auto stickers = state.stickers.current();
+	const auto removed = ranges::remove_if(stickers, [&](
+			const MoneyCardSticker &sticker) {
+		return Lost(state, sticker.key, sticker.chain, needs);
+	});
+	if (removed != end(stickers)) {
+		stickers.erase(removed, end(stickers));
+		state.stickers = std::move(stickers);
+		changed = true;
+	}
+	if (changed) {
+		Write(session, state);
+	}
+	state.needChain = needs.chain && !state.chainSlugs;
+	if (needs.telegram) {
+		RequestTelegramOwned(session);
+	}
+	if (state.needChain) {
+		session->wallet().loadMoreCollectibles();
 	}
 }
 
+void CheckOwned(
+		not_null<Main::Session*> session,
+		const std::vector<Data::SavedStarGift> &owned) {
+	auto slugs = base::flat_set<QString>();
+	for (const auto &gift : owned) {
+		if (const auto &unique = gift.info.unique) {
+			slugs.emplace(unique->slug);
+		}
+	}
+	StateFor(session).telegramSlugs = std::move(slugs);
+	PruneOwned(session);
+}
