+bool PaintMoneyCardStickerThumb(
+		QPainter &p,
+		not_null<Main::Session*> session,
+		const std::shared_ptr<Data::UniqueGift> &gift,
+		QRect rect,
+		int radius) {
+	if (!gift || !MoneyCardStickerOn(session, gift->slug)) {
+		return false;
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	auto gradient = QRadialGradient(
+		QRectF(rect).center(),
+		rect.width() / 2.);
+	gradient.setStops({
+		{ 0., gift->backdrop.centerColor },
+		{ 1., gift->backdrop.edgeColor },
+	});
+	p.setPen(Qt::NoPen);
+	p.setBrush(gradient);
+	p.drawRoundedRect(rect, radius, radius);
+	const auto model = MoneyCardModelRect(rect);
+	const auto image = Silhouette(
+		session,
+		gift->model.document->id,
+		anim::color(
+			gift->backdrop.edgeColor,
+			QColor(0, 0, 0),
+			kSilhouetteDarken),
+		model.width());
+	if (!image.isNull()) {
+		p.drawImage(model, image);
+	}
+	return true;
+}
