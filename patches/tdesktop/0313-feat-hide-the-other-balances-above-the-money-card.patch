+rpl::producer<bool> MoneyBalanceRowShown(rpl::producer<bool> shown) {
+	return rpl::combine(
+		std::move(shown),
+		MoneyHideBalancesValue()
+	) | rpl::map([](bool shown, bool hidden) {
+		return shown && !hidden;
+	});
+}
+
+void AddHideBalancesMenu(not_null<Ui::RpWidget*> row) {
+	const auto menu = row->lifetime().make_state<
+		base::unique_qptr<Ui::PopupMenu>>();
+	base::install_event_filter(row, [=](not_null<QEvent*> e) {
+		if (e->type() != QEvent::ContextMenu || !MoneyCardDesignsOn()) {
+			return base::EventFilterResult::Continue;
+		}
+		*menu = base::make_unique_q<Ui::PopupMenu>(
+			row,
+			st::popupMenuWithIcons);
+		(*menu)->addAction(Lower(u"Hide these rows"_q), [] {
+			SetMoneyHideBalances(true);
+		}, &st::menuIconCancel);
+		(*menu)->popup(QCursor::pos());
+		return base::EventFilterResult::Cancel;
+	});
+}
+
 QSize MoneyCardModelSize(int chipSide) {
 	const auto side = int(base::SafeRound(chipSide * kModelScale));
 	return QSize(side, side);
