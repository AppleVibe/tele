+bool MentionNoticeReply(
+		not_null<Main::Session*> session,
+		const Notice &notice) {
+	if (notice.reply) {
+		return *notice.reply;
+	}
+	const auto peer = PeerFromNotice(notice.source
+		? notice.source
+		: notice.peer);
+	const auto msg = MsgId(notice.source ? notice.sourceMsg : notice.msg);
+	const auto item = session->data().message(peer, msg);
+	return item && IsReply(item);
+}
