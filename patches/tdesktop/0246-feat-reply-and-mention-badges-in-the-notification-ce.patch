+[[nodiscard]] bool IsReply(not_null<HistoryItem*> item) {
+	const auto reply = item->Get<HistoryMessageReply>();
+	if (reply && reply->resolvedMessage) {
+		return RepliesToSelf(item);
+	} else if (TextMentionsSelf(item)) {
+		return false;
+	} else if (item->history()->peer->isRepliesChat()) {
+		return true;
+	}
+	const auto to = reply ? reply->messageId() : MsgId();
+	return to
+		&& item->mentionsMe()
+		&& !(item->history()->isForum() && to == item->topicRootId());
+}
